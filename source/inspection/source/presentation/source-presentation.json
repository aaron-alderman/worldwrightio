{
  "protocol": "encounter/source-presentation-policy/1",
  "status": "supplied-bootstrap-presentation-definition",
  "roles": [
    "plain",
    "comment",
    "keyword",
    "string",
    "property",
    "number",
    "boolean",
    "reference",
    "identifier",
    "operator",
    "punctuation",
    "identity",
    "predicate",
    "type"
  ],
  "themesAllowed": [
    "light",
    "dark"
  ],
  "jsonPatternPath": [
    "queries",
    "source.jsonSpan",
    6,
    "args",
    "pattern"
  ],
  "maxCodeUnits": 160000,
  "maxParts": 18000,
  "identifierPattern": "[@$]?[A-Za-z_][A-Za-z0-9_.-]*",
  "keywords": [
    "module",
    "entity",
    "view",
    "of",
    "isa",
    "representation",
    "given",
    "as",
    "require",
    "equals",
    "return",
    "render",
    "events",
    "edit",
    "through",
    "here",
    "in",
    "show",
    "each",
    "run",
    "arguments",
    "let",
    "assert",
    "otherwise",
    "port",
    "call",
    "when",
    "fold",
    "starts",
    "yield",
    "try",
    "catch",
    "type",
    "valueType",
    "expects"
  ],
  "punctuation": [
    "[",
    "]",
    "{",
    "}",
    ":",
    ",",
    "(",
    ")",
    ";"
  ],
  "operators": [
    "=",
    "→",
    "-"
  ],
  "fileProfiles": [
    {
      "pattern": "\\.json$",
      "language": "json"
    },
    {
      "pattern": "\\.rel$",
      "language": "rel"
    },
    {
      "pattern": "\\.encounter$",
      "language": "encounter"
    },
    {
      "pattern": "\\.temple$",
      "language": "temple"
    },
    {
      "pattern": "\\.(?:js|mjs|cjs)$",
      "language": "javascript"
    }
  ],
  "javascriptRoles": [
    {
      "role": "string",
      "kinds": [
        "string",
        "template",
        "`"
      ]
    },
    {
      "role": "number",
      "kinds": [
        "num",
        "bigint",
        "decimal"
      ]
    },
    {
      "role": "identifier",
      "kinds": [
        "name",
        "privateId"
      ]
    },
    {
      "role": "punctuation",
      "kinds": [
        "(",
        ")",
        "{",
        "}",
        "[",
        "]",
        ",",
        ";",
        ":",
        "."
      ]
    },
    {
      "role": "operator",
      "kinds": [
        "=",
        "_=",
        "==/!=/===/!==",
        "+/-",
        "*",
        "/",
        "%",
        "**",
        "++/--",
        "!/~",
        "=>",
        "?",
        "?.",
        "??",
        "||",
        "&&",
        "|",
        "&",
        "^",
        "${"
      ]
    },
    {
      "role": "string",
      "kinds": [
        "regexp"
      ]
    }
  ],
  "themes": [
    {
      "id": "light",
      "roles": {
        "plain": "#20323f",
        "comment": "#657166",
        "keyword": "#754a91",
        "string": "#196641",
        "property": "#07596c",
        "number": "#96501b",
        "boolean": "#854c88",
        "reference": "#6e4590",
        "identifier": "#20323f",
        "operator": "#7d431c",
        "punctuation": "#52636a",
        "identity": "#07596c",
        "predicate": "#754a91",
        "type": "#8c4b16"
      }
    },
    {
      "id": "dark",
      "roles": {
        "plain": "#d8e7e3",
        "comment": "#94a99e",
        "keyword": "#e6b6fa",
        "string": "#b9e1a1",
        "property": "#91dbe5",
        "number": "#f6c394",
        "boolean": "#e6b6fa",
        "reference": "#f1d293",
        "identifier": "#d8e7e3",
        "operator": "#f6b5a4",
        "punctuation": "#adc6c9",
        "identity": "#91dbe5",
        "predicate": "#e6b6fa",
        "type": "#ffd38b"
      }
    }
  ],
  "layoutRules": [
    {
      "selector": ".sp-code",
      "context": null,
      "declarations": [
        {
          "property": "display",
          "value": "block"
        },
        {
          "property": "font",
          "value": "inherit"
        },
        {
          "property": "white-space",
          "value": "inherit"
        },
        {
          "property": "counter-reset",
          "value": "sp-line"
        }
      ]
    },
    {
      "selector": ".sp-code .sp-line",
      "context": null,
      "declarations": [
        {
          "property": "display",
          "value": "inline"
        },
        {
          "property": "padding",
          "value": "0"
        },
        {
          "property": "min-height",
          "value": "0"
        }
      ]
    },
    {
      "selector": ".sp-code[data-numbered=\"true\"] .sp-line::before",
      "context": null,
      "declarations": [
        {
          "property": "content",
          "value": "attr(data-line)"
        },
        {
          "property": "display",
          "value": "inline-block"
        },
        {
          "property": "width",
          "value": "3ch"
        },
        {
          "property": "padding-right",
          "value": "1.5ch"
        },
        {
          "property": "text-align",
          "value": "right"
        },
        {
          "property": "opacity",
          "value": ".55"
        },
        {
          "property": "user-select",
          "value": "none"
        },
        {
          "property": "font-size",
          "value": ".85em"
        }
      ]
    },
    {
      "selector": ".sp-code[data-numbered=\"false\"] .sp-line::before",
      "context": null,
      "declarations": [
        {
          "property": "content",
          "value": "none"
        }
      ]
    },
    {
      "selector": ".sp-code .highlight",
      "context": null,
      "declarations": [
        {
          "property": "background",
          "value": "#b98b3933"
        },
        {
          "property": "outline",
          "value": "1px solid #b98b3966"
        }
      ]
    },
    {
      "selector": ".sp-code .sp-comment",
      "context": null,
      "declarations": [
        {
          "property": "font-style",
          "value": "italic"
        }
      ]
    },
    {
      "selector": ".sp-code:focus-visible",
      "context": null,
      "declarations": [
        {
          "property": "outline",
          "value": "2px solid currentColor"
        },
        {
          "property": "outline-offset",
          "value": "4px"
        }
      ]
    },
    {
      "selector": ".sp-code .sp-type",
      "context": null,
      "declarations": [
        {
          "property": "font-weight",
          "value": "600"
        }
      ]
    }
  ],
  "referenceSigil": "$",
  "fileAliases": {
    "facts": "source/experiment/story.rel",
    "encounter": "source/experiment/story.encounter",
    "contracts": "source/experiment/contracts.rel"
  },
  "typeIntroducers": {
    "encounter": [
      "isa",
      "representation",
      "return"
    ],
    "temple": [
      "isa",
      "type",
      "valueType",
      "expects"
    ]
  },
  "typePredicates": [
    "isa",
    "type",
    "valueType",
    "expects",
    "A.accepts"
  ]
}
