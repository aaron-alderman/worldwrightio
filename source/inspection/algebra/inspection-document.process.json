{
  "protocol": "temple/surface-process-module/1",
  "profile": "encounter/read-only-source-document/1",
  "queries": {
    "inspection.document": [
      {
        "let": "error",
        "value": null
      },
      {
        "let": "request",
        "value": [
          "at",
          "$eventInput",
          "request"
        ]
      },
      {
        "let": "snapshot",
        "value": [
          "at",
          "$eventInput",
          "snapshot"
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "s01.portable",
          "input": {
            "value": "$request",
            "ancestors": [
              "list"
            ]
          }
        },
        "into": "portable"
      },
      {
        "when": [
          "and",
          [
            "not",
            "$error"
          ],
          [
            "not",
            "$portable"
          ]
        ],
        "then": [
          {
            "let": "error",
            "value": {
              "code": "ENC-DOC-INPUT",
              "message": "Request must be finite own-data",
              "owner": "inspection.document"
            }
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "inspection.recordShape",
              "input": {
                "value": "$request",
                "keys": [
                  "list",
                  "principal",
                  "context",
                  "target",
                  "expectedBasis",
                  "display"
                ],
                "required": [
                  "list",
                  "principal",
                  "context",
                  "target",
                  "expectedBasis"
                ]
              }
            },
            "into": "shape"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                "$shape"
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-INPUT",
                  "message": "Missing or extra request fields",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "value.describe",
            "args": {
              "value": [
                "at",
                "$request",
                "principal"
              ]
            },
            "into": "principalType"
          },
          {
            "port": "value.describe",
            "args": {
              "value": [
                "at",
                "$request",
                "context"
              ]
            },
            "into": "contextType"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "and",
                  [
                    "eq",
                    [
                      "at",
                      "$principalType",
                      "type"
                    ],
                    "string"
                  ],
                  [
                    "not",
                    [
                      "eq",
                      [
                        "at",
                        "$request",
                        "principal"
                      ],
                      ""
                    ]
                  ],
                  [
                    "eq",
                    [
                      "at",
                      "$contextType",
                      "type"
                    ],
                    "string"
                  ],
                  [
                    "not",
                    [
                      "eq",
                      [
                        "at",
                        "$request",
                        "context"
                      ],
                      ""
                    ]
                  ]
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-INPUT",
                  "message": "Explicit principal and context required",
                  "owner": "inspection.document"
                }
              }
            ]
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "eq",
                  [
                    "at",
                    "$request",
                    "expectedBasis"
                  ],
                  [
                    "at",
                    "$snapshot",
                    "basis"
                  ]
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-BASIS",
                  "message": "This selection belongs to a different loaded source basis",
                  "owner": "inspection.document"
                }
              }
            ]
          },
          {
            "let": "record",
            "value": [
              "at",
              "$snapshot",
              "record"
            ]
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "and",
                  "$record",
                  [
                    "eq",
                    [
                      "at",
                      "$request",
                      "target"
                    ],
                    [
                      "at",
                      "$record",
                      "id"
                    ]
                  ]
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-TARGET",
                  "message": "No exact bound source target",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "s01.portable",
              "input": {
                "value": "$snapshot",
                "ancestors": [
                  "list"
                ]
              }
            },
            "into": "snapshotPortable"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                "$snapshotPortable"
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-INPUT",
                  "message": "Snapshot must be finite own-data",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "inspection.sourceSpan",
              "input": {
                "source": [
                  "at",
                  "$record",
                  "source"
                ],
                "excerpts": [
                  "at",
                  "$snapshot",
                  "excerpts"
                ]
              }
            },
            "into": "span"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "at",
                  "$span",
                  "ok"
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-SOURCE",
                  "message": "Source occurrence failed its pinned span/digest check",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "let": "id",
            "value": [
              "at",
              "$record",
              "id"
            ]
          },
          {
            "let": "facts",
            "value": [
              "list",
              {
                "s": "$id",
                "p": "isa",
                "o": [
                  "at",
                  "$snapshot",
                  "type"
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "label",
                "o": [
                  "at",
                  "$record",
                  "label"
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "kind",
                "o": [
                  "at",
                  "$record",
                  "kind"
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "file",
                "o": [
                  "at",
                  [
                    "at",
                    "$record",
                    "source"
                  ],
                  "file"
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "sourceHash",
                "o": [
                  "at",
                  [
                    "at",
                    "$record",
                    "source"
                  ],
                  "fileSha256"
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "start",
                "o": [
                  "concat",
                  [
                    "at",
                    [
                      "at",
                      "$record",
                      "source"
                    ],
                    "startUtf16"
                  ]
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "end",
                "o": [
                  "concat",
                  [
                    "at",
                    [
                      "at",
                      "$record",
                      "source"
                    ],
                    "endUtf16Exclusive"
                  ]
                ],
                "pol": "is"
              },
              {
                "s": "$id",
                "p": "text",
                "o": [
                  "at",
                  "$span",
                  "text"
                ],
                "pol": "is"
              }
            ]
          },
          {
            "port": "kernel.invoke",
            "args": {
              "query": "s01.compile",
              "input": [
                "at",
                "$snapshot",
                "schemaFacts"
              ]
            },
            "into": "compiled"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "at",
                  "$compiled",
                  "ok"
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-SCHEMA",
                  "message": "Source fragment definition failed compilation",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "s01.validate",
              "input": {
                "facts": "$facts",
                "interfaces": [
                  "at",
                  "$compiled",
                  "interfaces"
                ],
                "managed": [
                  "list",
                  "$id"
                ]
              }
            },
            "into": "issues"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "eq",
                  [
                    "count",
                    "$issues"
                  ],
                  0
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-SCHEMA",
                  "message": "Source fragment is not valid under its closed definition",
                  "owner": "inspection.document"
                }
              }
            ]
          },
          {
            "port": "kernel.invoke",
            "args": {
              "query": "s01.project",
              "input": "$facts"
            },
            "into": "projection"
          },
          {
            "port": "kernel.invoke",
            "args": {
              "query": "s01.typed",
              "input": {
                "projection": "$projection",
                "interfaces": [
                  "at",
                  "$compiled",
                  "interfaces"
                ]
              }
            },
            "into": "typed"
          },
          {
            "when": [
              "and",
              [
                "not",
                "$error"
              ],
              [
                "not",
                [
                  "not",
                  [
                    "at",
                    "$typed",
                    "error"
                  ]
                ]
              ]
            ],
            "then": [
              {
                "let": "error",
                "value": {
                  "code": "ENC-DOC-SCHEMA",
                  "message": "Typed source projection failed",
                  "owner": "inspection.document"
                }
              }
            ]
          }
        ]
      },
      {
        "let": "displayCheck",
        "value": "not-requested"
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "port": "record.entries",
            "args": {
              "value": "$request"
            },
            "into": "requestEntries"
          },
          {
            "let": "hasDisplay",
            "value": [
              "some",
              "$requestEntries",
              "entry",
              [
                "eq",
                [
                  "at",
                  "$entry",
                  0
                ],
                "display"
              ]
            ]
          },
          {
            "when": "$hasDisplay",
            "then": [
              {
                "port": "kernel.invoke",
                "args": {
                  "query": "inspection.recordShape",
                  "input": {
                    "value": [
                      "at",
                      "$request",
                      "display"
                    ],
                    "keys": [
                      "list",
                      "kind",
                      "text",
                      "href"
                    ],
                    "required": [
                      "list",
                      "kind"
                    ]
                  }
                },
                "into": "displayShape"
              },
              {
                "when": [
                  "and",
                  [
                    "not",
                    "$error"
                  ],
                  [
                    "not",
                    "$displayShape"
                  ]
                ],
                "then": [
                  {
                    "let": "error",
                    "value": {
                      "code": "ENC-DOC-DISPLAY",
                      "message": "Malformed native display observation",
                      "owner": "inspection.document"
                    }
                  }
                ]
              },
              {
                "when": [
                  "and",
                  [
                    "not",
                    "$error"
                  ],
                  [
                    "not",
                    [
                      "eq",
                      [
                        "at",
                        "$record",
                        "literalType"
                      ],
                      "string"
                    ]
                  ]
                ],
                "then": [
                  {
                    "let": "error",
                    "value": {
                      "code": "ENC-DOC-DISPLAY",
                      "message": "This source attachment is definition-only, not a literal display binding",
                      "owner": "inspection.document"
                    }
                  }
                ]
              },
              {
                "when": [
                  "not",
                  "$error"
                ],
                "then": [
                  {
                    "port": "kernel.invoke",
                    "args": {
                      "query": "inspection.literal",
                      "input": {
                        "text": [
                          "at",
                          "$span",
                          "text"
                        ]
                      }
                    },
                    "into": "literal"
                  },
                  {
                    "when": [
                      "and",
                      [
                        "not",
                        "$error"
                      ],
                      [
                        "not",
                        [
                          "at",
                          "$literal",
                          "ok"
                        ]
                      ]
                    ],
                    "then": [
                      {
                        "let": "error",
                        "value": {
                          "code": "ENC-DOC-SOURCE",
                          "message": "Source literal does not decode in this profile",
                          "owner": "inspection.document"
                        }
                      }
                    ]
                  },
                  {
                    "let": "display",
                    "value": [
                      "at",
                      "$request",
                      "display"
                    ]
                  },
                  {
                    "when": [
                      "and",
                      [
                        "not",
                        "$error"
                      ],
                      [
                        "not",
                        [
                          "includes",
                          [
                            "list",
                            "text",
                            "href"
                          ],
                          [
                            "at",
                            "$display",
                            "kind"
                          ]
                        ]
                      ]
                    ],
                    "then": [
                      {
                        "let": "error",
                        "value": {
                          "code": "ENC-DOC-DISPLAY",
                          "message": "Unsupported displayed projection",
                          "owner": "inspection.document"
                        }
                      }
                    ]
                  },
                  {
                    "when": [
                      "eq",
                      [
                        "at",
                        "$display",
                        "kind"
                      ],
                      "text"
                    ],
                    "then": [
                      {
                        "when": [
                          "and",
                          [
                            "not",
                            "$error"
                          ],
                          [
                            "not",
                            [
                              "eq",
                              [
                                "at",
                                "$display",
                                "text"
                              ],
                              [
                                "at",
                                "$literal",
                                "value"
                              ]
                            ]
                          ]
                        ],
                        "then": [
                          {
                            "let": "error",
                            "value": {
                              "code": "ENC-DOC-DISPLAY",
                              "message": "Displayed text disagrees with its exact source literal",
                              "owner": "inspection.document"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "when": [
                      "eq",
                      [
                        "at",
                        "$display",
                        "kind"
                      ],
                      "href"
                    ],
                    "then": [
                      {
                        "when": [
                          "and",
                          [
                            "not",
                            "$error"
                          ],
                          [
                            "not",
                            [
                              "eq",
                              [
                                "at",
                                "$display",
                                "href"
                              ],
                              [
                                "concat",
                                "#",
                                [
                                  "at",
                                  "$literal",
                                  "value"
                                ]
                              ]
                            ]
                          ]
                        ],
                        "then": [
                          {
                            "let": "error",
                            "value": {
                              "code": "ENC-DOC-DISPLAY",
                              "message": "Displayed destination disagrees with its exact source literal",
                              "owner": "inspection.document"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "let": "displayCheck",
                    "value": "host-observed-literal-agreement"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "let": "result",
        "value": {
          "ok": false,
          "status": "inspection-refused",
          "failure": "$error"
        }
      },
      {
        "when": [
          "not",
          "$error"
        ],
        "then": [
          {
            "let": "result",
            "value": {
              "ok": true,
              "status": "inspection-only",
              "basis": [
                "at",
                "$snapshot",
                "basis"
              ],
              "principal": [
                "at",
                "$request",
                "principal"
              ],
              "context": [
                "at",
                "$request",
                "context"
              ],
              "target": "$id",
              "label": [
                "at",
                "$record",
                "label"
              ],
              "kind": [
                "at",
                "$record",
                "kind"
              ],
              "facts": "$facts",
              "typed": [
                "at",
                [
                  "at",
                  "$typed",
                  "projection"
                ],
                "$id"
              ],
              "source": [
                "at",
                "$record",
                "source"
              ],
              "text": [
                "at",
                "$span",
                "text"
              ],
              "links": [
                "at",
                "$record",
                "links"
              ],
              "displayCheck": "$displayCheck",
              "authority": "read-only-host-supplied-source",
              "scope": "definition-not-execution",
              "limitations": [
                "list",
                "Source identity is unsigned local integrity, not authorship or scientific verification.",
                "DOM values are native host observations, not authenticated execution traces.",
                "Generated source projections are not independently authorable application state.",
                "No mutation, discovery, storage, publication or inferred learning authority."
              ]
            }
          }
        ]
      }
    ]
  }
}
