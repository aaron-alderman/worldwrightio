process-module "temple/surface-process-module/1"

process css.build:
  call css.render
  port file.write { path = "styles.css"; text = $css } → _

process css.render:
  call css.plan
  call css.renderPlan

process css.plan:
  let cssRuleIds = subjects("isa", "StyleRule")
  let cssOrderEntries = map($cssRuleIds, "cssRule", list(one($cssRule, "order"), $cssRule))
  port record.fromEntries { entries = $cssOrderEntries } → cssOrder
  port record.entries { value = $cssOrder } → cssOrders
  assert eq(count($cssOrders), count($cssRuleIds))
    otherwise "ENCOUNTER-CSS-001: Each style rule needs its own order. Keep the orders unique from 1 to the number of rules."
  fold range(count($cssRuleIds)) as cssPosition; cssRulePlans starts list():
    let cssRule = at($cssOrder, concat($cssPosition))
    assert $cssRule
      otherwise "ENCOUNTER-CSS-002: Style rule orders need to cover 1 to the number of rules. Correct the missing position."
    yield append($cssRulePlans, list({ id = $cssRule; selector = one($cssRule, "selector"); context = or(optional($cssRule, "context"), or(null, null)); declarations = map(objects($cssRule, "declaration"), "cssDeclaration", { id = $cssDeclaration; property = one($cssDeclaration, "property"); value = if(eq(add(count(objects($cssDeclaration, "value")), count(objects($cssDeclaration, "valueToken"))), 1), if(optional($cssDeclaration, "valueToken"), concat("var(--", one(one($cssDeclaration, "valueToken"), "name"), ")"), one($cssDeclaration, "value")), raise(concat("ENCOUNTER-CSS-003: ", $cssDeclaration, " needs exactly one value or token reference. Correct that declaration’s source."))) }) })) → cssRulePlans
  let cssPlan = { imports = map(subjects("isa", "FontImport"), "cssFont", { id = $cssFont; statement = one($cssFont, "statement") }); tokens = map(objects("presentation.perthEncounter", "token"), "cssToken", { id = $cssToken; name = one($cssToken, "name"); value = one($cssToken, "cssValue") }); rules = $cssRulePlans }
  let result = $cssPlan

process css.renderPlan:
  let imports = fold($cssPlan.imports, "cssFont", "imports", "", concat($imports, $cssFont.statement))
  let tokens = fold($cssPlan.tokens, "cssToken", "tokens", "", concat($tokens, "--", $cssToken.name, ":", $cssToken.value, ";"))
  fold $cssPlan.rules as cssRule; rules starts "":
    let declarations = fold($cssRule.declarations, "cssDeclaration", "declarations", "", concat($declarations, $cssDeclaration.property, ":", $cssDeclaration.value, ";"))
    let ruleText = concat($cssRule.selector, "{", $declarations, "}")
    yield concat($rules, if($cssRule.context, concat("@media", $cssRule.context, "{", $ruleText, "}"), $ruleText)) → rules
  let css = concat($imports, ":root{", $tokens, "}", $rules)
  assert includes($css, ":focus-visible")
    otherwise "Visible focus rule missing"
  let result = $css
