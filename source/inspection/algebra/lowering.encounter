process-module "temple/surface-process-module/1"

process lower.scan:
  port value.describe { value = $input } → kind
  let result = list()
  when eq($kind.type, "string"):
    port text.split { value = $input; pattern = "[^A-Za-z0-9_-]+" } → result
  when $kind.array:
    fold $input as part; tokens starts list():
      let input = $part
      fold list(null) as callFrame; frameResult starts null:
        call lower.scan
        yield $result → result
      yield append($tokens, $result) → result
  when if(eq($kind.type, "object"), if(if($kind.array, false, true), if(if(eq($input, null), false, true), true, false), false), false):
    port record.entries { value = $input } → entries
    fold $entries as entry; tokens starts list():
      let input = $entry
      fold list(null) as callFrame; frameResult starts null:
        call lower.scan
        yield $result → result
      yield append($tokens, $result) → result

process lower.fresh:
  let candidate = concat("__templeDerived", $context.serial)
  let occupied = includes($context.used, $candidate)
  when $occupied:
    fold list(null) as invokeInput; invokeAcc starts null:
      let input = $invokeInput
      let context = { used = $context.used; serial = add($context.serial, 1); locals = $context.locals }
      fold list(null) as callFrame; frameResult starts null:
        call lower.fresh
        yield $result → result
      yield $result → fresh
    let result = $fresh
  when if($occupied, false, true):
    let result = { value = $candidate; context = { used = append($context.used, list($candidate)); serial = add($context.serial, 1); locals = $context.locals } }

process lower.template:
  port value.describe { value = $input } → kind
  let result = { value = $input; context = $context }
  when $kind.array:
    fold $input as part; built starts { value = list(); context = $context }:
      let context = $built.context
      let input = $part
      fold list(null) as callFrame; frameResult starts null:
        call lower.template
        yield $result → result
      yield { value = append($built.value, list($result.value)); context = $result.context } → result
  when if(eq($kind.type, "object"), if(if($kind.array, false, true), if(if(eq($input, null), false, true), true, false), false), false):
    port record.entries { value = $input } → entries
    let handled = false
    when eq(count($entries), 1):
      let marker = at(at($entries, 0), 0)
      let key = at(at($entries, 0), 1)
      when if(eq($marker, "arg"), eq($marker, "arg"), eq($marker, "refArg")):
        port value.describe { value = $key } → placeholderKind
        assert if(eq($placeholderKind.type, "number"), includes(range(count($arguments)), add($key, 1)), false)
          otherwise "Invalid operator argument placeholder"
        let value = at($arguments, $key)
        when eq($marker, "refArg"):
          port value.describe { value = $value } → binderKind
          assert if(eq($binderKind.type, "string"), if(if(includes(list("__proto__", "prototype", "constructor"), $value), false, true), true, false), false)
            otherwise "Invalid operator binder"
          let value = concat($definitions.referenceSigil, $value)
        let result = { value = $value; context = $context }
        let handled = true
      when if(eq($marker, "bind"), eq($marker, "bind"), eq($marker, "ref")):
        let local = at($context.locals, $key)
        when if($local, false, true):
          fold list(null) as invokeInput; invokeAcc starts null:
            let input = $invokeInput
            fold list(null) as callFrame; frameResult starts null:
              call lower.fresh
              yield $result → result
            yield $result → fresh
          let local = $fresh.value
          port record.entries { value = $fresh.context.locals } → locals
          port record.fromEntries { entries = append($locals, list(list($key, $local))) } → locals
          let context = { used = $fresh.context.used; serial = $fresh.context.serial; locals = $locals }
        let result = { value = concat(if(eq($marker, "ref"), $definitions.referenceSigil, ""), $local); context = $context }
        let handled = true
      when if(eq($marker, "arguments"), if(eq($key, true), true, false), false):
        let result = { value = append(list("list"), $arguments); context = $context }
        let handled = true
      when eq($marker, "term"):
        let value = at($terms, $key)
        port value.describe { value = $value } → termKind
        assert if(eq($termKind.type, "undefined"), false, true)
          otherwise "Unknown template term"
        let result = { value = $value; context = $context }
        let handled = true
      when eq($marker, "foldArgs"):
        let spec = $key
        fold $arguments as part; reverse starts list():
          yield append(list($part), $reverse) → reverse
        fold list(at($spec, "initial")) as invokeInput; invokeAcc starts null:
          let input = $invokeInput
          fold list(null) as callFrame; frameResult starts null:
            call lower.template
            yield $result → result
          yield $result → initial
        fold $reverse as part; built starts $initial:
          port record.entries { value = $terms } → termEntries
          port record.fromEntries { entries = append($termEntries, list(list(at($spec, "item"), $part), list(at($spec, "accumulator"), $built.value))) } → newTerms
          let context = $built.context
          let input = at($spec, "body")
          let terms = $newTerms
          fold list(null) as callFrame; frameResult starts null:
            call lower.template
            yield $result → result
          yield $result → result
        let handled = true
    when if($handled, false, true):
      fold $entries as entry; built starts { value = list(); context = $context }:
        let context = $built.context
        let input = at($entry, 1)
        fold list(null) as callFrame; frameResult starts null:
          call lower.template
          yield $result → result
        yield { value = append($built.value, list(list(at($entry, 0), $result.value))); context = $result.context } → built
      port record.fromEntries { entries = $built.value } → value
      let result = { value = $value; context = $built.context }

process lower.expression:
  port value.describe { value = $input } → kind
  let result = { value = $input; context = $context }
  when if(eq($kind.type, "object"), if(if($kind.array, false, true), if(if(eq($input, null), false, true), true, false), false), false):
    port record.entries { value = $input } → entries
    fold $entries as entry; built starts { value = list(); context = $context }:
      let context = $built.context
      let input = at($entry, 1)
      fold list(null) as callFrame; frameResult starts null:
        call lower.expression
        yield $result → result
      yield { value = append($built.value, list(list(at($entry, 0), $result.value))); context = $result.context } → built
    port record.fromEntries { entries = $built.value } → value
    let result = { value = $value; context = $built.context }
  when if($kind.array, if(count($input), true, false), false):
    let operation = at($input, 0)
    let rule = at($definitions.operators, $operation)
    let primitive = includes($primitives, $operation)
    assert if($primitive, $primitive, $rule)
      otherwise "Unknown algebra operation [TEMPLE-L001]. Boundary: authored operator vocabulary. Correct the spelling or supply a derived law in algebra/operators.expression.json; do not add a native fallback. Rerun the isolated bootstrap proof."
    fold range(add(count($input), -1)) as index; arguments starts list():
      yield append($arguments, list(at($input, $index))) → arguments
    when if($primitive, false, true):
      assert if(includes($ancestry, $operation), false, true)
        otherwise "Cyclic operator definition [TEMPLE-L002]. Boundary: finite operator lowering. Break the dependency cycle in the authored laws; do not increase the execution budget. Rerun the isolated bootstrap proof."
      let arity = at($rule, "arity")
      port value.describe { value = $arity } → arityKind
      assert if(eq($arityKind.type, "number"), eq(count($arguments), $arity), includes(range(add(count($arguments), 1)), add(at($rule, "minimumArity"), 1)))
        otherwise "Invalid derived operator arity [TEMPLE-L003]. Boundary: operator call contract. Match the call arguments to the authored arity; preserve lazy argument semantics. Rerun the isolated bootstrap proof."
    fold $arguments as argument; built starts { value = list(); context = $context }:
      let context = $built.context
      let input = $argument
      fold list(null) as callFrame; frameResult starts null:
        call lower.expression
        yield $result → result
      yield { value = append($built.value, list($result.value)); context = $result.context } → built
    when $primitive:
      let result = { value = append(list($operation), $built.value); context = $built.context }
    when if($primitive, false, true):
      fold list(at($rule, "body")) as invokeInput; invokeAcc starts null:
        let input = $invokeInput
        let context = { used = $built.context.used; serial = $built.context.serial; locals = {} }
        let arguments = $built.value
        let terms = {}
        fold list(null) as callFrame; frameResult starts null:
          call lower.template
          yield $result → result
        yield $result → expanded
      fold list($expanded.value) as invokeInput; invokeAcc starts null:
        let input = $invokeInput
        let context = $expanded.context
        let ancestry = append($ancestry, list($operation))
        fold list(null) as callFrame; frameResult starts null:
          call lower.expression
          yield $result → result
        yield $result → result

process lower.programme:
  port value.describe { value = $input } → kind
  assert $kind.array
    otherwise "Process must be an array"
  fold $input as statement; built starts { value = list(); context = $context }:
    port record.entries { value = $statement } → entries
    fold $entries as entry; fields starts { value = list(); context = $built.context }:
      let field = at($entry, 0)
      let context = $fields.context
      let result = { value = at($entry, 1); context = $context }
      when includes($definitions.statementFields.programmes, $field):
        fold list(at($entry, 1)) as invokeInput; invokeAcc starts null:
          let input = $invokeInput
          fold list(null) as callFrame; frameResult starts null:
            call lower.programme
            yield $result → result
          yield $result → result
      when includes($definitions.statementFields.expressions, $field):
        fold list(at($entry, 1)) as invokeInput; invokeAcc starts null:
          let input = $invokeInput
          fold list(null) as callFrame; frameResult starts null:
            call lower.expression
            yield $result → result
          yield $result → result
      yield { value = append($fields.value, list(list(at($entry, 0), $result.value))); context = $result.context } → fields
    port record.fromEntries { entries = $fields.value } → statement
    yield { value = append($built.value, list($statement)); context = $fields.context } → result

process lower.model:
  let original = $input
  port record.entries { value = $input.queries } → queries
  fold $queries as query; built starts { value = list(); context = $context }:
    let context = $built.context
    let input = at($query, 1)
    fold list(null) as callFrame; frameResult starts null:
      call lower.programme
      yield $result → result
    yield { value = append($built.value, list(list(at($query, 0), $result.value))); context = $result.context } → built
  port record.fromEntries { entries = $built.value } → queries
  port record.entries { value = $original } → entries
  port record.fromEntries { entries = append($entries, list(list("queries", $queries))) } → value
  let result = { value = $value; context = $built.context }

process lower.start:
  assert eq($definitions.protocol, "temple/derived-expression-definitions/1")
    otherwise "Unknown expression definition protocol"
  port record.entries { value = $definitions.operators } → rules
  each $rules as ruleEntry:
    let ruleName = at($ruleEntry, 0)
    let rule = at($ruleEntry, 1)
    assert if(if(includes($primitives, $ruleName), false, true), if(if(includes(list("__proto__", "prototype", "constructor"), $ruleName), false, true), true, false), false)
      otherwise "Invalid or shadowing operator definition [TEMPLE-L004]. Boundary: primitive ownership and operator names. Use a valid distinct derived name; do not replace a seed primitive with a second definition. Rerun the isolated bootstrap proof."
    let arity = at($rule, "arity")
    port value.describe { value = $arity } → arityKind
    let declaredArity = if(eq($arityKind.type, "number"), $arity, at($rule, "minimumArity"))
    port value.describe { value = $declaredArity } → declaredKind
    assert if(eq($declaredKind.type, "number"), includes(range(64), add($declaredArity, 1)), false)
      otherwise "Invalid operator arity declaration"
    port value.describe { value = at($rule, "body") } → bodyKind
    assert if(eq($bodyKind.type, "undefined"), false, true)
      otherwise "Missing operator body [TEMPLE-L005]. Boundary: executable derived law. Supply the authored lowering body; do not restore a retired implementation module. Rerun the isolated bootstrap proof."
  let originalInput = $input
  fold list(list($input, $definitions)) as invokeInput; invokeAcc starts null:
    let input = $invokeInput
    fold list(null) as callFrame; frameResult starts null:
      call lower.scan
      yield $result → result
    yield $result → names
  let context = { used = distinct($names); serial = 0; locals = {} }
  let ancestry = list()
  assert includes(list("expression", "programme", "model"), $mode)
    otherwise "Unknown lowering mode"
  when eq($mode, "expression"):
    let input = $originalInput
    fold list(null) as callFrame; frameResult starts null:
      call lower.expression
      yield $result → result
  when eq($mode, "programme"):
    let input = $originalInput
    fold list(null) as callFrame; frameResult starts null:
      call lower.programme
      yield $result → result
  when eq($mode, "model"):
    let input = $originalInput
    fold list(null) as callFrame; frameResult starts null:
      call lower.model
      yield $result → result
