                                    list("Paragraph", { children = list("Assume numeric array inputs.") }),
                                    "\n",
                                    list("Paragraph", { children = list("map(xs, x, add(x, 1))") }),
                                    "\n",
                                    list("Paragraph", { children = list("↓ derived from smaller operators") }),
                                    "\n",
                                    list("Paragraph", { children = list("if isArray(xs)") }),
                                    "\n",
                                    list("Paragraph", { children = list("  fold(xs, x, acc, [],") }),
                                    "\n",
                                    list("Paragraph", { children = list("    append(acc, [add(x, 1)]))") }),
                                    "\n",
                                    list("Paragraph", { children = list("else raise(arrayError)") }),
