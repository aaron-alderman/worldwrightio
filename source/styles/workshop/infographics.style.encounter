process-module "temple/surface-process-module/1"

process style.definition:
  let result = {
    protocol = "encounter/style-projection/1";
    identity = "workshop/infographics.css";
    reason = "Own selectors, contexts and individual declarations as editable values.";
    target = "workshop/infographics.css";
    goal = "Generate CSS from rules without a latent stylesheet.";
    sheet = list("StyleSheet", list(
      list("StyleRule", ".print-library", list(
        list("Declaration", "max-width", "1240px")
      )),
      list("StyleRule", ".library-header h1", list(
        list("Declaration", "font-size", "clamp(40px,5vw,64px)"),
        list("Declaration", "margin-top", "18px")
      )),
      list("StyleRule", ".library-intro", list(
        list("Declaration", "font-size", "19px"),
        list("Declaration", "max-width", "700px"),
        list("Declaration", "margin-top", "16px")
      )),
      list("StyleRule", ".snapshot-note", list(
        list("Declaration", "max-width", "790px"),
        list("Declaration", "margin-top", "14px")
      )),
      list("StyleRule", ".diagram-picker", list(
        list("Declaration", "display", "grid"),
        list("Declaration", "grid-template-columns", "repeat(3,minmax(0,1fr))"),
        list("Declaration", "gap", "12px"),
        list("Declaration", "margin", "30px 0 20px")
      )),
      list("StyleRule", ".diagram-picker a", list(
        list("Declaration", "display", "block"),
        list("Declaration", "padding", "16px 18px"),
        list("Declaration", "color", "var(--ink)"),
        list("Declaration", "text-decoration", "none"),
        list("Declaration", "background", "var(--white)"),
        list("Declaration", "border", "1px solid var(--line)"),
        list("Declaration", "border-radius", "8px"),
        list("Declaration", "font-size", "14px"),
        list("Declaration", "line-height", "1.5")
      )),
      list("StyleRule", ".diagram-picker a span", list(
        list("Declaration", "display", "block"),
        list("Declaration", "font", "12px Consolas,monospace"),
        list("Declaration", "color", "var(--teal)"),
        list("Declaration", "margin-bottom", "8px")
      )),
      list("StyleRule", ".diagram-picker a[aria-current]", list(
        list("Declaration", "border-color", "var(--teal)"),
        list("Declaration", "background", "#e3efeb"),
        list("Declaration", "box-shadow", "inset 0 3px var(--teal)")
      )),
      list("StyleRule", ".diagram-controls", list(
        list("Declaration", "display", "flex"),
        list("Declaration", "flex-wrap", "wrap"),
        list("Declaration", "gap", "14px"),
        list("Declaration", "align-items", "end"),
        list("Declaration", "background", "var(--white)"),
        list("Declaration", "border", "1px solid var(--line)"),
        list("Declaration", "padding", "18px"),
        list("Declaration", "border-radius", "8px")
      )),
      list("StyleRule", ".diagram-controls label", list(
        list("Declaration", "display", "grid"),
        list("Declaration", "gap", "6px"),
        list("Declaration", "font-size", "12px"),
        list("Declaration", "font-weight", "600"),
        list("Declaration", "max-width", "100%")
      )),
      list("StyleRule", ".diagram-controls select", list(
        list("Declaration", "max-width", "100%"),
        list("Declaration", "min-width", "0"),
        list("Declaration", "font-size", "13px"),
        list("Declaration", "padding", "9px 10px")
      )),
      list("StyleRule", ".diagram-controls button", list(
        list("Declaration", "padding", "10px 14px"),
        list("Declaration", "background", "var(--teal)"),
        list("Declaration", "color", "white"),
        list("Declaration", "font-size", "13px")
      )),
      list("StyleRule", ".diagram-controls #reset-diagram", list(
        list("Declaration", "background", "var(--paper)"),
        list("Declaration", "color", "var(--teal)"),
        list("Declaration", "border", "1px solid var(--line)")
      )),
      list("StyleRule", ".print-help", list(
        list("Declaration", "flex-basis", "100%"),
        list("Declaration", "font-size", "12px"),
        list("Declaration", "color", "var(--muted)")
      )),
      list("StyleRule", "#diagram-status", list(
        list("Declaration", "margin-top", "20px"),
        list("Declaration", "font-size", "13px")
      )),
      list("StyleRule", ".print-sheet", list(
        list("Declaration", "margin-top", "14px"),
        list("Declaration", "border", "1px solid var(--line)"),
        list("Declaration", "border-radius", "8px"),
        list("Declaration", "background", "var(--white)"),
        list("Declaration", "padding", "22px"),
        list("Declaration", "min-width", "0")
      )),
      list("StyleRule", ".sheet-heading h2", list(
        list("Declaration", "font-size", "22px"),
        list("Declaration", "margin", "6px 0")
      )),
      list("StyleRule", ".sheet-description", list(
        list("Declaration", "font-size", "14px"),
        list("Declaration", "color", "var(--muted)"),
        list("Declaration", "max-width", "800px"),
        list("Declaration", "margin-bottom", "18px")
      )),
      list("StyleRule", ".viewer-canvas", list(
        list("Declaration", "max-height", "78vh"),
        list("Declaration", "overflow", "auto"),
        list("Declaration", "background", "var(--paper)"),
        list("Declaration", "border", "1px solid var(--line)"),
        list("Declaration", "overscroll-behavior", "contain")
      )),
      list("StyleRule", ".viewer-canvas img", list(
        list("Declaration", "display", "block"),
        list("Declaration", "width", "var(--diagram-width,100%)"),
        list("Declaration", "max-width", "none"),
        list("Declaration", "height", "auto")
      )),
      list("StyleRule", ".sheet-footer", list(
        list("Declaration", "font-size", "11px"),
        list("Declaration", "color", "var(--muted)"),
        list("Declaration", "margin-top", "12px")
      )),
      list("StyleRule", ".sheet-tools", list(
        list("Declaration", "display", "flex"),
        list("Declaration", "flex-wrap", "wrap"),
        list("Declaration", "gap", "12px 24px"),
        list("Declaration", "margin", "18px 0"),
        list("Declaration", "font-size", "13px")
      )),
      list("StyleRule", ".sheet-tools a,.library-footer a", list(
        list("Declaration", "color", "var(--teal)")
      )),
      list("StyleRule", ".text-version", list(
        list("Declaration", "border-top", "1px solid var(--line)"),
        list("Declaration", "padding-top", "14px"),
        list("Declaration", "font-size", "14px")
      )),
      list("StyleRule", ".text-version>div", list(
        list("Declaration", "max-width", "820px"),
        list("Declaration", "padding", "18px 4px")
      )),
      list("StyleRule", ".text-version p", list(
        list("Declaration", "margin", "9px 0")
      )),
      list("StyleRule", ".text-version h3", list(
        list("Declaration", "margin", "24px 0 12px"),
        list("Declaration", "font-size", "20px")
      )),
      list("StyleRule", ".library-footer", list(
        list("Declaration", "margin-top", "24px"),
        list("Declaration", "font-size", "13px")
      )),
      list("StyleRule", ".library-footer p+p", list(
        list("Declaration", "margin-top", "12px")
      )),
      list("StyleRule", ".print-library :focus-visible", list(
        list("Declaration", "outline", "3px solid #80520d"),
        list("Declaration", "outline-offset", "4px")
      )),
      list("StyleGroup", "media", "(max-width:640px)", list(
        list("StyleRule", ".diagram-picker", list(
          list("Declaration", "grid-template-columns", "1fr"),
          list("Declaration", "gap", "8px")
        )),
        list("StyleRule", ".diagram-picker a", list(
          list("Declaration", "padding", "12px 14px")
        )),
        list("StyleRule", ".diagram-picker a span", list(
          list("Declaration", "display", "inline"),
          list("Declaration", "margin-right", "10px")
        )),
        list("StyleRule", ".diagram-controls", list(
          list("Declaration", "gap", "12px"),
          list("Declaration", "padding", "14px")
        )),
        list("StyleRule", ".diagram-controls label", list(
          list("Declaration", "width", "100%")
        )),
        list("StyleRule", ".diagram-controls select", list(
          list("Declaration", "width", "100%")
        )),
        list("StyleRule", ".print-sheet", list(
          list("Declaration", "padding", "12px")
        )),
        list("StyleRule", ".sheet-heading h2", list(
          list("Declaration", "font-size", "20px")
        )),
        list("StyleRule", ".viewer-canvas", list(
          list("Declaration", "max-height", "70vh")
        ))
      )),
      list("StyleDescriptor", "page", "encounter-a3", list(
        list("Declaration", "size", "A3 portrait"),
        list("Declaration", "margin", "10mm")
      )),
      list("StyleDescriptor", "page", "encounter-a4", list(
        list("Declaration", "size", "A4 portrait"),
        list("Declaration", "margin", "10mm")
      )),
      list("StyleGroup", "media", "print", list(
        list("StyleRule", "html,:host", list(
          list("Declaration", "margin", "0"),
          list("Declaration", "padding", "0"),
          list("Declaration", "border", "0"),
          list("Declaration", "background", "white"),
          list("Declaration", "color", "#182d39"),
          list("Declaration", "print-color-adjust", "exact"),
          list("Declaration", "-webkit-print-color-adjust", "exact")
        )),
        list("StyleRule", ".print-library", list(
          list("Declaration", "max-width", "none"),
          list("Declaration", "width", "auto"),
          list("Declaration", "margin", "0"),
          list("Declaration", "padding", "0")
        )),
        list("StyleRule", ".skip,.library-header,.diagram-picker,.diagram-controls,#diagram-status,.sheet-tools,.text-version,.library-footer", list(
          list("Declaration", "display", "none!important")
        )),
        list("StyleRule", ".print-sheet,.print-sheet[hidden]", list(
          list("Declaration", "display", "flex!important"),
          list("Declaration", "flex-direction", "column"),
          list("Declaration", "border", "0"),
          list("Declaration", "border-radius", "0"),
          list("Declaration", "margin", "0"),
          list("Declaration", "padding", "0"),
          list("Declaration", "break-inside", "avoid"),
          list("Declaration", "break-after", "page"),
          list("Declaration", "overflow", "hidden")
        )),
        list("StyleRule", ":host[data-print-scope=current] .print-sheet:not(.print-current)", list(
          list("Declaration", "display", "none!important")
        )),
        list("StyleRule", ".print-sheet:last-child,:host[data-print-scope=current] .print-current", list(
          list("Declaration", "break-after", "auto")
        )),
        list("StyleRule", ":host[data-paper=a3] .print-sheet", list(
          list("Declaration", "page", "encounter-a3"),
          list("Declaration", "height", "399mm")
        )),
        list("StyleRule", ":host[data-paper=a4] .print-sheet", list(
          list("Declaration", "page", "encounter-a4"),
          list("Declaration", "height", "276mm")
        )),
        list("StyleRule", ".sheet-heading", list(
          list("Declaration", "flex", "none")
        )),
        list("StyleRule", ".sheet-heading .eyebrow", list(
          list("Declaration", "font-size", "8pt")
        )),
        list("StyleRule", ".sheet-heading h2", list(
          list("Declaration", "font-size", "13pt"),
          list("Declaration", "margin", "2mm 0")
        )),
        list("StyleRule", ".sheet-description", list(
          list("Declaration", "display", "none")
        )),
        list("StyleRule", ".viewer-canvas", list(
          list("Declaration", "flex", "1"),
          list("Declaration", "min-height", "0"),
          list("Declaration", "max-height", "none"),
          list("Declaration", "overflow", "visible"),
          list("Declaration", "border", "0"),
          list("Declaration", "background", "white"),
          list("Declaration", "display", "flex"),
          list("Declaration", "justify-content", "center")
        )),
        list("StyleRule", ".viewer-canvas img", list(
          list("Declaration", "width", "100%!important"),
          list("Declaration", "height", "100%"),
          list("Declaration", "min-height", "0"),
          list("Declaration", "object-fit", "contain"),
          list("Declaration", "object-position", "center top")
        )),
        list("StyleRule", ".sheet-footer", list(
          list("Declaration", "flex", "none"),
          list("Declaration", "font-size", "7pt"),
          list("Declaration", "margin", "2mm 0 0")
        ))
      ))
    ))
  }
