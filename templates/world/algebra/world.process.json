                  },
                  [
                    "map",
                    [
                      "objects",
                      "$place",
                      "source"
                    ],
                    "source",
                    {
                      "tag": "section",
                      "attrs": {},
                      "children": [
                        "list",
                        {
                          "tag": "h3",
                          "attrs": {},
                          "children": [
                            "list",
                            [
                              "one",
                              "$source",
                              "title"
                            ]
                          ]
                        },
                        {
                          "tag": "p",
                          "attrs": {},
                          "children": [
                            "list",
