        "as": "place",
        "steps": [
          {
            "let": "route",
            "value": [
              "concat",
              "$place",
              ".html"
            ]
          },
          {
            "let": "pageTitle",
            "value": [
              "one",
              "$place",
              "title"
            ]
          },
          {
            "let": "body",
            "value": [
              "list",
              {
                "tag": "p",
                "attrs": {
                  "class": "eyebrow"
                },
                "children": [
                  "list",
                  [
                    "one",
                    "$place",
                    "question"
                  ]
                ]
              },
              {
                "tag": "h1",
                "attrs": {},
                "children": [
                  "list",
                  [
                    "one",
                    "$place",
                    "title"
                  ]
                ]
              },
              {
                "tag": "p",
                "attrs": {
                  "class": "intro"
                },
                "children": [
                  "list",
                  [
                    "one",
