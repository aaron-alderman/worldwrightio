                    "reading"
                  ]
                ]
              },
              {
                "tag": "h2",
                "attrs": {},
                "children": [
                  "list",
                  "Where next?"
                ]
              },
              {
                "tag": "ul",
                "attrs": {},
                "children": [
                  "list",
                  [
                    "map",
                    [
                      "objects",
                      "$place",
                      "choice"
                    ],
                    "choice",
                    {
                      "tag": "li",
                      "attrs": {},
                      "children": [
                        "list",
                        {
                          "tag": "a",
                          "attrs": {
                            "href": [
                              "concat",
                              [
                                "one",
                                "$choice",
                                "target"
                              ],
                              ".html"
                            ]
                          },
                          "children": [
                            "list",
                            [
                              "one",
                              "$choice",
                              "label"
                            ]
                          ]
                        }
                      ]
                    }
                  ]
                ]
              },
              {
                "tag": "details",
                "attrs": {},
                "children": [
                  "list",
                  {
                    "tag": "summary",
