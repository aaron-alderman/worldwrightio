            ]
          },
          {
            "tag": "h2",
            "attrs": {},
            "children": [
              "list",
              "Follow your curiosity"
            ]
          },
          {
            "tag": "ul",
            "attrs": {},
            "children": [
              "list",
              [
                "map",
                [
                  "subjects",
                  "isa",
                  "Place"
                ],
                "place",
                {
                  "tag": "li",
                  "attrs": {},
                  "children": [
                    "list",
                    {
                      "tag": "a",
                      "attrs": {
                        "href": [
                          "concat",
                          "$place",
                          ".html"
                        ]
                      },
                      "children": [
                        "list",
                        [
                          "one",
                          "$place",
                          "title"
                        ]
                      ]
                    },
                    {
                      "tag": "p",
                      "attrs": {},
                      "children": [
                        "list",
                        [
                          "one",
                          "$place",
                          "question"
                        ]
                      ]
                    }
                  ]
                }
              ]
            ]
          }
        ]
      },
      {
