{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "world.validate": [
      {
        "let": "places",
        "value": [
          "subjects",
          "isa",
          "Place"
        ]
      },
      {
        "let": "sources",
        "value": [
          "subjects",
          "isa",
          "Source"
        ]
      },
      {
        "let": "choices",
        "value": [
          "subjects",
          "isa",
          "Choice"
        ]
      },
      {
        "assert": [
          "not",
          [
            "eq",
            [
              "count",
              "$places"
            ],
            0
          ]
        ],
        "message": "WORLD-PLACES: At least one place is required."
      },
      {
        "assert": [
          "not",
          [
            "eq",
            [
              "one",
              "world",
              "title"
            ],
            ""
          ]
        ],
        "message": "WORLD-EMPTY: title must not be empty."
      },
      {
        "assert": [
          "not",
          [
            "eq",
            [
              "one",
              "world",
              "description"
            ],
            ""
          ]
        ],
        "message": "WORLD-EMPTY: description must not be empty."
      },
      {
        "assert": [
          "not",
          [
            "eq",
            [
              "one",
              "world",
              "purpose"
            ],
            ""
          ]
        ],
        "message": "WORLD-EMPTY: purpose must not be empty."
      },
      {
        "assert": [
          "includes",
          "$places",
          [
            "one",
            "world",
            "entry"
          ]
        ],
        "message": "WORLD-ENTRY: Entry must name a declared Place."
      },
      {
        "each": "$places",
        "as": "place",
        "steps": [
          {
            "port": "text.matches",
            "args": {
              "value": "$place",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "into": "safeId"
          },
          {
            "assert": "$safeId",
            "message": "WORLD-ID: Place identities must be lowercase URL-safe slugs."
          },
          {
            "assert": [
              "not",
              [
                "includes",
                [
                  "list",
                  "index",
                  "sources",
                  "world"
                ],
                "$place"
              ]
            ],
            "message": "WORLD-ID: Reserved route identity."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$place",
                  "title"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: title must not be empty."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$place",
                  "question"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: question must not be empty."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$place",
                  "reading"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: reading must not be empty."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "count",
                  [
                    "objects",
                    "$place",
                    "source"
                  ]
                ],
                0
              ]
            ],
            "message": "WORLD-SOURCE: Every place needs an attributed source."
          },
          {
            "each": [
              "objects",
              "$place",
              "source"
            ],
            "as": "source",
            "steps": [
              {
                "assert": [
                  "includes",
                  "$sources",
                  "$source"
                ],
                "message": "WORLD-SOURCE: Place names an unknown Source."
              }
            ]
          },
          {
            "each": [
              "objects",
              "$place",
              "choice"
            ],
            "as": "choice",
            "steps": [
              {
                "assert": [
                  "includes",
                  "$choices",
                  "$choice"
                ],
                "message": "WORLD-CHOICE: Place names an unknown Choice."
              }
            ]
          }
        ]
      },
      {
        "each": "$choices",
        "as": "choice",
        "steps": [
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$choice",
                  "label"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: label must not be empty."
          },
          {
            "assert": [
              "includes",
              "$places",
              [
                "one",
                "$choice",
                "target"
              ]
            ],
            "message": "WORLD-TARGET: Choice target must name a Place."
          }
        ]
      },
      {
        "each": "$sources",
        "as": "source",
        "steps": [
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$source",
                  "title"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: title must not be empty."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$source",
                  "attribution"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: attribution must not be empty."
          },
          {
            "assert": [
              "not",
              [
                "eq",
                [
                  "one",
                  "$source",
                  "scope"
                ],
                ""
              ]
            ],
            "message": "WORLD-EMPTY: scope must not be empty."
          }
        ]
      }
    ],
    "world.document": [
      {
        "let": "input",
        "value": {
          "tag": "html",
          "attrs": {
            "lang": "en"
          },
          "children": [
            "list",
            {
              "tag": "head",
              "attrs": {},
              "children": [
                "list",
                {
                  "tag": "meta",
                  "attrs": {
                    "charset": "utf-8"
                  },
                  "children": [
                    "list"
                  ]
                },
                {
                  "tag": "meta",
                  "attrs": {
                    "name": "viewport",
                    "content": "width=device-width, initial-scale=1"
                  },
                  "children": [
                    "list"
                  ]
                },
                {
                  "tag": "meta",
                  "attrs": {
                    "name": "description",
                    "content": [
                      "one",
                      "world",
                      "description"
                    ]
                  },
                  "children": [
                    "list"
                  ]
                },
                {
                  "tag": "title",
                  "attrs": {},
                  "children": [
                    "list",
                    "$pageTitle"
                  ]
                },
                {
                  "tag": "link",
                  "attrs": {
                    "rel": "stylesheet",
                    "href": "styles.css"
                  },
                  "children": [
                    "list"
                  ]
                }
              ]
            },
            {
              "tag": "body",
              "attrs": {},
              "children": [
                "list",
                {
                  "tag": "a",
                  "attrs": {
                    "href": "#main",
                    "class": "skip"
                  },
                  "children": [
                    "list",
                    "Skip to content"
                  ]
                },
                {
                  "tag": "header",
                  "attrs": {},
                  "children": [
                    "list",
                    {
                      "tag": "a",
                      "attrs": {
                        "href": "index.html"
                      },
                      "children": [
                        "list",
                        [
                          "one",
                          "world",
                          "title"
                        ]
                      ]
                    },
                    {
                      "tag": "nav",
                      "attrs": {
                        "aria-label": "Main navigation"
                      },
                      "children": [
                        "list",
                        {
                          "tag": "a",
                          "attrs": {
                            "href": "index.html"
                          },
                          "children": [
                            "list",
                            "Explore"
                          ]
                        },
                        {
                          "tag": "a",
                          "attrs": {
                            "href": "sources.html"
                          },
                          "children": [
                            "list",
                            "Sources"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "main",
                  "attrs": {
                    "id": "main"
                  },
                  "children": [
                    "list",
                    "$body"
                  ]
                },
                {
                  "tag": "footer",
                  "attrs": {},
                  "children": [
                    "list",
                    "An illustrative world built with Worldwright. ",
                    {
                      "tag": "a",
                      "attrs": {
                        "href": "source/world.rel"
                      },
                      "children": [
                        "list",
                        "Inspect the owned sources"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "call": "html.serialize"
      },
      {
        "port": "file.write",
        "args": {
          "path": "$route",
          "text": [
            "concat",
            "<!doctype html>\n",
            "$result"
          ]
        },
        "into": "_"
      }
    ],
    "world.build": [
      {
        "call": "world.validate"
      },
      {
