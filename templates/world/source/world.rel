// Imaginary example: replace the identity and content with your own.
("world", "title", "The field notebook")
("world", "description", "A small world for following a question, meeting an idea and checking its source.")
("world", "purpose", "Help a curious reader turn one observation into a question worth following.")
("world", "entry", "garden")
("garden", "isa", "Place")
("garden", "title", "Where a question begins")
("garden", "question", "What did you notice today?")
("garden", "reading", "An ordinary place can hold a question. Begin with one thing you noticed, then follow the path to a different view.")
("garden", "source", "notebook")
("garden", "choice", "garden-to-lens")
("lens", "isa", "Place")
("lens", "title", "Look a little closer")
("lens", "question", "What would change your interpretation?")
("lens", "reading", "Separate what you saw from what you inferred. Keep another explanation available and name the observation that could distinguish them.")
("lens", "source", "notebook")
("lens", "choice", "lens-to-garden")
("garden-to-lens", "isa", "Choice")
("garden-to-lens", "label", "Follow another view")
("garden-to-lens", "target", "lens")
("lens-to-garden", "isa", "Choice")
("lens-to-garden", "label", "Return to the first question")
("lens-to-garden", "target", "garden")
("notebook", "isa", "Source")
("notebook", "title", "An illustrative notebook")
("notebook", "attribution", "Worldwright starter authors; fictional example.")
("notebook", "scope", "A writing exercise about observation and interpretation. No scientific result is asserted.")
