{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "frontdoors.home": [
      {
        "fold": [
          "subjects",
          "isa",
          "PublishedMicrosite"
        ],
        "as": "world",
        "accumulator": "cards",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "json.parse",
            "args": {
              "text": [
                "one",
                "$world",
                "icon"
              ]
            },
            "into": "emblem"
          }
        ],
        "yield": [
          "append",
          "$cards",
          [
            "list",
            {
              "tag": "a",
              "attrs": {
                "class": "microsite-link",
                "href": [
                  "one",
                  "$world",
                  "href"
                ],
                "data-world": [
                  "one",
                  "$world",
                  "light"
                ]
              },
              "children": [
                "list",
                {
                  "tag": "div",
                  "attrs": {
                    "class": "world-card-top"
                  },
                  "children": [
                    "list",
                    "$emblem",
                    {
                      "tag": "span",
                      "attrs": {
                        "class": "world-card-status"
                      },
                      "children": [
                        "list",
                        [
                          "one",
                          "$world",
                          "statusLabel"
                        ]
                      ]
                    }
                  ]
                },
                {
                  "tag": "strong",
                  "attrs": {},
                  "children": [
                    "list",
                    [
                      "one",
                      "$world",
                      "name"
                    ]
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "world-card-note"
                  },
                  "children": [
                    "list",
                    [
                      "one",
                      "$world",
                      "note"
                    ]
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "world-card-description"
                  },
                  "children": [
                    "list",
                    [
                      "one",
                      "$world",
                      "description"
                    ]
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "world-card-detail"
                  },
                  "children": [
                    "list",
                    [
                      "if",
                      [
                        "eq",
                        "$world",
                        "microsite.entry.worldwright"
                      ],
                      [
                        "one",
                        "site",
                        "purpose"
                      ],
                      [
                        "one",
                        "$world",
                        "detail"
                      ]
                    ]
                  ]
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "world-card-action"
                  },
                  "children": [
                    "list",
                    {
                      "tag": "span",
                      "attrs": {},
                      "children": [
                        "list",
                        [
                          "concat",
                          "Explore ",
                          [
                            "one",
                            "$world",
                            "name"
                          ]
                        ]
                      ]
                    },
                    {
                      "tag": "span",
                      "attrs": {
                        "aria-hidden": "true"
                      },
                      "children": [
                        "list",
                        "↗"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        ],
        "into": "cards"
      },
      {
        "fold": [
          "subjects",
          "isa",
          "CapabilitySet"
        ],
        "as": "capability",
        "accumulator": "capabilityCards",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "json.parse",
            "args": {
              "text": [
                "one",
                "$capability",
                "icon"
              ]
            },
            "into": "capabilityIcon"
          }
        ],
        "yield": [
          "append",
          "$capabilityCards",
          [
            "list",
            {
              "tag": "li",
              "attrs": {},
              "children": [
                "list",
                {
                  "tag": "a",
                  "attrs": {
                    "class": "capability-card",
                    "href": [
                      "one",
                      "$capability",
                      "href"
                    ]
                  },
                  "children": [
                    "list",
                    "$capabilityIcon",
                    {
                      "tag": "strong",
                      "attrs": {},
                      "children": [
                        "list",
                        [
                          "one",
                          "$capability",
                          "name"
                        ]
                      ]
                    },
                    {
                      "tag": "p",
                      "attrs": {
                        "class": "capability-blurb"
                      },
                      "children": [
                        "list",
                        [
                          "one",
                          "$capability",
                          "description"
                        ]
                      ]
                    },
                    {
                      "tag": "span",
                      "attrs": {
                        "class": "capability-arrow",
                        "aria-hidden": "true"
                      },
                      "children": [
                        "list",
                        "↗"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        ],
        "into": "capabilityCards"
      },
      {
        "let": "result",
        "value": {
          "tag": "div",
          "attrs": {
            "class": "hero-entrances"
          },
          "children": [
            "list",
            {
              "tag": "nav",
              "attrs": {
                "class": "hero-microsites",
                "id": "microsites",
                "aria-label": "Microsites"
              },
              "children": [
                "list",
                {
                  "tag": "p",
                  "attrs": {
                    "class": "eyebrow"
                  },
                  "children": [
                    "list",
                    "Explore the worlds"
                  ]
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "microsite-menu"
                  },
                  "children": [
                    "list",
                    "$cards"
                  ]
                }
              ]
            },
            {
              "tag": "nav",
              "attrs": {
                "class": "hero-capabilities",
                "id": "capabilities",
                "aria-label": "Capabilities"
              },
              "children": [
                "list",
                {
                  "tag": "p",
                  "attrs": {
                    "class": "eyebrow"
                  },
                  "children": [
                    "list",
                    "Capabilities"
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "capability-intro"
                  },
                  "children": [
                    "list",
                    "Ways of working that connect across the projects."
                  ]
                },
                {
                  "tag": "ul",
                  "attrs": {
                    "class": "capability-list"
                  },
                  "children": [
                    "list",
                    "$capabilityCards"
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
