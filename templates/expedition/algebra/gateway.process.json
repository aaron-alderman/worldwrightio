                    "tag": "article",
                    "attrs": {
                      "class": "corpus-door",
                      "data-light": [
                        "one",
                        "$door",
                        "light"
                      ],
                      "data-door": [
                        "one",
                        "$door",
                        "slug"
                      ],
                      "id": [
                        "concat",
                        "path-",
                        [
                          "one",
                          "$door",
                          "slug"
                        ]
                      ]
                    },
                    "children": [
                      "list",
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "door-portal",
                          "aria-hidden": "true"
                        },
                        "children": [
                          "list",
                          {
                            "tag": "span",
                            "attrs": {},
                            "children": [
                              "list",
                              "✧"
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "p",
                        "attrs": {
                          "class": "eyebrow"
                        },
                        "children": [
                          "list",
                          [
                            "one",
                            "$door",
                            "kind"
                          ]
                        ]
                      },
                      {
                        "tag": "h3",
                        "attrs": {},
                        "children": [
                          "list",
                          {
                            "tag": "a",
                            "attrs": {
                              "href": [
                                "one",
                                "$door",
                                "href"
                              ]
                            },
                            "children": [
                              "list",
                              [
                                "one",
                                "$door",
                                "readingName"
                              ]
                            ]
                          }
                        ]
                      },
                      {
                        "tag": "p",
                        "attrs": {
                          "class": "door-title"
                        },
                        "children": [
                          "list",
                          [
                            "one",
                            "$door",
                            "title"
                          ]
                        ]
                      },
                      {
                        "tag": "p",
                        "attrs": {
                          "class": "door-description"
                        },
                        "children": [
                          "list",
                          [
                            "one",
                            "$door",
                            "description"
                          ]
                        ]
                      },
                      {
                        "tag": "p",
                        "attrs": {
                          "class": "door-question"
                        },
                        "children": [
                          "list",
                          [
                            "one",
                            "$door",
                            "question"
                          ]
                        ]
                      },
                      {
                        "tag": "div",
                        "attrs": {
                          "class": "door-actions"
                        },
                        "children": [
                          "list",
                          {
                            "tag": "a",
                            "attrs": {
                              "href": [
                                "one",
                                "$door",
                                "href"
                              ],
                              "class": "door-primary"
                            },
                            "children": [
                              "list",
                              [
                                "concat",
                                [
                                  "one",
                                  "$door",
                                  "label"
                                ],
                                " ↗"
                              ]
                            ]
                          },
                          {
                            "tag": "a",
                            "attrs": {
                              "href": [
                                "one",
                                "$door",
                                "secondaryHref"
                              ],
                              "class": "door-secondary"
                            },
                            "children": [
                              "list",
                              [
                                "concat",
                                [
                                  "one",
                                  "$door",
                                  "secondaryLabel"
                                ],
                                " →"
                              ]
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "tag": "p",
                "attrs": {
                  "class": "gate-proposal"
                },
                "children": [
                  "list",
                  "The paths through faith, open questions and shared worlds are editorial invitations; they do not define future microsites."
                ]
              }
            ]
          },
          {
            "tag": "section",
            "attrs": {
              "class": "gate-library"
            },
            "children": [
              "list",
              {
                "tag": "div",
                "attrs": {},
                "children": [
                  "list",
                  {
                    "tag": "p",
                    "attrs": {
                      "class": "eyebrow"
                    },
                    "children": [
                      "list",
                      "Go beyond the guided tour"
                    ]
                  },
                  {
                    "tag": "h2",
                    "attrs": {},
                    "children": [
                      "list",
                      "The whole library is there to explore."
                    ]
                  },
                  {
                    "tag": "p",
                    "attrs": {},
                    "children": [
                      "list",
                      "Choose a subject, browse a programme, or trace a claim through its sources. A link is a way to investigate; it does not make a claim true."
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "class": "gate-library-actions"
                },
                "children": [
                  "list",
                  {
                    "tag": "a",
                    "attrs": {
                      "href": [
                        "one",
                        "gateway",
                        "library"
                      ],
                      "class": "button"
                    },
                    "children": [
                      "list",
                      "Browse the whole corpus ↗"
                    ]
                  },
                  {
                    "tag": "a",
                    "attrs": {
                      "href": "index.html#microsites"
                    },
                    "children": [
                      "list",
                      "Explore the project microsites →"
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
