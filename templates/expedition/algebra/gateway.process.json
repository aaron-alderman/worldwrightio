{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "gateway.build": [
      {
        "assert": [
          "not",
          [
            "eq",
            [
              "count",
              [
                "subjects",
                "isa",
                "CorpusDoor"
              ]
            ],
            0
          ]
        ],
        "message": "WORLD-DOORS: Declare at least one CorpusDoor."
      },
      {
        "let": "prefix",
        "value": ""
      },
      {
        "let": "pageTitle",
        "value": [
          "concat",
          "Reading paths — ",
          [
            "one",
            "site",
            "name"
          ]
        ]
      },
      {
        "let": "description",
        "value": [
          "one",
          "gateway",
          "description"
        ]
      },
      {
        "let": "canonical",
        "value": [
          "concat",
          [
            "one",
            "site",
            "origin"
          ],
          [
            "one",
            "gateway",
            "route"
          ]
        ]
      },
      {
        "let": "light",
        "value": "home"
      },
      {
        "call": "gateway.view"
      },
      {
        "let": "body",
        "value": "$result"
      },
      {
        "call": "publication.document"
      },
      {
        "port": "file.write",
        "args": {
          "path": [
            "one",
            "gateway",
            "route"
          ],
          "text": [
            "concat",
            "<!doctype html>\n",
            "$result"
          ]
        },
        "into": "_"
      }
    ],
    "gateway.view": [
      {
        "let": "result",
        "value": [
          "list",
          {
            "tag": "section",
            "attrs": {
              "class": "gate-hero",
              "aria-labelledby": "gate-heading"
            },
            "children": [
              "list",
              {
                "tag": "p",
                "attrs": {
                  "class": "eyebrow"
                },
                "children": [
                  "list",
                  [
                    "concat",
                    [
                      "one",
                      "site",
                      "name"
                    ],
                    " / Inside the corpus"
                  ]
                ]
              },
              {
                "tag": "h1",
                "attrs": {
                  "id": "gate-heading"
                },
                "children": [
                  "list",
                  "Follow a ",
                  {
                    "tag": "em",
                    "attrs": {},
                    "children": [
                      "list",
                      "thread."
                    ]
                  }
                ]
              },
              {
                "tag": "p",
                "attrs": {
                  "class": "gate-intro"
                },
                "children": [
                  "list",
                  [
                    "one",
                    "gateway",
                    "invitation"
                  ]
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "class": "gate-actions"
                },
                "children": [
                  "list",
                  {
                    "tag": "a",
                    "attrs": {
                      "href": [
                        "one",
                        "gateway",
                        "library"
                      ],
                      "class": "button gate-primary"
                    },
                    "children": [
                      "list",
                      "Open the corpus library ↗"
                    ]
                  },
                  {
                    "tag": "a",
                    "attrs": {
                      "href": [
                        "one",
                        "gateway",
                        "book"
                      ],
                      "class": "gate-book"
                    },
                    "children": [
                      "list",
                      "Read the current story ↗"
                    ]
                  }
                ]
              },
              {
                "tag": "p",
                "attrs": {
                  "class": "gate-footnote"
                },
                "children": [
                  "list",
                  "Corpus / the collected work, with its sources, disagreements and unfinished questions."
                ]
              }
            ]
          },
          {
            "tag": "section",
            "attrs": {
              "class": "section doorway-hall",
              "aria-labelledby": "doors-heading"
            },
            "children": [
              "list",
              {
                "tag": "div",
                "attrs": {
                  "class": "section-heading"
                },
                "children": [
                  "list",
                  {
                    "tag": "p",
                    "attrs": {
                      "class": "eyebrow"
                    },
                    "children": [
                      "list",
                      "Questions, sources, connections"
                    ]
                  },
                  {
                    "tag": "h2",
                    "attrs": {
                      "id": "doors-heading"
                    },
                    "children": [
                      "list",
                      "Choose a reading path."
                    ]
                  },
                  {
                    "tag": "p",
                    "attrs": {},
                    "children": [
                      "list",
                      "These paths follow ideas across the corpus. Each offers a research starting point and a smaller encounter to think with."
                    ]
                  }
                ]
              },
              {
                "tag": "div",
                "attrs": {
                  "class": "door-grid"
                },
                "children": [
                  "map",
