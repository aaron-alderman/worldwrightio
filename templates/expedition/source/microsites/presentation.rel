("ms.sourcery.index.html.n1577", "description", "{\"kind\":\"element\",\"tag\":\"video\",\"attributes\":[{\"name\":\"class\",\"value\":\"loop-video\"},{\"name\":\"data-autoplay\",\"value\":\"\"},{\"name\":\"muted\",\"value\":\"\"},{\"name\":\"loop\",\"value\":\"\"},{\"name\":\"playsinline\",\"value\":\"\"},{\"name\":\"preload\",\"value\":\"metadata\"},{\"name\":\"width\",\"value\":\"960\"},{\"name\":\"height\",\"value\":\"540\"},{\"name\":\"poster\",\"value\":\"films/media/flood-loop.jpg\"},{\"name\":\"aria-label\",\"value\":\"The flood as a paper theatre: brooms bobbing on the water while a counter reads brooms 40, buckets 80, decisions anyone made 0.\"}],\"children\":[\"ms.sourcery.index.html.n1578\",\"ms.sourcery.index.html.n1579\",\"ms.sourcery.index.html.n1580\",\"ms.sourcery.index.html.n1581\",\"ms.sourcery.index.html.n1582\"]}")
("ms.sourcery.index.html.n1578", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
