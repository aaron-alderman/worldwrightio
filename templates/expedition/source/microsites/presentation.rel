("ms.temple.index.html.n1070", "description", "{\"kind\":\"comment\",\"text\":\" VIII · Many Temples \"}")
("ms.temple.index.html.n1071", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1072", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"federation\"},{\"name\":\"class\",\"value\":\"scene-text federation\"},{\"name\":\"aria-labelledby\",\"value\":\"fed-title\"}],\"children\":[\"ms.temple.index.html.n1073\",\"ms.temple.index.html.n1074\",\"ms.temple.index.html.n1076\",\"ms.temple.index.html.n1077\",\"ms.temple.index.html.n1079\",\"ms.temple.index.html.n1080\",\"ms.temple.index.html.n1105\"]}")
