("ms.sourcery.index.html.n933", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n934", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n935\",\"ms.sourcery.index.html.n937\"]}")
("ms.sourcery.index.html.n935", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n936\"]}")
("ms.sourcery.index.html.n936", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n937", "description", "{\"kind\":\"text\",\"text\":\"Keep the magic. Lose the mystery.\"}")
("ms.sourcery.index.html.n938", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n939", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n940", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
