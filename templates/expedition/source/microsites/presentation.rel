("ms.sourcery.index.html.n921", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.sourcery.index.html.n922\"]}")
("ms.sourcery.index.html.n922", "description", "{\"kind\":\"text\",\"text\":\"The Witness\"}")
("ms.sourcery.index.html.n923", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n924", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n925\"]}")
("ms.sourcery.index.html.n925", "description", "{\"kind\":\"text\",\"text\":\"Every attempt leaves a receipt, refused ones too. The house remembers, and never quietly rewrites.\"}")
("ms.sourcery.index.html.n926", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n927", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"gloss\"}],\"children\":[\"ms.sourcery.index.html.n928\"]}")
("ms.sourcery.index.html.n928", "description", "{\"kind\":\"text\",\"text\":\"In Sourcery: a witness.\"}")
("ms.sourcery.index.html.n929", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n930", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n931", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
