("ms.temple.index.html.n778", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n779", "description", "{\"kind\":\"element\",\"tag\":\"path\",\"attributes\":[{\"name\":\"class\",\"value\":\"seal-wax\"},{\"name\":\"d\",\"value\":\"M60 22 C 82 20, 99 38, 97 60 C 99 84, 80 100, 58 98 C 36 99, 21 82, 23 60 C 21 38, 38 23, 60 22 Z\"}]}")
("ms.temple.index.html.n780", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
