("ms.sourcery.index.html.n290", "description", "{\"kind\":\"text\",\"text\":\"The\"}")
("ms.sourcery.index.html.n291", "description", "{\"kind\":\"text\",\"text\":\" Sorcerer’s Apprentice\"}")
("ms.sourcery.index.html.n292", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n293", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"front-lede\"}],\"children\":[\"ms.purpose.14\"]}")
("ms.sourcery.index.html.n294", "description", "{\"kind\":\"text\",\"text\":\"You know how it goes: a clever apprentice, a borrowed spell, a broom that won’t stop fetching water. This is the version where the sorcerer comes home with a better idea than a bigger spell.\"}")
("ms.sourcery.index.html.n295", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
