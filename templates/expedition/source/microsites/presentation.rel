("ms.sourcery.index.html.n1147", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"chip\"},{\"name\":\"data-example\",\"value\":\"Keep track of who borrowed which tools\"}],\"children\":[\"ms.sourcery.index.html.n1148\"]}")
