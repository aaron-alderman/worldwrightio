("ms.sourcery.index.html.n1364", "description", "{\"kind\":\"text\",\"text\":\"credential-sensitive review\"}")
("ms.sourcery.index.html.n1365", "description", "{\"kind\":\"text\",\"text\":\": only the credentialed, non-retracted study counts, and it clears the bar.\"}")
