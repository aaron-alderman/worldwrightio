("ms.temple.index.html.n1075", "description", "{\"kind\":\"text\",\"text\":\"VIII · Many Temples\"}")
("ms.temple.index.html.n1076", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1077", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"fed-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1078\"]}")
("ms.temple.index.html.n1078", "description", "{\"kind\":\"text\",\"text\":\"Many Temples. No emperor.\"}")
("ms.temple.index.html.n1079", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1080", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"fed-wrap\"}],\"children\":[\"ms.temple.index.html.n1081\",\"ms.temple.index.html.n1082\",\"ms.temple.index.html.n1083\",\"ms.temple.index.html.n1084\",\"ms.temple.index.html.n1104\"]}")
("ms.temple.index.html.n1081", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1082", "description", "{\"kind\":\"element\",\"tag\":\"canvas\",\"attributes\":[{\"name\":\"id\",\"value\":\"constellation\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}]}")
("ms.temple.index.html.n1083", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1084", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"fed-copy\"}],\"children\":[\"ms.temple.index.html.n1085\",\"ms.temple.index.html.n1086\",\"ms.temple.index.html.n1088\",\"ms.temple.index.html.n1089\",\"ms.temple.index.html.n1100\",\"ms.temple.index.html.n1101\",\"ms.temple.index.html.n1103\"]}")
("ms.temple.index.html.n1085", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1086", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1087\"]}")
("ms.temple.index.html.n1087", "description", "{\"kind\":\"text\",\"text\":\"Temples relate only through explicit covenants. A foreign witness is bounded evidence — “never a command”. Local consequences still require local admission.\"}")
("ms.temple.index.html.n1088", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1089", "description", "{\"kind\":\"element\",\"tag\":\"ul\",\"attributes\":[{\"name\":\"class\",\"value\":\"maxims\"}],\"children\":[\"ms.temple.index.html.n1090\",\"ms.temple.index.html.n1091\",\"ms.temple.index.html.n1093\",\"ms.temple.index.html.n1094\",\"ms.temple.index.html.n1096\",\"ms.temple.index.html.n1097\",\"ms.temple.index.html.n1099\"]}")
("ms.temple.index.html.n1090", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1091", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1092\"]}")
("ms.temple.index.html.n1092", "description", "{\"kind\":\"text\",\"text\":\"“Trust and authority are non-transitive by default.”\"}")
("ms.temple.index.html.n1093", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1094", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1095\"]}")
("ms.temple.index.html.n1095", "description", "{\"kind\":\"text\",\"text\":\"“Physical nesting, hosting, storage or discovery does not create authority.”\"}")
("ms.temple.index.html.n1096", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1097", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1098\"]}")
("ms.temple.index.html.n1098", "description", "{\"kind\":\"text\",\"text\":\"“Dissolution is not automatic: no timeout destroys state or grants emergency authority.”\"}")
("ms.temple.index.html.n1099", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1100", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1101", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1102\"]}")
("ms.temple.index.html.n1102", "description", "{\"kind\":\"text\",\"text\":\"In the laboratory: two Temples, west and east, joined by a blocking prepare-and-commit protocol — through a restart, a partial commit, and recovery.\"}")
("ms.temple.index.html.n1103", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1104", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
