("ms.temple.index.html.n1394", "description", "{\"kind\":\"text\",\"text\":\"Forty seconds, rendered from code.\"}")
("ms.temple.index.html.n1395", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1396", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body-wide\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.editorial.temple/index.html.28\"]}")
("ms.temple.index.html.n1397", "description", "{\"kind\":\"text\",\"text\":\"No cameras and no stock footage: a sky computed pixel by pixel, lights that leave trails, the commandments set in type, and a drone synthesised from sine waves. Every frame can be rendered again from the site’s own source — and the film carries a witness of its own.\"}")
("ms.temple.index.html.n1398", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
