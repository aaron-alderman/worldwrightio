("ms.temple.index.html.n1378", "description", "{\"kind\":\"text\",\"text\":\"Nobody owns the foundation.\"}")
("ms.temple.index.html.n1379", "description", "{\"kind\":\"element\",\"tag\":\"td\",\"children\":[\"ms.editorial.temple/index.html.27\"]}")
("ms.temple.index.html.n1380", "description", "{\"kind\":\"text\",\"text\":\"A draft public-good charter; not yet adopted.\"}")
