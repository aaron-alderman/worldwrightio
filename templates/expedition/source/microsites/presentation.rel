("ms.temple.index.html.n1360", "description", "{\"kind\":\"text\",\"text\":\"Anyone can check the history.\"}")
("ms.temple.index.html.n1361", "description", "{\"kind\":\"element\",\"tag\":\"td\",\"children\":[\"ms.temple.index.html.n1362\"]}")
("ms.temple.index.html.n1362", "description", "{\"kind\":\"text\",\"text\":\"Demonstrated in the lab: replay and re-judge from genesis.\"}")
("ms.temple.index.html.n1363", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1364", "description", "{\"kind\":\"element\",\"tag\":\"tr\",\"children\":[\"ms.temple.index.html.n1365\",\"ms.temple.index.html.n1367\"]}")
