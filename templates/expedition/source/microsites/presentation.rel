("ms.sourcery.index.html.n417", "description", "{\"kind\":\"text\",\"text\":\"Chapter I\"}")
("ms.sourcery.index.html.n418", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n419", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch1-title\"}],\"children\":[\"ms.sourcery.index.html.n420\"]}")
("ms.sourcery.index.html.n420", "description", "{\"kind\":\"text\",\"text\":\"The Apprentice\"}")
("ms.sourcery.index.html.n421", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n422", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n423", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"split\"}],\"children\":[\"ms.sourcery.index.html.n424\",\"ms.sourcery.index.html.n425\",\"ms.sourcery.index.html.n444\",\"ms.sourcery.index.html.n445\",\"ms.sourcery.index.html.n511\"]}")
("ms.sourcery.index.html.n424", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n425", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose\"}],\"children\":[\"ms.sourcery.index.html.n426\",\"ms.sourcery.index.html.n427\",\"ms.sourcery.index.html.n429\",\"ms.sourcery.index.html.n430\",\"ms.sourcery.index.html.n435\",\"ms.sourcery.index.html.n436\",\"ms.sourcery.index.html.n438\",\"ms.sourcery.index.html.n439\",\"ms.sourcery.index.html.n443\"]}")
("ms.sourcery.index.html.n426", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n427", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n428\"]}")
("ms.sourcery.index.html.n428", "description", "{\"kind\":\"text\",\"text\":\"Once, in a tall house full of books nobody had time to read, there lived an apprentice with a very modern problem: too much to do, and a spell that promised to do it for them.\"}")
("ms.sourcery.index.html.n429", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n430", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n431\",\"ms.sourcery.index.html.n432\",\"ms.sourcery.index.html.n434\"]}")
("ms.sourcery.index.html.n431", "description", "{\"kind\":\"text\",\"text\":\"The spell was short. \"}")
("ms.sourcery.index.html.n432", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n433\"]}")
("ms.sourcery.index.html.n433", "description", "{\"kind\":\"text\",\"text\":\"Broom, fetch the water. Don’t trouble me with the details.\"}")
("ms.sourcery.index.html.n434", "description", "{\"kind\":\"text\",\"text\":\" The apprentice liked that last part best.\"}")
("ms.sourcery.index.html.n435", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n436", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n437\"]}")
("ms.sourcery.index.html.n437", "description", "{\"kind\":\"text\",\"text\":\"The broom stood up, took a bucket in each hand and went to work. It was marvellous. It was hands-off. It was, for about four minutes, the future.\"}")
("ms.sourcery.index.html.n438", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n439", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n440\",\"ms.sourcery.index.html.n442\"]}")
("ms.sourcery.index.html.n440", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n441\"]}")
("ms.sourcery.index.html.n441", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n442", "description", "{\"kind\":\"text\",\"text\":\"A spell you can’t read is a spell you can’t stop.\"}")
("ms.sourcery.index.html.n443", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n444", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n445", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"class\",\"value\":\"plate-frame scene reveal\"}],\"children\":[\"ms.sourcery.index.html.n446\",\"ms.sourcery.index.html.n447\",\"ms.sourcery.index.html.n510\"]}")
("ms.sourcery.index.html.n446", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n447", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"plate-stack\"},{\"name\":\"role\",\"value\":\"img\"},{\"name\":\"aria-label\",\"value\":\"The apprentice, a small hooded figure, flicks a wand at a broom, which springs to life with two buckets. The spell book lies open and unread on the floor.\"}],\"children\":[\"ms.sourcery.index.html.n448\",\"ms.sourcery.index.html.n449\",\"ms.sourcery.index.html.n492\",\"ms.sourcery.index.html.n493\",\"ms.sourcery.index.html.n509\"]}")
("ms.sourcery.index.html.n448", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n449", "description", "{\"kind\":\"element\",\"tag\":\"svg\",\"attributes\":[{\"name\":\"class\",\"value\":\"plate plate-bg\"},{\"name\":\"viewBox\",\"value\":\"0 0 600 470\"},{\"name\":\"aria-hidden\",\"value\":\"true\"},{\"name\":\"focusable\",\"value\":\"false\"}],\"children\":[\"ms.sourcery.index.html.n450\",\"ms.sourcery.index.html.n451\",\"ms.sourcery.index.html.n459\",\"ms.sourcery.index.html.n460\",\"ms.sourcery.index.html.n461\",\"ms.sourcery.index.html.n462\",\"ms.sourcery.index.html.n472\",\"ms.sourcery.index.html.n473\",\"ms.sourcery.index.html.n474\",\"ms.sourcery.index.html.n475\",\"ms.sourcery.index.html.n476\",\"ms.sourcery.index.html.n477\",\"ms.sourcery.index.html.n478\",\"ms.sourcery.index.html.n479\",\"ms.sourcery.index.html.n480\",\"ms.sourcery.index.html.n481\",\"ms.sourcery.index.html.n491\"]}")
