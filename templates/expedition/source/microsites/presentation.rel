("ms.temple.index.html.n782", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n783", "description", "{\"kind\":\"element\",\"tag\":\"text\",\"children\":[\"ms.temple.index.html.n784\"]}")
("ms.temple.index.html.n784", "description", "{\"kind\":\"element\",\"tag\":\"textPath\",\"attributes\":[{\"name\":\"href\",\"value\":\"#seal-ring\"},{\"name\":\"startOffset\",\"value\":\"3%\"}],\"children\":[\"ms.temple.index.html.n785\"]}")
("ms.temple.index.html.n785", "description", "{\"kind\":\"text\",\"text\":\"NOT YET SEALED · NOT YET SEALED ·\"}")
("ms.temple.index.html.n786", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n787", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n788", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"children\":[\"ms.temple.index.html.n789\",\"ms.temple.index.html.n790\",\"ms.temple.index.html.n792\",\"ms.temple.index.html.n793\",\"ms.temple.index.html.n795\"]}")
("ms.temple.index.html.n789", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n790", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body\"}],\"children\":[\"ms.temple.index.html.n791\"]}")
("ms.temple.index.html.n791", "description", "{\"kind\":\"text\",\"text\":\"These commandments govern the form of valid Temples. Membership, authority, consent, exit, custody, reconciliation and succession policies remain per-Temple covenant choices expressed inside this space.\"}")
("ms.temple.index.html.n792", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n793", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.temple.index.html.n794\"]}")
("ms.temple.index.html.n794", "description", "{\"kind\":\"text\",\"text\":\"“No gate authorizes sealing the Ark. Sealing requires independent implementations, adversarial review and a separate explicit decision.”\"}")
("ms.temple.index.html.n795", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n796", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n797", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n798", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n799", "description", "{\"kind\":\"comment\",\"text\":\" VI · The gate \"}")
("ms.temple.index.html.n800", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n801", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"gate\"},{\"name\":\"class\",\"value\":\"gate\"},{\"name\":\"aria-labelledby\",\"value\":\"gate-title\"}],\"children\":[\"ms.temple.index.html.n802\",\"ms.temple.index.html.n803\",\"ms.temple.index.html.n817\",\"ms.temple.index.html.n818\",\"ms.temple.index.html.n978\",\"ms.temple.index.html.n979\",\"ms.temple.index.html.n1034\",\"ms.temple.index.html.n1035\",\"ms.temple.index.html.n1037\"]}")
("ms.temple.index.html.n802", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n803", "description", "{\"kind\":\"element\",\"tag\":\"header\",\"attributes\":[{\"name\":\"class\",\"value\":\"gate-head\"}],\"children\":[\"ms.temple.index.html.n804\",\"ms.temple.index.html.n805\",\"ms.temple.index.html.n807\",\"ms.temple.index.html.n808\",\"ms.temple.index.html.n810\",\"ms.temple.index.html.n811\",\"ms.temple.index.html.n813\",\"ms.temple.index.html.n814\",\"ms.temple.index.html.n816\"]}")
("ms.temple.index.html.n804", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n805", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"eyebrow\"}],\"children\":[\"ms.temple.index.html.n806\"]}")
("ms.temple.index.html.n806", "description", "{\"kind\":\"text\",\"text\":\"VI · The gate\"}")
("ms.temple.index.html.n807", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n808", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"gate-title\"}],\"children\":[\"ms.temple.index.html.n809\"]}")
("ms.temple.index.html.n809", "description", "{\"kind\":\"text\",\"text\":\"Try the gate.\"}")
("ms.temple.index.html.n810", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n811", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"scene-lead\"}],\"children\":[\"ms.temple.index.html.n812\"]}")
("ms.temple.index.html.n812", "description", "{\"kind\":\"text\",\"text\":\"A miniature Temple, running in your browser. Choose who you are and what you propose. Watch the six conditions judge it and keep the witness. Then try to rewrite history.\"}")
("ms.temple.index.html.n813", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
