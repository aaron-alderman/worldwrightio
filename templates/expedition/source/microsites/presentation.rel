("ms.temple.index.html.n1455", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1456", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.temple.index.html.n1457\"]}")
("ms.temple.index.html.n1457", "description", "{\"kind\":\"text\",\"text\":\"A speculative design. The gate is a miniature running in your browser — an illustration of Temple3’s kernel, not Temple3 itself. Quotations are from Sourcery’s and Temple’s own working documents.\"}")
