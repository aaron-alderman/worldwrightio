("ms.sourcery.index.html.n1592", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1593", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"film-teaser-title\"}],\"children\":[\"ms.sourcery.index.html.n1594\"]}")
("ms.sourcery.index.html.n1594", "description", "{\"kind\":\"text\",\"text\":\"The moving picture book\"}")
("ms.sourcery.index.html.n1595", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1596", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1597\"]}")
("ms.sourcery.index.html.n1597", "description", "{\"kind\":\"text\",\"text\":\"The whole fable, played out on a toy stage: cut-outs drawn in code, composited frame by frame with ffmpeg, and signed with the pipeline’s own witness.\"}")
("ms.sourcery.index.html.n1598", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
