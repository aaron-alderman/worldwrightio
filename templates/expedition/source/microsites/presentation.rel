("ms.temple.index.html.n209", "description", "{\"kind\":\"text\",\"text\":\"II · The quiet substitutions\"}")
("ms.temple.index.html.n210", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n211", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"subs-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n212\"]}")
("ms.temple.index.html.n212", "description", "{\"kind\":\"text\",\"text\":\"In ordinary software, meaning slides.\"}")
("ms.temple.index.html.n213", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n214", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body-wide\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n215\"]}")
("ms.temple.index.html.n215", "description", "{\"kind\":\"text\",\"text\":\"Authority hides in permissions, defaults and deployment scripts — or in the simple fact that someone happened to act first. And so, without anyone deciding it:\"}")
("ms.temple.index.html.n216", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
