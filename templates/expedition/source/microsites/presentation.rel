("ms.sourcery.index.html.n1388", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"attributes\":[{\"name\":\"class\",\"value\":\"pull\"}],\"children\":[\"ms.sourcery.index.html.n1389\"]}")
("ms.sourcery.index.html.n1389", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1390\"]}")
("ms.sourcery.index.html.n1390", "description", "{\"kind\":\"text\",\"text\":\"The platform does not produce a universal truth score.\"}")
("ms.sourcery.index.html.n1391", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1392", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1393\",\"ms.sourcery.index.html.n1394\"]}")
("ms.sourcery.index.html.n1393", "description", "{\"kind\":\"text\",\"text\":\"When a helper, human or AI, wants to add evidence, it proposes it, and a person reviews it before it counts. The goal isn’t to hand you a conclusion. As the Claimipedia spec puts it: \"}")
("ms.sourcery.index.html.n1394", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n1395\"]}")
("ms.sourcery.index.html.n1395", "description", "{\"kind\":\"text\",\"text\":\"its primary product is legibility.\"}")
("ms.sourcery.index.html.n1396", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1397", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n1398\",\"ms.sourcery.index.html.n1400\"]}")
("ms.sourcery.index.html.n1398", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n1399\"]}")
("ms.sourcery.index.html.n1399", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n1400", "description", "{\"kind\":\"text\",\"text\":\"Disagreement you can read beats agreement you can’t check.\"}")
("ms.sourcery.index.html.n1401", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1402", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n1403", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
("ms.sourcery.index.html.n1404", "description", "{\"kind\":\"element\",\"tag\":\"svg\",\"attributes\":[{\"name\":\"class\",\"value\":\"divider\"},{\"name\":\"viewBox\",\"value\":\"0 0 260 30\"},{\"name\":\"aria-hidden\",\"value\":\"true\"},{\"name\":\"focusable\",\"value\":\"false\"}],\"children\":[\"ms.sourcery.index.html.n1405\"]}")
("ms.sourcery.index.html.n1405", "description", "{\"kind\":\"element\",\"tag\":\"use\",\"attributes\":[{\"name\":\"href\",\"value\":\"#flourish\"}]}")
("ms.sourcery.index.html.n1406", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
("ms.sourcery.index.html.n1407", "description", "{\"kind\":\"comment\",\"text\":\" ============ VII ============ \"}")
("ms.sourcery.index.html.n1408", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n1409", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"chapter\"},{\"name\":\"id\",\"value\":\"ch7\"},{\"name\":\"aria-labelledby\",\"value\":\"ch7-title\"}],\"children\":[\"ms.sourcery.index.html.n1410\",\"ms.sourcery.index.html.n1411\",\"ms.sourcery.index.html.n1419\",\"ms.sourcery.index.html.n1420\",\"ms.sourcery.index.html.n1437\",\"ms.sourcery.index.html.n1438\",\"ms.sourcery.index.html.n1493\",\"ms.sourcery.index.html.n1494\",\"ms.sourcery.index.html.n1555\",\"ms.sourcery.index.html.n1556\",\"ms.sourcery.index.html.n1566\"]}")
("ms.sourcery.index.html.n1410", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1411", "description", "{\"kind\":\"element\",\"tag\":\"header\",\"attributes\":[{\"name\":\"class\",\"value\":\"chapter-head\"}],\"children\":[\"ms.sourcery.index.html.n1412\",\"ms.sourcery.index.html.n1413\",\"ms.sourcery.index.html.n1415\",\"ms.sourcery.index.html.n1416\",\"ms.sourcery.index.html.n1418\"]}")
("ms.sourcery.index.html.n1412", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1413", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"numeral\"}],\"children\":[\"ms.sourcery.index.html.n1414\"]}")
("ms.sourcery.index.html.n1414", "description", "{\"kind\":\"text\",\"text\":\"Chapter VII\"}")
("ms.sourcery.index.html.n1415", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1416", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch7-title\"}],\"children\":[\"ms.sourcery.index.html.n1417\"]}")
("ms.sourcery.index.html.n1417", "description", "{\"kind\":\"text\",\"text\":\"The Foundation\"}")
("ms.sourcery.index.html.n1418", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1419", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1420", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1421\",\"ms.sourcery.index.html.n1422\",\"ms.sourcery.index.html.n1424\",\"ms.sourcery.index.html.n1425\",\"ms.sourcery.index.html.n1433\",\"ms.sourcery.index.html.n1434\",\"ms.sourcery.index.html.n1436\"]}")
("ms.sourcery.index.html.n1421", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1422", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n1423\"]}")
("ms.sourcery.index.html.n1423", "description", "{\"kind\":\"text\",\"text\":\"Under the workshop and the library is the foundation, Temple. It’s where the house rules live, and where every change is judged.\"}")
("ms.sourcery.index.html.n1424", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1425", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1426\",\"ms.sourcery.index.html.n1427\",\"ms.sourcery.index.html.n1429\",\"ms.sourcery.index.html.n1430\",\"ms.sourcery.index.html.n1432\"]}")
("ms.sourcery.index.html.n1426", "description", "{\"kind\":\"text\",\"text\":\"In Temple, a change is an itemised proposal from someone, against an exact starting point. It’s judged under two layers of law: \"}")
("ms.sourcery.index.html.n1427", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1428\"]}")
("ms.sourcery.index.html.n1428", "description", "{\"kind\":\"text\",\"text\":\"the Ark\"}")
("ms.sourcery.index.html.n1429", "description", "{\"kind\":\"text\",\"text\":\", which binds every Temple, and a \"}")
("ms.sourcery.index.html.n1430", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1431\"]}")
("ms.sourcery.index.html.n1431", "description", "{\"kind\":\"text\",\"text\":\"covenant\"}")
("ms.sourcery.index.html.n1432", "description", "{\"kind\":\"text\",\"text\":\", each Temple’s own rules, which can narrow the Ark but never widen it. Accepted or refused, the judgment gets a witness, and anyone holding the rules can replay the whole history from the first stone.\"}")
("ms.sourcery.index.html.n1433", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1434", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1435\"]}")
("ms.sourcery.index.html.n1435", "description", "{\"kind\":\"text\",\"text\":\"The Ark’s candidate commandments are carved below. Tap a stone to read it.\"}")
("ms.sourcery.index.html.n1436", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1437", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1438", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"foundation reveal\"}],\"children\":[\"ms.sourcery.index.html.n1439\",\"ms.sourcery.index.html.n1440\",\"ms.sourcery.index.html.n1455\",\"ms.sourcery.index.html.n1456\",\"ms.sourcery.index.html.n1488\",\"ms.sourcery.index.html.n1489\",\"ms.sourcery.index.html.n1492\"]}")
("ms.sourcery.index.html.n1439", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1440", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"keystone\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.sourcery.index.html.n1441\",\"ms.sourcery.index.html.n1442\",\"ms.sourcery.index.html.n1448\",\"ms.sourcery.index.html.n1449\",\"ms.sourcery.index.html.n1454\"]}")
("ms.sourcery.index.html.n1441", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1442", "description", "{\"kind\":\"element\",\"tag\":\"svg\",\"attributes\":[{\"name\":\"viewBox\",\"value\":\"0 0 120 120\"},{\"name\":\"focusable\",\"value\":\"false\"}],\"children\":[\"ms.sourcery.index.html.n1443\",\"ms.sourcery.index.html.n1444\",\"ms.sourcery.index.html.n1445\",\"ms.sourcery.index.html.n1446\",\"ms.sourcery.index.html.n1447\"]}")
("ms.sourcery.index.html.n1443", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n1444", "description", "{\"kind\":\"element\",\"tag\":\"circle\",\"attributes\":[{\"name\":\"cx\",\"value\":\"60\"},{\"name\":\"cy\",\"value\":\"60\"},{\"name\":\"r\",\"value\":\"40\"},{\"name\":\"fill\",\"value\":\"none\"},{\"name\":\"stroke\",\"value\":\"#9c3550\"},{\"name\":\"stroke-width\",\"value\":\"3\"},{\"name\":\"stroke-dasharray\",\"value\":\"6 7\"}]}")
("ms.sourcery.index.html.n1445", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n1446", "description", "{\"kind\":\"element\",\"tag\":\"path\",\"attributes\":[{\"name\":\"d\",\"value\":\"M44 48l18 20M60 62l7-6 11 18-6 5z\"},{\"name\":\"stroke\",\"value\":\"#9c3550\"},{\"name\":\"stroke-width\",\"value\":\"3\"},{\"name\":\"fill\",\"value\":\"none\"},{\"name\":\"stroke-linecap\",\"value\":\"round\"},{\"name\":\"stroke-linejoin\",\"value\":\"round\"},{\"name\":\"opacity\",\"value\":\".55\"}]}")
("ms.sourcery.index.html.n1447", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1448", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1449", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1450\",\"ms.sourcery.index.html.n1451\",\"ms.sourcery.index.html.n1452\"]}")
("ms.sourcery.index.html.n1450", "description", "{\"kind\":\"text\",\"text\":\"The Ark\"}")
("ms.sourcery.index.html.n1451", "description", "{\"kind\":\"element\",\"tag\":\"br\"}")
("ms.sourcery.index.html.n1452", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n1453\"]}")
("ms.sourcery.index.html.n1453", "description", "{\"kind\":\"text\",\"text\":\"not yet sealed\"}")
("ms.sourcery.index.html.n1454", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1455", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1456", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"wall\"},{\"name\":\"role\",\"value\":\"group\"},{\"name\":\"aria-label\",\"value\":\"The ten candidate commandments\"}],\"children\":[\"ms.sourcery.index.html.n1457\",\"ms.sourcery.index.html.n1458\",\"ms.sourcery.index.html.n1460\",\"ms.sourcery.index.html.n1461\",\"ms.sourcery.index.html.n1463\",\"ms.sourcery.index.html.n1464\",\"ms.sourcery.index.html.n1466\",\"ms.sourcery.index.html.n1467\",\"ms.sourcery.index.html.n1469\",\"ms.sourcery.index.html.n1470\",\"ms.sourcery.index.html.n1472\",\"ms.sourcery.index.html.n1473\",\"ms.sourcery.index.html.n1475\",\"ms.sourcery.index.html.n1476\",\"ms.sourcery.index.html.n1478\",\"ms.sourcery.index.html.n1479\",\"ms.sourcery.index.html.n1481\",\"ms.sourcery.index.html.n1482\",\"ms.sourcery.index.html.n1484\",\"ms.sourcery.index.html.n1485\",\"ms.sourcery.index.html.n1487\"]}")
("ms.sourcery.index.html.n1457", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1458", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Identity, possession, capability, computation, custody and knowledge do not themselves authorize mutation.\"}],\"children\":[\"ms.sourcery.index.html.n1459\"]}")
("ms.sourcery.index.html.n1459", "description", "{\"kind\":\"text\",\"text\":\"No implicit authority\"}")
("ms.sourcery.index.html.n1460", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1461", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"A Temple predicate may narrow the Ark’s permitted relation but cannot widen it.\"}],\"children\":[\"ms.sourcery.index.html.n1462\"]}")
("ms.sourcery.index.html.n1462", "description", "{\"kind\":\"text\",\"text\":\"No absolute local policy\"}")
("ms.sourcery.index.html.n1463", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1464", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Every proposed change is represented by a finite, canonical delta against an identified initial state.\"}],\"children\":[\"ms.sourcery.index.html.n1465\"]}")
("ms.sourcery.index.html.n1465", "description", "{\"kind\":\"text\",\"text\":\"No hidden mutation\"}")
("ms.sourcery.index.html.n1466", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1467", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Every semantic input visible during judgment is contained in a canonical, bounded context.\"}],\"children\":[\"ms.sourcery.index.html.n1468\"]}")
("ms.sourcery.index.html.n1468", "description", "{\"kind\":\"text\",\"text\":\"No ambient context\"}")
("ms.sourcery.index.html.n1469", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1470", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Programs may construct proposals; only the fixed state algebra applies them.\"}],\"children\":[\"ms.sourcery.index.html.n1471\"]}")
("ms.sourcery.index.html.n1471", "description", "{\"kind\":\"text\",\"text\":\"No executable mutation authority\"}")
("ms.sourcery.index.html.n1472", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1473", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"The Ark, active predicate, initial state and context are fixed for the complete evaluation.\"}],\"children\":[\"ms.sourcery.index.html.n1474\"]}")
("ms.sourcery.index.html.n1474", "description", "{\"kind\":\"text\",\"text\":\"No self-enlargement during judgment\"}")
("ms.sourcery.index.html.n1475", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1476", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"A newly admitted predicate becomes active only in the resulting state and cannot authorize its own installation.\"}],\"children\":[\"ms.sourcery.index.html.n1477\"]}")
("ms.sourcery.index.html.n1477", "description", "{\"kind\":\"text\",\"text\":\"No retrospective law\"}")
("ms.sourcery.index.html.n1478", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1479", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Acceptance, rejection, conflict and unresolved outcomes remain explicit and attributable.\"}],\"children\":[\"ms.sourcery.index.html.n1480\"]}")
("ms.sourcery.index.html.n1480", "description", "{\"kind\":\"text\",\"text\":\"No silent failure\"}")
("ms.sourcery.index.html.n1481", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1482", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"Every operative successor binds its Temple, predicate, identity, initial state, delta, context and final state.\"}],\"children\":[\"ms.sourcery.index.html.n1483\"]}")
("ms.sourcery.index.html.n1483", "description", "{\"kind\":\"text\",\"text\":\"No unwitnessed continuation\"}")
("ms.sourcery.index.html.n1484", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1485", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"stone\"},{\"name\":\"aria-pressed\",\"value\":\"false\"},{\"name\":\"data-full\",\"value\":\"A foreign Temple’s witness is bounded context; local consequences still require local admission.\"}],\"children\":[\"ms.sourcery.index.html.n1486\"]}")
("ms.sourcery.index.html.n1486", "description", "{\"kind\":\"text\",\"text\":\"No ambient foreign sovereignty\"}")
("ms.sourcery.index.html.n1487", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1488", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1489", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"id\",\"value\":\"stone-caption\"},{\"name\":\"class\",\"value\":\"stone-caption\"},{\"name\":\"aria-live\",\"value\":\"polite\"}],\"children\":[\"ms.sourcery.index.html.n1490\"]}")
("ms.sourcery.index.html.n1490", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"stone-caption-hint\"}],\"children\":[\"ms.sourcery.index.html.n1491\"]}")
("ms.sourcery.index.html.n1491", "description", "{\"kind\":\"text\",\"text\":\"Each stone is one of the ten. The Ark itself is deliberately left unsealed while the laboratory tests them.\"}")
("ms.sourcery.index.html.n1492", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1493", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1494", "description", "{\"kind\":\"element\",\"tag\":\"details\",\"attributes\":[{\"name\":\"class\",\"value\":\"all-ten\"}],\"children\":[\"ms.sourcery.index.html.n1495\",\"ms.sourcery.index.html.n1496\",\"ms.sourcery.index.html.n1498\",\"ms.sourcery.index.html.n1499\",\"ms.sourcery.index.html.n1551\",\"ms.sourcery.index.html.n1552\",\"ms.sourcery.index.html.n1554\"]}")
("ms.sourcery.index.html.n1495", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1496", "description", "{\"kind\":\"element\",\"tag\":\"summary\",\"children\":[\"ms.sourcery.index.html.n1497\"]}")
("ms.sourcery.index.html.n1497", "description", "{\"kind\":\"text\",\"text\":\"Read all ten, as written\"}")
("ms.sourcery.index.html.n1498", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1499", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"children\":[\"ms.sourcery.index.html.n1500\",\"ms.sourcery.index.html.n1501\",\"ms.sourcery.index.html.n1505\",\"ms.sourcery.index.html.n1506\",\"ms.sourcery.index.html.n1510\",\"ms.sourcery.index.html.n1511\",\"ms.sourcery.index.html.n1515\",\"ms.sourcery.index.html.n1516\",\"ms.sourcery.index.html.n1520\",\"ms.sourcery.index.html.n1521\",\"ms.sourcery.index.html.n1525\",\"ms.sourcery.index.html.n1526\",\"ms.sourcery.index.html.n1530\",\"ms.sourcery.index.html.n1531\",\"ms.sourcery.index.html.n1535\",\"ms.sourcery.index.html.n1536\",\"ms.sourcery.index.html.n1540\",\"ms.sourcery.index.html.n1541\",\"ms.sourcery.index.html.n1545\",\"ms.sourcery.index.html.n1546\",\"ms.sourcery.index.html.n1550\"]}")
("ms.sourcery.index.html.n1500", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1501", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1502\",\"ms.sourcery.index.html.n1504\"]}")
("ms.sourcery.index.html.n1502", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1503\"]}")
("ms.sourcery.index.html.n1503", "description", "{\"kind\":\"text\",\"text\":\"No implicit authority.\"}")
("ms.sourcery.index.html.n1504", "description", "{\"kind\":\"text\",\"text\":\" Identity, possession, capability, computation, custody and knowledge do not themselves authorize mutation.\"}")
("ms.sourcery.index.html.n1505", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1506", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1507\",\"ms.sourcery.index.html.n1509\"]}")
("ms.sourcery.index.html.n1507", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1508\"]}")
("ms.sourcery.index.html.n1508", "description", "{\"kind\":\"text\",\"text\":\"No absolute local policy.\"}")
("ms.sourcery.index.html.n1509", "description", "{\"kind\":\"text\",\"text\":\" A Temple predicate may narrow the Ark’s permitted relation but cannot widen it.\"}")
("ms.sourcery.index.html.n1510", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1511", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1512\",\"ms.sourcery.index.html.n1514\"]}")
("ms.sourcery.index.html.n1512", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1513\"]}")
("ms.sourcery.index.html.n1513", "description", "{\"kind\":\"text\",\"text\":\"No hidden mutation.\"}")
("ms.sourcery.index.html.n1514", "description", "{\"kind\":\"text\",\"text\":\" Every proposed change is represented by a finite, canonical delta against an identified initial state.\"}")
("ms.sourcery.index.html.n1515", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1516", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1517\",\"ms.sourcery.index.html.n1519\"]}")
("ms.sourcery.index.html.n1517", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1518\"]}")
("ms.sourcery.index.html.n1518", "description", "{\"kind\":\"text\",\"text\":\"No ambient context.\"}")
("ms.sourcery.index.html.n1519", "description", "{\"kind\":\"text\",\"text\":\" Every semantic input visible during judgment is contained in a canonical, bounded context.\"}")
("ms.sourcery.index.html.n1520", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1521", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1522\",\"ms.sourcery.index.html.n1524\"]}")
("ms.sourcery.index.html.n1522", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1523\"]}")
("ms.sourcery.index.html.n1523", "description", "{\"kind\":\"text\",\"text\":\"No executable mutation authority.\"}")
("ms.sourcery.index.html.n1524", "description", "{\"kind\":\"text\",\"text\":\" Programs may construct proposals; only the fixed state algebra applies them.\"}")
("ms.sourcery.index.html.n1525", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1526", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1527\",\"ms.sourcery.index.html.n1529\"]}")
("ms.sourcery.index.html.n1527", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1528\"]}")
("ms.sourcery.index.html.n1528", "description", "{\"kind\":\"text\",\"text\":\"No self-enlargement during judgment.\"}")
("ms.sourcery.index.html.n1529", "description", "{\"kind\":\"text\",\"text\":\" The Ark, active predicate, initial state and context are fixed for the complete evaluation.\"}")
("ms.sourcery.index.html.n1530", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1531", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1532\",\"ms.sourcery.index.html.n1534\"]}")
("ms.sourcery.index.html.n1532", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1533\"]}")
("ms.sourcery.index.html.n1533", "description", "{\"kind\":\"text\",\"text\":\"No retrospective law.\"}")
("ms.sourcery.index.html.n1534", "description", "{\"kind\":\"text\",\"text\":\" A newly admitted predicate becomes active only in the resulting state and cannot authorize its own installation.\"}")
("ms.sourcery.index.html.n1535", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1536", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1537\",\"ms.sourcery.index.html.n1539\"]}")
("ms.sourcery.index.html.n1537", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1538\"]}")
("ms.sourcery.index.html.n1538", "description", "{\"kind\":\"text\",\"text\":\"No silent failure.\"}")
("ms.sourcery.index.html.n1539", "description", "{\"kind\":\"text\",\"text\":\" Acceptance, rejection, conflict and unresolved outcomes remain explicit and attributable.\"}")
("ms.sourcery.index.html.n1540", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1541", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1542\",\"ms.sourcery.index.html.n1544\"]}")
("ms.sourcery.index.html.n1542", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1543\"]}")
("ms.sourcery.index.html.n1543", "description", "{\"kind\":\"text\",\"text\":\"No unwitnessed continuation.\"}")
("ms.sourcery.index.html.n1544", "description", "{\"kind\":\"text\",\"text\":\" Every operative successor binds its Temple, predicate, identity, initial state, delta, context and final state.\"}")
("ms.sourcery.index.html.n1545", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1546", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1547\",\"ms.sourcery.index.html.n1549\"]}")
("ms.sourcery.index.html.n1547", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1548\"]}")
("ms.sourcery.index.html.n1548", "description", "{\"kind\":\"text\",\"text\":\"No ambient foreign sovereignty.\"}")
("ms.sourcery.index.html.n1549", "description", "{\"kind\":\"text\",\"text\":\" A foreign Temple’s witness is bounded context; local consequences still require local admission.\"}")
("ms.sourcery.index.html.n1550", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1551", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1552", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.sourcery.index.html.n1553\"]}")
("ms.sourcery.index.html.n1553", "description", "{\"kind\":\"text\",\"text\":\"Candidate Ark commandments, v0.1. “These are not yet sealed.”\"}")
("ms.sourcery.index.html.n1554", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1555", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1556", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1557\",\"ms.sourcery.index.html.n1558\",\"ms.sourcery.index.html.n1560\",\"ms.sourcery.index.html.n1561\",\"ms.sourcery.index.html.n1565\"]}")
("ms.sourcery.index.html.n1557", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1558", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"status-note\"}],\"children\":[\"ms.purpose.29\"]}")
("ms.sourcery.index.html.n1559", "description", "{\"kind\":\"text\",\"text\":\"Where it stands: Sourcery and Claimipedia run on Temple2 today. Temple3 is where the foundation is being recut, rules first. It’s a working laboratory whose results are cross-checked by three implementations (JavaScript, Python and Rust). It isn’t audited or in production, and the Ark is deliberately not yet sealed.\"}")
("ms.sourcery.index.html.n1560", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1561", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n1562\",\"ms.sourcery.index.html.n1564\"]}")
("ms.sourcery.index.html.n1562", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n1563\"]}")
("ms.sourcery.index.html.n1563", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n1564", "description", "{\"kind\":\"text\",\"text\":\"The best foundations are the least magical part of the house. That’s the point.\"}")
("ms.sourcery.index.html.n1565", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1566", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n1567", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
("ms.sourcery.index.html.n1568", "description", "{\"kind\":\"element\",\"tag\":\"svg\",\"attributes\":[{\"name\":\"class\",\"value\":\"divider\"},{\"name\":\"viewBox\",\"value\":\"0 0 260 30\"},{\"name\":\"aria-hidden\",\"value\":\"true\"},{\"name\":\"focusable\",\"value\":\"false\"}],\"children\":[\"ms.sourcery.index.html.n1569\"]}")
("ms.sourcery.index.html.n1569", "description", "{\"kind\":\"element\",\"tag\":\"use\",\"attributes\":[{\"name\":\"href\",\"value\":\"#flourish\"}]}")
("ms.sourcery.index.html.n1570", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
("ms.sourcery.index.html.n1571", "description", "{\"kind\":\"comment\",\"text\":\" ============ Interlude: the film ============ \"}")
("ms.sourcery.index.html.n1572", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
