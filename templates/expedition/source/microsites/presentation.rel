("ms.sourcery.index.html.n687", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"flood-text prose\"}],\"children\":[\"ms.sourcery.index.html.n688\",\"ms.sourcery.index.html.n689\",\"ms.sourcery.index.html.n694\",\"ms.sourcery.index.html.n695\",\"ms.sourcery.index.html.n697\",\"ms.sourcery.index.html.n698\",\"ms.sourcery.index.html.n742\",\"ms.sourcery.index.html.n743\",\"ms.sourcery.index.html.n748\",\"ms.sourcery.index.html.n749\",\"ms.sourcery.index.html.n753\"]}")
("ms.sourcery.index.html.n688", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n689", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n690\",\"ms.sourcery.index.html.n691\",\"ms.sourcery.index.html.n693\"]}")
("ms.sourcery.index.html.n690", "description", "{\"kind\":\"text\",\"text\":\"The broom fetched a bucket. Then another. Nobody had said \"}")
("ms.sourcery.index.html.n691", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n692\"]}")
("ms.sourcery.index.html.n692", "description", "{\"kind\":\"text\",\"text\":\"how many\"}")
("ms.sourcery.index.html.n693", "description", "{\"kind\":\"text\",\"text\":\", so it split itself in two to keep up, and each half had the same excellent idea.\"}")
("ms.sourcery.index.html.n694", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n695", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n696\"]}")
("ms.sourcery.index.html.n696", "description", "{\"kind\":\"text\",\"text\":\"By the time the apprentice looked up there were forty brooms, and the water was at the windowsill. Nobody had lied. Nobody had exactly decided anything, either.\"}")
("ms.sourcery.index.html.n697", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n698", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"substitutions\"}],\"children\":[\"ms.sourcery.index.html.n699\",\"ms.sourcery.index.html.n700\",\"ms.sourcery.index.html.n702\",\"ms.sourcery.index.html.n703\",\"ms.sourcery.index.html.n741\"]}")
("ms.sourcery.index.html.n699", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n700", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n701\"]}")
("ms.sourcery.index.html.n701", "description", "{\"kind\":\"text\",\"text\":\"Things simply became true:\"}")
("ms.sourcery.index.html.n702", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n703", "description", "{\"kind\":\"element\",\"tag\":\"ul\",\"children\":[\"ms.sourcery.index.html.n704\",\"ms.sourcery.index.html.n705\",\"ms.sourcery.index.html.n710\",\"ms.sourcery.index.html.n711\",\"ms.sourcery.index.html.n716\",\"ms.sourcery.index.html.n717\",\"ms.sourcery.index.html.n722\",\"ms.sourcery.index.html.n723\",\"ms.sourcery.index.html.n728\",\"ms.sourcery.index.html.n729\",\"ms.sourcery.index.html.n734\",\"ms.sourcery.index.html.n735\",\"ms.sourcery.index.html.n740\"]}")
("ms.sourcery.index.html.n704", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n705", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n706\",\"ms.sourcery.index.html.n707\",\"ms.sourcery.index.html.n709\"]}")
("ms.sourcery.index.html.n706", "description", "{\"kind\":\"text\",\"text\":\"what was \"}")
("ms.sourcery.index.html.n707", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n708\"]}")
("ms.sourcery.index.html.n708", "description", "{\"kind\":\"text\",\"text\":\"generated\"}")
("ms.sourcery.index.html.n709", "description", "{\"kind\":\"text\",\"text\":\" was treated as intended,\"}")
("ms.sourcery.index.html.n710", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n711", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n712\",\"ms.sourcery.index.html.n713\",\"ms.sourcery.index.html.n715\"]}")
("ms.sourcery.index.html.n712", "description", "{\"kind\":\"text\",\"text\":\"what was \"}")
("ms.sourcery.index.html.n713", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n714\"]}")
("ms.sourcery.index.html.n714", "description", "{\"kind\":\"text\",\"text\":\"stored\"}")
("ms.sourcery.index.html.n715", "description", "{\"kind\":\"text\",\"text\":\" was treated as true,\"}")
("ms.sourcery.index.html.n716", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n717", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n718\",\"ms.sourcery.index.html.n719\",\"ms.sourcery.index.html.n721\"]}")
("ms.sourcery.index.html.n718", "description", "{\"kind\":\"text\",\"text\":\"what was \"}")
("ms.sourcery.index.html.n719", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n720\"]}")
("ms.sourcery.index.html.n720", "description", "{\"kind\":\"text\",\"text\":\"repeated\"}")
("ms.sourcery.index.html.n721", "description", "{\"kind\":\"text\",\"text\":\" was treated as supported,\"}")
("ms.sourcery.index.html.n722", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n723", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n724\",\"ms.sourcery.index.html.n725\",\"ms.sourcery.index.html.n727\"]}")
("ms.sourcery.index.html.n724", "description", "{\"kind\":\"text\",\"text\":\"what was \"}")
("ms.sourcery.index.html.n725", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n726\"]}")
("ms.sourcery.index.html.n726", "description", "{\"kind\":\"text\",\"text\":\"attributed\"}")
("ms.sourcery.index.html.n727", "description", "{\"kind\":\"text\",\"text\":\" was treated as endorsed,\"}")
("ms.sourcery.index.html.n728", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n729", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n730\",\"ms.sourcery.index.html.n731\",\"ms.sourcery.index.html.n733\"]}")
("ms.sourcery.index.html.n730", "description", "{\"kind\":\"text\",\"text\":\"what was \"}")
("ms.sourcery.index.html.n731", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n732\"]}")
("ms.sourcery.index.html.n732", "description", "{\"kind\":\"text\",\"text\":\"authorised\"}")
("ms.sourcery.index.html.n733", "description", "{\"kind\":\"text\",\"text\":\" was treated as done,\"}")
("ms.sourcery.index.html.n734", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.sourcery.index.html.n735", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n736\",\"ms.sourcery.index.html.n737\",\"ms.sourcery.index.html.n739\"]}")
("ms.sourcery.index.html.n736", "description", "{\"kind\":\"text\",\"text\":\"and whatever was \"}")
("ms.sourcery.index.html.n737", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n738\"]}")
("ms.sourcery.index.html.n738", "description", "{\"kind\":\"text\",\"text\":\"technically possible\"}")
("ms.sourcery.index.html.n739", "description", "{\"kind\":\"text\",\"text\":\" was treated as permitted.\"}")
("ms.sourcery.index.html.n740", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.sourcery.index.html.n741", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n742", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n743", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n744\",\"ms.sourcery.index.html.n745\",\"ms.sourcery.index.html.n747\"]}")
("ms.sourcery.index.html.n744", "description", "{\"kind\":\"text\",\"text\":\"This is the flood a lot of AI marketing is quietly selling: \"}")
("ms.sourcery.index.html.n745", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n746\"]}")
("ms.sourcery.index.html.n746", "description", "{\"kind\":\"text\",\"text\":\"let it run, it’ll figure it out.\"}")
("ms.sourcery.index.html.n747", "description", "{\"kind\":\"text\",\"text\":\" The trouble was never the magic. It’s that afterwards nobody can say who meant what, who decided, or how to put it right.\"}")
("ms.sourcery.index.html.n748", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n749", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n750\",\"ms.sourcery.index.html.n752\"]}")
("ms.sourcery.index.html.n750", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n751\"]}")
("ms.sourcery.index.html.n751", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n752", "description", "{\"kind\":\"text\",\"text\":\"Water doesn’t care who meant it.\"}")
("ms.sourcery.index.html.n753", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n754", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n755", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n756", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
