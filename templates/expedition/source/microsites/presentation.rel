("ms.temple.index.html.n546", "description", "{\"kind\":\"comment\",\"text\":\" IV · The Ark and the covenant \"}")
("ms.temple.index.html.n547", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
