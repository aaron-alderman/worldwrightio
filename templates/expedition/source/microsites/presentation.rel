("ms.sourcery.films/index.html.n204", "description", "{\"kind\":\"text\",\"text\":\"How it was made\"}")
("ms.sourcery.films/index.html.n205", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n206", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"attributes\":[{\"name\":\"class\",\"value\":\"made\"}],\"children\":[\"ms.sourcery.films/index.html.n207\",\"ms.sourcery.films/index.html.n208\",\"ms.sourcery.films/index.html.n212\",\"ms.sourcery.films/index.html.n213\",\"ms.sourcery.films/index.html.n220\",\"ms.sourcery.films/index.html.n221\",\"ms.sourcery.films/index.html.n228\",\"ms.sourcery.films/index.html.n229\",\"ms.sourcery.films/index.html.n236\",\"ms.sourcery.films/index.html.n237\",\"ms.sourcery.films/index.html.n244\"]}")
("ms.sourcery.films/index.html.n207", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n208", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n209\",\"ms.sourcery.films/index.html.n211\"]}")
("ms.sourcery.films/index.html.n209", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.films/index.html.n210\"]}")
("ms.sourcery.films/index.html.n210", "description", "{\"kind\":\"text\",\"text\":\"Cut-outs.\"}")
("ms.sourcery.films/index.html.n211", "description", "{\"kind\":\"text\",\"text\":\" Every figure, backdrop, curtain and title card is drawn as SVG on one sprite sheet and rasterised by headless Chrome to transparent PNGs, set in the site’s own fonts. Each cut-out gets a cream paper margin and a cast shadow, like a toy theatre piece.\"}")
("ms.sourcery.films/index.html.n212", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n213", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n214\",\"ms.sourcery.films/index.html.n216\",\"ms.sourcery.films/index.html.n217\",\"ms.sourcery.films/index.html.n219\"]}")
("ms.sourcery.films/index.html.n214", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.films/index.html.n215\"]}")
("ms.sourcery.films/index.html.n215", "description", "{\"kind\":\"text\",\"text\":\"The stage.\"}")
("ms.sourcery.films/index.html.n216", "description", "{\"kind\":\"text\",\"text\":\" ffmpeg composites the cut-outs with \"}")
("ms.sourcery.films/index.html.n217", "description", "{\"kind\":\"element\",\"tag\":\"code\",\"children\":[\"ms.sourcery.films/index.html.n218\"]}")
("ms.sourcery.films/index.html.n218", "description", "{\"kind\":\"text\",\"text\":\"overlay\"}")
("ms.sourcery.films/index.html.n219", "description", "{\"kind\":\"text\",\"text\":\" time expressions: brooms hop and bob on sine curves, the water rises on a smoothstep, backdrops drift for parallax, and each new broom splits off an old one and slides to its place.\"}")
("ms.sourcery.films/index.html.n220", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n221", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n222\",\"ms.sourcery.films/index.html.n224\",\"ms.sourcery.films/index.html.n225\",\"ms.sourcery.films/index.html.n227\"]}")
("ms.sourcery.films/index.html.n222", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.films/index.html.n223\"]}")
("ms.sourcery.films/index.html.n223", "description", "{\"kind\":\"text\",\"text\":\"The paint.\"}")
("ms.sourcery.films/index.html.n224", "description", "{\"kind\":\"text\",\"text\":\" Watercolour washes are computed pixel by pixel with \"}")
("ms.sourcery.films/index.html.n225", "description", "{\"kind\":\"element\",\"tag\":\"code\",\"children\":[\"ms.sourcery.films/index.html.n226\"]}")
("ms.sourcery.films/index.html.n226", "description", "{\"kind\":\"text\",\"text\":\"geq\"}")
("ms.sourcery.films/index.html.n227", "description", "{\"kind\":\"text\",\"text\":\": wobbly ellipses with pigment pooling at the edges and a little granulation. A paper grain is multiplied over every frame.\"}")
("ms.sourcery.films/index.html.n228", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n229", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n230\",\"ms.sourcery.films/index.html.n232\",\"ms.sourcery.films/index.html.n233\",\"ms.sourcery.films/index.html.n235\"]}")
("ms.sourcery.films/index.html.n230", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.films/index.html.n231\"]}")
("ms.sourcery.films/index.html.n231", "description", "{\"kind\":\"text\",\"text\":\"The theatre.\"}")
("ms.sourcery.films/index.html.n232", "description", "{\"kind\":\"text\",\"text\":\" A painted proscenium frames the whole film, velvet curtains open and close on the title and the moral, and the scenes change with \"}")
("ms.sourcery.films/index.html.n233", "description", "{\"kind\":\"element\",\"tag\":\"code\",\"children\":[\"ms.sourcery.films/index.html.n234\"]}")
("ms.sourcery.films/index.html.n234", "description", "{\"kind\":\"text\",\"text\":\"xfade\"}")
("ms.sourcery.films/index.html.n235", "description", "{\"kind\":\"text\",\"text\":\" page wipes and an iris.\"}")
("ms.sourcery.films/index.html.n236", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n237", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n238\",\"ms.sourcery.films/index.html.n240\",\"ms.sourcery.films/index.html.n241\",\"ms.sourcery.films/index.html.n243\"]}")
("ms.sourcery.films/index.html.n238", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.films/index.html.n239\"]}")
("ms.sourcery.films/index.html.n239", "description", "{\"kind\":\"text\",\"text\":\"The sound.\"}")
("ms.sourcery.films/index.html.n240", "description", "{\"kind\":\"text\",\"text\":\" A music box played by \"}")
("ms.sourcery.films/index.html.n241", "description", "{\"kind\":\"element\",\"tag\":\"code\",\"children\":[\"ms.sourcery.films/index.html.n242\"]}")
