("ms.temple.index.html.n1366", "description", "{\"kind\":\"text\",\"text\":\"AI proposes; people decide.\"}")
("ms.temple.index.html.n1367", "description", "{\"kind\":\"element\",\"tag\":\"td\",\"children\":[\"ms.editorial.temple/index.html.26\"]}")
("ms.temple.index.html.n1368", "description", "{\"kind\":\"text\",\"text\":\"Enforced in Claimipedia today.\"}")
("ms.temple.index.html.n1369", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1370", "description", "{\"kind\":\"element\",\"tag\":\"tr\",\"children\":[\"ms.temple.index.html.n1371\",\"ms.temple.index.html.n1373\"]}")
