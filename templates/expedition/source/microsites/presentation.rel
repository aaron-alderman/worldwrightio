("ms.sourcery.index.html.n1372", "description", "{\"kind\":\"text\",\"text\":\"equal-evidence review\"}")
("ms.sourcery.index.html.n1373", "description", "{\"kind\":\"text\",\"text\":\": every item weighs the same, and support and challenge both cross their thresholds.\"}")
