("ms.temple.index.html.n171", "description", "{\"kind\":\"text\",\"text\":\"I · The distance\"}")
("ms.temple.index.html.n172", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n173", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"distance-title\"},{\"name\":\"class\",\"value\":\"statement\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n174\"]}")
("ms.temple.index.html.n174", "description", "{\"kind\":\"text\",\"text\":\"Artificial intelligence makes ideas easier to express, combine, and execute.\"}")
("ms.temple.index.html.n175", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n176", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"statement soft\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n177\"]}")
("ms.temple.index.html.n177", "description", "{\"kind\":\"text\",\"text\":\"That is its promise, but also its danger.\"}")
("ms.temple.index.html.n178", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n179", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"class\",\"value\":\"gap\"},{\"name\":\"aria-labelledby\",\"value\":\"gap-caption\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n180\",\"ms.temple.index.html.n181\",\"ms.temple.index.html.n195\",\"ms.temple.index.html.n196\",\"ms.temple.index.html.n198\"]}")
("ms.temple.index.html.n180", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
