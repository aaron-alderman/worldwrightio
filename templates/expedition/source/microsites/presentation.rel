("ms.temple.index.html.n193", "description", "{\"kind\":\"text\",\"text\":\"an action\"}")
("ms.temple.index.html.n194", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n195", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n196", "description", "{\"kind\":\"element\",\"tag\":\"figcaption\",\"attributes\":[{\"name\":\"id\",\"value\":\"gap-caption\"}],\"children\":[\"ms.temple.index.html.n197\"]}")
("ms.temple.index.html.n197", "description", "{\"kind\":\"text\",\"text\":\"The distance between a sentence and a consequential action is shrinking.\"}")
("ms.temple.index.html.n198", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n199", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n200", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body-wide\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n201\"]}")
("ms.temple.index.html.n201", "description", "{\"kind\":\"text\",\"text\":\"A suggestion can become a policy, a database migration, a financial decision, a public narrative, or a deployed system before the people affected by it understand what happened or who authorized it.\"}")
("ms.temple.index.html.n202", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n203", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n204", "description", "{\"kind\":\"comment\",\"text\":\" II · The substitutions \"}")
("ms.temple.index.html.n205", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n206", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"substitutions\"},{\"name\":\"class\",\"value\":\"scene-text\"},{\"name\":\"aria-labelledby\",\"value\":\"subs-title\"}],\"children\":[\"ms.temple.index.html.n207\",\"ms.temple.index.html.n208\",\"ms.temple.index.html.n210\",\"ms.temple.index.html.n211\",\"ms.temple.index.html.n213\",\"ms.temple.index.html.n214\",\"ms.temple.index.html.n216\",\"ms.temple.index.html.n217\",\"ms.temple.index.html.n323\",\"ms.temple.index.html.n324\",\"ms.temple.index.html.n326\",\"ms.temple.index.html.n327\",\"ms.temple.index.html.n332\"]}")
