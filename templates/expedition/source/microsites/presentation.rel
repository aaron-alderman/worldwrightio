("ms.sourcery.index.html.n1715", "description", "{\"kind\":\"text\",\"text\":\"Your agent. Your seal.\"}")
("ms.sourcery.index.html.n1716", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1717", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.purpose.30\"]}")
("ms.sourcery.index.html.n1718", "description", "{\"kind\":\"text\",\"text\":\"Sourcery is authored through conversation with the AI agent you already use. It drafts; you decide; the house keeps the record.\"}")
("ms.sourcery.index.html.n1719", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1720", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"btn btn--ink\"},{\"name\":\"id\",\"value\":\"cta-button\"},{\"name\":\"aria-expanded\",\"value\":\"false\"},{\"name\":\"aria-controls\",\"value\":\"cta-note\"}],\"children\":[\"ms.sourcery.index.html.n1721\"]}")
("ms.sourcery.index.html.n1721", "description", "{\"kind\":\"text\",\"text\":\"Bring your own agent\"}")
("ms.sourcery.index.html.n1722", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
