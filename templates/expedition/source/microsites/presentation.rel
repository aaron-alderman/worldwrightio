("ms.sourcery.index.html.n1610", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.index.html.n1611", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"class\",\"value\":\"epilogue\"},{\"name\":\"id\",\"value\":\"epilogue\"},{\"name\":\"aria-labelledby\",\"value\":\"epi-title\"}],\"children\":[\"ms.sourcery.index.html.n1612\",\"ms.sourcery.index.html.n1613\",\"ms.sourcery.index.html.n1621\",\"ms.sourcery.index.html.n1622\",\"ms.sourcery.index.html.n1630\",\"ms.sourcery.index.html.n1631\",\"ms.sourcery.index.html.n1679\",\"ms.sourcery.index.html.n1680\",\"ms.sourcery.index.html.n1727\"]}")
("ms.sourcery.index.html.n1612", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1613", "description", "{\"kind\":\"element\",\"tag\":\"header\",\"attributes\":[{\"name\":\"class\",\"value\":\"chapter-head\"}],\"children\":[\"ms.sourcery.index.html.n1614\",\"ms.sourcery.index.html.n1615\",\"ms.sourcery.index.html.n1617\",\"ms.sourcery.index.html.n1618\",\"ms.sourcery.index.html.n1620\"]}")
("ms.sourcery.index.html.n1614", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1615", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"numeral\"}],\"children\":[\"ms.sourcery.index.html.n1616\"]}")
("ms.sourcery.index.html.n1616", "description", "{\"kind\":\"text\",\"text\":\"Epilogue\"}")
("ms.sourcery.index.html.n1617", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1618", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"epi-title\"}],\"children\":[\"ms.sourcery.index.html.n1619\"]}")
("ms.sourcery.index.html.n1619", "description", "{\"kind\":\"text\",\"text\":\"Magic that shows its work\"}")
("ms.sourcery.index.html.n1620", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1621", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1622", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1623\",\"ms.sourcery.index.html.n1624\",\"ms.sourcery.index.html.n1626\",\"ms.sourcery.index.html.n1627\",\"ms.sourcery.index.html.n1629\"]}")
("ms.sourcery.index.html.n1623", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1624", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n1625\"]}")
("ms.sourcery.index.html.n1625", "description", "{\"kind\":\"text\",\"text\":\"The apprentice kept the brooms. Everyone does. What changed was the house: spells written down, seals that mean something, and a witness for every splash.\"}")
("ms.sourcery.index.html.n1626", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1627", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1628\"]}")
("ms.sourcery.index.html.n1628", "description", "{\"kind\":\"text\",\"text\":\"That’s the whole idea. Not less magic. More of it, safely, and all of it showing its work.\"}")
("ms.sourcery.index.html.n1629", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1630", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1631", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"rules\"}],\"children\":[\"ms.sourcery.index.html.n1632\",\"ms.sourcery.index.html.n1633\",\"ms.sourcery.index.html.n1635\",\"ms.sourcery.index.html.n1636\",\"ms.sourcery.index.html.n1678\"]}")
("ms.sourcery.index.html.n1632", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1633", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"attributes\":[{\"name\":\"class\",\"value\":\"rules-title\"}],\"children\":[\"ms.sourcery.index.html.n1634\"]}")
("ms.sourcery.index.html.n1634", "description", "{\"kind\":\"text\",\"text\":\"The house rules we’re promising\"}")
("ms.sourcery.index.html.n1635", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1636", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"attributes\":[{\"name\":\"class\",\"value\":\"rules-list\"}],\"children\":[\"ms.sourcery.index.html.n1637\",\"ms.sourcery.index.html.n1638\",\"ms.sourcery.index.html.n1645\",\"ms.sourcery.index.html.n1646\",\"ms.sourcery.index.html.n1653\",\"ms.sourcery.index.html.n1654\",\"ms.sourcery.index.html.n1661\",\"ms.sourcery.index.html.n1662\",\"ms.sourcery.index.html.n1669\",\"ms.sourcery.index.html.n1670\",\"ms.sourcery.index.html.n1677\"]}")
("ms.sourcery.index.html.n1637", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1638", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1639\",\"ms.sourcery.index.html.n1643\"]}")
("ms.sourcery.index.html.n1639", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1640\",\"ms.sourcery.index.html.n1642\"]}")
("ms.sourcery.index.html.n1640", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1641\"]}")
("ms.sourcery.index.html.n1641", "description", "{\"kind\":\"text\",\"text\":\"You can always ask “why?”\"}")
("ms.sourcery.index.html.n1642", "description", "{\"kind\":\"text\",\"text\":\" Every result traces back to who proposed it, who decided, the evidence and the rules.\"}")
("ms.sourcery.index.html.n1643", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"stand\"}],\"children\":[\"ms.purpose.20\"]}")
("ms.sourcery.index.html.n1644", "description", "{\"kind\":\"text\",\"text\":\"How Sourcery and Claimipedia work today.\"}")
("ms.sourcery.index.html.n1645", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1646", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1647\",\"ms.sourcery.index.html.n1651\"]}")
("ms.sourcery.index.html.n1647", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1648\",\"ms.sourcery.index.html.n1650\"]}")
("ms.sourcery.index.html.n1648", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1649\"]}")
("ms.sourcery.index.html.n1649", "description", "{\"kind\":\"text\",\"text\":\"AI proposes; people decide.\"}")
("ms.sourcery.index.html.n1650", "description", "{\"kind\":\"text\",\"text\":\" Nothing becomes real without an accountable seal.\"}")
("ms.sourcery.index.html.n1651", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"stand\"}],\"children\":[\"ms.purpose.21\"]}")
("ms.sourcery.index.html.n1652", "description", "{\"kind\":\"text\",\"text\":\"Enforced in Claimipedia today, where AI can only propose.\"}")
("ms.sourcery.index.html.n1653", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1654", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1655\",\"ms.sourcery.index.html.n1659\"]}")
("ms.sourcery.index.html.n1655", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1656\",\"ms.sourcery.index.html.n1658\"]}")
("ms.sourcery.index.html.n1656", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1657\"]}")
("ms.sourcery.index.html.n1657", "description", "{\"kind\":\"text\",\"text\":\"Say what you mean, get working software.\"}")
("ms.sourcery.index.html.n1658", "description", "{\"kind\":\"text\",\"text\":\" Author the meaning once; let the system handle the app.\"}")
("ms.sourcery.index.html.n1659", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"stand\"}],\"children\":[\"ms.purpose.22\"]}")
("ms.sourcery.index.html.n1660", "description", "{\"kind\":\"text\",\"text\":\"Demonstrated internally. The front door is still being smoothed.\"}")
("ms.sourcery.index.html.n1661", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1662", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1663\",\"ms.sourcery.index.html.n1667\"]}")
("ms.sourcery.index.html.n1663", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1664\",\"ms.sourcery.index.html.n1666\"]}")
("ms.sourcery.index.html.n1664", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1665\"]}")
("ms.sourcery.index.html.n1665", "description", "{\"kind\":\"text\",\"text\":\"Disagreement you can read.\"}")
("ms.sourcery.index.html.n1666", "description", "{\"kind\":\"text\",\"text\":\" No universal truth score: see where views part ways, and why.\"}")
("ms.sourcery.index.html.n1667", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"stand\"}],\"children\":[\"ms.purpose.23\"]}")
("ms.sourcery.index.html.n1668", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia’s first version, opening soon.\"}")
("ms.sourcery.index.html.n1669", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1670", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.index.html.n1671\",\"ms.sourcery.index.html.n1675\"]}")
("ms.sourcery.index.html.n1671", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1672\",\"ms.sourcery.index.html.n1674\"]}")
("ms.sourcery.index.html.n1672", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.sourcery.index.html.n1673\"]}")
("ms.sourcery.index.html.n1673", "description", "{\"kind\":\"text\",\"text\":\"Correction without erasure.\"}")
("ms.sourcery.index.html.n1674", "description", "{\"kind\":\"text\",\"text\":\" History is kept, never quietly rewritten.\"}")
("ms.sourcery.index.html.n1675", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"stand\"}],\"children\":[\"ms.purpose.24\"]}")
("ms.sourcery.index.html.n1676", "description", "{\"kind\":\"text\",\"text\":\"Records are append-only today. Appeal and repair are Temple3 laboratory work.\"}")
("ms.sourcery.index.html.n1677", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
