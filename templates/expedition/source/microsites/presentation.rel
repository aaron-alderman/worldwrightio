("ms.temple.index.html.n1036", "description", "{\"kind\":\"text\",\"text\":\"A miniature running in your browser — an illustration of Temple3’s kernel, not Temple3 itself. It uses real SHA-256 over canonical bytes, a simplified Merkle commitment, its own error codes, and a covenant written in the kernel’s operator vocabulary: literal, read, eq, not, all, any.\"}")
("ms.temple.index.html.n1037", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1038", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n1039", "description", "{\"kind\":\"comment\",\"text\":\" VII · The witness \"}")
("ms.temple.index.html.n1040", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
