("ms.sourcery.index.html.n1165", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1166", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"attributes\":[{\"name\":\"id\",\"value\":\"ledger-title\"}],\"children\":[\"ms.sourcery.index.html.n1167\"]}")
("ms.sourcery.index.html.n1167", "description", "{\"kind\":\"text\",\"text\":\"The house ledger\"}")
("ms.sourcery.index.html.n1168", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1169", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ledger-note\"}],\"children\":[\"ms.sourcery.index.html.n1170\"]}")
("ms.sourcery.index.html.n1170", "description", "{\"kind\":\"text\",\"text\":\"Every attempt is witnessed, sealed or sent back. Each entry’s fingerprint includes the one before it. This ledger lives in this page only.\"}")
