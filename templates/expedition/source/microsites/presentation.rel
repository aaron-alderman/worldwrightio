"\n    },\n    {\n      \"n\": 3,\n      \"title\": \"The algebra applies\",\n      \"gloss\": \"S₁ = (S₀ − consume) ∪ create\"\n    },\n    {\n      \"n\": 4,\n      \"title\": \"The claimed root is the computed root\",\n      \"gloss\": \"What the proposer says will happen is what does happen.\"\n    },\n    {\n      \"n\": 5,\n      \"title\": \"The covenant says yes\",\n      \"gloss\": \"The active predicate returns true.\"\n    },\n    {\n      \"n\": 6,\n      \"title\": \"Every Ark invariant holds\",\n      \"gloss\": \"Universal law, which no covenant can widen.\"\n    }\n  ]\n}\n")
