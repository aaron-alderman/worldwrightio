("ms.sourcery.films/index.html.n201", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"class\",\"value\":\"film-section\"},{\"name\":\"aria-labelledby\",\"value\":\"made-title\"}],\"children\":[\"ms.sourcery.films/index.html.n202\",\"ms.sourcery.films/index.html.n203\",\"ms.sourcery.films/index.html.n205\",\"ms.sourcery.films/index.html.n206\",\"ms.sourcery.films/index.html.n245\"]}")
