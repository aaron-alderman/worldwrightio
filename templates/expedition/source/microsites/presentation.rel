("ms.sourcery.index.html.n1073", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1074\",\"ms.sourcery.index.html.n1075\",\"ms.sourcery.index.html.n1077\",\"ms.sourcery.index.html.n1078\",\"ms.sourcery.index.html.n1082\"]}")
("ms.sourcery.index.html.n1074", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1075", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1076\"]}")
("ms.sourcery.index.html.n1076", "description", "{\"kind\":\"text\",\"text\":\"An emissary can draft anything, test anything and explain anything. What it can’t do is make something real on its own say-so. That isn’t a limit on the magic. It’s what makes the magic safe to use at full strength.\"}")
("ms.sourcery.index.html.n1077", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1078", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"moral\"}],\"children\":[\"ms.sourcery.index.html.n1079\",\"ms.sourcery.index.html.n1081\"]}")
("ms.sourcery.index.html.n1079", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.sourcery.index.html.n1080\"]}")
("ms.sourcery.index.html.n1080", "description", "{\"kind\":\"text\",\"text\":\"Moral\"}")
("ms.sourcery.index.html.n1081", "description", "{\"kind\":\"text\",\"text\":\"Capable is not the same as in charge.\"}")
("ms.sourcery.index.html.n1082", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1083", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
