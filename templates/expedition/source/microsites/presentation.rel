("ms.sourcery.films/index.html.n108", "description", "{\"kind\":\"text\",\"text\":\" Chapter I: The Apprentice\"}")
("ms.sourcery.films/index.html.n109", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n110", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n111\",\"ms.sourcery.films/index.html.n113\"]}")
("ms.sourcery.films/index.html.n111", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n112\"]}")
("ms.sourcery.films/index.html.n112", "description", "{\"kind\":\"text\",\"text\":\"0:07\"}")
("ms.sourcery.films/index.html.n113", "description", "{\"kind\":\"text\",\"text\":\" Broom, fetch the water. Don’t trouble me with the details.\"}")
("ms.sourcery.films/index.html.n114", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n115", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n116\",\"ms.sourcery.films/index.html.n118\"]}")
("ms.sourcery.films/index.html.n116", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n117\"]}")
("ms.sourcery.films/index.html.n117", "description", "{\"kind\":\"text\",\"text\":\"0:10\"}")
("ms.sourcery.films/index.html.n118", "description", "{\"kind\":\"text\",\"text\":\" Chapter II: The Flood\"}")
("ms.sourcery.films/index.html.n119", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n120", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n121\",\"ms.sourcery.films/index.html.n123\"]}")
("ms.sourcery.films/index.html.n121", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n122\"]}")
("ms.sourcery.films/index.html.n122", "description", "{\"kind\":\"text\",\"text\":\"0:15\"}")
("ms.sourcery.films/index.html.n123", "description", "{\"kind\":\"text\",\"text\":\" Nobody lied. Nobody decided anything, either.\"}")
("ms.sourcery.films/index.html.n124", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n125", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n126\",\"ms.sourcery.films/index.html.n128\"]}")
("ms.sourcery.films/index.html.n126", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n127\"]}")
("ms.sourcery.films/index.html.n127", "description", "{\"kind\":\"text\",\"text\":\"0:16\"}")
("ms.sourcery.films/index.html.n128", "description", "{\"kind\":\"text\",\"text\":\" Brooms: 40. Buckets: 80. Decisions anyone made: 0.\"}")
("ms.sourcery.films/index.html.n129", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n130", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n131\",\"ms.sourcery.films/index.html.n133\"]}")
("ms.sourcery.films/index.html.n131", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n132\"]}")
("ms.sourcery.films/index.html.n132", "description", "{\"kind\":\"text\",\"text\":\"0:18\"}")
("ms.sourcery.films/index.html.n133", "description", "{\"kind\":\"text\",\"text\":\" Chapter III: The Sorcerer Returns\"}")
("ms.sourcery.films/index.html.n134", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n135", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n136\",\"ms.sourcery.films/index.html.n138\"]}")
("ms.sourcery.films/index.html.n136", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n137\"]}")
("ms.sourcery.films/index.html.n137", "description", "{\"kind\":\"text\",\"text\":\"0:21\"}")
("ms.sourcery.films/index.html.n138", "description", "{\"kind\":\"text\",\"text\":\" The Book. The Seal. The Witness.\"}")
("ms.sourcery.films/index.html.n139", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n140", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n141\",\"ms.sourcery.films/index.html.n143\"]}")
("ms.sourcery.films/index.html.n141", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n142\"]}")
("ms.sourcery.films/index.html.n142", "description", "{\"kind\":\"text\",\"text\":\"0:23\"}")
("ms.sourcery.films/index.html.n143", "description", "{\"kind\":\"text\",\"text\":\" Not a bigger spell: a book, a seal and a witness.\"}")
("ms.sourcery.films/index.html.n144", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n145", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n146\",\"ms.sourcery.films/index.html.n148\"]}")
("ms.sourcery.films/index.html.n146", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n147\"]}")
("ms.sourcery.films/index.html.n147", "description", "{\"kind\":\"text\",\"text\":\"0:25\"}")
("ms.sourcery.films/index.html.n148", "description", "{\"kind\":\"text\",\"text\":\" Chapter IV: Brooms as Emissaries\"}")
("ms.sourcery.films/index.html.n149", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n150", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n151\",\"ms.sourcery.films/index.html.n153\"]}")
("ms.sourcery.films/index.html.n151", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n152\"]}")
("ms.sourcery.films/index.html.n152", "description", "{\"kind\":\"text\",\"text\":\"0:29\"}")
("ms.sourcery.films/index.html.n153", "description", "{\"kind\":\"text\",\"text\":\" Nothing becomes real until someone accountable seals it.\"}")
("ms.sourcery.films/index.html.n154", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n155", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n156\",\"ms.sourcery.films/index.html.n158\"]}")
("ms.sourcery.films/index.html.n156", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n157\"]}")
("ms.sourcery.films/index.html.n157", "description", "{\"kind\":\"text\",\"text\":\"0:31\"}")
("ms.sourcery.films/index.html.n158", "description", "{\"kind\":\"text\",\"text\":\" Chapter V: The Library\"}")
("ms.sourcery.films/index.html.n159", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n160", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n161\",\"ms.sourcery.films/index.html.n163\"]}")
("ms.sourcery.films/index.html.n161", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n162\"]}")
("ms.sourcery.films/index.html.n162", "description", "{\"kind\":\"text\",\"text\":\"0:33\"}")
("ms.sourcery.films/index.html.n163", "description", "{\"kind\":\"text\",\"text\":\" Accepted. Conflicted. Undecided.\"}")
("ms.sourcery.films/index.html.n164", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n165", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n166\",\"ms.sourcery.films/index.html.n168\"]}")
("ms.sourcery.films/index.html.n166", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n167\"]}")
("ms.sourcery.films/index.html.n167", "description", "{\"kind\":\"text\",\"text\":\"0:35\"}")
("ms.sourcery.films/index.html.n168", "description", "{\"kind\":\"text\",\"text\":\" One claim, three written-down methods, three honest answers.\"}")
("ms.sourcery.films/index.html.n169", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n170", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.sourcery.films/index.html.n171\",\"ms.sourcery.films/index.html.n173\"]}")
("ms.sourcery.films/index.html.n171", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"at\"}],\"children\":[\"ms.sourcery.films/index.html.n172\"]}")
("ms.sourcery.films/index.html.n172", "description", "{\"kind\":\"text\",\"text\":\"0:40\"}")
("ms.sourcery.films/index.html.n173", "description", "{\"kind\":\"text\",\"text\":\" Magic that shows its work. Sourcery. Claimipedia opens soon.\"}")
("ms.sourcery.films/index.html.n174", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n175", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n176", "description", "{\"kind\":\"comment\",\"text\":\" transcript:end \"}")
("ms.sourcery.films/index.html.n177", "description", "{\"kind\":\"text\",\"text\":\"\\n  \"}")
("ms.sourcery.films/index.html.n178", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n  \"}")
("ms.sourcery.films/index.html.n179", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"class\",\"value\":\"film-section\"},{\"name\":\"aria-labelledby\",\"value\":\"loop-title\"}],\"children\":[\"ms.sourcery.films/index.html.n180\",\"ms.sourcery.films/index.html.n181\",\"ms.sourcery.films/index.html.n183\",\"ms.sourcery.films/index.html.n184\",\"ms.sourcery.films/index.html.n186\",\"ms.sourcery.films/index.html.n187\",\"ms.sourcery.films/index.html.n199\"]}")
("ms.sourcery.films/index.html.n180", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n181", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"loop-title\"}],\"children\":[\"ms.sourcery.films/index.html.n182\"]}")
("ms.sourcery.films/index.html.n182", "description", "{\"kind\":\"text\",\"text\":\"The flood, forever\"}")
("ms.sourcery.films/index.html.n183", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n184", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.films/index.html.n185\"]}")
("ms.sourcery.films/index.html.n185", "description", "{\"kind\":\"text\",\"text\":\"Eight seconds that loop without a seam: every bob and wave completes a whole number of cycles, so the last frame leads straight back to the first.\"}")
("ms.sourcery.films/index.html.n186", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.films/index.html.n187", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"class\",\"value\":\"loop-frame\"}],\"children\":[\"ms.sourcery.films/index.html.n188\",\"ms.sourcery.films/index.html.n189\",\"ms.sourcery.films/index.html.n195\",\"ms.sourcery.films/index.html.n196\",\"ms.sourcery.films/index.html.n198\"]}")
("ms.sourcery.films/index.html.n188", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.films/index.html.n189", "description", "{\"kind\":\"element\",\"tag\":\"video\",\"attributes\":[{\"name\":\"class\",\"value\":\"loop-video\"},{\"name\":\"data-autoplay\",\"value\":\"\"},{\"name\":\"muted\",\"value\":\"\"},{\"name\":\"loop\",\"value\":\"\"},{\"name\":\"playsinline\",\"value\":\"\"},{\"name\":\"preload\",\"value\":\"metadata\"},{\"name\":\"width\",\"value\":\"960\"},{\"name\":\"height\",\"value\":\"540\"},{\"name\":\"poster\",\"value\":\"media/flood-loop.jpg\"},{\"name\":\"aria-label\",\"value\":\"Brooms bobbing on a flooded workshop floor, while a counter reads: brooms 40, buckets 80, decisions anyone made 0.\"}],\"children\":[\"ms.sourcery.films/index.html.n190\",\"ms.sourcery.films/index.html.n191\",\"ms.sourcery.films/index.html.n192\",\"ms.sourcery.films/index.html.n193\",\"ms.sourcery.films/index.html.n194\"]}")
