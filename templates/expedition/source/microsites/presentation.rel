("ms.sourcery.index.html.n1587", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1588", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"children\":[\"ms.sourcery.index.html.n1589\",\"ms.sourcery.index.html.n1590\",\"ms.sourcery.index.html.n1592\",\"ms.sourcery.index.html.n1593\",\"ms.sourcery.index.html.n1595\",\"ms.sourcery.index.html.n1596\",\"ms.sourcery.index.html.n1598\",\"ms.sourcery.index.html.n1599\",\"ms.sourcery.index.html.n1603\"]}")
