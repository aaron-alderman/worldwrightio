("ms.sourcery.index.html.n1161", "description", "{\"kind\":\"text\",\"text\":\"A playful illustration running in your browser. No AI is called: the broom follows a simple template. The seal is a real SHA-256 fingerprint of the exact proposal.\"}")
("ms.sourcery.index.html.n1162", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1163", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
