("ms.temple.index.html.n1048", "description", "{\"kind\":\"text\",\"text\":\"VII · The witness\"}")
("ms.temple.index.html.n1049", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1050", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"witness-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1051\"]}")
("ms.temple.index.html.n1051", "description", "{\"kind\":\"text\",\"text\":\"Every judgment leaves a witness.\"}")
("ms.temple.index.html.n1052", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1053", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1054\"]}")
("ms.temple.index.html.n1054", "description", "{\"kind\":\"text\",\"text\":\"Acceptance, rejection, conflict and unresolved outcomes remain explicit and attributable. Anyone holding the rules can replay a Temple from its genesis and re-judge every step.\"}")
("ms.temple.index.html.n1055", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1056", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"attributes\":[{\"name\":\"class\",\"value\":\"quote\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1057\"]}")
("ms.temple.index.html.n1057", "description", "{\"kind\":\"text\",\"text\":\"“A machine owner may destroy or fork local bytes, but cannot produce a continuation under the original identity without a valid witnessed transition.”\"}")
("ms.temple.index.html.n1058", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1059", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
