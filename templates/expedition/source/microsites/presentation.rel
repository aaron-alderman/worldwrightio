("ms.sourcery.index.html.n1219", "description", "{\"kind\":\"text\",\"text\":\"The Library\"}")
("ms.sourcery.index.html.n1220", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1221", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1222", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1223\",\"ms.sourcery.index.html.n1224\",\"ms.sourcery.index.html.n1226\",\"ms.sourcery.index.html.n1227\",\"ms.sourcery.index.html.n1231\"]}")
("ms.sourcery.index.html.n1223", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1224", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n1225\"]}")
("ms.sourcery.index.html.n1225", "description", "{\"kind\":\"text\",\"text\":\"Down the hall is the library, where the spells are about what’s true. That magic is harder, and the old trick of one oracle and one answer only makes it worse.\"}")
("ms.sourcery.index.html.n1226", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1227", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.purpose.26\",\"ms.purpose.28\"]}")
("ms.sourcery.index.html.n1228", "description", "{\"kind\":\"element\",\"tag\":\"strong\",\"children\":[\"ms.sourcery.index.html.n1229\"]}")
("ms.sourcery.index.html.n1229", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia\"}")
("ms.sourcery.index.html.n1230", "description", "{\"kind\":\"text\",\"text\":\", opening soon, does it differently. A claim gets a permanent address. Groups judge it with review methods they write down: which evidence counts, how much it weighs, how many independent sources are enough. Each method runs the same way every time. You don’t get one verdict. You see what each method concludes, and exactly where they part ways.\"}")
("ms.sourcery.index.html.n1231", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1232", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
