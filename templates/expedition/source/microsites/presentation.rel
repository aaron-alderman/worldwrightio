("ms.temple.index.html.n325", "description", "{\"kind\":\"text\",\"text\":\"These are not merely data-quality mistakes. They are changes in the political and moral meaning of a system.\"}")
("ms.temple.index.html.n326", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n327", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"attributes\":[{\"name\":\"class\",\"value\":\"question\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n328\",\"ms.temple.index.html.n329\",\"ms.temple.index.html.n331\"]}")
("ms.temple.index.html.n328", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n329", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n330\"]}")
("ms.temple.index.html.n330", "description", "{\"kind\":\"text\",\"text\":\"How can representations become procedures without silently changing their epistemic, political, or moral type?\"}")
("ms.temple.index.html.n331", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n332", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
