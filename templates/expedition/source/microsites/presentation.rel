("ms.temple.index.html.n773", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n774", "description", "{\"kind\":\"element\",\"tag\":\"defs\",\"children\":[\"ms.temple.index.html.n775\"]}")
