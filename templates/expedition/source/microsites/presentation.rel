("ms.sourcery.index.html.n767", "description", "{\"kind\":\"text\",\"text\":\"Chapter III\"}")
("ms.sourcery.index.html.n768", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n769", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch3-title\"}],\"children\":[\"ms.sourcery.index.html.n770\"]}")
("ms.sourcery.index.html.n770", "description", "{\"kind\":\"text\",\"text\":\"The Sorcerer Returns\"}")
("ms.sourcery.index.html.n771", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n772", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n773", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n774\",\"ms.sourcery.index.html.n775\",\"ms.sourcery.index.html.n777\"]}")
("ms.sourcery.index.html.n774", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n775", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n776\"]}")
("ms.sourcery.index.html.n776", "description", "{\"kind\":\"text\",\"text\":\"In the old versions, the sorcerer strides in and ends it all with a bigger spell. Ours came home, looked at the water, and reached for three quieter things.\"}")
("ms.sourcery.index.html.n777", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n778", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n779", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"class\",\"value\":\"plate-frame plate-frame--wide scene reveal\"}],\"children\":[\"ms.sourcery.index.html.n780\",\"ms.sourcery.index.html.n781\",\"ms.sourcery.index.html.n842\"]}")
("ms.sourcery.index.html.n780", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
