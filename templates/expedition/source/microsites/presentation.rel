("ms.sourcery.index.html.n1095", "description", "{\"kind\":\"text\",\"text\":\"Chapter V\"}")
("ms.sourcery.index.html.n1096", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1097", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch5-title\"}],\"children\":[\"ms.sourcery.index.html.n1098\"]}")
("ms.sourcery.index.html.n1098", "description", "{\"kind\":\"text\",\"text\":\"The Workshop\"}")
("ms.sourcery.index.html.n1099", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1100", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1101", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n1102\",\"ms.sourcery.index.html.n1103\",\"ms.sourcery.index.html.n1105\",\"ms.sourcery.index.html.n1106\",\"ms.sourcery.index.html.n1108\",\"ms.sourcery.index.html.n1109\",\"ms.sourcery.index.html.n1111\"]}")
("ms.sourcery.index.html.n1102", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1103", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n1104\"]}")
("ms.sourcery.index.html.n1104", "description", "{\"kind\":\"text\",\"text\":\"This is where Sourcery comes in. It’s a workshop for turning what you mean into working software, with the book, the seal and the witness built in.\"}")
("ms.sourcery.index.html.n1105", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1106", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n1107\"]}")
("ms.sourcery.index.html.n1107", "description", "{\"kind\":\"text\",\"text\":\"You describe what you need in plain words, to your own AI agent. The agent drafts the change as a proposal Sourcery can read: the records it would create, the actions and views, the rules it would add. Sourcery checks it, shows you, and waits. Nothing becomes real until someone accountable seals it, and every step leaves a receipt.\"}")
("ms.sourcery.index.html.n1108", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n1109", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"motto\"}],\"children\":[\"ms.sourcery.index.html.n1110\"]}")
("ms.sourcery.index.html.n1110", "description", "{\"kind\":\"text\",\"text\":\"Author the meaning once. Let the system handle the app.\"}")
("ms.sourcery.index.html.n1111", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n1112", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n    \"}")
