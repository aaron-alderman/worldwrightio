("ms.purpose.1", "description", "{\"kind\":\"text\",\"text\":\"A foundation for\"}")
("ms.purpose.2", "description", "{\"kind\":\"element\",\"tag\":\"br\",\"attributes\":[],\"children\":[]}")
("ms.purpose.4", "description", "{\"kind\":\"text\",\"text\":\"accountable change.\"}")
("ms.purpose.3", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"soft\"}],\"children\":[\"ms.purpose.4\"]}")
("ms.purpose.5", "description", "{\"kind\":\"text\",\"text\":\"Temple is a small execution kernel: software that checks proposed changes against explicit rules and authority, then records acceptance or refusal. Its philosophy is that power should remain answerable to the people and commitments it affects.\"}")
("ms.purpose.6", "description", "{\"kind\":\"text\",\"text\":\"The lamp and gate below illustrate proposals, permissions and a history that can be checked for tampering. They are educational models, not a production security guarantee. \"}")
("ms.purpose.8", "description", "{\"kind\":\"text\",\"text\":\"Watch the speculative film.\"}")
("ms.purpose.7", "description", "{\"kind\":\"element\",\"tag\":\"a\",\"attributes\":[{\"name\":\"href\",\"value\":\"films/\"}],\"children\":[\"ms.purpose.8\"]}")
("ms.purpose.9", "description", "{\"kind\":\"text\",\"text\":\"Sourcery · Software creation with accountable change\"}")
("ms.purpose.10", "description", "{\"kind\":\"text\",\"text\":\"Software that\"}")
("ms.purpose.11", "description", "{\"kind\":\"element\",\"tag\":\"br\",\"attributes\":[],\"children\":[]}")
("ms.purpose.13", "description", "{\"kind\":\"text\",\"text\":\"shows its work.\"}")
("ms.purpose.12", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"t-the\"}],\"children\":[\"ms.purpose.13\"]}")
("ms.purpose.14", "description", "{\"kind\":\"text\",\"text\":\"Sourcery creates software from explicit descriptions of meaning, behaviour and permitted change. People and AI propose; declared rules and accountable decisions govern what takes effect. The aim is automation people can understand, question and correct. This microsite illustrates the approach; it is not a general app-building service.\"}")
("ms.purpose.15", "description", "{\"kind\":\"text\",\"text\":\"The Sorcerer’s Apprentice is the fable below: broomsticks illustrate automation, seals illustrate decisions, and a ledger illustrates a checkable history. Or \"}")
("ms.purpose.17", "description", "{\"kind\":\"text\",\"text\":\"watch the moving picture book\"}")
("ms.purpose.16", "description", "{\"kind\":\"element\",\"tag\":\"a\",\"attributes\":[{\"name\":\"href\",\"value\":\"films/\"}],\"children\":[\"ms.purpose.17\"]}")
("ms.purpose.18", "description", "{\"kind\":\"text\",\"text\":\".\"}")
("ms.purpose.19", "description", "{\"kind\":\"text\",\"text\":\"Sourcery — Software that shows its work\"}")
("ms.purpose.20", "description", "{\"kind\":\"text\",\"text\":\"A design commitment. The miniature below demonstrates a limited trace; it does not establish coverage across a deployed platform.\"}")
("ms.purpose.21", "description", "{\"kind\":\"text\",\"text\":\"A human-review boundary in Claimipedia’s documented design; this page does not certify every deployment.\"}")
("ms.purpose.22", "description", "{\"kind\":\"text\",\"text\":\"The engineering programme moves application meaning into process algebra. A general-purpose conversation-to-software service is not offered by this page.\"}")
("ms.purpose.23", "description", "{\"kind\":\"text\",\"text\":\"Explore the working Claimipedia microsite: three explicit methods read the same fictional evidence.\"}")
("ms.purpose.24", "description", "{\"kind\":\"text\",\"text\":\"The Temple miniature retains accepted and refused attempts. Broader appeal and repair mechanisms remain implementation work.\"}")
("ms.purpose.25", "description", "{\"kind\":\"text\",\"text\":\"Explore Temple for governed change, Claimipedia for evidence and disagreement, or the corpus reading paths for the engineering notes. This microsite does not collect sign-ups or deploy an application for you.\"}")
("ms.purpose.27", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia\"}")
("ms.purpose.26", "description", "{\"kind\":\"element\",\"tag\":\"strong\",\"attributes\":[],\"children\":[\"ms.purpose.27\"]}")
("ms.purpose.28", "description", "{\"kind\":\"text\",\"text\":\" keeps claims, evidence and review methods distinct. A claim has a stable identity and version. A method states which evidence counts, how it is weighed and what is enough to decide. The working microsite illustrates how the same evidence can produce different conclusions, with the reasons visible.\"}")
("ms.purpose.29", "description", "{\"kind\":\"text\",\"text\":\"Where it stands: this edition runs the story’s bounded examples through process algebra. The wider Sourcery engineering programme is a staged migration of platform and application meaning into algebra-owned sources. The examples do not establish production readiness, an independent security audit or completion of that migration.\"}")
("ms.purpose.30", "description", "{\"kind\":\"text\",\"text\":\"The wider ambition is software authored through conversation, with meaning, permission and change made explicit. Here, the broomstick exercise illustrates a proposal and decision; it does not build or deploy a real app.\"}")

