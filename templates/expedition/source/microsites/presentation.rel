("ms.temple.index.html.n345", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"judgment-title\"}],\"children\":[\"ms.temple.index.html.n346\"]}")
("ms.temple.index.html.n346", "description", "{\"kind\":\"text\",\"text\":\"One sentence of law.\"}")
("ms.temple.index.html.n347", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n348", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"scene-lead\"}],\"children\":[\"ms.temple.index.html.n349\"]}")
("ms.temple.index.html.n349", "description", "{\"kind\":\"text\",\"text\":\"Temple answers with a single judgment. Every change in a Temple must satisfy it — no exceptions, no side doors.\"}")
