("ms.temple.index.html.n1213", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"coda\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1214\"]}")
("ms.temple.index.html.n1214", "description", "{\"kind\":\"text\",\"text\":\"The project is not fundamentally about making AI more powerful. It is about ensuring that increasing power does not require decreasing human intelligibility, plurality, responsibility, or capacity for correction.\"}")
("ms.temple.index.html.n1215", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1216", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n1217", "description", "{\"kind\":\"comment\",\"text\":\" X · What stands on it \"}")
("ms.temple.index.html.n1218", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1219", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"built\"},{\"name\":\"class\",\"value\":\"scene-text built\"},{\"name\":\"aria-labelledby\",\"value\":\"built-title\"}],\"children\":[\"ms.temple.index.html.n1220\",\"ms.temple.index.html.n1221\",\"ms.temple.index.html.n1223\",\"ms.temple.index.html.n1224\",\"ms.temple.index.html.n1226\",\"ms.temple.index.html.n1227\",\"ms.temple.index.html.n1237\",\"ms.temple.index.html.n1238\",\"ms.temple.index.html.n1293\"]}")
("ms.temple.index.html.n1220", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1221", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"eyebrow\"}],\"children\":[\"ms.temple.index.html.n1222\"]}")
("ms.temple.index.html.n1222", "description", "{\"kind\":\"text\",\"text\":\"X · What stands on it\"}")
("ms.temple.index.html.n1223", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1224", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"built-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1225\"]}")
("ms.temple.index.html.n1225", "description", "{\"kind\":\"text\",\"text\":\"The workshop and the library.\"}")
("ms.temple.index.html.n1226", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1227", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body-wide stack\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1228\",\"ms.temple.index.html.n1230\",\"ms.temple.index.html.n1231\",\"ms.temple.index.html.n1233\",\"ms.temple.index.html.n1234\",\"ms.temple.index.html.n1236\"]}")
("ms.temple.index.html.n1228", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1229\"]}")
("ms.temple.index.html.n1229", "description", "{\"kind\":\"text\",\"text\":\"Temple\"}")
("ms.temple.index.html.n1230", "description", "{\"kind\":\"text\",\"text\":\" makes explicit meaning executable. \"}")
("ms.temple.index.html.n1231", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1232\"]}")
("ms.temple.index.html.n1232", "description", "{\"kind\":\"text\",\"text\":\"Sourcery\"}")
("ms.temple.index.html.n1233", "description", "{\"kind\":\"text\",\"text\":\" makes the path from human intention to executable consequence governable. \"}")
("ms.temple.index.html.n1234", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1235\"]}")
("ms.temple.index.html.n1235", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia\"}")
("ms.temple.index.html.n1236", "description", "{\"kind\":\"text\",\"text\":\" makes the epistemic, political, and moral distinctions within that path inspectable.\"}")
("ms.temple.index.html.n1237", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1238", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"cards\"}],\"children\":[\"ms.temple.index.html.n1239\",\"ms.temple.index.html.n1240\",\"ms.temple.index.html.n1257\",\"ms.temple.index.html.n1258\",\"ms.temple.index.html.n1277\",\"ms.temple.index.html.n1278\",\"ms.temple.index.html.n1292\"]}")
("ms.temple.index.html.n1239", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1240", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"card\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1241\",\"ms.temple.index.html.n1242\",\"ms.temple.index.html.n1244\",\"ms.temple.index.html.n1245\",\"ms.temple.index.html.n1247\",\"ms.temple.index.html.n1248\",\"ms.temple.index.html.n1250\",\"ms.temple.index.html.n1251\",\"ms.temple.index.html.n1253\",\"ms.temple.index.html.n1254\",\"ms.temple.index.html.n1256\"]}")
("ms.temple.index.html.n1241", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1242", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-kicker\"}],\"children\":[\"ms.temple.index.html.n1243\"]}")
("ms.temple.index.html.n1243", "description", "{\"kind\":\"text\",\"text\":\"Sourcery · the workshop\"}")
("ms.temple.index.html.n1244", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1245", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n1246\"]}")
("ms.temple.index.html.n1246", "description", "{\"kind\":\"text\",\"text\":\"Say what you need. Keep the receipt.\"}")
("ms.temple.index.html.n1247", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1248", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n1249\"]}")
("ms.temple.index.html.n1249", "description", "{\"kind\":\"text\",\"text\":\"You describe the work in conversation. People and AI emissaries draft, test and propose; nothing becomes real until it passes the gate and someone accountable says yes. Generation is not commitment.\"}")
("ms.temple.index.html.n1250", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1251", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-line\"}],\"children\":[\"ms.temple.index.html.n1252\"]}")
("ms.temple.index.html.n1252", "description", "{\"kind\":\"text\",\"text\":\"“Author the meaning once. Let the system handle the app.”\"}")
("ms.temple.index.html.n1253", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1254", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.temple.index.html.n1255\"]}")
("ms.temple.index.html.n1255", "description", "{\"kind\":\"text\",\"text\":\"AI here is an emissary — capable, attributed, bounded, and never sovereign.\"}")
("ms.temple.index.html.n1256", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1257", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1258", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"card card-soon\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1259\",\"ms.temple.index.html.n1260\",\"ms.temple.index.html.n1264\",\"ms.temple.index.html.n1265\",\"ms.temple.index.html.n1267\",\"ms.temple.index.html.n1268\",\"ms.temple.index.html.n1270\",\"ms.temple.index.html.n1271\",\"ms.temple.index.html.n1273\",\"ms.temple.index.html.n1274\",\"ms.temple.index.html.n1276\"]}")
("ms.temple.index.html.n1259", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1260", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-kicker\"}],\"children\":[\"ms.editorial.temple/index.html.6\"]}")
("ms.temple.index.html.n1261", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia · the library · \"}")
("ms.temple.index.html.n1262", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"soon\"}],\"children\":[\"ms.temple.index.html.n1263\"]}")
("ms.temple.index.html.n1263", "description", "{\"kind\":\"text\",\"text\":\"opening soon\"}")
("ms.temple.index.html.n1264", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1265", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n1266\"]}")
("ms.temple.index.html.n1266", "description", "{\"kind\":\"text\",\"text\":\"Disagreement you can read.\"}")
("ms.temple.index.html.n1267", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1268", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n1269\"]}")
("ms.temple.index.html.n1269", "description", "{\"kind\":\"text\",\"text\":\"Claims judged under stated, versioned review methods — with the reasoning shown. The same evidence can be Accepted under one method, Conflicted under another and Undecided under a third, and you can see exactly why.\"}")
("ms.temple.index.html.n1270", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1271", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-line\"}],\"children\":[\"ms.temple.index.html.n1272\"]}")
("ms.temple.index.html.n1272", "description", "{\"kind\":\"text\",\"text\":\"“The platform does not produce a universal truth score.”\"}")
("ms.temple.index.html.n1273", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1274", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.editorial.temple/index.html.7\"]}")
("ms.temple.index.html.n1275", "description", "{\"kind\":\"text\",\"text\":\"AI contributions arrive as proposals. Only a human reviewer can accept them.\"}")
("ms.temple.index.html.n1276", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1277", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1278", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"card\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1279\",\"ms.temple.index.html.n1280\",\"ms.temple.index.html.n1282\",\"ms.temple.index.html.n1283\",\"ms.temple.index.html.n1285\",\"ms.temple.index.html.n1286\",\"ms.temple.index.html.n1288\",\"ms.temple.index.html.n1289\",\"ms.temple.index.html.n1291\"]}")
("ms.temple.index.html.n1279", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1280", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-kicker\"}],\"children\":[\"ms.temple.index.html.n1281\"]}")
("ms.temple.index.html.n1281", "description", "{\"kind\":\"text\",\"text\":\"For the people who do the work\"}")
("ms.temple.index.html.n1282", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1283", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n1284\"]}")
("ms.temple.index.html.n1284", "description", "{\"kind\":\"text\",\"text\":\"Not a machine that thinks for you.\"}")
("ms.temple.index.html.n1285", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1286", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n1287\"]}")
("ms.temple.index.html.n1287", "description", "{\"kind\":\"text\",\"text\":\"A discipline that lets scientists, stewards, reviewers and whole communities work alongside AI — and still answer for what happens. We suspect it grows new crafts, too: covenant architects, evidence stewards, wardens of emissaries.\"}")
("ms.temple.index.html.n1288", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1289", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"card-line\"}],\"children\":[\"ms.temple.index.html.n1290\"]}")
("ms.temple.index.html.n1290", "description", "{\"kind\":\"text\",\"text\":\"“AI may propose; Temple decides admissibility.”\"}")
("ms.temple.index.html.n1291", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1292", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1293", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1294", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n1295", "description", "{\"kind\":\"comment\",\"text\":\" XI · The ledger \"}")
("ms.temple.index.html.n1296", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n1297", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"ledger\"},{\"name\":\"class\",\"value\":\"scene-text ledger\"},{\"name\":\"aria-labelledby\",\"value\":\"ledger-title\"}],\"children\":[\"ms.temple.index.html.n1298\",\"ms.temple.index.html.n1299\",\"ms.temple.index.html.n1301\",\"ms.temple.index.html.n1302\",\"ms.temple.index.html.n1304\",\"ms.temple.index.html.n1305\",\"ms.temple.index.html.n1384\"]}")
("ms.temple.index.html.n1298", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1299", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"eyebrow\"}],\"children\":[\"ms.temple.index.html.n1300\"]}")
("ms.temple.index.html.n1300", "description", "{\"kind\":\"text\",\"text\":\"XI · The ledger\"}")
("ms.temple.index.html.n1301", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1302", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ledger-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1303\"]}")
("ms.temple.index.html.n1303", "description", "{\"kind\":\"text\",\"text\":\"Where it stands, honestly.\"}")
("ms.temple.index.html.n1304", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1305", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"ledger-grid\"}],\"children\":[\"ms.temple.index.html.n1306\",\"ms.temple.index.html.n1307\",\"ms.temple.index.html.n1343\",\"ms.temple.index.html.n1344\",\"ms.temple.index.html.n1383\"]}")
("ms.temple.index.html.n1306", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1307", "description", "{\"kind\":\"element\",\"tag\":\"ul\",\"attributes\":[{\"name\":\"class\",\"value\":\"status\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1308\",\"ms.temple.index.html.n1309\",\"ms.temple.index.html.n1313\",\"ms.temple.index.html.n1314\",\"ms.temple.index.html.n1318\",\"ms.temple.index.html.n1319\",\"ms.temple.index.html.n1323\",\"ms.temple.index.html.n1324\",\"ms.temple.index.html.n1328\",\"ms.temple.index.html.n1329\",\"ms.temple.index.html.n1333\",\"ms.temple.index.html.n1334\",\"ms.temple.index.html.n1338\",\"ms.temple.index.html.n1339\",\"ms.temple.index.html.n1342\"]}")
("ms.temple.index.html.n1308", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1309", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.8\",\"ms.editorial.temple/index.html.10\"]}")
("ms.temple.index.html.n1310", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1311\"]}")
("ms.temple.index.html.n1311", "description", "{\"kind\":\"text\",\"text\":\"Temple3 is a v0.1 laboratory.\"}")
("ms.temple.index.html.n1312", "description", "{\"kind\":\"text\",\"text\":\" It is not a production system, and it has not been independently audited.\"}")
("ms.temple.index.html.n1313", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1314", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.11\",\"ms.editorial.temple/index.html.13\"]}")
("ms.temple.index.html.n1315", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1316\"]}")
("ms.temple.index.html.n1316", "description", "{\"kind\":\"text\",\"text\":\"101 of 101 checks\"}")
("ms.temple.index.html.n1317", "description", "{\"kind\":\"text\",\"text\":\" passed in its latest integrated qualification run.\"}")
("ms.temple.index.html.n1318", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1319", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.14\",\"ms.editorial.temple/index.html.16\"]}")
("ms.temple.index.html.n1320", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1321\"]}")
("ms.temple.index.html.n1321", "description", "{\"kind\":\"text\",\"text\":\"Three implementations\"}")
("ms.temple.index.html.n1322", "description", "{\"kind\":\"text\",\"text\":\" — a JavaScript model, a Python verifier and a Rust library — are cross-checked on shared vectors. They share design lineage, so correlated mistakes remain possible.\"}")
("ms.temple.index.html.n1323", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1324", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.17\",\"ms.editorial.temple/index.html.19\"]}")
("ms.temple.index.html.n1325", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1326\"]}")
("ms.temple.index.html.n1326", "description", "{\"kind\":\"text\",\"text\":\"486 hostile cases\"}")
("ms.temple.index.html.n1327", "description", "{\"kind\":\"text\",\"text\":\" in a differential corpus surfaced 26 semantic mismatches between them. After repair: zero.\"}")
("ms.temple.index.html.n1328", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1329", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.20\",\"ms.editorial.temple/index.html.22\"]}")
("ms.temple.index.html.n1330", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1331\"]}")
("ms.temple.index.html.n1331", "description", "{\"kind\":\"text\",\"text\":\"Two Temples\"}")
("ms.temple.index.html.n1332", "description", "{\"kind\":\"text\",\"text\":\" have federated in the lab. Networking, key rotation, encryption and zero-knowledge proofs are not built.\"}")
("ms.temple.index.html.n1333", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1334", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.editorial.temple/index.html.23\",\"ms.editorial.temple/index.html.25\"]}")
("ms.temple.index.html.n1335", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1336\"]}")
("ms.temple.index.html.n1336", "description", "{\"kind\":\"text\",\"text\":\"Today\"}")
("ms.temple.index.html.n1337", "description", "{\"kind\":\"text\",\"text\":\", Sourcery and Claimipedia run on Temple2 — the fact runtime Temple3 learns from.\"}")
("ms.temple.index.html.n1338", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1339", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n1340\"]}")
("ms.temple.index.html.n1340", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n1341\"]}")
("ms.temple.index.html.n1341", "description", "{\"kind\":\"text\",\"text\":\"The Ark is not yet sealed.\"}")
("ms.temple.index.html.n1342", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1343", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n1344", "description", "{\"kind\":\"element\",\"tag\":\"table\",\"attributes\":[{\"name\":\"class\",\"value\":\"promises\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n1345\",\"ms.temple.index.html.n1346\",\"ms.temple.index.html.n1348\",\"ms.temple.index.html.n1349\",\"ms.temple.index.html.n1355\",\"ms.temple.index.html.n1356\",\"ms.temple.index.html.n1382\"]}")
("ms.temple.index.html.n1345", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n1346", "description", "{\"kind\":\"element\",\"tag\":\"caption\",\"children\":[\"ms.temple.index.html.n1347\"]}")
("ms.temple.index.html.n1347", "description", "{\"kind\":\"text\",\"text\":\"Four promises, and how far they have come\"}")
("ms.temple.index.html.n1348", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
