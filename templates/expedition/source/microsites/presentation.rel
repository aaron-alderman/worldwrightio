("ms.temple.index.html.n1372", "description", "{\"kind\":\"text\",\"text\":\"Communities keep their own laws and still cooperate.\"}")
("ms.temple.index.html.n1373", "description", "{\"kind\":\"element\",\"tag\":\"td\",\"children\":[\"ms.temple.index.html.n1374\"]}")
("ms.temple.index.html.n1374", "description", "{\"kind\":\"text\",\"text\":\"A two-Temple laboratory demonstration.\"}")
("ms.temple.index.html.n1375", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n1376", "description", "{\"kind\":\"element\",\"tag\":\"tr\",\"children\":[\"ms.temple.index.html.n1377\",\"ms.temple.index.html.n1379\"]}")
