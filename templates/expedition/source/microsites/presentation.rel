("ms.sourcery.index.html.n951", "description", "{\"kind\":\"text\",\"text\":\"Chapter IV\"}")
("ms.sourcery.index.html.n952", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n953", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch4-title\"}],\"children\":[\"ms.sourcery.index.html.n954\"]}")
("ms.sourcery.index.html.n954", "description", "{\"kind\":\"text\",\"text\":\"Brooms as Emissaries\"}")
("ms.sourcery.index.html.n955", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n956", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n957", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"prose prose--center\"}],\"children\":[\"ms.sourcery.index.html.n958\",\"ms.sourcery.index.html.n959\",\"ms.sourcery.index.html.n964\",\"ms.sourcery.index.html.n965\",\"ms.sourcery.index.html.n967\"]}")
("ms.sourcery.index.html.n958", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n959", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"opening\"}],\"children\":[\"ms.sourcery.index.html.n960\",\"ms.sourcery.index.html.n961\",\"ms.sourcery.index.html.n963\"]}")
("ms.sourcery.index.html.n960", "description", "{\"kind\":\"text\",\"text\":\"The brooms stayed. Of course they did: they were far too useful. But they stopped being servants of a spell nobody could read, and became \"}")
("ms.sourcery.index.html.n961", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n962\"]}")
("ms.sourcery.index.html.n962", "description", "{\"kind\":\"text\",\"text\":\"emissaries\"}")
("ms.sourcery.index.html.n963", "description", "{\"kind\":\"text\",\"text\":\": capable, tireless and answerable.\"}")
("ms.sourcery.index.html.n964", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.sourcery.index.html.n965", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.sourcery.index.html.n966\"]}")
("ms.sourcery.index.html.n966", "description", "{\"kind\":\"text\",\"text\":\"Every broom now carries a slip.\"}")
("ms.sourcery.index.html.n967", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
("ms.sourcery.index.html.n968", "description", "{\"kind\":\"text\",\"text\":\"\\n    \"}")
