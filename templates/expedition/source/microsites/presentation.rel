("ms.temple.index.html.n552", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"children\":[\"ms.temple.index.html.n553\",\"ms.temple.index.html.n554\",\"ms.temple.index.html.n556\",\"ms.temple.index.html.n557\",\"ms.temple.index.html.n559\",\"ms.temple.index.html.n560\",\"ms.temple.index.html.n562\",\"ms.temple.index.html.n563\",\"ms.temple.index.html.n575\",\"ms.temple.index.html.n576\",\"ms.temple.index.html.n578\"]}")
("ms.temple.index.html.n553", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n554", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"eyebrow\"}],\"children\":[\"ms.temple.index.html.n555\"]}")
("ms.temple.index.html.n555", "description", "{\"kind\":\"text\",\"text\":\"IV · The Ark and the covenant\"}")
("ms.temple.index.html.n556", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n557", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"ark-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n558\"]}")
("ms.temple.index.html.n558", "description", "{\"kind\":\"text\",\"text\":\"Universal law. Local law. Only ever narrower.\"}")
("ms.temple.index.html.n559", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n560", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n561\"]}")
("ms.temple.index.html.n561", "description", "{\"kind\":\"text\",\"text\":\"The Ark defines the universal transition boundary. A Temple’s covenant defines its local permitted relation.\"}")
("ms.temple.index.html.n562", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n563", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"formula\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n564\",\"ms.temple.index.html.n566\",\"ms.temple.index.html.n567\",\"ms.temple.index.html.n569\",\"ms.temple.index.html.n570\",\"ms.temple.index.html.n572\",\"ms.temple.index.html.n573\"]}")
("ms.temple.index.html.n564", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.temple.index.html.n565\"]}")
("ms.temple.index.html.n565", "description", "{\"kind\":\"text\",\"text\":\"effective validity\"}")
("ms.temple.index.html.n566", "description", "{\"kind\":\"text\",\"text\":\" = \"}")
("ms.temple.index.html.n567", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.temple.index.html.n568\"]}")
("ms.temple.index.html.n568", "description", "{\"kind\":\"text\",\"text\":\"Ark validity\"}")
("ms.temple.index.html.n569", "description", "{\"kind\":\"text\",\"text\":\" \"}")
("ms.temple.index.html.n570", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.index.html.n571\"]}")
("ms.temple.index.html.n571", "description", "{\"kind\":\"text\",\"text\":\"and\"}")
("ms.temple.index.html.n572", "description", "{\"kind\":\"text\",\"text\":\" \"}")
("ms.temple.index.html.n573", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"children\":[\"ms.temple.index.html.n574\"]}")
("ms.temple.index.html.n574", "description", "{\"kind\":\"text\",\"text\":\"covenant validity\"}")
("ms.temple.index.html.n575", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n576", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"body\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n577\"]}")
("ms.temple.index.html.n577", "description", "{\"kind\":\"text\",\"text\":\"So a covenant can be as particular as its community needs — a laboratory, a guild, a council, a family business — and still never grant what the Ark forbids.\"}")
("ms.temple.index.html.n578", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n579", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n580", "description", "{\"kind\":\"element\",\"tag\":\"svg\",\"attributes\":[{\"name\":\"class\",\"value\":\"ark-svg\"},{\"name\":\"viewBox\",\"value\":\"0 0 640 540\"},{\"name\":\"role\",\"value\":\"img\"},{\"name\":\"aria-labelledby\",\"value\":\"ark-svg-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n581\",\"ms.temple.index.html.n582\",\"ms.temple.index.html.n584\",\"ms.temple.index.html.n585\",\"ms.temple.index.html.n606\",\"ms.temple.index.html.n607\",\"ms.temple.index.html.n608\",\"ms.temple.index.html.n609\",\"ms.temple.index.html.n612\",\"ms.temple.index.html.n613\",\"ms.temple.index.html.n617\",\"ms.temple.index.html.n618\",\"ms.temple.index.html.n625\",\"ms.temple.index.html.n626\",\"ms.temple.index.html.n628\",\"ms.temple.index.html.n629\",\"ms.temple.index.html.n631\",\"ms.temple.index.html.n632\",\"ms.temple.index.html.n634\",\"ms.temple.index.html.n635\",\"ms.temple.index.html.n637\"]}")
("ms.temple.index.html.n581", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n582", "description", "{\"kind\":\"element\",\"tag\":\"title\",\"attributes\":[{\"name\":\"id\",\"value\":\"ark-svg-title\"}],\"children\":[\"ms.temple.index.html.n583\"]}")
("ms.temple.index.html.n583", "description", "{\"kind\":\"text\",\"text\":\"A great circle, the Ark, encloses every permitted transition. A covenant is drawn inside it; where it reaches past the Ark, it fades to a dashed outline that grants nothing.\"}")
("ms.temple.index.html.n584", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n585", "description", "{\"kind\":\"element\",\"tag\":\"defs\",\"children\":[\"ms.temple.index.html.n586\",\"ms.temple.index.html.n587\",\"ms.temple.index.html.n589\",\"ms.temple.index.html.n590\",\"ms.temple.index.html.n596\",\"ms.temple.index.html.n597\",\"ms.temple.index.html.n603\",\"ms.temple.index.html.n604\",\"ms.temple.index.html.n605\"]}")
