("ms.temple.index.html.n677", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"tablet\"},{\"name\":\"aria-label\",\"value\":\"Commandments one to five\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n678\",\"ms.temple.index.html.n679\",\"ms.temple.index.html.n721\"]}")
("ms.temple.index.html.n678", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n679", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"children\":[\"ms.temple.index.html.n680\",\"ms.temple.index.html.n681\",\"ms.temple.index.html.n688\",\"ms.temple.index.html.n689\",\"ms.temple.index.html.n696\",\"ms.temple.index.html.n697\",\"ms.temple.index.html.n704\",\"ms.temple.index.html.n705\",\"ms.temple.index.html.n712\",\"ms.temple.index.html.n713\",\"ms.temple.index.html.n720\"]}")
("ms.temple.index.html.n680", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n681", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n682\",\"ms.temple.index.html.n684\",\"ms.temple.index.html.n686\"]}")
("ms.temple.index.html.n682", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n683\"]}")
("ms.temple.index.html.n683", "description", "{\"kind\":\"text\",\"text\":\"I\"}")
("ms.temple.index.html.n684", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n685\"]}")
("ms.temple.index.html.n685", "description", "{\"kind\":\"text\",\"text\":\"No implicit authority.\"}")
("ms.temple.index.html.n686", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n687\"]}")
("ms.temple.index.html.n687", "description", "{\"kind\":\"text\",\"text\":\"Identity, possession, capability, computation, custody and knowledge do not themselves authorize mutation.\"}")
("ms.temple.index.html.n688", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n689", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n690\",\"ms.temple.index.html.n692\",\"ms.temple.index.html.n694\"]}")
("ms.temple.index.html.n690", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n691\"]}")
("ms.temple.index.html.n691", "description", "{\"kind\":\"text\",\"text\":\"II\"}")
("ms.temple.index.html.n692", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n693\"]}")
("ms.temple.index.html.n693", "description", "{\"kind\":\"text\",\"text\":\"No absolute local policy.\"}")
("ms.temple.index.html.n694", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n695\"]}")
("ms.temple.index.html.n695", "description", "{\"kind\":\"text\",\"text\":\"A Temple predicate may narrow the Ark’s permitted relation but cannot widen it.\"}")
("ms.temple.index.html.n696", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n697", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n698\",\"ms.temple.index.html.n700\",\"ms.temple.index.html.n702\"]}")
("ms.temple.index.html.n698", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n699\"]}")
("ms.temple.index.html.n699", "description", "{\"kind\":\"text\",\"text\":\"III\"}")
("ms.temple.index.html.n700", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n701\"]}")
("ms.temple.index.html.n701", "description", "{\"kind\":\"text\",\"text\":\"No hidden mutation.\"}")
("ms.temple.index.html.n702", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n703\"]}")
("ms.temple.index.html.n703", "description", "{\"kind\":\"text\",\"text\":\"Every proposed change is represented by a finite, canonical delta against an identified initial state.\"}")
("ms.temple.index.html.n704", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n705", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n706\",\"ms.temple.index.html.n708\",\"ms.temple.index.html.n710\"]}")
("ms.temple.index.html.n706", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n707\"]}")
("ms.temple.index.html.n707", "description", "{\"kind\":\"text\",\"text\":\"IV\"}")
("ms.temple.index.html.n708", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n709\"]}")
("ms.temple.index.html.n709", "description", "{\"kind\":\"text\",\"text\":\"No ambient context.\"}")
("ms.temple.index.html.n710", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n711\"]}")
("ms.temple.index.html.n711", "description", "{\"kind\":\"text\",\"text\":\"Every semantic input visible during judgment is contained in a canonical, bounded context.\"}")
("ms.temple.index.html.n712", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n713", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n714\",\"ms.temple.index.html.n716\",\"ms.temple.index.html.n718\"]}")
("ms.temple.index.html.n714", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n715\"]}")
("ms.temple.index.html.n715", "description", "{\"kind\":\"text\",\"text\":\"V\"}")
("ms.temple.index.html.n716", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n717\"]}")
("ms.temple.index.html.n717", "description", "{\"kind\":\"text\",\"text\":\"No executable mutation authority.\"}")
("ms.temple.index.html.n718", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n719\"]}")
("ms.temple.index.html.n719", "description", "{\"kind\":\"text\",\"text\":\"Programs may construct proposals; only the fixed state algebra applies them.\"}")
("ms.temple.index.html.n720", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n721", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n722", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n723", "description", "{\"kind\":\"element\",\"tag\":\"article\",\"attributes\":[{\"name\":\"class\",\"value\":\"tablet\"},{\"name\":\"aria-label\",\"value\":\"Commandments six to ten\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n724\",\"ms.temple.index.html.n725\",\"ms.temple.index.html.n767\"]}")
("ms.temple.index.html.n724", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n725", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"attributes\":[{\"name\":\"start\",\"value\":\"6\"}],\"children\":[\"ms.temple.index.html.n726\",\"ms.temple.index.html.n727\",\"ms.temple.index.html.n734\",\"ms.temple.index.html.n735\",\"ms.temple.index.html.n742\",\"ms.temple.index.html.n743\",\"ms.temple.index.html.n750\",\"ms.temple.index.html.n751\",\"ms.temple.index.html.n758\",\"ms.temple.index.html.n759\",\"ms.temple.index.html.n766\"]}")
("ms.temple.index.html.n726", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n727", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n728\",\"ms.temple.index.html.n730\",\"ms.temple.index.html.n732\"]}")
("ms.temple.index.html.n728", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n729\"]}")
("ms.temple.index.html.n729", "description", "{\"kind\":\"text\",\"text\":\"VI\"}")
("ms.temple.index.html.n730", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n731\"]}")
("ms.temple.index.html.n731", "description", "{\"kind\":\"text\",\"text\":\"No self-enlargement during judgment.\"}")
("ms.temple.index.html.n732", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n733\"]}")
("ms.temple.index.html.n733", "description", "{\"kind\":\"text\",\"text\":\"The Ark, active predicate, initial state and context are fixed for the complete evaluation.\"}")
("ms.temple.index.html.n734", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n735", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n736\",\"ms.temple.index.html.n738\",\"ms.temple.index.html.n740\"]}")
("ms.temple.index.html.n736", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n737\"]}")
("ms.temple.index.html.n737", "description", "{\"kind\":\"text\",\"text\":\"VII\"}")
("ms.temple.index.html.n738", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n739\"]}")
("ms.temple.index.html.n739", "description", "{\"kind\":\"text\",\"text\":\"No retrospective law.\"}")
("ms.temple.index.html.n740", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n741\"]}")
("ms.temple.index.html.n741", "description", "{\"kind\":\"text\",\"text\":\"A newly admitted predicate becomes active only in the resulting state and cannot authorize its own installation.\"}")
("ms.temple.index.html.n742", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n743", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n744\",\"ms.temple.index.html.n746\",\"ms.temple.index.html.n748\"]}")
("ms.temple.index.html.n744", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n745\"]}")
("ms.temple.index.html.n745", "description", "{\"kind\":\"text\",\"text\":\"VIII\"}")
("ms.temple.index.html.n746", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n747\"]}")
("ms.temple.index.html.n747", "description", "{\"kind\":\"text\",\"text\":\"No silent failure.\"}")
("ms.temple.index.html.n748", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n749\"]}")
("ms.temple.index.html.n749", "description", "{\"kind\":\"text\",\"text\":\"Acceptance, rejection, conflict and unresolved outcomes remain explicit and attributable.\"}")
("ms.temple.index.html.n750", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n751", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n752\",\"ms.temple.index.html.n754\",\"ms.temple.index.html.n756\"]}")
("ms.temple.index.html.n752", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n753\"]}")
("ms.temple.index.html.n753", "description", "{\"kind\":\"text\",\"text\":\"IX\"}")
("ms.temple.index.html.n754", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n755\"]}")
("ms.temple.index.html.n755", "description", "{\"kind\":\"text\",\"text\":\"No unwitnessed continuation.\"}")
("ms.temple.index.html.n756", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n757\"]}")
("ms.temple.index.html.n757", "description", "{\"kind\":\"text\",\"text\":\"Every operative successor binds its Temple, predicate, identity, initial state, delta, context and final state.\"}")
("ms.temple.index.html.n758", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n759", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n760\",\"ms.temple.index.html.n762\",\"ms.temple.index.html.n764\"]}")
("ms.temple.index.html.n760", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"num\"},{\"name\":\"aria-hidden\",\"value\":\"true\"}],\"children\":[\"ms.temple.index.html.n761\"]}")
("ms.temple.index.html.n761", "description", "{\"kind\":\"text\",\"text\":\"X\"}")
("ms.temple.index.html.n762", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n763\"]}")
("ms.temple.index.html.n763", "description", "{\"kind\":\"text\",\"text\":\"No ambient foreign sovereignty.\"}")
("ms.temple.index.html.n764", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n765\"]}")
("ms.temple.index.html.n765", "description", "{\"kind\":\"text\",\"text\":\"A foreign Temple’s witness is bounded context; local consequences still require local admission.\"}")
("ms.temple.index.html.n766", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n767", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n768", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n769", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
