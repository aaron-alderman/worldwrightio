("ms.sourcery.index.html.n1121", "description", "{\"kind\":\"text\",\"text\":\"Cast a spell\"}")
("ms.sourcery.index.html.n1122", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n1123", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"spell-lede\"}],\"children\":[\"ms.sourcery.index.html.n1124\"]}")
("ms.sourcery.index.html.n1124", "description", "{\"kind\":\"text\",\"text\":\"Tell a broom what you need. It will come back with a proposal, not a done deal.\"}")
("ms.sourcery.index.html.n1125", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
