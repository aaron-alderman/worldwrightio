("ms.sourcery.index.html.n1092", "description", "{\"kind\":\"element\",\"tag\":\"header\",\"attributes\":[{\"name\":\"class\",\"value\":\"chapter-head\"}],\"children\":[\"ms.sourcery.index.html.n1093\",\"ms.sourcery.index.html.n1094\",\"ms.sourcery.index.html.n1096\",\"ms.sourcery.index.html.n1097\",\"ms.sourcery.index.html.n1099\"]}")
