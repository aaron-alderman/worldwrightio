("ms.temple.index.html.n633", "description", "{\"kind\":\"text\",\"text\":\"cannot\"}")
("ms.temple.index.html.n634", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n635", "description", "{\"kind\":\"element\",\"tag\":\"text\",\"attributes\":[{\"name\":\"class\",\"value\":\"cov-cannot\"},{\"name\":\"x\",\"value\":\"566\"},{\"name\":\"y\",\"value\":\"272\"}],\"children\":[\"ms.temple.index.html.n636\"]}")
("ms.temple.index.html.n636", "description", "{\"kind\":\"text\",\"text\":\"widen\"}")
("ms.temple.index.html.n637", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n638", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n639", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n640", "description", "{\"kind\":\"element\",\"tag\":\"div\",\"attributes\":[{\"name\":\"class\",\"value\":\"axioms\"}],\"children\":[\"ms.temple.index.html.n641\",\"ms.temple.index.html.n642\",\"ms.temple.index.html.n647\",\"ms.temple.index.html.n648\",\"ms.temple.index.html.n653\",\"ms.temple.index.html.n654\",\"ms.temple.index.html.n659\"]}")
("ms.temple.index.html.n641", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n642", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n643\",\"ms.temple.index.html.n645\"]}")
("ms.temple.index.html.n643", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"children\":[\"ms.temple.index.html.n644\"]}")
("ms.temple.index.html.n644", "description", "{\"kind\":\"text\",\"text\":\"“Preparation is provenance, not authority.”\"}")
("ms.temple.index.html.n645", "description", "{\"kind\":\"element\",\"tag\":\"figcaption\",\"children\":[\"ms.temple.index.html.n646\"]}")
("ms.temple.index.html.n646", "description", "{\"kind\":\"text\",\"text\":\"Whoever prepares a Temple’s founding state holds no power over it afterwards — unless the covenant says so.\"}")
("ms.temple.index.html.n647", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n648", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n649\",\"ms.temple.index.html.n651\"]}")
("ms.temple.index.html.n649", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"children\":[\"ms.temple.index.html.n650\"]}")
("ms.temple.index.html.n650", "description", "{\"kind\":\"text\",\"text\":\"“Information access is authority too.”\"}")
("ms.temple.index.html.n651", "description", "{\"kind\":\"element\",\"tag\":\"figcaption\",\"children\":[\"ms.temple.index.html.n652\"]}")
("ms.temple.index.html.n652", "description", "{\"kind\":\"text\",\"text\":\"A covenant sees only the cells a proposal names. Holding a complete copy never widens what it may inspect.\"}")
("ms.temple.index.html.n653", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n654", "description", "{\"kind\":\"element\",\"tag\":\"figure\",\"attributes\":[{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n655\",\"ms.temple.index.html.n657\"]}")
("ms.temple.index.html.n655", "description", "{\"kind\":\"element\",\"tag\":\"blockquote\",\"children\":[\"ms.temple.index.html.n656\"]}")
("ms.temple.index.html.n656", "description", "{\"kind\":\"text\",\"text\":\"The Ark names no priesthood.\"}")
("ms.temple.index.html.n657", "description", "{\"kind\":\"element\",\"tag\":\"figcaption\",\"children\":[\"ms.temple.index.html.n658\"]}")
("ms.temple.index.html.n658", "description", "{\"kind\":\"text\",\"text\":\"It prescribes no distinguished authority grant, priest, role, membership, consent, quorum, arbitration or succession. Those are choices each Temple writes into its own covenant.\"}")
("ms.temple.index.html.n659", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n660", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n661", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.index.html.n662", "description", "{\"kind\":\"comment\",\"text\":\" V · The commandments \"}")
("ms.temple.index.html.n663", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
