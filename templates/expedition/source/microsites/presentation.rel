("microsite.temple", "configuration", "{\n  \"identities\": [\n    {\n      \"id\": \"steward\",\n      \"label\": \"Steward\",\n      \"note\": \"named in the role cell\"\n    },\n    {\n      \"id\": \"visitor\",\n      \"label\": \"Visitor\",\n      \"note\": \"no grant\"\n    },\n    {\n      \"id\": \"emissary\",\n      \"label\": \"AI emissary\",\n      \"note\": \"acting for the visitor\"\n    }\n  ],\n  \"presets\": [\n    {\n      \"id\": \"tend\",\n      \"title\": \"Tend the lamp\",\n      \"blurb\": \"Burn one measure of oil and light the flame. Names the steward’s role in read.\"\n    },\n    {\n      \"id\": \"tend-unseen\",\n      \"title\": \"Tend the lamp, unseen\",\n      \"blurb\": \"The same change — but the proposal doesn’t name the role cell, so the covenant cannot see who the steward is.\"\n    },\n    {\n      \"id\": \"refill\",\n      \"title\": \"Refill the lamp\",\n      \"blurb\": \"Consume the oil cell and create a fuller one: three more measures.\"\n    },\n    {\n      \"id\": \"take\",\n      \"title\": \"Take the oil\",\n      \"blurb\": \"Consume the oil and create nothing in its place.\"\n    },\n    {\n      \"id\": \"note\",\n      \"title\": \"Leave a note\",\n      \"blurb\": \"Create a new note cell. Creation is open to anyone.\"\n    },\n    {\n      \"id\": \"appoint\",\n      \"title\": \"Appoint yourself steward\",\n      \"blurb\": \"Consume the steward’s role cell and create one naming you.\"\n    },\n    {\n      \"id\": \"amend\",\n      \"title\": \"Amend the covenant\",\n      \"blurb\": \"Propose a successor covenant that lets visitors tend the lamp too.\"\n    },\n    {\n      \"id\": \"amend-beyond\",\n      \"title\": \"Amend beyond the Ark\",\n      \"blurb\": \"Propose a successor covenant nested forty deep. The Ark allows thirty-two.\"\n    }\n  ],\n  \"genesisCells\": [\n    {\n      \"key\": \"lamp.oil\",\n      \"value\": \"3\"\n    },\n    {\n      \"key\": \"lamp.flame\",\n      \"value\": \"unlit\"\n    },\n    {\n      \"key\": \"role.steward\",\n      \"value\": \"steward\"\n    },\n    {\n      \"key\": \"note.1\",\n      \"value\": \"The lamp is kept here.\"\n    }\n  ],\n  \"covenants\": [\n    {\n      \"title\": \"The Covenant of the Lamp\",\n      \"rules\": [\n        {\n          \"name\": \"A\",\n          \"text\": \"Oil moves only by the steward’s hand.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"B\",\n          \"text\": \"Oil never simply vanishes.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"eq\",\n                    \"args\": [\n                      {\n                        \"op\": \"read\",\n                        \"path\": \"create.lamp.oil\"\n                      },\n                      {\n                        \"op\": \"literal\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"C\",\n          \"text\": \"The steward’s role is fixed.\",\n          \"ast\": {\n            \"op\": \"eq\",\n            \"args\": [\n              {\n                \"op\": \"read\",\n                \"path\": \"consume.role.steward\"\n              },\n              {\n                \"op\": \"literal\",\n                \"value\": null\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"D\",\n          \"text\": \"Only the steward may amend the covenant.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"successor\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"ast\": {\n        \"op\": \"all\",\n        \"args\": [\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"eq\",\n                    \"args\": [\n                      {\n                        \"op\": \"read\",\n                        \"path\": \"create.lamp.oil\"\n                      },\n                      {\n                        \"op\": \"literal\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"op\": \"eq\",\n            \"args\": [\n              {\n                \"op\": \"read\",\n                \"path\": \"consume.role.steward\"\n              },\n              {\n                \"op\": \"literal\",\n                \"value\": null\n              }\n            ]\n          },\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"successor\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"title\": \"The Covenant of the Lamp, amended\",\n      \"rules\": [\n        {\n          \"name\": \"A\",\n          \"text\": \"Oil moves by the steward’s hand — or a visitor’s.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": \"visitor\"\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"B\",\n          \"text\": \"Oil never simply vanishes.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"eq\",\n                    \"args\": [\n                      {\n                        \"op\": \"read\",\n                        \"path\": \"create.lamp.oil\"\n                      },\n                      {\n                        \"op\": \"literal\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"C\",\n          \"text\": \"The steward’s role is fixed.\",\n          \"ast\": {\n            \"op\": \"eq\",\n            \"args\": [\n              {\n                \"op\": \"read\",\n                \"path\": \"consume.role.steward\"\n              },\n              {\n                \"op\": \"literal\",\n                \"value\": null\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"D\",\n          \"text\": \"Only the steward may amend the covenant.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"successor\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"ast\": {\n        \"op\": \"all\",\n        \"args\": [\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": \"visitor\"\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"eq\",\n                    \"args\": [\n                      {\n                        \"op\": \"read\",\n                        \"path\": \"create.lamp.oil\"\n                      },\n                      {\n                        \"op\": \"literal\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              }\n            ]\n          },\n          {\n            \"op\": \"eq\",\n            \"args\": [\n              {\n                \"op\": \"read\",\n                \"path\": \"consume.role.steward\"\n              },\n              {\n                \"op\": \"literal\",\n                \"value\": null\n              }\n            ]\n          },\n          {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"successor\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        ]\n      }\n    },\n    {\n      \"title\": \"A covenant nested forty deep\",\n      \"rules\": [\n        {\n          \"name\": \"A\",\n          \"text\": \"Oil moves only by the steward’s hand.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"B\",\n          \"text\": \"Oil never simply vanishes.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"consume.lamp.oil\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"eq\",\n                    \"args\": [\n                      {\n                        \"op\": \"read\",\n                        \"path\": \"create.lamp.oil\"\n                      },\n                      {\n                        \"op\": \"literal\",\n                        \"value\": null\n                      }\n                    ]\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"C\",\n          \"text\": \"The steward’s role is fixed.\",\n          \"ast\": {\n            \"op\": \"eq\",\n            \"args\": [\n              {\n                \"op\": \"read\",\n                \"path\": \"consume.role.steward\"\n              },\n              {\n                \"op\": \"literal\",\n                \"value\": null\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"D\",\n          \"text\": \"Only the steward may amend the covenant.\",\n          \"ast\": {\n            \"op\": \"any\",\n            \"args\": [\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"successor\"\n                  },\n                  {\n                    \"op\": \"literal\",\n                    \"value\": null\n                  }\n                ]\n              },\n              {\n                \"op\": \"eq\",\n                \"args\": [\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"identity\"\n                  },\n                  {\n                    \"op\": \"read\",\n                    \"path\": \"read.role.steward\"\n                  }\n                ]\n              }\n            ]\n          }\n        },\n        {\n          \"name\": \"E\",\n          \"text\": \"Forty nested negations.\",\n          \"ast\": {\n            \"op\": \"not\",\n            \"args\": [\n              {\n                \"op\": \"not\",\n                \"args\": [\n                  {\n                    \"op\": \"not\",\n                    \"args\": [\n                      {\n                        \"op\": \"not\",\n                        \"args\": [\n                          {\n                            \"op\": \"not\",\n                            \"args\": [\n                              {\n                                \"op\": \"not\",\n                                \"args\": [\n                                  {\n                                    \"op\": \"not\",\n                                    \"args\": [\n                                      {\n                                        \"op\": \"not\",\n                                        \"args\": [\n                                          {\n                                            \"op\": \"not\",\n                                            \"args\": [\n                                              {\n                                                \"op\": \"not\",\n                                                \"args\": [\n                                                  {\n                                                    \"op\": \"not\",\n                                                    \"args\": [\n                                                      {\n                                                        \"op\": \"not\",\n                                                        \"args\": [\n                                                          {\n                                                            \"op\": \"not\",\n                                                            \"args\": [\n                                                              {\n                                                                \"op\": \"not\",\n                                                                \"args\": [\n                                                                  {\n                                                                    \"op\": \"not\",\n                                                                    \"args\": [\n                                                                      {\n                                                                        \"op\": \"not\",\n                                                                        \"args\": [\n                                                                          {\n                                                                            \"op\": \"not\",\n                                                                            \"args\": [\n                                                                              {\n                                                                                \"op\": \"not\",\n                                                                                \"args\": [\n                                                                                  {\n                                                                                    \"op\": \"not\",\n                                                                                    \"args\": [\n                                                                                      {\n                                                                                        \"op\": \"not\",\n                                                                                        \"args\": [\n                                                                                          {\n                                                                                            \"op\": \"not\",\n                                                                                            \"args\": [\n                                                                                              {\n        