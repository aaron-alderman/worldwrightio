("ms.temple.index.html.n627", "description", "{\"kind\":\"text\",\"text\":\"A COVENANT\"}")
("ms.temple.index.html.n628", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n629", "description", "{\"kind\":\"element\",\"tag\":\"text\",\"attributes\":[{\"name\":\"class\",\"value\":\"cov-sub\"},{\"name\":\"x\",\"value\":\"330\"},{\"name\":\"y\",\"value\":\"290\"}],\"children\":[\"ms.temple.index.html.n630\"]}")
("ms.temple.index.html.n630", "description", "{\"kind\":\"text\",\"text\":\"this Temple’s law\"}")
("ms.temple.index.html.n631", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
