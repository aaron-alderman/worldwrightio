("ms.sourcery.index.html.n1194", "description", "{\"kind\":\"text\",\"text\":\"This isn’t only a storybook trick. In one internal demonstration, a blank project and the words \"}")
("ms.sourcery.index.html.n1195", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.sourcery.index.html.n1196\"]}")
("ms.sourcery.index.html.n1196", "description", "{\"kind\":\"text\",\"text\":\"“Build me a timesheet app”\"}")
("ms.sourcery.index.html.n1197", "description", "{\"kind\":\"text\",\"text\":\" became a working app in five parts, every step on the record.\"}")
("ms.sourcery.index.html.n1198", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
