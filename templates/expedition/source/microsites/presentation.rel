("ms.temple.index.html.n400", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n401\"]}")
("ms.temple.index.html.n401", "description", "{\"kind\":\"text\",\"text\":\"P\"}")
("ms.temple.index.html.n402", "description", "{\"kind\":\"text\",\"text\":\", identity \"}")
("ms.temple.index.html.n403", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n404\"]}")
("ms.temple.index.html.n404", "description", "{\"kind\":\"text\",\"text\":\"i\"}")
("ms.temple.index.html.n405", "description", "{\"kind\":\"text\",\"text\":\"’s delta \"}")
("ms.temple.index.html.n406", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n407\"]}")
("ms.temple.index.html.n407", "description", "{\"kind\":\"text\",\"text\":\"d\"}")
("ms.temple.index.html.n408", "description", "{\"kind\":\"text\",\"text\":\" takes state \"}")
("ms.temple.index.html.n409", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n410\"]}")
("ms.temple.index.html.n410", "description", "{\"kind\":\"text\",\"text\":\"S₀\"}")
("ms.temple.index.html.n411", "description", "{\"kind\":\"text\",\"text\":\" to \"}")
("ms.temple.index.html.n412", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n413\"]}")
("ms.temple.index.html.n413", "description", "{\"kind\":\"text\",\"text\":\"S₁\"}")
("ms.temple.index.html.n414", "description", "{\"kind\":\"text\",\"text\":\" — and witness \"}")
("ms.temple.index.html.n415", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n416\"]}")
("ms.temple.index.html.n416", "description", "{\"kind\":\"text\",\"text\":\"W\"}")
("ms.temple.index.html.n417", "description", "{\"kind\":\"text\",\"text\":\" records the judgment.\"}")
("ms.temple.index.html.n418", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n419", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"c\"}],\"children\":[\"ms.temple.index.html.n420\",\"ms.temple.index.html.n424\",\"ms.temple.index.html.n426\"]}")
("ms.temple.index.html.n420", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n421\",\"ms.temple.index.html.n423\"]}")
("ms.temple.index.html.n421", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n422\"]}")
("ms.temple.index.html.n422", "description", "{\"kind\":\"text\",\"text\":\"C\"}")
("ms.temple.index.html.n423", "description", "{\"kind\":\"text\",\"text\":\" — the evidence on the table\"}")
("ms.temple.index.html.n424", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n425\"]}")
("ms.temple.index.html.n425", "description", "{\"kind\":\"text\",\"text\":\"Everything the judgment may consider sits inside one canonical, bounded context: at most 65,536 bytes. Nothing ambient.\"}")
("ms.temple.index.html.n426", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n427\"]}")
("ms.temple.index.html.n427", "description", "{\"kind\":\"text\",\"text\":\"Commandment IV · No ambient context\"}")
("ms.temple.index.html.n428", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n429", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"turn\"}],\"children\":[\"ms.temple.index.html.n430\",\"ms.temple.index.html.n432\"]}")
("ms.temple.index.html.n430", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n431\"]}")
("ms.temple.index.html.n431", "description", "{\"kind\":\"text\",\"text\":\"⊢ — is judged valid\"}")
("ms.temple.index.html.n432", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n433\"]}")
("ms.temple.index.html.n433", "description", "{\"kind\":\"text\",\"text\":\"A total, deterministic decision. The same inputs always yield the same judgment, on any conforming machine.\"}")
("ms.temple.index.html.n434", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n435", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"ark\"}],\"children\":[\"ms.temple.index.html.n436\",\"ms.temple.index.html.n441\",\"ms.temple.index.html.n446\"]}")
("ms.temple.index.html.n436", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n437\",\"ms.temple.index.html.n438\",\"ms.temple.index.html.n440\"]}")
("ms.temple.index.html.n437", "description", "{\"kind\":\"text\",\"text\":\"Ark ∧ \"}")
("ms.temple.index.html.n438", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n439\"]}")
("ms.temple.index.html.n439", "description", "{\"kind\":\"text\",\"text\":\"P\"}")
("ms.temple.index.html.n440", "description", "{\"kind\":\"text\",\"text\":\" — universal law, and local law\"}")
("ms.temple.index.html.n441", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n442\",\"ms.temple.index.html.n443\",\"ms.temple.index.html.n445\"]}")
("ms.temple.index.html.n442", "description", "{\"kind\":\"text\",\"text\":\"Effective validity is Ark validity \"}")
("ms.temple.index.html.n443", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.temple.index.html.n444\"]}")
("ms.temple.index.html.n444", "description", "{\"kind\":\"text\",\"text\":\"and\"}")
("ms.temple.index.html.n445", "description", "{\"kind\":\"text\",\"text\":\" covenant validity. A Temple may narrow the Ark. It can never widen it.\"}")
("ms.temple.index.html.n446", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n447\"]}")
("ms.temple.index.html.n447", "description", "{\"kind\":\"text\",\"text\":\"Commandment II · No absolute local policy\"}")
("ms.temple.index.html.n448", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n449", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"i\"}],\"children\":[\"ms.temple.index.html.n450\",\"ms.temple.index.html.n454\",\"ms.temple.index.html.n456\"]}")
("ms.temple.index.html.n450", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n451\",\"ms.temple.index.html.n453\"]}")
("ms.temple.index.html.n451", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n452\"]}")
("ms.temple.index.html.n452", "description", "{\"kind\":\"text\",\"text\":\"i\"}")
("ms.temple.index.html.n453", "description", "{\"kind\":\"text\",\"text\":\" — who is asking\"}")
("ms.temple.index.html.n454", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n455\"]}")
("ms.temple.index.html.n455", "description", "{\"kind\":\"text\",\"text\":\"An identity bound to a key. “Key possession is necessary for authentication, never sufficient for covenant authorization.”\"}")
("ms.temple.index.html.n456", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n457\"]}")
("ms.temple.index.html.n457", "description", "{\"kind\":\"text\",\"text\":\"Commandment I · No implicit authority\"}")
("ms.temple.index.html.n458", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n459", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"s0\"}],\"children\":[\"ms.temple.index.html.n460\",\"ms.temple.index.html.n464\"]}")
("ms.temple.index.html.n460", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n461\",\"ms.temple.index.html.n463\"]}")
("ms.temple.index.html.n461", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n462\"]}")
("ms.temple.index.html.n462", "description", "{\"kind\":\"text\",\"text\":\"S₀\"}")
("ms.temple.index.html.n463", "description", "{\"kind\":\"text\",\"text\":\" — the exact starting point\"}")
("ms.temple.index.html.n464", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n465\"]}")
("ms.temple.index.html.n465", "description", "{\"kind\":\"text\",\"text\":\"Named by its state root: one fingerprint of everything. Propose against a stale basis and you are refused.\"}")
("ms.temple.index.html.n466", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n467", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"d\"}],\"children\":[\"ms.temple.index.html.n468\",\"ms.temple.index.html.n472\",\"ms.temple.index.html.n482\"]}")
("ms.temple.index.html.n468", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n469\",\"ms.temple.index.html.n471\"]}")
("ms.temple.index.html.n469", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n470\"]}")
("ms.temple.index.html.n470", "description", "{\"kind\":\"text\",\"text\":\"d\"}")
("ms.temple.index.html.n471", "description", "{\"kind\":\"text\",\"text\":\" — an itemized change order\"}")
("ms.temple.index.html.n472", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n473\",\"ms.temple.index.html.n474\",\"ms.temple.index.html.n481\"]}")
("ms.temple.index.html.n473", "description", "{\"kind\":\"text\",\"text\":\"What it reads, what it consumes, what it creates. \"}")
("ms.temple.index.html.n474", "description", "{\"kind\":\"element\",\"tag\":\"span\",\"attributes\":[{\"name\":\"class\",\"value\":\"nowrap\"}],\"children\":[\"ms.temple.index.html.n475\",\"ms.temple.index.html.n477\",\"ms.temple.index.html.n478\",\"ms.temple.index.html.n480\"]}")
("ms.temple.index.html.n475", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n476\"]}")
("ms.temple.index.html.n476", "description", "{\"kind\":\"text\",\"text\":\"S₁\"}")
("ms.temple.index.html.n477", "description", "{\"kind\":\"text\",\"text\":\" = (\"}")
("ms.temple.index.html.n478", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n479\"]}")
("ms.temple.index.html.n479", "description", "{\"kind\":\"text\",\"text\":\"S₀\"}")
("ms.temple.index.html.n480", "description", "{\"kind\":\"text\",\"text\":\" − consume) ∪ create\"}")
("ms.temple.index.html.n481", "description", "{\"kind\":\"text\",\"text\":\". Programs may construct proposals; only the fixed algebra applies them.\"}")
("ms.temple.index.html.n482", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n483\"]}")
("ms.temple.index.html.n483", "description", "{\"kind\":\"text\",\"text\":\"Commandment III · No hidden mutation\"}")
("ms.temple.index.html.n484", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n485", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"w\"}],\"children\":[\"ms.temple.index.html.n486\",\"ms.temple.index.html.n490\",\"ms.temple.index.html.n492\"]}")
("ms.temple.index.html.n486", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n487\",\"ms.temple.index.html.n489\"]}")
("ms.temple.index.html.n487", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n488\"]}")
("ms.temple.index.html.n488", "description", "{\"kind\":\"text\",\"text\":\"W\"}")
("ms.temple.index.html.n489", "description", "{\"kind\":\"text\",\"text\":\" — the witness\"}")
("ms.temple.index.html.n490", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n491\"]}")
("ms.temple.index.html.n491", "description", "{\"kind\":\"text\",\"text\":\"A deterministic receipt binding Temple, predicate, identity, initial state, delta, context and final state. Refusals receive one too — and never advance the state.\"}")
("ms.temple.index.html.n492", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n493\"]}")
("ms.temple.index.html.n493", "description", "{\"kind\":\"text\",\"text\":\"Commandment VIII · No silent failure\"}")
("ms.temple.index.html.n494", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n495", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"s1\"}],\"children\":[\"ms.temple.index.html.n496\",\"ms.temple.index.html.n500\",\"ms.temple.index.html.n502\"]}")
("ms.temple.index.html.n496", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n497\",\"ms.temple.index.html.n499\"]}")
("ms.temple.index.html.n497", "description", "{\"kind\":\"element\",\"tag\":\"i\",\"children\":[\"ms.temple.index.html.n498\"]}")
("ms.temple.index.html.n498", "description", "{\"kind\":\"text\",\"text\":\"S₁\"}")
("ms.temple.index.html.n499", "description", "{\"kind\":\"text\",\"text\":\" — the result\"}")
("ms.temple.index.html.n500", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"children\":[\"ms.temple.index.html.n501\"]}")
("ms.temple.index.html.n501", "description", "{\"kind\":\"text\",\"text\":\"Its root must equal the root the proposal claimed. Anyone holding the rules can recompute it, from genesis onward.\"}")
("ms.temple.index.html.n502", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"ref\"}],\"children\":[\"ms.temple.index.html.n503\"]}")
("ms.temple.index.html.n503", "description", "{\"kind\":\"text\",\"text\":\"Commandment IX · No unwitnessed continuation\"}")
("ms.temple.index.html.n504", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n505", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"attributes\":[{\"name\":\"data-k\",\"value\":\"six\"}],\"children\":[\"ms.temple.index.html.n506\",\"ms.temple.index.html.n508\",\"ms.temple.index.html.n509\",\"ms.temple.index.html.n529\"]}")
("ms.temple.index.html.n506", "description", "{\"kind\":\"element\",\"tag\":\"h3\",\"children\":[\"ms.temple.index.html.n507\"]}")
("ms.temple.index.html.n507", "description", "{\"kind\":\"text\",\"text\":\"Accepted exactly when\"}")
("ms.temple.index.html.n508", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n509", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"attributes\":[{\"name\":\"class\",\"value\":\"six\"}],\"children\":[\"ms.temple.index.html.n510\",\"ms.temple.index.html.n511\",\"ms.temple.index.html.n513\",\"ms.temple.index.html.n514\",\"ms.temple.index.html.n516\",\"ms.temple.index.html.n517\",\"ms.temple.index.html.n519\",\"ms.temple.index.html.n520\",\"ms.temple.index.html.n522\",\"ms.temple.index.html.n523\",\"ms.temple.index.html.n525\",\"ms.temple.index.html.n526\",\"ms.temple.index.html.n528\"]}")
("ms.temple.index.html.n510", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n511", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n512\"]}")
("ms.temple.index.html.n512", "description", "{\"kind\":\"text\",\"text\":\"all inputs are canonical and bounded;\"}")
("ms.temple.index.html.n513", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n514", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n515\"]}")
("ms.temple.index.html.n515", "description", "{\"kind\":\"text\",\"text\":\"the proposal’s basis equals the current state root;\"}")
("ms.temple.index.html.n516", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n517", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n518\"]}")
("ms.temple.index.html.n518", "description", "{\"kind\":\"text\",\"text\":\"the fixed algebra applies the delta;\"}")
("ms.temple.index.html.n519", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n520", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n521\"]}")
("ms.temple.index.html.n521", "description", "{\"kind\":\"text\",\"text\":\"the claimed final root equals the computed root;\"}")
("ms.temple.index.html.n522", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n523", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n524\"]}")
("ms.temple.index.html.n524", "description", "{\"kind\":\"text\",\"text\":\"the active covenant returns true;\"}")
("ms.temple.index.html.n525", "description", "{\"kind\":\"text\",\"text\":\"\\n                \"}")
("ms.temple.index.html.n526", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.index.html.n527\"]}")
("ms.temple.index.html.n527", "description", "{\"kind\":\"text\",\"text\":\"every Ark invariant holds.\"}")
("ms.temple.index.html.n528", "description", "{\"kind\":\"text\",\"text\":\"\\n              \"}")
("ms.temple.index.html.n529", "description", "{\"kind\":\"text\",\"text\":\"\\n            \"}")
("ms.temple.index.html.n530", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.index.html.n531", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
