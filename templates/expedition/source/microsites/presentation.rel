("ms.editorial.temple/index.html.1", "description", "{\"kind\":\"text\",\"text\":\"Temple\"}")
("ms.editorial.temple/films/index.html.2", "description", "{\"kind\":\"text\",\"text\":\"Temple\"}")
("ms.editorial.temple/index.html.3", "description", "{\"kind\":\"text\",\"text\":\"The Covenant · Temple\"}")
("ms.editorial.temple/films/index.html.4", "description", "{\"kind\":\"text\",\"text\":\"The Film · Temple\"}")
("ms.editorial.temple/index.html.5", "description", "{\"kind\":\"text\",\"text\":\"Temple · the foundation\"}")
("ms.editorial.temple/index.html.6", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia · the library\"}")
("ms.editorial.temple/index.html.7", "description", "{\"kind\":\"text\",\"text\":\"Claimipedia’s design treats AI contributions as proposals for human review.\"}")
("ms.editorial.temple/index.html.9", "description", "{\"kind\":\"text\",\"text\":\"This gate is an educational miniature.\"}")
("ms.editorial.temple/index.html.8", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.9\"]}")
("ms.editorial.temple/index.html.10", "description", "{\"kind\":\"text\",\"text\":\" Its witnesses belong to this page; they do not certify a production platform or independently audit Temple.\"}")
("ms.editorial.temple/index.html.12", "description", "{\"kind\":\"text\",\"text\":\"The original laboratory reported qualification checks.\"}")
("ms.editorial.temple/index.html.11", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.12\"]}")
("ms.editorial.temple/index.html.13", "description", "{\"kind\":\"text\",\"text\":\" Those results describe that prototype, rather than the current state of every Temple implementation.\"}")
("ms.editorial.temple/index.html.15", "description", "{\"kind\":\"text\",\"text\":\"The original laboratory compared three implementations\"}")
("ms.editorial.temple/index.html.14", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.15\"]}")
("ms.editorial.temple/index.html.16", "description", "{\"kind\":\"text\",\"text\":\" — JavaScript, Python and Rust. Shared design lineage means correlated mistakes remain possible.\"}")
("ms.editorial.temple/index.html.18", "description", "{\"kind\":\"text\",\"text\":\"Adversarial cases\"}")
("ms.editorial.temple/index.html.17", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.18\"]}")
("ms.editorial.temple/index.html.19", "description", "{\"kind\":\"text\",\"text\":\" were used to compare implementations and expose differences in how they judged the same proposals.\"}")
("ms.editorial.temple/index.html.21", "description", "{\"kind\":\"text\",\"text\":\"An original two-Temple demonstration\"}")
("ms.editorial.temple/index.html.20", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.21\"]}")
("ms.editorial.temple/index.html.22", "description", "{\"kind\":\"text\",\"text\":\" explored federation and recovery. It was a laboratory exercise, not a production networking or security system.\"}")
("ms.editorial.temple/index.html.24", "description", "{\"kind\":\"text\",\"text\":\"This published edition\"}")
("ms.editorial.temple/index.html.23", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"attributes\":[],\"children\":[\"ms.editorial.temple/index.html.24\"]}")
("ms.editorial.temple/index.html.25", "description", "{\"kind\":\"text\",\"text\":\" runs the miniature through process algebra. The wider corpus holds the design notes and implementation history.\"}")
("ms.editorial.temple/index.html.26", "description", "{\"kind\":\"text\",\"text\":\"An explicit human-review boundary in Claimipedia’s documented design.\"}")
("ms.editorial.temple/index.html.27", "description", "{\"kind\":\"text\",\"text\":\"A draft public-good charter in the source material; this page does not establish its adoption.\"}")
("ms.editorial.temple/index.html.28", "description", "{\"kind\":\"text\",\"text\":\"No cameras and no stock footage: a sky computed pixel by pixel, lights that leave trails, the commandments set in type, and a drone synthesised from sine waves. This edition retains the original procedural film and verifies the published files against their captured hashes.\"}")
("ms.editorial.temple/index.html.29", "description", "{\"kind\":\"text\",\"text\":\"Explore the foundation. Follow the evidence.\"}")
("ms.editorial.temple/index.html.30", "description", "{\"kind\":\"text\",\"text\":\"Read the candidate commandments, explore the working miniature, and follow the research in the wider corpus.\"}")
("ms.editorial.temple/index.html.31", "description", "{\"kind\":\"text\",\"text\":\"Where to go next\"}")
("ms.editorial.temple/index.html.32", "description", "{\"kind\":\"text\",\"text\":\"Continue through the \"}")
("ms.editorial.temple/index.html.34", "description", "{\"kind\":\"text\",\"text\":\"corpus gate\"}")
("ms.editorial.temple/index.html.33", "description", "{\"kind\":\"element\",\"tag\":\"a\",\"attributes\":[{\"name\":\"href\",\"value\":\"../gate.html\"}],\"children\":[\"ms.editorial.temple/index.html.34\"]}")
("ms.editorial.temple/index.html.35", "description", "{\"kind\":\"text\",\"text\":\", or explore \"}")
("ms.editorial.temple/index.html.37", "description", "{\"kind\":\"text\",\"text\":\"Sourcery’s story\"}")
("ms.editorial.temple/index.html.36", "description", "{\"kind\":\"element\",\"tag\":\"a\",\"attributes\":[{\"name\":\"href\",\"value\":\"../sourcery/\"}],\"children\":[\"ms.editorial.temple/index.html.37\"]}")
("ms.editorial.temple/index.html.38", "description", "{\"kind\":\"text\",\"text\":\". This page does not collect contact details.\"}")
("ms.editorial.temple/films/index.html.39", "description", "{\"kind\":\"text\",\"text\":\"A trailer rendered entirely from code: a sky computed pixel by pixel, lights that leave trails, the commandments set in type, and a drone synthesised from sine waves and noise. This edition preserves the original film, its captions and its recorded provenance.\"}")
("ms.editorial.temple/films/index.html.40", "description", "{\"kind\":\"text\",\"text\":\"The Covenant · 41 seconds · 1280×720 · retained from the original procedural film.\"}")
("ms.editorial.temple/films/index.html.41", "description", "{\"kind\":\"text\",\"text\":\"The original film was made with a separate rendering pipeline. A choreography file set the scenes, lights, sparks and chimes; Python, ffmpeg and headless Chrome produced the picture and sound. This edition retains the rendered files and their manifest.\"}")
("ms.editorial.temple/films/index.html.42", "description", "{\"kind\":\"text\",\"text\":\"The manifest records the original files and the source hash reported by their rendering pipeline. This edition checks the retained file bytes against the captured hashes. It does not rerun or independently verify that original rendering pipeline.\"}")
("ms.editorial.temple/films/index.html.43", "description", "{\"kind\":\"text\",\"text\":\"A speculative design, retained from the original procedural film. The published media are checked against their captured file hashes.\"}")
("ms.editorial.sourcery/films/index.html.44", "description", "{\"kind\":\"text\",\"text\":\"The original pipeline recorded hashes for its sources and rendered files. This edition preserves the film and checks its published bytes against the captured file hashes; it does not rerun the original rendering pipeline.\"}")
("ms.editorial.temple/index.html.47", "description", "{\"kind\":\"text\",\"text\":\"Corpus gate\"}")
