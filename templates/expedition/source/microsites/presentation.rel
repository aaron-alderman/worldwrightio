("ms.temple.films/index.html.n274", "description", "{\"kind\":\"element\",\"tag\":\"ol\",\"attributes\":[{\"name\":\"class\",\"value\":\"transcript-lines\"}],\"children\":[\"ms.temple.films/index.html.n275\",\"ms.temple.films/index.html.n276\",\"ms.temple.films/index.html.n280\",\"ms.temple.films/index.html.n281\",\"ms.temple.films/index.html.n303\",\"ms.temple.films/index.html.n304\",\"ms.temple.films/index.html.n308\",\"ms.temple.films/index.html.n309\",\"ms.temple.films/index.html.n313\",\"ms.temple.films/index.html.n314\",\"ms.temple.films/index.html.n318\",\"ms.temple.films/index.html.n319\",\"ms.temple.films/index.html.n323\"]}")
("ms.temple.films/index.html.n275", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n276", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n277\",\"ms.temple.films/index.html.n279\"]}")
("ms.temple.films/index.html.n277", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n278\"]}")
("ms.temple.films/index.html.n278", "description", "{\"kind\":\"text\",\"text\":\"The distance.\"}")
("ms.temple.films/index.html.n279", "description", "{\"kind\":\"text\",\"text\":\" Two lights — a sentence and an action — rush together. “The distance between a sentence and a consequential action is shrinking.”\"}")
("ms.temple.films/index.html.n280", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n281", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n282\",\"ms.temple.films/index.html.n284\",\"ms.temple.films/index.html.n285\",\"ms.temple.films/index.html.n287\",\"ms.temple.films/index.html.n288\",\"ms.temple.films/index.html.n290\",\"ms.temple.films/index.html.n291\",\"ms.temple.films/index.html.n293\",\"ms.temple.films/index.html.n294\",\"ms.temple.films/index.html.n296\",\"ms.temple.films/index.html.n297\",\"ms.temple.films/index.html.n299\",\"ms.temple.films/index.html.n300\",\"ms.temple.films/index.html.n302\"]}")
("ms.temple.films/index.html.n282", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n283\"]}")
("ms.temple.films/index.html.n283", "description", "{\"kind\":\"text\",\"text\":\"The quiet substitutions.\"}")
("ms.temple.films/index.html.n284", "description", "{\"kind\":\"text\",\"text\":\" “In ordinary software, meaning slides.” generated \"}")
("ms.temple.films/index.html.n285", "description", "{\"kind\":\"element\",\"tag\":\"s\",\"children\":[\"ms.temple.films/index.html.n286\"]}")
("ms.temple.films/index.html.n286", "description", "{\"kind\":\"text\",\"text\":\"becomes treated as\"}")
("ms.temple.films/index.html.n287", "description", "{\"kind\":\"text\",\"text\":\" \"}")
("ms.temple.films/index.html.n288", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.temple.films/index.html.n289\"]}")
("ms.temple.films/index.html.n289", "description", "{\"kind\":\"text\",\"text\":\"is not\"}")
("ms.temple.films/index.html.n290", "description", "{\"kind\":\"text\",\"text\":\" intended · stored \"}")
("ms.temple.films/index.html.n291", "description", "{\"kind\":\"element\",\"tag\":\"s\",\"children\":[\"ms.temple.films/index.html.n292\"]}")
("ms.temple.films/index.html.n292", "description", "{\"kind\":\"text\",\"text\":\"becomes treated as\"}")
("ms.temple.films/index.html.n293", "description", "{\"kind\":\"text\",\"text\":\" \"}")
("ms.temple.films/index.html.n294", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.temple.films/index.html.n295\"]}")
("ms.temple.films/index.html.n295", "description", "{\"kind\":\"text\",\"text\":\"is not\"}")
("ms.temple.films/index.html.n296", "description", "{\"kind\":\"text\",\"text\":\" true · authorized \"}")
("ms.temple.films/index.html.n297", "description", "{\"kind\":\"element\",\"tag\":\"s\",\"children\":[\"ms.temple.films/index.html.n298\"]}")
("ms.temple.films/index.html.n298", "description", "{\"kind\":\"text\",\"text\":\"becomes treated as\"}")
("ms.temple.films/index.html.n299", "description", "{\"kind\":\"text\",\"text\":\" \"}")
("ms.temple.films/index.html.n300", "description", "{\"kind\":\"element\",\"tag\":\"em\",\"children\":[\"ms.temple.films/index.html.n301\"]}")
("ms.temple.films/index.html.n301", "description", "{\"kind\":\"text\",\"text\":\"is not\"}")
("ms.temple.films/index.html.n302", "description", "{\"kind\":\"text\",\"text\":\" executed.\"}")
("ms.temple.films/index.html.n303", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n304", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n305\",\"ms.temple.films/index.html.n307\"]}")
("ms.temple.films/index.html.n305", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n306\"]}")
("ms.temple.films/index.html.n306", "description", "{\"kind\":\"text\",\"text\":\"One sentence of law.\"}")
("ms.temple.films/index.html.n307", "description", "{\"kind\":\"text\",\"text\":\" The kernel judgment, C ⊢ (Ark ∧ P, i) S₀ —d / W→ S₁. “Every change in a Temple must satisfy it.”\"}")
("ms.temple.films/index.html.n308", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n309", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n310\",\"ms.temple.films/index.html.n312\"]}")
("ms.temple.films/index.html.n310", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n311\"]}")
("ms.temple.films/index.html.n311", "description", "{\"kind\":\"text\",\"text\":\"Ten candidate commandments.\"}")
("ms.temple.films/index.html.n312", "description", "{\"kind\":\"text\",\"text\":\" The two tablets; then “No implicit authority.”, “No hidden mutation.”, “No silent failure.” — and a broken seal: “Candidate Ark commandments · v0.1 · Not yet sealed.”\"}")
("ms.temple.films/index.html.n313", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n314", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n315\",\"ms.temple.films/index.html.n317\"]}")
("ms.temple.films/index.html.n315", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n316\"]}")
("ms.temple.films/index.html.n316", "description", "{\"kind\":\"text\",\"text\":\"Many Temples.\"}")
("ms.temple.films/index.html.n317", "description", "{\"kind\":\"text\",\"text\":\" A constellation of Temples, witnesses travelling between them. “Many Temples. No emperor.” “A foreign witness is bounded evidence — never a command.”\"}")
("ms.temple.films/index.html.n318", "description", "{\"kind\":\"text\",\"text\":\"\\n          \"}")
("ms.temple.films/index.html.n319", "description", "{\"kind\":\"element\",\"tag\":\"li\",\"children\":[\"ms.temple.films/index.html.n320\",\"ms.temple.films/index.html.n322\"]}")
("ms.temple.films/index.html.n320", "description", "{\"kind\":\"element\",\"tag\":\"b\",\"children\":[\"ms.temple.films/index.html.n321\"]}")
("ms.temple.films/index.html.n321", "description", "{\"kind\":\"text\",\"text\":\"Law you can execute.\"}")
("ms.temple.films/index.html.n322", "description", "{\"kind\":\"text\",\"text\":\" The temple, its doorway lit. “Law you can execute. History no one can quietly rewrite.” “The Ark is not yet sealed.”\"}")
("ms.temple.films/index.html.n323", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.films/index.html.n324", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.films/index.html.n325", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"fine\"}],\"children\":[\"ms.temple.films/index.html.n326\"]}")
("ms.temple.films/index.html.n326", "description", "{\"kind\":\"text\",\"text\":\"Temple3 is a v0.1 laboratory and its Ark is unsealed; the film is a speculative trailer, not a product demonstration.\"}")
("ms.temple.films/index.html.n327", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.films/index.html.n328", "description", "{\"kind\":\"text\",\"text\":\"\\n\\n      \"}")
("ms.temple.films/index.html.n329", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"class\",\"value\":\"follow\"},{\"name\":\"aria-labelledby\",\"value\":\"back-title\"}],\"children\":[\"ms.temple.films/index.html.n330\",\"ms.temple.films/index.html.n331\",\"ms.temple.films/index.html.n333\",\"ms.temple.films/index.html.n334\",\"ms.temple.films/index.html.n336\",\"ms.temple.films/index.html.n337\",\"ms.temple.films/index.html.n339\"]}")
("ms.temple.films/index.html.n330", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.films/index.html.n331", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"back-title\"}],\"children\":[\"ms.temple.films/index.html.n332\"]}")
("ms.temple.films/index.html.n332", "description", "{\"kind\":\"text\",\"text\":\"Now try the gate yourself.\"}")
("ms.temple.films/index.html.n333", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.films/index.html.n334", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"lead\"}],\"children\":[\"ms.temple.films/index.html.n335\"]}")
("ms.temple.films/index.html.n335", "description", "{\"kind\":\"text\",\"text\":\"The film shows the judgment. The page lets you stand in front of it.\"}")
("ms.temple.films/index.html.n336", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.films/index.html.n337", "description", "{\"kind\":\"element\",\"tag\":\"a\",\"attributes\":[{\"name\":\"class\",\"value\":\"btn-gold big\"},{\"name\":\"href\",\"value\":\"../index.html#gate\"}],\"children\":[\"ms.temple.films/index.html.n338\"]}")
("ms.temple.films/index.html.n338", "description", "{\"kind\":\"text\",\"text\":\"Try the gate\"}")
("ms.temple.films/index.html.n339", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
