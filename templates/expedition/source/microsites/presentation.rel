("ms.sourcery.index.html.n782", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.sourcery.index.html.n783", "description", "{\"kind\":\"element\",\"tag\":\"title\",\"attributes\":[{\"name\":\"id\",\"value\":\"ch3-art\"}],\"children\":[\"ms.sourcery.index.html.n784\"]}")
("ms.sourcery.index.html.n784", "description", "{\"kind\":\"text\",\"text\":\"The sorcerer stands in a lit doorway above the stairs, holding a book under one arm. Below, the water has stopped rising and the brooms stand still, waiting.\"}")
("ms.sourcery.index.html.n785", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
