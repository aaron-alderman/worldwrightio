("ms.temple.index.html.n166", "description", "{\"kind\":\"comment\",\"text\":\" I · The distance \"}")
("ms.temple.index.html.n167", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
("ms.temple.index.html.n168", "description", "{\"kind\":\"element\",\"tag\":\"section\",\"attributes\":[{\"name\":\"id\",\"value\":\"distance\"},{\"name\":\"class\",\"value\":\"scene-text distance\"},{\"name\":\"aria-labelledby\",\"value\":\"distance-title\"},{\"name\":\"data-progress\",\"value\":\"\"}],\"children\":[\"ms.temple.index.html.n169\",\"ms.temple.index.html.n170\",\"ms.temple.index.html.n172\",\"ms.temple.index.html.n173\",\"ms.temple.index.html.n175\",\"ms.temple.index.html.n176\",\"ms.temple.index.html.n178\",\"ms.temple.index.html.n179\",\"ms.temple.index.html.n199\",\"ms.temple.index.html.n200\",\"ms.temple.index.html.n202\"]}")
("ms.temple.index.html.n169", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
