("ms.temple.index.html.n1435", "description", "{\"kind\":\"text\",\"text\":\"XIII · Follow the Ark\"}")
("ms.temple.index.html.n1436", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1437", "description", "{\"kind\":\"element\",\"tag\":\"h2\",\"attributes\":[{\"name\":\"id\",\"value\":\"follow-title\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.editorial.temple/index.html.29\"]}")
("ms.temple.index.html.n1438", "description", "{\"kind\":\"text\",\"text\":\"The Ark is unsealed. Watch it being sealed.\"}")
("ms.temple.index.html.n1439", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1440", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"lead\"},{\"name\":\"data-reveal\",\"value\":\"\"}],\"children\":[\"ms.editorial.temple/index.html.30\"]}")
("ms.temple.index.html.n1441", "description", "{\"kind\":\"text\",\"text\":\"The commandments are candidates. They will be tested, argued over and, one day, sealed. Follow along — and be there when Claimipedia opens.\"}")
("ms.temple.index.html.n1442", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1443", "description", "{\"kind\":\"element\",\"tag\":\"button\",\"attributes\":[{\"name\":\"type\",\"value\":\"button\"},{\"name\":\"class\",\"value\":\"btn-gold big\"},{\"name\":\"id\",\"value\":\"follow-btn\"},{\"name\":\"aria-controls\",\"value\":\"follow-note\"},{\"name\":\"aria-expanded\",\"value\":\"false\"}],\"children\":[\"ms.editorial.temple/index.html.31\"]}")
("ms.temple.index.html.n1444", "description", "{\"kind\":\"text\",\"text\":\"Follow the Ark\"}")
("ms.temple.index.html.n1445", "description", "{\"kind\":\"text\",\"text\":\"\\n        \"}")
("ms.temple.index.html.n1446", "description", "{\"kind\":\"element\",\"tag\":\"p\",\"attributes\":[{\"name\":\"class\",\"value\":\"follow-note\"},{\"name\":\"id\",\"value\":\"follow-note\"},{\"name\":\"role\",\"value\":\"status\"},{\"name\":\"hidden\",\"value\":\"\"}],\"children\":[\"ms.editorial.temple/index.html.32\",\"ms.editorial.temple/index.html.33\",\"ms.editorial.temple/index.html.35\",\"ms.editorial.temple/index.html.36\",\"ms.editorial.temple/index.html.38\"]}")
("ms.temple.index.html.n1447", "description", "{\"kind\":\"text\",\"text\":\"Thank you. Claimipedia opens soon — this preview doesn’t collect details yet.\"}")
("ms.temple.index.html.n1448", "description", "{\"kind\":\"text\",\"text\":\"\\n      \"}")
