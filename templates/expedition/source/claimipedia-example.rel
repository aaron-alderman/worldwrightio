("claimipedia.example", "configuration", "{\"claim\":\"The North River restoration reduced mean nitrate concentration by at least 15 percent during 2025.\",\"scope\":\"North River monitoring sites; 2025 compared with 2024.\",\"claimVersion\":\"claimVersion.riverNitrate.1\",\"evidence\":[{\"id\":\"evidence.northStudy\",\"name\":\"North laboratory study\",\"evidenceType\":\"Study\",\"direction\":\"Supports\",\"sourceActor\":\"actor.source.labNorth\",\"sourceCredentialed\":\"true\",\"sourceIndependent\":\"true\",\"peerReviewed\":\"true\",\"retracted\":\"false\"},{\"id\":\"evidence.southDataset\",\"name\":\"South laboratory dataset\",\"evidenceType\":\"Dataset\",\"direction\":\"Supports\",\"sourceActor\":\"actor.source.labSouth\",\"sourceCredentialed\":\"false\",\"sourceIndependent\":\"true\",\"peerReviewed\":\"not recorded\",\"retracted\":\"false\"},{\"id\":\"evidence.communityTestimony\",\"name\":\"Community observations\",\"evidenceType\":\"Testimony\",\"direction\":\"Challenges\",\"sourceActor\":\"actor.source.communityPanel\",\"sourceCredentialed\":\"false\",\"sourceIndependent\":\"true\",\"peerReviewed\":\"not recorded\",\"retracted\":\"not recorded\"},{\"id\":\"evidence.retractedStudy\",\"name\":\"Retracted North study\",\"evidenceType\":\"Study\",\"direction\":\"Challenges\",\"sourceActor\":\"actor.source.labNorth\",\"sourceCredentialed\":\"true\",\"sourceIndependent\":\"false\",\"peerReviewed\":\"true\",\"retracted\":\"true\"}],\"methods\":[{\"id\":\"programVersion.credentialReview.1\",\"name\":\"Credentialed studies\",\"summary\":\"Only credentialed studies that have not been retracted count.\",\"threshold\":0.75,\"thresholdUnits\":750000,\"minimum\":1,\"defaultDecision\":\"Excluded\",\"rules\":[{\"id\":\"rule.credential.study\",\"priority\":100,\"weight\":0.8,\"units\":800000,\"reason\":\"The item is a credentialed, non-retracted study.\",\"conditions\":[{\"field\":\"evidenceType\",\"expected\":\"Study\"},{\"field\":\"sourceCredentialed\",\"expected\":\"true\"},{\"field\":\"retracted\",\"expected\":\"false\"}]}]},{\"id\":\"programVersion.equalEvidence.1\",\"name\":\"Equal weight\",\"summary\":\"Every submitted item counts equally, including the retracted study.\",\"threshold\":0.75,\"thresholdUnits\":750000,\"minimum\":1,\"defaultDecision\":\"Unresolved\",\"rules\":[{\"id\":\"rule.equal.all\",\"priority\":10,\"weight\":0.5,\"units\":500000,\"reason\":\"This constitution assigns equal weight to every submitted evidence item.\",\"conditions\":[]}]},{\"id\":\"programVersion.independentSource.1\",\"name\":\"Independent sources\",\"summary\":\"Only independent, peer-reviewed studies and independent datasets count.\",\"threshold\":1.2,\"thresholdUnits\":1200000,\"minimum\":2,\"defaultDecision\":\"Excluded\",\"rules\":[{\"id\":\"rule.independent.study\",\"priority\":100,\"weight\":0.45,\"units\":450000,\"reason\":\"Independent peer-reviewed study passed the non-retraction rule.\",\"conditions\":[{\"field\":\"evidenceType\",\"expected\":\"Study\"},{\"field\":\"sourceIndependent\",\"expected\":\"true\"},{\"field\":\"peerReviewed\",\"expected\":\"true\"},{\"field\":\"retracted\",\"expected\":\"false\"}]},{\"id\":\"rule.independent.dataset\",\"priority\":90,\"weight\":0.45,\"units\":450000,\"reason\":\"Independent dataset passed the source-independence rule.\",\"conditions\":[{\"field\":\"evidenceType\",\"expected\":\"Dataset\"},{\"field\":\"sourceIndependent\",\"expected\":\"true\"}]}]}]}")
