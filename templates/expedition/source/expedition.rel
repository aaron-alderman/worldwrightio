("place.cost.choice.0", "destination", "place.laboratory")
("place.cost.choice.0", "label", "Return to the bench")
("place.cost.choice.0", "kind", "Another way back")
("place.cost", "choice", "place.cost.choice.1")
("place.cost.choice.1", "destination", "place.weights")
("place.cost.choice.1", "label", "Ask who owns the tradeoff")
("place.cost.choice.1", "kind", "Ideas to compare")
("place.cost", "choice", "place.cost.choice.2")
("place.cost.choice.2", "destination", "place.scale")
("place.cost.choice.2", "label", "Change the scale of the account")
("place.cost.choice.2", "kind", "Ideas to compare")
("place.cosmos", "isa", "Place")
("place.cosmos", "slug", "cosmos")
("place.cosmos", "route", "places/cosmos.html")
("place.cosmos", "title", "A larger sky. An unfinished explanation.")
("place.cosmos", "lead", "A big question becomes more useful when we can name what is still missing.")
("place.cosmos", "region", "The unfinished observatory")
("place.cosmos", "chapter", "32")
("place.cosmos", "source", "note.cosmos")
("place.cosmos", "light", "unseen")
("place.cosmos", "paragraph", "Choose a window into gravity, particles or cosmic history. Each shows a different piece of work needed before the explanation can go further.")
("place.cosmos", "paragraph", "The sky is an illustration. These are open research questions, not discoveries already made. They can still help someone choose a calculation or observation worth trying.")
("place.cosmos", "fullParagraph", "The target map includes gravity and torsion, flavour and neutrino structure, joined cosmological likelihoods and continuum control. Each carries a different missing obligation. A shared word or symmetry cannot fill all of them.")
("place.cosmos", "fullParagraph", "Open a window to see the named gate. A gravity route may need new coefficient-selection structure; a cosmological claim needs one model with common parameters across different observations. The map records these boundaries rather than offering a simulated sky as their evidence.")
("place.cosmos", "fullParagraph", "An unfinished observatory can still be useful. It can tell us which calculation, observation or independent check would make a proposal more identifying—and which previously exhausted route should not be repeated without a new datum.")
("place.cosmos", "word", "word.cosmology")
("place.cosmos", "word", "word.model")
("place.cosmos", "pause", "How far does this explanation reach?")
("place.cosmos", "instruction", "Choose a research question. Read what would still be needed to answer it.")
