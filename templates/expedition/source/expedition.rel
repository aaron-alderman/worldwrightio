("place.personal", "isa", "Place")
("place.personal", "slug", "personal")
("place.personal", "route", "places/personal.html")
("place.personal", "title", "I trusted the process.")
("place.personal", "lead", "A passage from Aaron’s own account.")
("place.personal", "region", "Love, separation and trust")
("place.personal", "chapter", "04")
("place.personal", "source", "note.personal")
("place.personal", "light", "human")
("place.personal", "paragraph", "I experienced my children becoming alienated from me. It broke my heart. My marriage suffered, and my wife left.")
("place.personal", "paragraph", "I took kenosis seriously. I trusted the process. Along the way, I had to remember to care. In the intensity of everything, it could become totalizing.")
("place.personal", "fullParagraph", "I experienced my children becoming alienated from me. It broke my heart. My marriage suffered, and my wife left.")
("place.personal", "fullParagraph", "I took kenosis seriously. I trusted the process. Along the way, I had to remember to care. In the intensity of everything, it could become totalizing.")
("place.personal", "word", "word.kenosis")
("place.personal", "word", "word.totalizing")
("place.personal", "personal", "true")
("place.personal", "choice", "place.personal.choice.0")
("place.personal.choice.0", "destination", "place.kenosis")
("place.personal.choice.0", "label", "What did kenosis mean to me?")
("place.personal.choice.0", "kind", "Follow the concept")
("place.personal", "choice", "place.personal.choice.1")
("place.personal.choice.1", "destination", "place.care")
("place.personal.choice.1", "label", "Remember to care")
("place.personal.choice.1", "kind", "Stay with the human question")
("place.personal", "choice", "place.personal.choice.2")
("place.personal.choice.2", "destination", "place.return")
("place.personal.choice.2", "label", "Return to the mathematical trail")
("place.personal.choice.2", "kind", "Another way back")
("place.care", "isa", "Place")
("place.care", "slug", "care")
("place.care", "route", "places/care.html")
("place.care", "title", "Remember to care.")
("place.care", "lead", "Who or what needs my attention here?")
("place.care", "region", "Care")
("place.care", "chapter", "05")
("place.care", "source", "note.personal")
("place.care", "light", "human")
("place.care", "paragraph", "When an idea takes up all our attention, we can lose sight of the people living with its consequences. Who is carrying a cost? What have I stopped noticing?")
("place.care", "paragraph", "Care might mean listening, offering protection, setting a boundary, or changing an explanation. You can stay with the question without having to produce a lesson or an answer.")
("place.care", "fullParagraph", "Who is carrying the cost? What have I stopped noticing?")
("place.care", "fullParagraph", "Care can mean attention, protection, a boundary, or the willingness to revise an explanation. These are questions I am still carrying.")
("place.care", "personal", "true")
("place.care", "choice", "place.care.choice.0")
("place.care.choice.0", "destination", "place.water")
("place.care.choice.0", "label", "Meet a horse with reservations")
("place.care.choice.0", "kind", "Reflective passage")
("place.care", "choice", "place.care.choice.1")
("place.care.choice.1", "destination", "place.contact")
("place.care.choice.1", "label", "When an explanation loses contact")
("place.care.choice.1", "kind", "Ideas to compare")
("place.care", "choice", "place.care.choice.2")
