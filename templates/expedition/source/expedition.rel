("place.instrument", "isa", "Place")
("place.instrument", "slug", "instrument")
("place.instrument", "route", "places/instrument.html")
("place.instrument", "title", "The change can be real. The detector can miss it.")
("place.instrument", "lead", "A measuring tool can miss a change that another tool would reveal.")
("place.instrument", "region", "The instrument")
("place.instrument", "chapter", "03")
("place.instrument", "source", "note.detector")
("place.instrument", "light", "unseen")
("place.instrument", "paragraph", "In the research example, one measurement gives the same answer while part of the mathematical system changes. Measuring several related quantities together can reveal more.")
("place.instrument", "paragraph", "This works only if the measurements reach the changing part and are checked against a known reference. The research includes a computer experiment. A physical device would need its own tests.")
("place.instrument", "fullParagraph", "In the finite corpus example, one measured response stays unchanged while a hidden two-dimensional plane makes a quarter-turn. A calibrated matrix measurement can recover the moving projector.")
("place.instrument", "fullParagraph", "The corpus develops this into a four-mode virtual instrument. Physical acquisition is a separate next step.")
("place.instrument", "word", "word.calibration")
("place.instrument", "word", "word.model")
("place.instrument", "instruction", "Switch between the views. The added reference shows where each signal is in its cycle.")
("place.instrument", "choice", "place.instrument.choice.0")
("place.instrument.choice.0", "destination", "place.calibration")
("place.instrument.choice.0", "label", "Who calibrated the richer view?")
("place.instrument.choice.0", "kind", "Look more closely")
("place.instrument", "choice", "place.instrument.choice.1")
("place.instrument.choice.1", "destination", "place.return")
("place.instrument.choice.1", "label", "Return to the fork")
("place.instrument.choice.1", "kind", "Another way back")
("place.instrument", "choice", "place.instrument.choice.2")
("place.instrument.choice.2", "destination", "place.sourcery")
("place.instrument.choice.2", "label", "How do you preserve what a model knows?")
("place.instrument.choice.2", "kind", "Ideas to compare")
