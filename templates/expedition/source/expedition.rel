("place.observation", "isa", "Place")
("place.observation", "slug", "observation")
("place.observation", "route", "places/observation.html")
("place.observation", "title", "What did the measurement miss?")
("place.observation", "lead", "Two different things can look the same through one kind of measurement.")
("place.observation", "region", "Observation")
("place.observation", "chapter", "01")
("place.observation", "source", "note.frontier")
("place.observation", "light", "unseen")
("place.observation", "paragraph", "Imagine two repeating signals that reach the same height. A measuring tool that keeps only their heights may report the same result, even if the signals rise and fall at different times.")
("place.observation", "paragraph", "Try the two views beside this story. The extra timing reference reveals a difference the first view left out. The drawing explains an idea; it is not a recording from an experiment.")
("place.observation", "fullParagraph", "Sometimes the next discovery begins by preserving a distinction the instrument discarded. More data from the same narrow view may never reveal it.")
("place.observation", "fullParagraph", "Choose a different way of looking. What becomes visible?")
("place.observation", "word", "word.phase")
("place.observation", "word", "word.detector")
("place.observation", "instruction", "Switch between the views. Look for a difference the first view misses.")
("place.observation", "choice", "place.observation.choice.0")
("place.observation.choice.0", "destination", "place.return")
("place.observation.choice.0", "label", "Can something return changed?")
("place.observation.choice.0", "kind", "Follow the research")
("place.observation", "choice", "place.observation.choice.1")
("place.observation.choice.1", "destination", "place.contact")
("place.observation.choice.1", "label", "Does this happen between people?")
("place.observation.choice.1", "kind", "Ideas to compare")
("place.observation", "choice", "place.observation.choice.2")
("place.observation.choice.2", "destination", "place.monster")
("place.observation.choice.2", "label", "What would reveal the Monster?")
("place.observation.choice.2", "kind", "Follow the research")
("place.observation", "choice", "place.observation.choice.3")
