("place.observation.choice.3", "kind", "A path into the wider world")
("place.return", "isa", "Place")
("place.return", "slug", "return")
("place.return", "route", "places/return.html")
("place.return", "title", "Back where you started. Something has changed.")
("place.return", "lead", "You can come back to the same place with something facing a different way.")
("place.return", "region", "The return")
("place.return", "chapter", "02")
("place.return", "source", "note.invariant")
("place.return", "light", "unseen")
("place.return", "paragraph", "Follow the little arrow around the loop. It returns to its starting place, but points in a different direction. The path has left a change that the final location alone does not describe.")
("place.return", "paragraph", "Mathematicians call this kind of change after a closed journey holonomy. The next question is practical: could a measuring tool notice the change? The personal path offers a separate association with change in a life.")
("place.return", "fullParagraph", "Transport around a loop can return a state with a different orientation, even when the local comparison was preserved. The mathematical question is called holonomy.")
("place.return", "fullParagraph", "The next question is practical: would your instrument notice?")
("place.return", "word", "word.holonomy")
("place.return", "instruction", "Choose “Go round the loop.” Watch which way the little arrow points when it comes back.")
