process-module "temple/surface-process-module/1"

process hub.footer.links:
  let input = { tag = "nav"; attrs = { class = "stewardship-links"; "aria-label" = "Licensing and stewardship" }; children = list({ tag = "a"; attrs = { href = "https://github.com/aaron-alderman/worldwrightio/blob/master/LICENSE.md" }; children = list("Licence ↗") }, { tag = "a"; attrs = { href = "https://github.com/aaron-alderman/worldwrightio/blob/master/CHRISTIAN_STEWARDSHIP_COVENANT.md" }; children = list("Christian stewardship covenant ↗") }) }
  call html.serialize

process hub.footer.style:
  let cssPlan = { imports = list(); tokens = list(); rules = list({ id = "footer:has(>.stewardship-links)"; selector = "footer:has(>.stewardship-links)"; context = null; declarations = list({ property = "flex-wrap"; value = "wrap" }) }, { id = "nav.stewardship-links"; selector = "nav.stewardship-links"; context = null; declarations = list({ property = "display"; value = "flex" }, { property = "flex-wrap"; value = "wrap" }, { property = "gap"; value = "8px 24px" }, { property = "flex-basis"; value = "100%" }, { property = "font-size"; value = "12px" }, { property = "width"; value = "100%" }, { property = "box-sizing"; value = "border-box" }) }, { id = "nav.stewardship-links a"; selector = "nav.stewardship-links a"; context = null; declarations = list({ property = "display"; value = "inline-flex" }, { property = "align-items"; value = "center" }, { property = "min-height"; value = "44px" }, { property = "max-width"; value = "100%" }) }, { id = "stewardship.focus"; selector = "nav.stewardship-links a:focus-visible"; context = null; declarations = list({ property = "outline"; value = "2px solid currentColor" }, { property = "outline-offset"; value = "4px" }) }, { id = "stewardship.mobile"; selector = "footer:has(>.stewardship-links)"; context = "(max-width: 650px)"; declarations = list({ property = "grid-template-columns"; value = "minmax(0,1fr)" }, { property = "justify-content"; value = "stretch" }) }) }
  call css.renderPlan
  let input = { tag = "style"; attrs = { "data-owner" = "hub.footer" }; children = list($result) }
  call html.serialize

process hub.footer.project:
  let markup = $input.markup
  let result = $markup
  when not(includes($markup, "class=\"stewardship-links\"")):
    assert includes($markup, "</footer>")
      otherwise "The declared hub document must have a footer."
    call hub.footer.links
    port text.replaceAll { value = $markup; search = "</footer>"; replacement = concat($result, "</footer>") } → markup
    call hub.footer.style
    port text.replaceAll { value = $markup; search = "</head>"; replacement = concat($result, "</head>") } → result
