{
  "protocol": "worldwright/pack/1",
  "id": "activities",
  "title": "Coastal interactions",
  "requires": [
    "core",
    "models"
  ],
  "conflicts": [],
  "modules": [
    "algebra/activities.process.json"
  ],
  "sources": [
    "source/activities.rel"
  ],
  "assets": [
    "assets/activities.css"
  ],
  "build": "activities.build",
  "render": "activities.view",
  "navigation": {
    "label": "Interactions",
    "route": "activities.html"
  },
  "grants": {
    "build": [
      "json.parse",
      "file.write",
