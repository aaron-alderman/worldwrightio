    ],
    "browser": [
      "browser.attribute",
      "browser.class",
      "browser.content",
      "browser.dialog",
      "browser.environment",
      "browser.frame",
      "browser.on",
      "browser.relative",
      "browser.select",
      "browser.style",
      "browser.write",
      "clock.read",
      "dom.exists",
      "json.parse",
      "kernel.invoke",
      "number.calculate",
      "number.format",
      "number.parse",
      "record.entries",
      "record.get",
      "state.get",
      "state.set",
      "storage.write",
      "text.matches",
      "text.replaceAll",
      "value.describe",
      "value.string"
    ]
  },
  "runtime": {
    "entry": "activities.boot",
    "queries": [
      "activities.boot"
    ],
    "profile": "activitiesBrowser",
    "allPages": true
  },
  "outputs": [
    "activities.html",
    "activities-runtime.js"
  ],
  "stylesheets": [
    "assets/activities.css"
  ],
  "files": [
    {
      "source": "README.md",
      "target": "docs/packs/activities.md"
    }
  ]
