{
  "protocol": "worldwright/pack/1",
  "id": "reader",
  "title": "Fieldbook",
  "requires": [
    "core"
  ],
  "conflicts": [],
  "modules": [
    "algebra/reader.process.json"
  ],
  "sources": [],
  "assets": [],
  "build": "reader.build",
  "navigation": {
    "label": "Fieldbook",
    "route": "reader.html"
  },
  "grants": {
    "build": [
      "runtime.bundle"
    ],
    "browser": [
      "dom.exists",
      "dom.on",
      "dom.value",
      "dom.content",
      "state.get",
      "state.set",
      "storage.read",
      "storage.write",
      "storage.remove",
      "dom.attribute",
      "dom.setValue",
      "dom.text",
      "dom.focus",
      "browser.on"
    ]
  },
  "outputs": [
    "reader.html",
    "reader-runtime.js"
  ],
  "render": "reader.view",
  "runtime": {
    "entry": "reader.boot",
    "queries": [
      "reader.boot",
      "reader.search"
    ],
    "profile": "readerBrowser",
    "output": "reader-runtime.js",
    "allPages": true
  },
  "files": [
    {
      "source": "README.md",
      "target": "docs/packs/reader.md"
    }
  ]
}
