{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "media.stream.screens.init": [
      {
        "port": "browser.select",
        "args": {
          "selector": "[data-screen]"
        },
        "into": "screens"
      },
      {
        "each": "$screens",
        "as": "screen",
        "steps": [
          {
            "port": "browser.relative",
            "args": {
              "ref": [
                "at",
                "$screen",
                "ref"
              ],
              "relation": "query",
              "selector": "video"
            },
            "into": "video"
          },
          {
            "when": "$video",
            "then": [
              {
                "port": "browser.relative",
                "args": {
                  "ref": [
                    "at",
                    "$screen",
                    "ref"
                  ],
                  "relation": "query",
                  "selector": "[data-sound]"
                },
                "into": "sound"
              },
              {
                "when": "$sound",
                "then": [
                  {
                    "port": "browser.on",
                    "args": {
                      "ref": [
                        "at",
                        "$sound",
                        "ref"
                      ],
                      "event": "click",
                      "query": "media.stream.sound.toggle",
                      "input": {
                        "video": [
                          "at",
                          "$video",
                          "ref"
                        ],
                        "sound": [
                          "at",
                          "$sound",
                          "ref"
                        ]
                      }
                    },
                    "into": "_"
                  },
                  {
                    "port": "browser.on",
                    "args": {
                      "ref": [
                        "at",
                        "$video",
                        "ref"
                      ],
                      "event": "volumechange",
                      "query": "media.stream.sound.sync",
                      "input": {
                        "video": [
                          "at",
                          "$video",
                          "ref"
                        ],
                        "sound": [
                          "at",
                          "$sound",
                          "ref"
                        ]
                      }
                    },
                    "into": "_"
                  },
                  {
                    "port": "kernel.invoke",
                    "args": {
                      "query": "media.stream.sound.sync",
                      "input": {
                        "video": [
                          "at",
                          "$video",
                          "ref"
                        ],
                        "sound": [
                          "at",
                          "$sound",
                          "ref"
                        ]
                      }
                    },
                    "into": "result"
                  }
                ]
              },
              {
                "port": "browser.relative",
                "args": {
                  "ref": [
                    "at",
                    "$screen",
                    "ref"
                  ],
                  "relation": "parent"
                },
                "into": "parent"
              },
              {
                "port": "browser.relative",
                "args": {
                  "ref": [
                    "at",
                    "$parent",
                    "ref"
                  ],
                  "relation": "query",
                  "selector": ".chapters"
                },
                "into": "chapters"
              },
              {
                "when": "$chapters",
                "then": [
                  {
                    "port": "state.set",
                    "args": {
                      "key": [
                        "concat",
                        "seek.",
                        [
                          "at",
                          [
                            "at",
                            "$video",
                            "ref"
                          ],
                          "handle"
                        ]
                      ],
                      "value": null
                    },
                    "into": "_"
                  },
                  {
                    "port": "browser.on",
                    "args": {
                      "ref": [
                        "at",
                        "$chapters",
                        "ref"
                      ],
                      "event": "click",
                      "query": "media.stream.seek.click",
                      "input": {
                        "video": [
                          "at",
                          "$video",
                          "ref"
                        ]
                      },
                      "delegate": "[data-seek]"
                    },
                    "into": "_"
                  },
                  {
                    "port": "browser.on",
                    "args": {
                      "ref": [
                        "at",
                        "$video",
                        "ref"
                      ],
                      "event": "loadedmetadata",
                      "query": "media.stream.seek.loaded",
                      "input": {
                        "video": [
                          "at",
                          "$video",
                          "ref"
                        ]
                      }
                    },
                    "into": "_"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "port": "browser.environment",
        "args": {},
        "into": "env"
      },
      {
        "when": [
          "at",
          "$env",
          "intersection"
        ],
        "then": [
          {
            "port": "browser.intersection",
            "args": {
              "selector": "[data-screen] video",
              "query": "media.stream.screens.intersection",
              "input": {},
              "threshold": 0.2
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "browser.select",
        "args": {
          "selector": "#provenance"
        },
        "into": "boxes"
      },
      {
        "when": [
          "not",
          [
            "eq",
            [
              "count",
              "$boxes"
            ],
            0
          ]
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.provenance",
              "input": {}
            },
            "into": "result"
          }
        ]
      }
    ],
    "media.stream.sound.sync": [
      {
        "port": "media.read",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ]
        },
        "into": "video"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "sound"
          ],
          "name": "textContent",
          "value": [
            "if",
            [
              "at",
              "$video",
              "muted"
            ],
            "Sound off",
            "Sound on"
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "sound"
          ],
          "name": "aria-pressed",
          "value": [
            "if",
            [
              "at",
              "$video",
              "muted"
            ],
            "false",
            "true"
          ]
        },
        "into": "_"
      }
    ],
    "media.stream.sound.toggle": [
      {
        "port": "media.read",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ]
        },
        "into": "video"
      },
      {
        "port": "media.write",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ],
          "name": "muted",
          "value": [
            "not",
            [
              "at",
              "$video",
              "muted"
            ]
          ]
        },
        "into": "_"
      },
      {
        "when": [
          "and",
          [
            "at",
            "$video",
            "muted"
          ],
          [
            "eq",
            [
              "at",
              "$video",
              "volume"
            ],
            0
          ]
        ],
        "then": [
          {
            "port": "media.write",
            "args": {
              "ref": [
                "at",
                "$eventInput",
                "video"
              ],
              "name": "volume",
              "value": 0.8
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "media.stream.sound.sync",
          "input": {
            "video": [
              "at",
              "$eventInput",
              "video"
            ],
            "sound": [
              "at",
              "$eventInput",
              "sound"
            ]
          }
        },
        "into": "result"
      }
    ],
    "media.stream.screens.intersection": [
      {
        "each": [
          "at",
          "$eventInput",
          "entries"
        ],
        "as": "entry",
        "steps": [
          {
            "when": [
              "not",
              [
                "at",
                "$entry",
                "isIntersecting"
              ]
            ],
            "then": [
              {
                "port": "media.read",
                "args": {
                  "ref": [
                    "at",
                    "$entry",
                    "ref"
                  ]
                },
                "into": "video"
              },
              {
                "when": [
                  "not",
                  [
                    "at",
                    "$video",
                    "paused"
                  ]
                ],
                "then": [
                  {
                    "port": "media.pause",
                    "args": {
                      "ref": [
                        "at",
                        "$entry",
                        "ref"
                      ]
                    },
                    "into": "_"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "media.stream.seek.click": [
      {
        "port": "number.parse",
        "args": {
          "value": [
            "at",
            [
              "at",
              [
                "at",
                "$eventInput",
                "matched"
              ],
              "attributes"
            ],
            "data-seek"
          ]
        },
        "into": "time"
      },
      {
        "port": "state.set",
        "args": {
          "key": [
            "concat",
            "seek.",
            [
              "at",
              [
                "at",
                "$eventInput",
                "video"
              ],
              "handle"
            ]
          ],
          "value": {
            "time": "$time",
            "phase": "metadata"
          }
        },
        "into": "_"
      },
      {
        "port": "media.read",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ]
        },
        "into": "video"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "less",
          "values": [
            "list",
            [
              "at",
              "$video",
              "readyState"
            ],
            1
          ]
        },
        "into": "unloaded"
      },
      {
        "when": "$unloaded",
        "then": [
          {
            "port": "media.write",
            "args": {
              "ref": [
                "at",
                "$eventInput",
                "video"
              ],
              "name": "preload",
              "value": "auto"
            },
            "into": "_"
          },
          {
            "port": "media.load",
            "args": {
              "ref": [
                "at",
                "$eventInput",
                "video"
              ]
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "not",
          "$unloaded"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.seek.prepare",
              "input": {
                "video": [
                  "at",
                  "$eventInput",
                  "video"
                ],
                "time": "$time"
              }
            },
            "into": "result"
          }
        ]
      },
      {
        "port": "browser.focus",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ],
          "preventScroll": true
        },
        "into": "_"
      }
    ],
    "media.stream.seek.loaded": [
      {
        "port": "state.get",
        "args": {
          "key": [
            "concat",
            "seek.",
            [
              "at",
              [
                "at",
                "$eventInput",
                "video"
              ],
              "handle"
            ]
          ]
        },
        "into": "pending"
      },
      {
        "when": "$pending",
        "then": [
          {
            "when": [
              "eq",
              [
                "at",
                "$pending",
                "phase"
              ],
              "metadata"
            ],
            "then": [
              {
                "port": "kernel.invoke",
                "args": {
                  "query": "media.stream.seek.prepare",
                  "input": {
                    "video": [
                      "at",
                      "$eventInput",
                      "video"
                    ],
                    "time": [
                      "at",
                      "$pending",
                      "time"
                    ]
                  }
                },
                "into": "result"
              }
            ]
          },
          {
            "when": [
              "eq",
              [
                "at",
                "$pending",
                "phase"
              ],
              "blob"
            ],
            "then": [
              {
                "port": "kernel.invoke",
                "args": {
                  "query": "media.stream.seek.finish",
                  "input": {
                    "video": [
                      "at",
                      "$eventInput",
                      "video"
                    ],
                    "time": [
                      "at",
                      "$pending",
                      "time"
                    ]
                  }
                },
                "into": "result"
              }
            ]
          }
        ]
      }
    ],
    "media.stream.seek.contains": [
      {
        "fold": [
          "at",
          "$eventInput",
          "ranges"
        ],
        "as": "range",
        "accumulator": "found",
        "initial": false,
        "steps": [
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                [
                  "at",
                  "$range",
                  0
                ],
                [
                  "at",
                  "$eventInput",
                  "time"
                ]
              ]
            },
            "into": "after"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "lessEqual",
              "values": [
                "list",
                [
                  "at",
                  "$eventInput",
                  "time"
                ],
                [
                  "at",
                  "$range",
                  1
                ]
              ]
            },
            "into": "before"
          }
        ],
        "yield": [
          "or",
          "$found",
          [
            "and",
            "$after",
            "$before"
          ]
        ],
        "into": "result"
      },
      {
        "let": "result",
        "value": [
          "not",
          [
            "not",
            "$result"
          ]
        ]
      }
    ],
    "media.stream.seek.prepare": [
      {
        "port": "media.read",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ]
        },
        "into": "video"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "media.stream.seek.contains",
          "input": {
            "ranges": [
              "at",
              "$video",
              "seekable"
            ],
            "time": [
              "at",
              "$eventInput",
              "time"
            ]
          }
        },
        "into": "seekable"
      },
      {
        "port": "text.matches",
        "args": {
          "value": [
            "at",
            "$video",
            "currentSrc"
          ],
          "pattern": "^blob:"
        },
        "into": "blob"
      },
      {
        "let": "finish",
        "value": true
      },
      {
        "when": [
          "and",
          [
            "not",
            "$seekable"
          ],
          [
            "at",
            "$video",
            "currentSrc"
          ],
          [
            "not",
            "$blob"
          ]
        ],
        "then": [
          {
            "try": [
              {
                "port": "asset.blobURL",
                "args": {
                  "url": [
                    "at",
                    "$video",
                    "currentSrc"
                  ]
                },
                "into": "url"
              },
              {
                "port": "state.set",
                "args": {
                  "key": [
                    "concat",
                    "seek.",
                    [
                      "at",
                      [
                        "at",
                        "$eventInput",
                        "video"
                      ],
                      "handle"
                    ]
                  ],
                  "value": {
                    "time": [
                      "at",
                      "$eventInput",
                      "time"
                    ],
                    "phase": "blob"
                  }
                },
                "into": "_"
              },
              {
                "port": "media.write",
                "args": {
                  "ref": [
                    "at",
                    "$eventInput",
                    "video"
                  ],
                  "name": "src",
                  "value": "$url"
                },
                "into": "_"
              },
              {
                "port": "media.write",
                "args": {
                  "ref": [
                    "at",
                    "$eventInput",
                    "video"
                  ],
                  "name": "muted",
                  "value": [
                    "at",
                    "$video",
                    "muted"
                  ]
                },
                "into": "_"
              },
              {
                "let": "finish",
                "value": false
              }
            ],
            "catch": [],
            "error": "error"
          }
        ]
      },
      {
        "when": "$finish",
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.seek.finish",
              "input": {
                "video": [
                  "at",
                  "$eventInput",
                  "video"
                ],
                "time": [
                  "at",
                  "$eventInput",
                  "time"
                ]
              }
            },
            "into": "result"
          }
        ]
      }
    ],
    "media.stream.seek.finish": [
      {
        "port": "state.set",
        "args": {
          "key": [
            "concat",
            "seek.",
            [
              "at",
              [
                "at",
                "$eventInput",
                "video"
              ],
              "handle"
            ]
          ],
          "value": null
        },
        "into": "_"
      },
      {
        "port": "media.write",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ],
          "name": "currentTime",
          "value": [
            "at",
            "$eventInput",
            "time"
          ]
        },
        "into": "_"
      },
      {
        "port": "media.play",
        "args": {
          "ref": [
            "at",
            "$eventInput",
            "video"
          ]
        },
        "into": "_"
      }
    ],
    "media.stream.provenance": [
      {
        "try": [
          {
            "port": "asset.json",
            "args": {
              "url": "manifest.json",
              "cache": "no-cache"
            },
            "into": "manifest"
          },
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.provenance.view",
              "input": {
                "manifest": "$manifest"
              }
            },
            "into": "node"
          },
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.html",
              "input": {
                "node": "$node"
              }
            },
            "into": "html"
          },
          {
            "port": "browser.content",
            "args": {
              "ref": "#provenance",
              "html": "$html"
            },
            "into": "_"
          }
        ],
        "catch": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "media.stream.html",
              "input": {
                "node": {
                  "tag": "p",
                  "attrs": {
                    "class": "fine"
                  },
                  "children": [
                    "list",
                    "The manifest could not be read here. It sits beside the film as ",
                    {
                      "tag": "a",
                      "attrs": {
                        "href": "manifest.json"
                      },
                      "children": [
                        "list",
                        "manifest.json"
                      ]
                    },
                    "."
                  ]
                }
              }
            },
            "into": "html"
          },
          {
            "port": "browser.content",
            "args": {
              "ref": "#provenance",
              "html": "$html"
            },
            "into": "_"
          }
        ],
        "error": "error"
      }
    ],
    "media.stream.provenance.view": [
      {
        "let": "m",
        "value": [
          "at",
          "$eventInput",
          "manifest"
        ]
      },
      {
        "fold": [
          "at",
          "$m",
          "files"
        ],
        "as": "file",
        "accumulator": "rows",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "text.replace",
            "args": {
              "value": [
                "at",
                "$file",
                "path"
              ],
              "pattern": "^films/",
              "flags": "",
              "replacement": ""
            },
            "into": "path"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "divide",
              "values": [
                "list",
                [
                  "at",
                  "$file",
                  "bytes"
                ],
                1000000
              ]
            },
            "into": "arithmetic23"
          },
          {
            "let": "mb",
            "value": "$arithmetic23"
          },
          {
            "port": "number.format",
            "args": {
              "value": "$mb",
              "digits": 2
            },
            "into": "mb"
          },
          {
            "port": "text.slice",
            "args": {
              "value": [
                "at",
                "$file",
                "sha256"
              ],
              "start": 0,
              "end": 16
            },
            "into": "hash"
          }
        ],
        "yield": [
          "append",
          "$rows",
          [
            "list",
            {
              "tag": "tr",
              "attrs": {},
              "children": [
                "list",
                {
                  "tag": "th",
                  "attrs": {
                    "scope": "row"
                  },
                  "children": [
                    "list",
                    {
                      "tag": "a",
                      "attrs": {
                        "href": "$path"
                      },
                      "children": [
                        "list",
                        "$path"
                      ]
                    }
                  ]
                },
                {
                  "tag": "td",
                  "attrs": {},
                  "children": [
                    "list",
                    [
                      "concat",
                      [
                        "at",
                        "$file",
                        "kind"
                      ],
                      [
                        "if",
                        [
                          "at",
                          "$file",
                          "duration"
                        ],
                        [
                          "concat",
                          " · ",
                          [
                            "at",
                            "$file",
                            "duration"
                          ],
                          " s"
                        ],
                        ""
                      ],
                      [
                        "if",
                        [
                          "at",
                          "$file",
                          "codecs"
                        ],
                        [
                          "concat",
                          " · ",
                          [
                            "at",
                            [
                              "at",
                              "$file",
                              "codecs"
                            ],
                            "video"
                          ],
                          "/",
                          [
                            "at",
                            [
                              "at",
                              "$file",
                              "codecs"
                            ],
                            "audio"
                          ]
                        ],
                        ""
                      ]
                    ]
                  ]
                },
                {
                  "tag": "td",
                  "attrs": {},
                  "children": [
                    "list",
                    [
                      "concat",
                      "$mb",
                      " MB"
                    ]
                  ]
                },
                {
                  "tag": "td",
                  "attrs": {},
                  "children": [
                    "list",
                    {
                      "tag": "code",
                      "attrs": {
                        "title": [
                          "at",
                          "$file",
                          "sha256"
                        ]
                      },
                      "children": [
                        "list",
                        [
                          "concat",
                          "$hash",
                          "…"
                        ]
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        ],
        "into": "rows"
      },
      {
