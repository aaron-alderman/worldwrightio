{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "draft.subject": [
      {
        "port": "text.lowerCase",
        "args": {
          "value": "$eventInput.text"
        },
        "into": "lower"
      },
      {
        "port": "text.match",
        "args": {
          "value": "$lower",
          "pattern": "$eventInput.configuration.subjectPattern",
          "flags": ""
        },
        "into": "match"
      },
      {
        "let": "result",
        "value": "$eventInput.fallback"
      },
      {
        "when": [
          "not",
          [
            "eq",
            "$match",
            null
          ]
        ],
        "then": [
          {
            "port": "text.split",
            "args": {
              "value": [
                "at",
                "$match.groups",
                1
              ],
              "pattern": "\\s+"
            },
            "into": "candidates"
          },
          {
            "fold": "$candidates",
            "as": "word",
            "accumulator": "reading",
            "initial": {
              "words": [
                "list"
              ],
              "done": false
            },
            "steps": [
              {
                "let": "next",
                "value": "$reading"
              },
              {
                "when": [
                  "not",
                  "$reading.done"
                ],
                "then": [
                  {
                    "when": [
                      "includes",
                      "$eventInput.configuration.stopWords",
                      "$word"
                    ],
                    "then": [
                      {
                        "let": "next",
                        "value": {
                          "words": "$reading.words",
                          "done": true
                        }
                      }
                    ]
                  },
                  {
                    "when": [
                      "not",
                      [
                        "includes",
                        "$eventInput.configuration.stopWords",
                        "$word"
                      ]
                    ],
                    "then": [
                      {
                        "let": "words",
                        "value": [
                          "append",
                          "$reading.words",
                          [
                            "list",
                            "$word"
                          ]
                        ]
                      },
                      {
                        "port": "number.calculate",
                        "args": {
                          "operation": "greaterEqual",
                          "values": [
                            "list",
                            [
                              "count",
                              "$words"
                            ],
                            2
                          ]
                        },
                        "into": "full"
                      },
                      {
                        "let": "next",
                        "value": {
                          "words": "$words",
                          "done": "$full"
                        }
                      }
                    ]
                  }
                ]
              }
            ],
            "yield": "$next",
            "into": "reading"
          },
          {
            "when": [
              "not",
              [
                "eq",
                [
                  "count",
                  "$reading.words"
                ],
                0
              ]
            ],
            "then": [
              {
                "port": "text.join",
                "args": {
                  "values": "$reading.words",
                  "separator": " "
                },
                "into": "words"
              },
              {
                "let": "determiner",
                "value": [
                  "at",
                  "$match.groups",
                  0
                ]
              },
              {
                "let": "result",
                "value": [
                  "concat",
                  [
                    "if",
                    [
                      "includes",
                      [
                        "list",
                        "the",
                        "our",
                        "my",
                        "your",
                        "their"
                      ],
                      "$determiner"
                    ],
                    "$determiner",
                    "the"
                  ],
                  " ",
                  "$words"
                ]
              }
            ]
          }
        ]
      }
    ],
    "draft.format": [
      {
        "let": "value",
        "value": "$eventInput.value"
      },
      {
        "port": "value.describe",
        "args": {
          "value": "$value"
        },
        "into": "kind"
      },
      {
        "let": "result",
        "value": "$value"
      },
      {
        "when": [
          "eq",
          "$kind.type",
          "string"
        ],
        "then": [
          {
            "port": "record.entries",
            "args": {
              "value": "$eventInput.variables"
            },
            "into": "variables"
          },
          {
            "fold": "$variables",
            "as": "variable",
            "accumulator": "formatted",
            "initial": "$value",
            "steps": [
              {
                "port": "text.replaceAll",
                "args": {
                  "value": "$formatted",
                  "search": [
                    "concat",
                    "{{",
                    [
                      "at",
                      "$variable",
                      0
                    ],
                    "}}"
                  ],
                  "replacement": [
                    "at",
                    "$variable",
                    1
                  ]
                },
                "into": "formatted"
              }
            ],
            "yield": "$formatted",
            "into": "result"
          }
        ]
      },
      {
        "when": "$kind.array",
        "then": [
          {
            "fold": "$value",
            "as": "item",
            "accumulator": "parts",
            "initial": [
              "list"
            ],
            "steps": [
              {
                "port": "kernel.invoke",
                "args": {
                  "query": "draft.format",
                  "input": {
                    "value": "$item",
                    "variables": "$eventInput.variables"
                  }
                },
                "into": "part"
              }
            ],
            "yield": [
              "append",
              "$parts",
              [
                "list",
                "$part"
              ]
            ],
            "into": "result"
          }
        ]
      },
      {
        "when": [
          "and",
          [
            "eq",
            "$kind.type",
            "object"
          ],
          [
            "not",
            "$kind.null"
          ],
          [
            "not",
            "$kind.array"
          ]
        ],
        "then": [
          {
            "port": "record.entries",
            "args": {
              "value": "$value"
            },
            "into": "entries"
          },
          {
            "fold": "$entries",
            "as": "entry",
            "accumulator": "formatted",
            "initial": {},
            "steps": [
              {
                "port": "kernel.invoke",
                "args": {
                  "query": "draft.format",
                  "input": {
                    "value": [
                      "at",
                      "$entry",
                      1
                    ],
                    "variables": "$eventInput.variables"
                  }
                },
                "into": "part"
              },
              {
                "port": "record.put",
                "args": {
                  "record": "$formatted",
                  "key": [
                    "at",
                    "$entry",
                    0
                  ],
                  "value": "$part"
                },
                "into": "formatted"
              }
            ],
            "yield": "$formatted",
            "into": "result"
          }
        ]
      }
    ],
    "draft.draft": [
      {
        "let": "configuration",
        "value": "$eventInput.configuration"
      },
      {
        "port": "text.lowerCase",
        "args": {
          "value": "$eventInput.text"
        },
        "into": "lower"
      },
      {
        "fold": "$configuration.archetypes",
        "as": "archetype",
        "accumulator": "key",
        "initial": "generic",
        "steps": [
          {
            "let": "next",
            "value": "$key"
          },
          {
            "when": [
              "eq",
              "$key",
              "generic"
            ],
            "then": [
              {
                "port": "text.matches",
                "args": {
                  "value": "$lower",
                  "pattern": "$archetype.re.pattern",
                  "flags": "$archetype.re.flags"
                },
                "into": "matches"
              },
              {
                "when": "$matches",
                "then": [
                  {
                    "let": "next",
                    "value": "$archetype.key"
                  }
                ]
              }
            ]
          }
        ],
        "yield": "$next",
        "into": "key"
      },
      {
        "let": "template",
        "value": [
          "at",
          "$configuration.templates",
          "$key"
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "draft.subject",
          "input": {
            "text": "$eventInput.text",
            "fallback": "$template.fallback",
            "configuration": "$configuration"
          }
        },
        "into": "subject"
      },
      {
        "fold": "$configuration.events",
        "as": "event",
        "accumulator": "naming",
        "initial": {
          "noun": "entry",
          "found": false
        },
        "steps": [
          {
            "let": "next",
            "value": "$naming"
          },
          {
            "when": [
              "not",
              "$naming.found"
            ],
            "then": [
              {
                "port": "text.matches",
                "args": {
                  "value": "$lower",
                  "pattern": "$event.pattern",
                  "flags": "$event.flags"
                },
                "into": "matches"
              },
              {
                "when": "$matches",
                "then": [
                  {
                    "let": "next",
                    "value": {
                      "noun": "$event.noun",
                      "found": true
                    }
                  }
                ]
              }
            ]
          }
        ],
        "yield": "$next",
        "into": "naming"
      },
      {
        "let": "noun",
        "value": "$naming.noun"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$noun",
          "start": 0,
          "end": 1
        },
        "into": "first"
      },
      {
        "port": "text.upperCase",
        "args": {
          "value": "$first"
        },
        "into": "capital"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$noun",
          "start": 1
        },
        "into": "rest"
      },
      {
        "let": "capitalNoun",
        "value": [
          "concat",
          "$capital",
          "$rest"
        ]
      },
      {
        "port": "text.matches",
        "args": {
          "value": "$noun",
          "pattern": "(s|x|ch|sh)$"
        },
        "into": "takesEs"
      },
      {
        "let": "pluralNoun",
        "value": [
          "concat",
          "$noun",
          [
            "if",
            "$takesEs",
            "es",
            "s"
          ]
        ]
      },
      {
        "port": "text.matches",
        "args": {
          "value": "$noun",
          "pattern": "^[aeiou]"
        },
        "into": "vowel"
      },
      {
        "port": "text.match",
        "args": {
          "value": "$eventInput.text",
          "pattern": "$configuration.amountPattern"
        },
        "into": "amountMatch"
      },
      {
        "let": "amount",
        "value": [
          "if",
          [
            "eq",
            "$amountMatch",
            null
          ],
          "",
          [
            "at",
            "$amountMatch",
            "text"
          ]
        ]
      },
      {
        "port": "text.replace",
        "args": {
          "value": "$amount",
          "pattern": "\\s",
          "flags": "g",
          "replacement": ""
        },
        "into": "amount"
      },
      {
        "port": "text.replace",
        "args": {
          "value": "$subject",
          "pattern": "^(the|our|my|your|their) ",
          "flags": "",
          "replacement": ""
        },
        "into": "recordName"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$recordName",
          "start": 0,
          "end": 1
        },
        "into": "first"
      },
      {
        "port": "text.upperCase",
        "args": {
          "value": "$first"
        },
        "into": "capital"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$recordName",
          "start": 1
        },
        "into": "rest"
      },
      {
        "let": "recordName",
        "value": [
          "concat",
          "$capital",
          "$rest"
        ]
      },
      {
        "let": "variables",
        "value": {
          "subject": "$subject",
          "noun": "$noun",
          "capitalNoun": "$capitalNoun",
          "pluralNoun": "$pluralNoun",
          "article": [
            "if",
            "$vowel",
            "an",
            "a"
          ],
          "amountPrefix": [
            "if",
            [
              "eq",
              "$amount",
              ""
            ],
            "",
            [
              "concat",
              " at ",
              "$amount"
            ]
          ],
          "approvalSubject": [
            "if",
            [
              "eq",
              "$amount",
              ""
            ],
            "Requests over the limit",
            [
              "concat",
              "Requests over ",
              "$amount"
            ]
          ],
          "recordName": "$recordName"
        }
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "draft.format",
          "input": {
            "value": "$template",
            "variables": "$variables"
          }
        },
        "into": "draft"
      },
      {
        "port": "text.matchAll",
        "args": {
          "value": "$eventInput.text",
          "pattern": "$configuration.refusalPattern",
          "flags": "gi"
        },
        "into": "refusalMatches"
      },
      {
        "fold": "$refusalMatches",
        "as": "match",
        "accumulator": "refusals",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "let": "next",
            "value": "$refusals"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "less",
              "values": [
                "list",
                [
                  "count",
                  "$refusals"
                ],
                2
              ]
            },
            "into": "room"
          },
          {
            "when": "$room",
            "then": [
              {
                "port": "text.lowerCase",
                "args": {
                  "value": [
                    "at",
                    "$match.groups",
                    0
                  ]
                },
                "into": "refusal"
              },
              {
                "let": "next",
                "value": [
                  "append",
                  "$refusals",
                  [
                    "list",
                    [
                      "concat",
                      "No ",
                      "$refusal",
                      ", as you asked"
                    ]
                  ]
                ]
              }
            ]
          }
        ],
        "yield": "$next",
        "into": "refusals"
      },
      {
        "let": "result",
        "value": {
          "pattern": "$draft.pattern",
          "title": "$draft.title",
          "creates": "$draft.creates",
          "rules": "$draft.rules",
          "asks": "$draft.asks",
          "wont": [
            "append",
            [
              "append",
              "$refusals",
              "$draft.wont"
            ],
            [
              "list",
              "Make any of this real before you seal it"
            ]
          ]
        }
      }
    ],
    "draft.proposal": [
      {
        "port": "kernel.invoke",
        "args": {
          "query": "draft.draft",
          "input": {
            "text": "$eventInput.text",
            "configuration": "$eventInput.configuration"
          }
        },
        "into": "draft"
      },
      {
        "port": "digest.sha256",
        "args": {
          "text": "$eventInput.text",
          "fallback": true
        },
        "into": "intentHash"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$intentHash",
          "start": 0,
          "end": 4
        },
        "into": "first"
      },
      {
        "port": "number.parse",
        "args": {
          "value": "$first",
          "radix": 16
        },
        "into": "number"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "remainder",
          "values": [
            "list",
            "$number",
            40
          ]
        },
        "into": "number"
      },
      {
        "let": "assistantNumber",
        "value": [
          "add",
          "$number",
          1
        ]
      },
      {
        "let": "proposal",
        "value": {
          "kind": "proposal",
          "intent": "$eventInput.text",
          "pattern": "$draft.pattern",
          "creates": [
            "map",
            "$draft.creates",
            "creation",
            [
              "concat",
              [
                "at",
                "$creation",
                0
              ],
              ": ",
              [
                "at",
                "$creation",
                1
              ],
              " (",
              [
                "at",
                "$creation",
                2
              ],
              ")"
            ]
          ],
          "rules": "$draft.rules",
          "asks": "$draft.asks",
          "wont": "$draft.wont",
          "emissary": [
            "concat",
            "assistant-",
            "$assistantNumber"
          ],
          "askedBy": "you",
          "basis": "$eventInput.previous"
        }
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "canonical.encode",
          "input": {
            "value": "$proposal",
            "numbers": true
          }
        },
        "into": "canonical"
      },
      {
        "port": "digest.sha256",
        "args": {
          "text": "$canonical",
          "fallback": true
        },
        "into": "hash"
      },
      {
        "let": "result",
        "value": {
          "draft": "$draft",
          "proposal": "$proposal",
          "hash": "$hash",
          "assistantNumber": "$assistantNumber"
        }
      }
    ],
    "draft.decide": [
      {
        "let": "ledger",
        "value": "$eventInput.ledger"
      },
      {
        "let": "current",
        "value": "$eventInput.current"
      },
      {
        "let": "previous",
        "value": [
          "if",
          [
            "eq",
            [
              "count",
              "$ledger"
            ],
            0
          ],
          "genesis",
          [
            "at",
            [
              "at",
              "$ledger",
              [
                "add",
                [
                  "count",
                  "$ledger"
                ],
                -1
              ]
            ],
            "witness"
          ]
        ]
      },
      {
        "let": "record",
        "value": {
          "kind": "witness",
          "n": [
            "add",
            [
              "count",
              "$ledger"
            ],
            1
          ],
          "verdict": "$eventInput.verdict",
          "by": "you",
          "emissary": "$current.proposal.emissary",
          "intent": "$current.proposal.intent",
          "note": "$eventInput.note",
          "proposal": "$current.hash",
          "previous": "$previous",
          "at": "$eventInput.at"
        }
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "canonical.encode",
          "input": {
            "value": "$record",
            "numbers": true
          }
        },
        "into": "canonical"
      },
      {
        "port": "digest.sha256",
        "args": {
          "text": "$canonical",
          "fallback": true
        },
        "into": "witness"
      },
      {
        "let": "result",
        "value": {
          "record": "$record",
          "witness": "$witness",
          "ledger": [
            "append",
            "$ledger",
            [
              "list",
              {
                "record": "$record",
                "witness": "$witness"
              }
            ]
          ]
        }
      }
    ],
    "draft.verify": [
      {
        "let": "ledger",
        "value": "$eventInput.ledger"
      },
      {
        "fold": "$ledger",
        "as": "entry",
        "accumulator": "recomputed",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "canonical.encode",
              "input": {
                "value": "$entry.record",
                "numbers": true
              }
            },
            "into": "canonical"
          },
          {
            "port": "digest.sha256",
            "args": {
              "text": "$canonical",
              "fallback": true
            },
            "into": "hash"
          }
        ],
        "yield": [
          "append",
          "$recomputed",
          [
            "list",
            "$hash"
          ]
        ],
        "into": "recomputed"
      },
      {
        "fold": [
          "range",
          [
            "count",
            "$ledger"
          ]
        ],
        "as": "position",
        "accumulator": "verification",
        "initial": {
          "marks": [
            "list"
          ],
          "firstBad": -1
        },
        "steps": [
          {
            "let": "index",
            "value": [
              "add",
              "$position",
              -1
            ]
          },
          {
            "let": "entry",
            "value": [
              "at",
              "$ledger",
              "$index"
            ]
          },
          {
            "let": "selfOk",
            "value": [
              "eq",
              [
                "at",
                "$recomputed",
                "$index"
              ],
              "$entry.witness"
            ]
          },
          {
            "let": "linkOk",
            "value": [
              "if",
              [
                "eq",
                "$index",
                0
              ],
              [
                "eq",
                "$entry.record.previous",
                "genesis"
              ],
              [
                "eq",
                "$entry.record.previous",
                [
                  "at",
                  "$recomputed",
                  [
                    "add",
                    "$index",
                    -1
                  ]
                ]
              ]
            ]
          },
          {
            "let": "ok",
            "value": [
              "and",
              "$selfOk",
              "$linkOk",
              [
                "eq",
                "$verification.firstBad",
                -1
              ]
            ]
          },
          {
            "let": "firstBad",
            "value": [
              "if",
              [
                "and",
                [
                  "not",
                  "$ok"
                ],
                [
                  "eq",
                  "$verification.firstBad",
                  -1
                ]
              ],
              "$index",
              "$verification.firstBad"
            ]
          }
        ],
        "yield": {
          "marks": [
            "append",
            "$verification.marks",
            [
              "list",
              "$ok"
            ]
          ],
          "firstBad": "$firstBad"
        },
        "into": "verification"
      },
      {
        "let": "ok",
        "value": [
          "eq",
          "$verification.firstBad",
          -1
        ]
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greater",
          "values": [
            "list",
            [
              "count",
              "$ledger"
            ],
            [
              "add",
              "$verification.firstBad",
              1
            ]
          ]
        },
        "into": "later"
      },
      {
        "let": "result",
        "value": {
          "marks": "$verification.marks",
          "firstBad": "$verification.firstBad",
          "ok": "$ok",
          "message": [
            "if",
            "$ok",
            [
              "concat",
              "✓ ",
              [
                "count",
                "$ledger"
              ],
              [
                "if",
                [
                  "eq",
                  [
                    "count",
                    "$ledger"
                  ],
                  1
                ],
                " witness",
                " witnesses"
              ],
              " recomputed. The chain is intact."
            ],
            [
              "concat",
              "✗ № ",
              [
                "add",
                "$verification.firstBad",
                1
              ],
              " no longer matches its witness",
              [
                "if",
                "$later",
                ", so every entry after it has lost its footing.",
                "."
              ],
              " Rewriting history shows."
            ]
          ]
        }
      }
    ],
    "draft.tamper": [
      {
        "let": "ledger",
        "value": "$eventInput.ledger"
      },
      {
        "let": "result",
        "value": {
          "ledger": "$ledger",
          "originalRecord": "$eventInput.originalRecord",
          "message": ""
        }
      },
      {
        "when": [
          "not",
          [
            "eq",
            [
              "count",
              "$ledger"
            ],
            0
          ]
        ],
        "then": [
          {
            "let": "entry",
            "value": [
              "at",
              "$ledger",
              0
            ]
          },
          {
            "let": "originalRecord",
            "value": "$eventInput.originalRecord"
          },
          {
            "let": "record",
            "value": "$originalRecord"
          },
          {
            "let": "message",
            "value": "Tampering undone. Verify again to see the chain restored."
          },
          {
            "when": [
              "eq",
              "$originalRecord",
              null
            ],
            "then": [
              {
                "let": "originalRecord",
                "value": "$entry.record"
              },
              {
                "port": "record.put",
                "args": {
                  "record": "$entry.record",
                  "key": "intent",
                  "value": [
                    "concat",
                    "$entry.record.intent",
                    " (and the neighbour’s cat)"
                  ]
                },
                "into": "record"
              },
              {
                "let": "message",
                "value": "Entry № 1 now reads differently, but its witness hasn’t changed. Try verifying."
              }
            ]
          },
          {
            "when": [
              "not",
              [
                "eq",
                "$eventInput.originalRecord",
                null
              ]
            ],
            "then": [
              {
                "let": "originalRecord",
                "value": null
              }
            ]
          },
          {
            "port": "record.put",
            "args": {
              "record": "$entry",
              "key": "record",
              "value": "$record"
            },
            "into": "entry"
          },
          {
            "let": "ledger",
            "value": [
              "map",
              [
                "range",
                [
                  "count",
                  "$ledger"
                ]
              ],
              "position",
              [
                "if",
                [
                  "eq",
                  "$position",
                  1
                ],
                "$entry",
                [
                  "at",
                  "$ledger",
                  [
                    "add",
                    "$position",
                    -1
                  ]
                ]
              ]
            ]
          },
          {
            "let": "result",
            "value": {
              "ledger": "$ledger",
              "originalRecord": "$originalRecord",
              "message": "$message"
            }
          }
        ]
      }
    ]
  }
}
