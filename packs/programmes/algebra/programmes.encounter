process-module "temple/surface-process-module/1"

process programmes.hash:
  port kernel.invoke { query = "canonical.encode"; input = { value = { kind = "programme"; value = $eventInput.value }; numbers = true } } → bytes
  port digest.sha256 { text = $bytes } → digest
  let result = concat("programme:sha256:", $digest)

process programmes.initial:
  port kernel.invoke { query = "programmes.hash"; input = { value = $data.initial } } → root
  let result = { state = $data.initial; root = $root; ledger = list(); requests = list() }

process programmes.propose:
  let current = $eventInput.current
  let proposal = $eventInput.proposal
  assert eq($proposal.actor, $data.member)
    otherwise "PROPOSAL_AUTHORITY: only the declared member may lend instruments."
  assert eq($proposal.basis, $current.root)
    otherwise "PROPOSAL_STALE: the proposal basis must match the accepted root."
  assert not(includes($current.requests, $proposal.requestId))
    otherwise "PROPOSAL_DUPLICATE: request already accepted."
  port value.type { value = $proposal.requestId } → idType
  assert and(eq($idType, "string"), not(eq($proposal.requestId, "")))
    otherwise "PROPOSAL_ID: request identity required."
  assert includes(list("lend", "return"), $proposal.action)
    otherwise "PROPOSAL_ACTION: unknown action."
  port number.calculate { operation = "add"; values = list($current.state.available, if(eq($proposal.action, "lend"), -1, 1)) } → available
  port number.calculate { operation = "greaterEqual"; values = list($available, 0) } → above
  port number.calculate { operation = "lessEqual"; values = list($available, $data.initial.available) } → below
  assert and($above, $below)
    otherwise "PROPOSAL_CAPACITY: availability must stay between zero and three."
  port number.calculate { operation = "add"; values = list($current.state.revision, 1) } → revision
  let next = { available = $available; revision = $revision }
  port kernel.invoke { query = "programmes.hash"; input = { value = $next } } → root
  let receipt = { before = $current.root; after = $root; proposal = $proposal; state = $next }
  port kernel.invoke { query = "programmes.hash"; input = { value = $receipt } } → digest
  let result = { state = $next; root = $root; ledger = append($current.ledger, list({ receipt = $receipt; digest = $digest })); requests = append($current.requests, list($proposal.requestId)) }

process programmes.witness:
  port kernel.invoke { query = "programmes.initial"; input = {} } → initial
  fold $eventInput.current.ledger as item; replayed starts $initial:
    port kernel.invoke { query = "programmes.hash"; input = { value = $item.receipt } } → actual
    assert eq($actual, $item.digest)
      otherwise "WITNESS_TAMPER: receipt bytes differ from their address."
    assert eq($item.receipt.before, $replayed.root)
      otherwise "WITNESS_CHAIN: receipt basis is not the preceding accepted state."
    port kernel.invoke { query = "programmes.propose"; input = { current = $replayed; proposal = $item.receipt.proposal } } → next
    assert eq($next.root, $item.receipt.after)
      otherwise "WITNESS_REPLAY: receipt result differs from replay."
    yield $next → replayed
  assert eq($replayed.root, $eventInput.current.root)
    otherwise "WITNESS_HEAD: accepted root differs from replay."
  assert eq($replayed.state, $eventInput.current.state)
    otherwise "WITNESS_STATE: accepted state differs from replay."
  assert eq($replayed.requests, $eventInput.current.requests)
    otherwise "WITNESS_REQUESTS: request history differs from replay."
  port kernel.invoke { query = "programmes.merkle"; input = { digests = map($eventInput.current.ledger, "item", $item.digest) } } → witnessRoot
  let result = { ok = true; root = $replayed.root; witnessRoot = $witnessRoot; receipts = count($eventInput.current.ledger); state = $replayed.state }

process programmes.boot:
  port dom.exists { selector = "#programmes-mount" } → mounted
  when $mounted:
    port kernel.invoke { query = "programmes.initial"; input = {} } → current
    port state.set { key = "programmes.current"; value = $current } → _
    port browser.on { ref = "#programmes-apply"; event = "click"; query = "programmes.apply"; input = {} } → _
    port browser.on { ref = "#programmes-reset"; event = "click"; query = "programmes.reset"; input = {} } → _
    port browser.on { ref = "#programmes-replay"; event = "click"; query = "programmes.replay"; input = {} } → _
    port browser.on { ref = "#programmes-tamper"; event = "click"; query = "programmes.tamper"; input = {} } → _
    port kernel.invoke { query = "programmes.render"; input = {} } → result
    port kernel.invoke { query = "programmes.cellsBoot"; input = {} } → result
    port kernel.invoke { query = "programmes.draftBoot"; input = {} } → result

process programmes.reset:
  port kernel.invoke { query = "programmes.initial"; input = {} } → current
  port state.set { key = "programmes.current"; value = $current } → _
  port browser.write { ref = "#programmes-notice"; name = "textContent"; value = "Session reset." } → _
  port kernel.invoke { query = "programmes.render"; input = {} } → result

process programmes.apply:
  port state.get { key = "programmes.current" } → current
  port browser.property { ref = "#programmes-action"; name = "value" } → action
  port browser.property { ref = "#programmes-actor"; name = "value" } → actor
  port browser.property { ref = "#programmes-request"; name = "value" } → requestId
  try:
    port kernel.invoke { query = "programmes.propose"; input = { current = $current; proposal = { actor = $actor; action = $action; requestId = $requestId; basis = $current.root } } } → next
    port state.set { key = "programmes.current"; value = $next } → _
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = "Accepted: new content-addressed receipt." } → _
  catch error:
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = concat("Refused; accepted state preserved. ", $error.message) } → _
  port kernel.invoke { query = "programmes.render"; input = {} } → result

process programmes.replay:
  port state.get { key = "programmes.current" } → current
  try:
    port kernel.invoke { query = "programmes.witness"; input = { current = $current } } → report
    port json.stringify { value = $report; space = 2 } → text
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = $text } → _
  catch error:
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = concat("Witness refused: ", $error.message) } → _

process programmes.tamper:
  port state.get { key = "programmes.current" } → current
  port record.put { record = $current; key = "root"; value = "programme:sha256:tampered" } → tampered
  try:
    port kernel.invoke { query = "programmes.witness"; input = { current = $tampered } } → report
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = "Unexpected witness acceptance." } → _
  catch error:
    port browser.write { ref = "#programmes-notice"; name = "textContent"; value = concat("Tamper detected; accepted state preserved. ", $error.message) } → _

process programmes.render:
  port state.get { key = "programmes.current" } → current
  port browser.write { ref = "#programmes-summary"; name = "textContent"; value = concat($current.state.available, " of ", $data.initial.available, " instruments available · revision ", $current.state.revision, " · ", count($current.ledger), " accepted receipts.") } → _
  port json.stringify { value = $current; space = 2 } → text
  port browser.write { ref = "#programmes-ledger"; name = "textContent"; value = $text } → _

process programmes.build:
  let configurationOwner = "programmes"
  call configuration.read
  let pageTitle = "Instrument lending"
  let route = "programmes.html"
  call programmes.view
  let body = $result
  call shell.document
  port runtime.bundle { entry = "programmes.boot"; mode = "browser"; grantProfile = "programmesBrowser"; queries = append(append(append(list("programmes.hash", "programmes.initial", "programmes.propose", "programmes.witness", "programmes.boot", "programmes.reset", "programmes.apply", "programmes.replay", "programmes.tamper", "programmes.render", "canonical.encode", "canonical.identify", "canonical.is", "address.digest", "address.short", "record.remove", "record.clone", "html.escape", "html.serialize", "html.observe", "html.inspect", "html.cssText", "facts.index", "lower.scan", "lower.fresh", "lower.template", "lower.expression", "lower.programme", "lower.model", "lower.start", "admit.binding", "admit.expression", "admit.programme", "admit.model", "admit.effects.programme", "admit.effects", "admit.ownership", "css.render", "css.plan", "css.renderPlan", "language.refuse", "language.line", "language.module", "language.entity", "language.property", "language.compile", "programmes.merkle", "cells.measure"), list("cells.readPath", "cells.evaluateNode", "cells.evaluate", "cells.render", "cells.cellId", "cells.merkle", "cells.merkleLevel", "cells.stateRoot", "cells.cellsByKey", "cells.findCell", "cells.createWorld", "cells.availability", "cells.applyUnchecked", "address.flip", "cells.buildProposal", "cells.checkCanonical", "cells.judge", "cells.namedCells", "cells.commit", "cells.propose", "cells.freshHub", "cells.replay", "cells.forge", "draft.subject", "draft.format", "draft.draft", "draft.proposal", "draft.decide", "draft.verify", "draft.tamper", "programmes.cellInitial", "programmes.cellPropose", "programmes.cellReplay", "programmes.cellForge", "programmes.cellsBoot", "programmes.cellsAction", "programmes.cellsRender", "programmes.draft", "programmes.draftBoot", "programmes.draftAction")), list("ui.cells.tree", "ui.cells.treeY")), list("programmes.cellPreview", "programmes.admissionView", "programmes.cellsPreview")); factSubjects = list("programmes"); data = $configuration; budget = 20000000 } → runtime
  port file.write { path = "programmes-runtime.js"; text = $runtime } → _

process programmes.view:
  let configurationOwner = "programmes"
  call configuration.read
  let result = { tag = "div"; attrs = { id = "programmes-mount"; class = "feature-workbench" }; children = list({ tag = "section"; attrs = { class = "prose" }; children = list({ tag = "h1"; attrs = {}; children = list($configuration.title) }, { tag = "p"; attrs = {}; children = list($configuration.scope) }, { tag = "p"; attrs = { id = "programmes-summary"; class = "status"; "aria-live" = "polite" }; children = list() }, { tag = "div"; attrs = { class = "grid" }; children = list({ tag = "label"; attrs = {}; children = list("Actor", { tag = "select"; attrs = { id = "programmes-actor"; class = "field" }; children = list({ tag = "option"; attrs = { value = $configuration.member }; children = list("Station member") }, { tag = "option"; attrs = { value = "visitor" }; children = list("Visitor (no lending authority)") }) }) }, { tag = "label"; attrs = {}; children = list("Proposal", { tag = "select"; attrs = { id = "programmes-action"; class = "field" }; children = list({ tag = "option"; attrs = { value = "lend" }; children = list("Lend one instrument") }, { tag = "option"; attrs = { value = "return" }; children = list("Return one instrument") }) }) }, { tag = "label"; attrs = {}; children = list("Unique request id", { tag = "input"; attrs = { id = "programmes-request"; value = "request-1"; class = "field" }; children = list() }) }) }, { tag = "div"; attrs = { class = "toolbar" }; children = list({ tag = "button"; attrs = { id = "programmes-apply"; class = "button" }; children = list("apply") }, { tag = "button"; attrs = { id = "programmes-replay"; class = "button" }; children = list("replay") }, { tag = "button"; attrs = { id = "programmes-tamper"; class = "button" }; children = list("tamper") }, { tag = "button"; attrs = { id = "programmes-reset"; class = "button" }; children = list("reset") }) }, { tag = "pre"; attrs = { id = "programmes-notice"; "aria-live" = "polite"; class = "status" }; children = list() }, { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Inspect technical receipt") }, { tag = "pre"; attrs = { id = "programmes-ledger"; class = "card"; disclosed = true }; children = list() }) }, { tag = "section"; attrs = { class = "card" }; children = list({ tag = "h2"; attrs = {}; children = list("Content-addressed equipment cells") }, { tag = "p"; attrs = {}; children = list("A separate reusable cell-world engine: explicit read context, consume/create proposals, bounded covenant evaluation, Merkle roots, witnesses and replay.") }, { tag = "label"; attrs = {}; children = list("Actor", { tag = "select"; attrs = { id = "cells-actor"; class = "field" }; children = map($configuration.cellConfiguration.identities, "i", { tag = "option"; attrs = { value = $i.id }; children = list($i.label) }) }) }, { tag = "label"; attrs = {}; children = list("Cell proposal", { tag = "select"; attrs = { id = "cells-preset"; class = "field" }; children = map($configuration.cellConfiguration.presets, "p", { tag = "option"; attrs = { value = $p.id }; children = list($p.title) }) }) }, { tag = "div"; attrs = { class = "toolbar" }; children = list({ tag = "button"; attrs = { id = "cells-apply"; class = "button" }; children = list("Propose cell change") }, { tag = "button"; attrs = { id = "cells-replay"; class = "button" }; children = list("Replay witnesses") }, { tag = "button"; attrs = { id = "cells-forge"; class = "button" }; children = list("Try forged witness") }) }, { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Inspect technical receipt") }, { tag = "pre"; attrs = { id = "cells-report"; "aria-live" = "polite"; disclosed = true }; children = list() }) }, { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Inspect technical receipt") }, { tag = "pre"; attrs = { id = "cells-ledger"; disclosed = true }; children = list() }) }, { tag = "p"; attrs = { id = "cells-summary"; class = "status" }; children = list() }, { tag = "p"; attrs = { id = "cells-decision"; "aria-live" = "polite" }; children = list() }) }, { tag = "section"; attrs = { class = "card" }; children = list({ tag = "h2"; attrs = {}; children = list("Draft and witness a station procedure") }, { tag = "p"; attrs = {}; children = list("Source-owned language patterns propose a record. A person explicitly accepts or refuses; a separate verifier checks the resulting witness chain.") }, { tag = "textarea"; attrs = { id = "draft-intent"; class = "field"; rows = "3" }; children = list("Track the inlet instrument without publishing") }, { tag = "div"; attrs = { class = "toolbar" }; children = list({ tag = "button"; attrs = { id = "draft-draft"; class = "button" }; children = list("draft") }, { tag = "button"; attrs = { id = "draft-accept"; class = "button" }; children = list("accept") }, { tag = "button"; attrs = { id = "draft-refuse"; class = "button" }; children = list("refuse") }, { tag = "button"; attrs = { id = "draft-verify"; class = "button" }; children = list("verify") }, { tag = "button"; attrs = { id = "draft-tamper"; class = "button" }; children = list("tamper") }) }, { tag = "details"; attrs = {}; children = list({ tag = "summary"; attrs = {}; children = list("Inspect draft and witness details") }, { tag = "pre"; attrs = { id = "draft-report"; "aria-live" = "polite"; disclosed = true }; children = list() }) }) }, { tag = "p"; attrs = { id = "draft-summary"; class = "status"; "aria-live" = "polite" }; children = list() }, { tag = "section"; attrs = { class = "card" }; children = list({ tag = "h2"; attrs = {}; children = list("Equipment cell commitment") }, { tag = "p"; attrs = {}; children = list("Leaves identify cell content. Their parent hashes and the active covenant contribute to the root commitment.") }, { tag = "div"; attrs = { id = "cells-tree" }; children = list() }) }, { tag = "section"; attrs = { class = "card" }; children = list({ tag = "h2"; attrs = {}; children = list("Cell proposal admission") }, { tag = "p"; attrs = {}; children = list("Preview judges the declared proposal against the accepted state without committing it. A refused proposal preserves the existing cell state.") }, { tag = "button"; attrs = { id = "cells-preview"; class = "button" }; children = list("Preview selected cell proposal") }, { tag = "div"; attrs = { id = "cells-stages"; "aria-live" = "polite" }; children = list() }) }) }) }

process programmes.merkle:
  let digests = $eventInput.digests
  when eq(count($digests), 0):
    port kernel.invoke { query = "programmes.hash"; input = { value = list() } } → result
  when eq(count($digests), 1):
    let result = at($digests, 0)
  when not(includes(list(0, 1), count($digests))):
    fold $digests as digest; pairs starts { pending = null; nodes = list() }:
      let paired = not(eq($pairs.pending, null))
      when $paired:
        port kernel.invoke { query = "programmes.hash"; input = { value = list($pairs.pending, $digest) } } → node
      yield if($paired, { pending = null; nodes = append($pairs.nodes, list($node)) }, { pending = $digest; nodes = $pairs.nodes }) → pairs
    when not(eq($pairs.pending, null)):
      port kernel.invoke { query = "programmes.hash"; input = { value = list($pairs.pending, $pairs.pending) } } → node
      let pairs = { pending = null; nodes = append($pairs.nodes, list($node)) }
    port kernel.invoke { query = "programmes.merkle"; input = { digests = $pairs.nodes } } → result

process programmes.cellInitial:
  port kernel.invoke { query = "cells.createWorld"; input = { configuration = $data.cellConfiguration } } → result

process programmes.cellPropose:
  port kernel.invoke { query = "cells.propose"; input = { world = $eventInput.world; recipe = $eventInput.recipe; configuration = $data.cellConfiguration } } → result

process programmes.cellReplay:
  port kernel.invoke { query = "cells.replay"; input = { world = $eventInput.world; configuration = $data.cellConfiguration; journal = $eventInput.world.journal; publishedHead = $eventInput.world.hub.root } } → result

process programmes.cellForge:
  port kernel.invoke { query = "cells.forge"; input = { world = $eventInput.world; mode = $eventInput.mode; configuration = $data.cellConfiguration } } → forged
  assert $forged
    otherwise "FORGE_HISTORY: accept a cell proposal before trying a forged-history exercise."
  port kernel.invoke { query = "cells.replay"; input = { world = $eventInput.world; journal = $forged.journal; publishedHead = $eventInput.world.hub.root; configuration = $data.cellConfiguration } } → verification
  let result = { forged = $forged; verification = $verification }

process programmes.cellsBoot:
  port kernel.invoke { query = "programmes.cellInitial"; input = {} } → world
  port state.set { key = "programmes.cells"; value = $world } → _
  port browser.on { ref = "#cells-apply"; event = "click"; query = "programmes.cellsAction"; input = { action = "apply" } } → _
  port browser.on { ref = "#cells-replay"; event = "click"; query = "programmes.cellsAction"; input = { action = "replay" } } → _
  port browser.on { ref = "#cells-forge"; event = "click"; query = "programmes.cellsAction"; input = { action = "forge" } } → _
  port browser.on { ref = "#cells-preview"; event = "click"; query = "programmes.cellsPreview"; input = {} } → _
  port kernel.invoke { query = "programmes.cellsRender"; input = {} } → result

process programmes.cellsAction:
  port state.get { key = "programmes.cells" } → world
  port browser.property { ref = "#cells-preset"; name = "value" } → preset
  port browser.property { ref = "#cells-actor"; name = "value" } → actor
  try:
    when eq($eventInput.action, "apply"):
      port kernel.invoke { query = "programmes.cellPropose"; input = { world = $world; recipe = { preset = $preset; identity = $actor; stale = false; falseClaim = false; note = "An instrument check at the inlet" } } } → decision
      port state.set { key = "programmes.cells"; value = $decision.world } → _
      let report = $decision.result
      port browser.write { ref = "#cells-decision"; name = "textContent"; value = if($decision.result.accepted, "Cell proposal accepted. Its witness records the consumed cells, explicit read context and new Merkle root.", "Cell proposal refused. The accepted cell state and root are preserved; inspect the admission stages below.") } → _
      port kernel.invoke { query = "programmes.admissionView"; input = { judgment = $decision.result } } → tree
      let input = $tree
      call html.serialize
      port browser.content { ref = "#cells-stages"; html = $result } → _
    when eq($eventInput.action, "replay"):
      port kernel.invoke { query = "programmes.cellReplay"; input = { world = $world } } → report
      port browser.write { ref = "#cells-decision"; name = "textContent"; value = if($report.ok, "Replay reproduced the accepted head from genesis.", "Replay failed; inspect the first failing witness below.") } → _
    when eq($eventInput.action, "forge"):
      port kernel.invoke { query = "programmes.cellForge"; input = { world = $world; mode = "edit" } } → report
      port browser.write { ref = "#cells-decision"; name = "textContent"; value = "A copy of the witness history was forged. The accepted history remains unchanged; inspect verification below." } → _
    port json.stringify { value = $report; space = 2 } → text
    port browser.write { ref = "#cells-report"; name = "textContent"; value = $text } → _
  catch error:
    port browser.write { ref = "#cells-report"; name = "textContent"; value = concat("Refused: ", $error.message) } → _
  port kernel.invoke { query = "programmes.cellsRender"; input = {} } → result

process programmes.cellsRender:
  port state.get { key = "programmes.cells" } → world
  port browser.write { ref = "#cells-summary"; name = "textContent"; value = concat("Cell world: ", count($world.journal), " witnessed proposals. Current state is content-addressed; inspect its Merkle root below.") } → _
  port json.stringify { value = { root = $world.hub.root; state = $world.hub.state; journal = $world.journal }; space = 2 } → text
  port browser.write { ref = "#cells-ledger"; name = "textContent"; value = $text } → _
  port kernel.invoke { query = "ui.cells.tree"; input = { tree = $world.hub.tree; root = $world.hub.root; predicate = $world.hub.state.predicateId; fresh = false; seen = list() } } → layout
  let input = { tag = "svg"; attrs = { viewBox = "0 0 360 175"; role = "img"; "aria-label" = "Content-addressed equipment cells and their Merkle root" }; children = list($layout.nodes) }
  call html.serialize
  port browser.content { ref = "#cells-tree"; html = $result } → _

process programmes.draft:
  port kernel.invoke { query = "draft.proposal"; input = { text = $eventInput.text; configuration = $data.draftConfiguration; previous = $eventInput.previous } } → result

process programmes.draftBoot:
  port state.set { key = "programmes.drafts"; value = list() } → _
  port browser.on { ref = "#draft-draft"; event = "click"; query = "programmes.draftAction"; input = { action = "draft" } } → _
  port browser.on { ref = "#draft-accept"; event = "click"; query = "programmes.draftAction"; input = { action = "accept" } } → _
  port browser.on { ref = "#draft-refuse"; event = "click"; query = "programmes.draftAction"; input = { action = "refuse" } } → _
  port browser.on { ref = "#draft-verify"; event = "click"; query = "programmes.draftAction"; input = { action = "verify" } } → _
  port browser.on { ref = "#draft-tamper"; event = "click"; query = "programmes.draftAction"; input = { action = "tamper" } } → _

process programmes.draftAction:
  port state.get { key = "programmes.drafts" } → ledger
  let action = $eventInput.action
  try:
    when eq($action, "draft"):
      port browser.property { ref = "#draft-intent"; name = "value" } → intent
      port kernel.invoke { query = "programmes.draft"; input = { text = $intent; previous = if(eq(count($ledger), 0), "genesis", at(at($ledger, add(count($ledger), -1)), "witness")) } } → report
      port state.set { key = "programmes.draftCurrent"; value = $report } → _
    when includes(list("accept", "refuse"), $action):
      port state.get { key = "programmes.draftCurrent" } → current
      assert $current
        otherwise "DRAFT_REQUIRED: create a proposal before deciding."
      port kernel.invoke { query = "draft.decide"; input = { ledger = $ledger; current = $current; verdict = $action; note = "Local fictional station review"; at = "local-session" } } → decision
      port state.set { key = "programmes.drafts"; value = $decision.ledger } → _
      let report = $decision
    when eq($action, "verify"):
      port kernel.invoke { query = "draft.verify"; input = { ledger = $ledger } } → report
    when eq($action, "tamper"):
      assert not(eq(count($ledger), 0))
        otherwise "DRAFT_WITNESS_REQUIRED: record one decision first."
      port kernel.invoke { query = "draft.tamper"; input = { ledger = $ledger; originalRecord = at(at($ledger, 0), "record") } } → report
    port browser.write { ref = "#draft-summary"; name = "textContent"; value = if(eq($action, "draft"), "Draft prepared for review. It has no authority to make a real booking.", if(includes(list("accept", "refuse"), $action), concat("Decision recorded: ", $action, ". The witness links to its predecessor."), if(eq($action, "verify"), "Witness verification completed; inspect the result for any failing link.", "Tamper test completed on a copy; accepted history is preserved."))) } → _
    port json.stringify { value = $report; space = 2 } → text
    port browser.write { ref = "#draft-report"; name = "textContent"; value = $text } → _
  catch error:
    port browser.write { ref = "#draft-report"; name = "textContent"; value = concat("Refused; accepted history preserved. ", $error.message) } → _

process programmes.cellPreview:
  port kernel.invoke { query = "cells.buildProposal"; input = { hub = $eventInput.world.hub; registry = $eventInput.world.registry; recipe = $eventInput.recipe; configuration = $data.cellConfiguration } } → proposal
  port kernel.invoke { query = "cells.judge"; input = { hub = $eventInput.world.hub; proposal = $proposal; configuration = $data.cellConfiguration } } → judgment
  let result = { proposal = $proposal; judgment = $judgment }

process programmes.admissionView:
  let result = { tag = "ol"; attrs = { class = "admission-stages" }; children = list(map($eventInput.judgment.stages, "stage", { tag = "li"; attrs = { class = if($stage.ok, "stage-held", "stage-refused") }; children = list({ tag = "strong"; attrs = {}; children = list(concat(at(list("Canonical form and bounds", "Current basis", "Read, consume and create context", "Computed state root", "Active covenant", "Successor bounds"), add($stage.n, -1)), ": ", if($stage.ok, "passed", "refused"))) }, { tag = "p"; attrs = {}; children = list($stage.detail) }) })) }

process programmes.cellsPreview:
  port state.get { key = "programmes.cells" } → world
  port browser.property { ref = "#cells-preset"; name = "value" } → preset
  port browser.property { ref = "#cells-actor"; name = "value" } → actor
  try:
    port kernel.invoke { query = "programmes.cellPreview"; input = { world = $world; recipe = { preset = $preset; identity = $actor; stale = false; falseClaim = false; note = "An instrument check at the inlet" } } } → preview
    port kernel.invoke { query = "programmes.admissionView"; input = { judgment = $preview.judgment } } → tree
    let input = $tree
    call html.serialize
    port browser.content { ref = "#cells-stages"; html = $result } → _
    port browser.write { ref = "#cells-decision"; name = "textContent"; value = if($preview.judgment.accepted, "Preview passes admission. The accepted cell state is unchanged until you propose the change.", "Preview refuses admission. The accepted cell state remains unchanged.") } → _
  catch error:
    port browser.write { ref = "#cells-decision"; name = "textContent"; value = concat("Preview refused: ", $error.message) } → _
