process-module "temple/surface-process-module/1"

process composition.definition:
  let result = {
    protocol = "worldwright/pack/1";
    id = "programmes";
    title = "Instrument lending";
    requires = list("core");
    conflicts = list();
    modules = list(
      {
        source = "algebra/canonical.encounter";
        target = "algebra/canonical.process.json"
      },
      {
        source = "algebra/programmes.encounter";
        target = "algebra/programmes.process.json"
      },
      {
        source = "algebra/cell-values.encounter";
        target = "algebra/cell-values.process.json"
      },
      {
        source = "algebra/cell-proposals.encounter";
        target = "algebra/cell-proposals.process.json"
      },
      {
        source = "algebra/cell-drafts.encounter";
        target = "algebra/cell-drafts.process.json"
      },
      {
        source = "algebra/cell-tree.encounter";
        target = "algebra/cell-tree.process.json"
      }
    );
    sources = list(
      {
        source = "source/programmes.encounter";
        target = "source/programmes.rel"
      }
    );
    assets = list("assets/programmes.css");
    build = "programmes.build";
    navigation = {
      label = "Instrument lending";
      route = "programmes.html"
    };
    grants = {
      build = list("json.parse", "file.write", "runtime.bundle");
      browser = list(
        "browser.content",
        "browser.on",
        "browser.property",
        "browser.write",
        "digest.sha256",
        "dom.exists",
        "json.parse",
        "json.stringify",
        "kernel.invoke",
        "number.calculate",
        "number.parse",
        "record.entries",
        "record.fromEntries",
        "record.get",
        "record.put",
        "state.get",
        "state.set",
        "text.indexOf",
        "text.join",
        "text.lowerCase",
        "text.match",
        "text.matchAll",
        "text.matches",
        "text.replace",
        "text.replaceAll",
        "text.slice",
        "text.split",
        "text.trim",
        "text.upperCase",
        "text.utf8Length",
        "value.describe",
        "value.freeze",
        "value.sort",
        "value.string",
        "value.type"
      )
    };
    runtime = {
      entry = "programmes.boot";
      queries = list("programmes.boot");
      profile = "programmesBrowser";
      allPages = true
    };
    outputs = list("programmes.html", "programmes-runtime.js");
    render = "programmes.view";
    sharedModules = list(
      "algebra/language.process.json",
      "algebra/fact-index.process.json",
      "algebra/lowering.process.json",
      "algebra/admission.process.json"
    );
    stylesheets = list("assets/programmes.css");
    files = list(
      {
        source = "README.md";
        target = "docs/packs/programmes.md"
      }
    )
  }
