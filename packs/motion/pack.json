{
  "protocol": "worldwright/pack/1",
  "id": "motion",
  "title": "Tide instrument",
  "requires": [
    "core"
  ],
  "conflicts": [],
  "modules": [
    "algebra/motion.process.json",
    "algebra/motion-graphics.process.json"
  ],
  "sources": [
    "source/motion.rel"
  ],
  "assets": [],
  "build": "motion.build",
  "render": "motion.view",
  "navigation": {
    "label": "Tide instrument",
    "route": "motion.html"
  },
  "grants": {
    "build": [
      "json.parse",
      "file.write",
      "runtime.bundle"
    ],
    "browser": [
      "browser.attribute",
      "browser.cancel",
      "browser.class",
      "browser.content",
      "browser.environment",
      "browser.focus",
      "browser.fontsReady",
      "browser.frame",
      "browser.intersection",
      "browser.mediaQuery",
      "browser.on",
      "browser.read",
      "browser.relative",
      "browser.select",
      "browser.style",
      "browser.timer",
      "browser.unobserve",
      "browser.write",
      "canvas.draw",
      "dom.exists",
      "image.rasterize",
      "json.parse",
      "kernel.invoke",
      "media.pause",
      "media.play",
      "media.read",
      "media.write",
      "number.calculate",
      "number.format",
      "number.parse",
      "random.values",
      "record.put",
      "state.get",
      "state.set",
      "text.join",
      "text.trim"
    ]
  },
  "runtime": {
    "entry": "motion.boot",
    "queries": [
      "motion.boot",
      "motion.toggle",
      "motion.visibility",
      "motion.schedule",
      "motion.tick",
      "motion.draw"
    ],
    "profile": "motionBrowser",
    "allPages": true
  },
  "outputs": [
    "motion.html",
    "motion-runtime.js"
  ]
}
