process-module "temple/surface-process-module/1"

process motion.boot:
  port dom.exists { selector = "#motion-mount" } → mounted
  when $mounted:
    port browser.environment {} → environment
    port state.set { key = "motion.active"; value = not($environment.reduced) } → _
    port browser.on { ref = "#motion-toggle"; event = "click"; query = "motion.toggle"; input = {} } → _
    port browser.on { ref = "document"; event = "visibilitychange"; query = "motion.visibility"; input = {} } → _
    port state.set { key = "motion.time"; value = 0 } → _
    call motion.draw
    call motion.schedule
  when not($mounted):
    let result = false

process motion.toggle:
  port state.get { key = "motion.active" } → active
  port state.set { key = "motion.active"; value = not($active) } → _
  port state.get { key = "motion.frame" } → frame
  when $frame:
    port browser.cancel { id = $frame } → _
  call motion.draw
  call motion.schedule

process motion.visibility:
  port state.get { key = "motion.frame" } → frame
  when $frame:
    port browser.cancel { id = $frame } → _
  call motion.schedule

process motion.schedule:
  port browser.environment {} → environment
  port state.get { key = "motion.active" } → active
  when and($active, not($environment.hidden)):
    port browser.frame { query = "motion.tick"; input = {} } → frame
    port state.set { key = "motion.frame"; value = $frame } → _
  when not(and($active, not($environment.hidden))):
    let result = false

process motion.tick:
  port state.set { key = "motion.time"; value = $eventInput.time } → _
  call motion.draw
  call motion.schedule

process motion.draw:
  let configuration = $data
  port state.get { key = "motion.time" } → time
  port number.calculate { operation = "divide"; values = list($time, $configuration.speed) } → phase
  let commands = list({ kind = "set"; name = "fillStyle"; value = $configuration.paper }, { name = "fillRect"; args = list(0, 0, 800, 240) }, { kind = "set"; name = "strokeStyle"; value = $configuration.coral }, { kind = "set"; name = "lineWidth"; value = 1 }, { name = "beginPath"; args = list() }, { name = "moveTo"; args = list(0, 120) }, { name = "lineTo"; args = list(800, 120) }, { name = "stroke"; args = list() }, { kind = "set"; name = "strokeStyle"; value = $configuration.ink }, { kind = "set"; name = "lineWidth"; value = 3 }, { name = "beginPath"; args = list() })
  fold range(81) as n; commands starts $commands:
    port number.calculate { operation = "subtract"; values = list($n, 1) } → index
    port number.calculate { operation = "multiply"; values = list($index, 10) } → x
    port number.calculate { operation = "divide"; values = list($x, 100) } → position
    port number.calculate { operation = "add"; values = list($position, $phase) } → angle
    port number.calculate { operation = "sin"; values = list($angle) } → wave
    port number.calculate { operation = "multiply"; values = list($wave, $configuration.amplitude) } → offset
    port number.calculate { operation = "add"; values = list(120, $offset) } → y
    let commands = append($commands, list({ name = if(eq($index, 0), "moveTo", "lineTo"); args = list($x, $y) }))
    yield $commands → commands
  let commands = append($commands, list({ name = "stroke"; args = list() }))
  port canvas.draw { ref = "#motion-canvas"; width = 800; height = 240; dpr = 1; commands = $commands } → _
  port state.get { key = "motion.active" } → active
  port browser.write { ref = "#motion-status"; name = "textContent"; value = if($active, "Live schematic · pause to inspect", "Still schematic · resume when ready") } → _
  let result = true

process motion.view:
  let configurationOwner = "motion"
  call configuration.read
  let result = { tag = "section"; attrs = { id = "motion-mount"; class = "feature-block" }; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list("INSTRUMENT / 05") }, { tag = "h2"; attrs = {}; children = list($configuration.title) }, { tag = "canvas"; attrs = { id = "motion-canvas"; width = "800"; height = "240"; role = "img"; "aria-label" = "Synthetic tidal signal; a still view is shown when reduced motion is enabled." }; children = list("A schematic moving waterline over fixed survey marks.") }, { tag = "p"; attrs = {}; children = list($configuration.caption) }, { tag = "button"; attrs = { id = "motion-toggle"; type = "button"; class = "button" }; children = list("Pause / resume") }, { tag = "p"; attrs = { id = "motion-status"; role = "status" }; children = list("Preparing a still frame.") }) }

process motion.build:
  let configurationOwner = "motion"
  call configuration.read
  let pageTitle = "Tide instrument"
  let route = "motion.html"
  call motion.view
  let body = $result
  call shell.document
  port runtime.bundle { entry = "motion.boot"; mode = "browser"; grantProfile = "motionBrowser"; queries = append(list("motion.boot", "motion.toggle", "motion.visibility", "motion.schedule", "motion.tick", "motion.draw", "motion.scroll.init", "motion.scroll.scenes", "motion.scroll.reduced", "motion.scroll.tocToggle", "motion.scroll.tocClose", "motion.scroll.escape", "motion.scroll.chapters", "motion.scroll.stone", "motion.scroll.cta", "motion.flood.rand", "motion.flood.scatter", "motion.flood.init", "motion.flood.intersection", "motion.flood.scroll", "motion.flood.running", "motion.flood.frame", "motion.flood.wave", "motion.flood.pose", "motion.flood.render", "motion.autoplay.init", "motion.autoplay.toggle", "motion.autoplay.label", "motion.autoplay.intersection", "motion.chapter.init", "motion.chapter.follow", "motion.chapter.reveal", "motion.chapter.scroll", "motion.chapter.mode", "motion.chapter.scenes", "motion.sky.star", "motion.sky.mote", "motion.sky.seed", "motion.sky.plan", "motion.sky.draw"), list("motion.sky.start", "motion.sky.frame", "motion.sky.resize", "motion.sky.reseed", "motion.sky.scroll", "motion.stone.row", "motion.stone", "motion.constellation.pos", "motion.constellation.marker", "motion.constellation.plan", "motion.constellation.init", "motion.constellation.size", "motion.constellation.draw", "motion.constellation.start", "motion.constellation.frame", "motion.constellation.intersection", "motion.constellation.resize", "motion.graphics.html", "html.escape", "html.serialize", "html.observe", "html.inspect", "html.cssText")); factSubjects = list("motion"); data = $configuration; budget = 20000000 } → runtime
  port file.write { path = "motion-runtime.js"; text = $runtime } → _
