process-module "temple/surface-process-module/1"

process sources.view:
  let result = { tag = "section"; attrs = { id = "sources-mount" }; children = list({ tag = "h2"; attrs = {}; children = list("Sources and scope") }, { tag = "div"; attrs = { class = "grid" }; children = map(subjects("isa", "Source"), "source", { tag = "article"; attrs = { class = "card" }; children = list({ tag = "h3"; attrs = {}; children = list(one($source, "title")) }, { tag = "p"; attrs = {}; children = list(one($source, "attribution")) }, { tag = "p"; attrs = {}; children = list(one($source, "scope")) }, if(optional($source, "href"), { tag = "a"; attrs = { href = optional($source, "href") }; children = list("Open source") }, null)) }) }, { tag = "h3"; attrs = {}; children = list("Executable source files") }, { tag = "ul"; attrs = {}; children = map(subjects("isa", "SourceFile"), "file", { tag = "li"; attrs = {}; children = list({ tag = "a"; attrs = { href = one($file, "path") }; children = list(one($file, "path")) }) }) }) }

process sources.build:
  let pageTitle = "Sources"
  let route = "sources.html"
  call sources.view
  let body = $result
  call shell.document
  each subjects("isa", "SourceFile") as file:
    port file.copy { path = one($file, "path") } → _
  port file.copy { path = "source/composition.json" } → _
  port file.copy { path = "composition-receipt.json" } → _
