process-module "temple/surface-process-module/1"

process composition.definition:
  let result = {
    protocol = "worldwright/pack/1";
    id = "inspector";
    title = "Source inspector";
    requires = list("core");
    conflicts = list();
    modules = list(
      {
        source = "algebra/encounter-source.encounter";
        target = "algebra/encounter-source.process.json"
      },
      {
        source = "algebra/source.encounter";
        target = "algebra/source.process.json"
      },
      {
        source = "algebra/inspector.encounter";
        target = "algebra/inspector.process.json"
      }
    );
    sources = list(
      {
        source = "source/inspector.encounter";
        target = "source/inspector.rel"
      }
    );
    assets = list();
    build = "inspector.build";
    navigation = {
      label = "Source inspector";
      route = "inspector.html"
    };
    grants = {
      build = list("json.parse", "file.write", "runtime.bundle");
      browser = list(
        "browser.content",
        "browser.on",
        "browser.property",
        "browser.write",
        "digest.sha256",
        "dom.exists",
        "json.parse",
        "json.stringify",
        "kernel.invoke",
        "record.entries",
        "record.fromEntries",
        "record.put",
        "text.indexOf",
        "text.join",
        "text.matches",
        "text.replaceAll",
        "text.slice",
        "text.split",
        "text.trim",
        "value.describe",
        "value.freeze",
        "value.string",
        "value.type"
      )
    };
    runtime = {
      entry = "inspector.boot";
      queries = list("inspector.boot");
      profile = "inspectorBrowser";
      allPages = true
    };
    outputs = list("inspector.html", "inspector-runtime.js");
    render = "inspector.view";
    sharedModules = list(
      "algebra/language.process.json",
      "algebra/fact-index.process.json",
      "algebra/lowering.process.json",
      "algebra/admission.process.json"
    );
    files = list(
      {
        source = "README.md";
        target = "docs/packs/inspector.md"
      }
    )
  }
