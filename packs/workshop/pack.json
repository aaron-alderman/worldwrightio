{
  "protocol": "worldwright/pack/1",
  "id": "workshop",
  "title": "Notebook workshop",
  "requires": [
    "core",
    "inspector"
  ],
  "conflicts": [],
  "modules": [
    "algebra/encounter-code-types.process.json",
    "algebra/encounter-code-compiler.process.json",
    "algebra/encounter-code-runtime.process.json",
    "algebra/workshop.process.json",
    "algebra/workshop-lab.process.json"
  ],
  "sources": [
    "source/workshop.rel"
  ],
  "assets": [],
  "build": "workshop.build",
  "navigation": {
    "label": "Notebook workshop",
    "route": "workshop.html"
  },
  "grants": {
    "build": [
      "json.parse",
      "file.write",
      "runtime.bundle",
      "file.read",
      "file.copy"
    ],
    "browser": [
      "browser.attribute",
      "browser.content",
      "browser.on",
      "browser.property",
      "browser.write",
      "digest.sha256",
      "dom.exists",
      "json.parse",
      "json.stringify",
      "kernel.evaluate",
      "kernel.execute",
      "kernel.invoke",
      "record.entries",
      "record.fromEntries",
      "record.put",
      "state.get",
      "state.set",
      "text.indexOf",
      "text.join",
      "text.matches",
      "text.replaceAll",
      "text.slice",
      "text.split",
      "text.trim",
      "value.describe",
      "value.freeze",
      "value.string",
      "value.type"
    ]
  },
  "runtime": {
    "entry": "workshop.boot",
    "queries": [
      "workshop.boot"
    ],
    "profile": "workshopBrowser",
    "allPages": true
  },
  "outputs": [
    "workshop.html",
    "workshop-runtime.js"
  ],
  "render": "workshop.view",
  "sharedModules": [
    "algebra/language.process.json",
    "algebra/fact-index.process.json",
    "algebra/lowering.process.json",
    "algebra/admission.process.json"
  ],
  "files": [
    {
      "source": "README.md",
      "target": "docs/packs/workshop.md"
    }
  ]
}
