{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "session.snapshot": [
      {
        "let": "candidate",
        "value": "$eventInput.candidate"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "lab.snapshot",
          "input": {
            "candidate": "$candidate"
          }
        },
        "into": "measured"
      },
      {
        "let": "panels",
        "value": "$measured.rendered"
      },
      {
        "let": "page",
        "value": [
          "at",
          [
            "filter",
            "$panels",
            "panel",
            [
              "eq",
              "$panel.projection.output.type",
              "Page"
            ]
          ],
          0
        ]
      },
      {
        "let": "web",
        "value": [
          "at",
          [
            "filter",
            "$panels",
            "panel",
            [
              "eq",
              "$panel.projection.output.type",
              "WebLink"
            ]
          ],
          0
        ]
      },
      {
        "let": "result",
        "value": {
          "candidate": "$candidate",
          "revision": "$eventInput.revision",
          "receipt": "$eventInput.receipt",
          "title": [
            "at",
            "$page.projection.output.values",
            "P.title"
          ],
          "webLabel": [
            "at",
            "$web.projection.output.values",
            "W.text"
          ],
          "panels": "$panels",
          "sources": {
            "facts": "$candidate.inputs.factText",
            "encounter": "$candidate.inputs.codeText",
            "contracts": "$candidate.inputs.contractText"
          }
        }
      }
    ],
    "session.change": [
      {
        "assert": [
          "eq",
          "$eventInput.request.revision",
          "$eventInput.snapshot.revision"
        ],
        "message": "LAB-STALE: This view is out of date. Reload the current state before editing."
      },
      {
        "let": "before",
        "value": "$eventInput.snapshot"
      },
      {
        "let": "request",
        "value": "$eventInput.request"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "lab.edit",
          "input": {
            "candidate": "$before.candidate",
            "kind": "$request.kind",
            "value": "$request.value"
          }
        },
        "into": "changed"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "session.diff",
          "input": {
            "before": "$before.sources.facts",
            "after": "$changed.candidate.inputs.factText"
          }
        },
        "into": "factDiff"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "session.diff",
          "input": {
            "before": "$before.sources.encounter",
            "after": "$changed.candidate.inputs.codeText"
          }
        },
        "into": "codeDiff"
      },
      {
        "let": "receipt",
        "value": {
          "kind": "$request.kind",
          "value": "$request.value",
          "basis": "$before.revision",
          "destination": "$changed.destination",
          "factDiff": "$factDiff",
          "codeDiff": "$codeDiff",
          "reason": "Change one visible value at its declared semantic owner.",
          "target": [
            "if",
            [
              "eq",
              "$request.kind",
              "title"
            ],
            "ShoreNote / S.Title",
            "experiment.nav.notebook / experiment.FieldMenu / N.label"
          ],
          "goal": "Reproduce the requested value through the existing checked projection."
        }
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "session.snapshot",
          "input": {
            "candidate": "$changed.candidate",
            "revision": [
              "add",
              "$before.revision",
              1
            ],
            "receipt": "$receipt"
          }
        },
        "into": "result"
      }
    ],
    "session.diff": [
      {
        "port": "text.split",
        "args": {
          "value": "$eventInput.before",
          "pattern": "\\r?\\n"
        },
        "into": "before"
      },
      {
        "port": "text.split",
        "args": {
          "value": "$eventInput.after",
          "pattern": "\\r?\\n"
        },
        "into": "after"
      },
      {
        "fold": [
          "range",
          [
            "count",
            "$before"
          ]
        ],
        "as": "line",
        "accumulator": "diff",
        "initial": "",
        "steps": [
          {
            "let": "index",
            "value": [
              "add",
              "$line",
              -1
            ]
          },
          {
            "let": "old",
            "value": [
              "at",
              "$before",
              "$index"
            ]
          },
          {
            "let": "next",
            "value": [
              "at",
              "$after",
              "$index"
            ]
          }
        ],
        "yield": [
          "concat",
          "$diff",
          [
            "if",
            [
              "eq",
              "$old",
              "$next"
            ],
            "",
            [
              "concat",
              [
                "if",
                [
                  "eq",
                  "$diff",
                  ""
                ],
                "",
                "\n"
              ],
              "− ",
              "$old",
              "\n+ ",
              "$next"
            ]
          ]
        ],
        "into": "diff"
      },
      {
        "let": "result",
        "value": [
          "or",
          "$diff",
          "No change."
        ]
      }
    ],
    "lab.snapshot": [
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.run",
          "input": {
            "candidate": "$eventInput.candidate"
          }
        },
        "into": "labProjections"
      },
      {
        "fold": "$labProjections",
        "as": "labP",
        "accumulator": "labRendered",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "let": "input",
            "value": "$labP.output.tree"
          },
          {
            "call": "html.serialize"
          }
        ],
        "yield": [
          "append",
          "$labRendered",
          [
            "list",
            {
              "projection": "$labP",
              "html": "$result"
            }
          ]
        ],
        "into": "labRendered"
      },
      {
        "let": "result",
        "value": {
          "rendered": "$labRendered"
        }
      }
    ],
    "lab.edit": [
      {
        "assert": [
          "includes",
          [
            "list",
            "title",
            "web-label"
          ],
          "$eventInput.kind"
        ],
        "message": "LAB-E001: Choose a notebook-title or web-label edit."
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.run",
          "input": {
            "candidate": "$eventInput.candidate"
          }
        },
        "into": "labCurrent"
      },
      {
        "let": "labMatches",
        "value": [
          "filter",
          "$labCurrent",
          "labP",
          [
            "eq",
            "$labP.output.type",
            [
              "if",
              [
                "eq",
                "$eventInput.kind",
                "title"
              ],
              "Page",
              "WebLink"
            ]
          ]
        ]
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$labMatches"
          ],
          1
        ],
        "message": "LAB-E002: The edit needs one current, derived projection. Reopen the example."
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.patch",
          "input": {
            "candidate": "$eventInput.candidate",
            "projection": [
              "at",
              "$labMatches",
              0
            ],
            "field": [
              "if",
              [
                "eq",
                "$eventInput.kind",
                "title"
              ],
              "P.title",
              "N.label"
            ],
            "value": "$eventInput.value"
          }
        },
        "into": "labPatched"
      },
      {
        "let": "result",
        "value": "$labPatched"
      }
    ]
  }
}
