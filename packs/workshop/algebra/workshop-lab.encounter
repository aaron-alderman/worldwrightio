process-module "temple/surface-process-module/1"

process session.snapshot:
  let candidate = $eventInput.candidate
  port kernel.invoke { query = "lab.snapshot"; input = { candidate = $candidate } } → measured
  let panels = $measured.rendered
  let page = at(filter($panels, "panel", eq($panel.projection.output.type, "Page")), 0)
  let web = at(filter($panels, "panel", eq($panel.projection.output.type, "WebLink")), 0)
  let result = { candidate = $candidate; revision = $eventInput.revision; receipt = $eventInput.receipt; title = at($page.projection.output.values, "P.title"); webLabel = at($web.projection.output.values, "W.text"); panels = $panels; sources = { facts = $candidate.inputs.factText; encounter = $candidate.inputs.codeText; contracts = $candidate.inputs.contractText } }

process session.change:
  assert eq($eventInput.request.revision, $eventInput.snapshot.revision)
    otherwise "LAB-STALE: This view is out of date. Reload the current state before editing."
  let before = $eventInput.snapshot
  let request = $eventInput.request
  port kernel.invoke { query = "lab.edit"; input = { candidate = $before.candidate; kind = $request.kind; value = $request.value } } → changed
  port kernel.invoke { query = "session.diff"; input = { before = $before.sources.facts; after = $changed.candidate.inputs.factText } } → factDiff
  port kernel.invoke { query = "session.diff"; input = { before = $before.sources.encounter; after = $changed.candidate.inputs.codeText } } → codeDiff
  let receipt = { kind = $request.kind; value = $request.value; basis = $before.revision; destination = $changed.destination; factDiff = $factDiff; codeDiff = $codeDiff; reason = "Change one visible value at its declared semantic owner."; target = if(eq($request.kind, "title"), "ShoreNote / S.Title", "experiment.nav.notebook / experiment.FieldMenu / N.label"); goal = "Reproduce the requested value through the existing checked projection." }
  port kernel.invoke { query = "session.snapshot"; input = { candidate = $changed.candidate; revision = add($before.revision, 1); receipt = $receipt } } → result

process session.diff:
  port text.split { value = $eventInput.before; pattern = "\\r?\\n" } → before
  port text.split { value = $eventInput.after; pattern = "\\r?\\n" } → after
  fold range(count($before)) as line; diff starts "":
    let index = add($line, -1)
    let old = at($before, $index)
    let next = at($after, $index)
    yield concat($diff, if(eq($old, $next), "", concat(if(eq($diff, ""), "", "\n"), "− ", $old, "\n+ ", $next))) → diff
  let result = or($diff, "No change.")

process lab.snapshot:
  port kernel.invoke { query = "ec.run"; input = { candidate = $eventInput.candidate } } → labProjections
  fold $labProjections as labP; labRendered starts list():
    let input = $labP.output.tree
    call html.serialize
    yield append($labRendered, list({ projection = $labP; html = $result })) → labRendered
  let result = { rendered = $labRendered }

process lab.edit:
  assert includes(list("title", "web-label"), $eventInput.kind)
    otherwise "LAB-E001: Choose a notebook-title or web-label edit."
  port kernel.invoke { query = "ec.run"; input = { candidate = $eventInput.candidate } } → labCurrent
  let labMatches = filter($labCurrent, "labP", eq($labP.output.type, if(eq($eventInput.kind, "title"), "Page", "WebLink")))
  assert eq(count($labMatches), 1)
    otherwise "LAB-E002: The edit needs one current, derived projection. Reopen the example."
  port kernel.invoke { query = "ec.patch"; input = { candidate = $eventInput.candidate; projection = at($labMatches, 0); field = if(eq($eventInput.kind, "title"), "P.title", "N.label"); value = $eventInput.value } } → labPatched
  let result = $labPatched
