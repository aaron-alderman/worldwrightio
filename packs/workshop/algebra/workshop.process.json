    "workshop.dispatch": [
      {
        "let": "candidate",
        "value": "$eventInput.candidate"
      },
      {
        "let": "codePlan",
        "value": "$candidate.plan"
      },
      {
        "let": "codeModel",
        "value": "$candidate.model"
      },
      {
        "let": "factIndex",
        "value": "$candidate.factIndex"
      },
      {
        "let": "event",
        "value": "$eventInput.event"
      },
      {
        "let": "representation",
        "value": [
          "at",
          [
            "filter",
            "$codePlan.representations",
            "r",
            [
              "eq",
              "$r.id",
              "$event.run"
            ]
          ],
          0
        ]
      },
      {
        "assert": "$representation",
        "message": "WORKSHOP_ACTION: action must name an admitted representation."
      },
      {
        "fold": "$representation.given",
        "as": "given",
        "accumulator": "arguments",
        "initial": {},
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "ec.argument",
              "input": {
                "type": "$given.type",
                "value": [
                  "at",
                  "$event.arguments",
                  "$given.name"
                ]
              }
            },
            "into": "argument"
          },
          {
            "port": "record.put",
            "args": {
              "record": "$arguments",
              "key": "$given.name",
              "value": "$argument"
            },
            "into": "arguments"
          }
        ],
        "yield": "$arguments",
        "into": "arguments"
      },
      {
        "port": "kernel.execute",
        "args": {
          "model": "$codeModel",
          "entry": "$representation.entry",
          "input": "$arguments"
        },
        "into": "output"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.safeTree",
          "input": {
            "tree": "$output.tree"
          }
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.events",
          "input": {
            "tree": "$output.tree",
            "events": "$output.events"
          }
        },
        "into": "_"
      },
      {
        "let": "result",
        "value": "$output"
      }
    ],
    "workshop.activate": [
      {
        "port": "state.get",
        "args": {
          "key": "candidate"
        },
        "into": "candidate"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.run",
          "input": {
            "candidate": "$candidate"
          }
        },
        "into": "projections"
      },
      {
        "let": "row",
        "value": [
          "at",
          [
            "filter",
            "$projections",
            "p",
            [
              "eq",
              "$p.output.type",
              "NotebookRow"
            ]
          ],
          0
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "workshop.dispatch",
          "input": {
            "candidate": "$candidate",
            "event": [
              "at",
              "$row.output.events",
              0
            ]
          }
        },
        "into": "output"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "workshop.html",
          "input": {
            "tree": "$output.tree"
          }
        },
        "into": "markup"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#workshop-open",
          "html": "$markup"
        },
        "into": "_"
      }
    ],
    "workshop.labInitial": [
      {
        "port": "state.get",
        "args": {
          "key": "candidate"
        },
        "into": "candidate"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "session.snapshot",
          "input": {
            "candidate": "$candidate",
            "revision": 0,
            "receipt": null
          }
        },
        "into": "snapshot"
      },
      {
        "port": "state.set",
        "args": {
          "key": "workshop.session",
          "value": "$snapshot"
        },
        "into": "_"
      }
    ],
    "workshop.labApply": [
      {
        "port": "state.get",
        "args": {
          "key": "workshop.session"
        },
        "into": "snapshot"
      },
      {
        "port": "browser.property",
        "args": {
          "ref": "#lab-kind",
          "name": "value"
        },
        "into": "kind"
      },
      {
        "port": "browser.property",
        "args": {
          "ref": "#lab-value",
          "name": "value"
        },
        "into": "value"
      },
      {
        "try": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "session.change",
              "input": {
                "snapshot": "$snapshot",
                "request": {
                  "revision": [
                    "if",
                    [
                      "at",
                      "$eventInput",
                      "stale"
                    ],
                    -1,
                    "$snapshot.revision"
                  ],
                  "kind": "$kind",
                  "value": "$value"
                }
              }
            },
            "into": "changed"
          },
          {
            "port": "state.set",
            "args": {
              "key": "workshop.session",
              "value": "$changed"
            },
            "into": "_"
          },
          {
            "port": "state.set",
            "args": {
              "key": "candidate",
              "value": "$changed.candidate"
            },
            "into": "_"
          },
          {
            "port": "json.stringify",
            "args": {
              "value": "$changed.receipt",
              "space": 2
            },
            "into": "text"
          },
          {
            "port": "browser.write",
            "args": {
              "ref": "#lab-receipt",
              "name": "textContent",
              "value": "$text"
            },
            "into": "_"
          }
        ],
        "error": "error",
        "catch": [
          {
            "port": "browser.write",
            "args": {
              "ref": "#lab-receipt",
              "name": "textContent",
              "value": [
                "concat",
                "Refused; candidate and revision preserved. ",
                "$error.message"
              ]
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "workshop.render",
          "input": {}
        },
        "into": "result"
      }
    ]
  }
}
