process-module "temple/surface-process-module/1"

process composition.definition:
  let result = {
    protocol = "worldwright/pack/1";
    id = "core";
    title = "World foundation";
    requires = list();
    conflicts = list();
    modules = list(
      {
        source = "algebra/core.encounter";
        target = "algebra/core.process.json"
      }
    );
    sources = list(
      "source/world.rel",
      {
        source = "source/presentation.encounter";
        target = "source/presentation.rel"
      }
    );
    assets = list();
    build = "core.build";
    navigation = null;
    grants = {
      build = list("value.sort");
      browser = list()
    };
    outputs = list("index.html", "styles.css");
    files = list(
      {
        source = "README.md";
        target = "docs/packs/core.md"
      }
    )
  }
