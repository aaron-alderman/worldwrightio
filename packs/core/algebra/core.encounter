process-module "temple/surface-process-module/1"

process shell.validate:
  each list("title", "description", "purpose") as field:
    assert not(eq(one("world", $field), null))
      otherwise "WORLD-FIELD: A world needs title, description and purpose."
  each subjects("isa", "FeatureBlock") as block:
    let placement = one($block, "placement")
    let same = filter(subjects("isa", "FeatureBlock"), "other", eq(one($other, "placement"), $placement))
    assert not(eq(one($block, "order"), null))
      otherwise "PACK-MOUNT-ORDER: Every block needs an order."
    assert eq(count(filter($same, "other", eq(one($other, "feature"), one($block, "feature")))), 1)
      otherwise "PACK-MOUNT-DUPLICATE: Mount each feature only once per placement."
    assert eq(count(filter($same, "other", eq(one($other, "order"), one($block, "order")))), 1)
      otherwise "PACK-MOUNT-ORDER: Block order must be unique."
  each subjects("isa", "FeatureBlock") as block:
    port text.matches { value = one($block, "order"); pattern = "^[1-9][0-9]*$" } → validOrder
    assert $validOrder
      otherwise "PACK-MOUNT-ORDER: Orders must be positive integers."
  call shell.validateOutputs

process shell.assets:
  each subjects("isa", "PackAsset") as asset:
    port file.copy { path = one($asset, "path") } → _

process shell.blocks:
  let blocks = filter(subjects("isa", "FeatureBlock"), "candidate", eq(one($candidate, "placement"), $placement))
  port value.sort { values = map($blocks, "candidate", one($candidate, "order")); mode = "numeric" } → orders
  fold $orders as ordinal; trees starts list():
    let matches = filter($blocks, "candidate", eq(one($candidate, "order"), $ordinal))
    let block = at($matches, 0)
    call shell.block
    yield append($trees, list($result)) → result

process shell.document:
  let prefix = if(includes($route, "/"), "../", "")
  let input = { tag = "html"; attrs = { lang = "en" }; children = list({ tag = "head"; attrs = {}; children = append(list({ tag = "meta"; attrs = { charset = "utf-8" }; children = list() }, { tag = "meta"; attrs = { name = "viewport"; content = "width=device-width, initial-scale=1" }; children = list() }, { tag = "base"; attrs = { href = $prefix }; children = list() }, { tag = "title"; attrs = {}; children = list(concat($pageTitle, " · ", one("world", "title"))) }, { tag = "link"; attrs = { rel = "stylesheet"; href = "styles.css" }; children = list() }), map(subjects("isa", "PackStylesheet"), "sheet", { tag = "link"; attrs = { rel = "stylesheet"; href = one($sheet, "path") }; children = list() })) }, { tag = "body"; attrs = {}; children = list({ tag = "header"; attrs = {}; children = list({ tag = "a"; attrs = { href = "index.html"; class = "brand" }; children = list(one("world", "title")) }, { tag = "nav"; attrs = { "aria-label" = "World navigation" }; children = map(subjects("isa", "PackNavigation"), "nav", { tag = "a"; attrs = { href = one($nav, "route") }; children = list(one($nav, "label")) }) }) }, { tag = "main"; attrs = { id = "main"; tabindex = "-1" }; children = $body }, { tag = "p"; attrs = { class = "status"; "data-temple-errors" = ""; "aria-live" = "polite" }; children = list() }, { tag = "footer"; attrs = {}; children = list("Built from selected Worldwright features. ", { tag = "a"; attrs = { href = "build-receipt.json" }; children = list("Build receipt") }) }, { tag = "div"; attrs = {}; children = map(subjects("isa", "PackRuntime"), "runtime", if(or(eq(one($runtime, "allPages"), "true"), eq(one($runtime, "route"), $route)), { tag = "script"; attrs = { src = one($runtime, "output"); defer = true; type = "module" }; children = list() }, null)) }) }) }
  call html.serialize
  port file.write { path = $route; text = concat("<!doctype html>\n", $result) } → _

process core.build:
  let placement = "home"
  call shell.blocks
  let blocks = $result
  let pageTitle = one("world", "title")
  let route = "index.html"
  let body = append(list({ tag = "section"; attrs = { class = "hero" }; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list(if(optional("world", "kicker"), optional("world", "kicker"), "An independent world")) }, { tag = "h1"; attrs = { class = "world-title" }; children = list(one("world", "title")) }, { tag = "p"; attrs = { class = "lead" }; children = list(one("world", "description")) }, { tag = "p"; attrs = {}; children = list(one("world", "purpose")) }, if(optional("world", "image"), { tag = "img"; attrs = { src = optional("world", "image"); alt = if(optional("world", "imageAlt"), optional("world", "imageAlt"), "") }; children = list() }, null), if(and(includes(subjects("isa", "PackNavigation"), "pack.reader"), optional("world", "entry")), { tag = "a"; attrs = { href = concat("places/", one("world", "entry"), ".html"); class = "button primary" }; children = list(if(optional("world", "entryLabel"), one("world", "entryLabel"), "Begin the field notes →")) }, null)) }, { tag = "section"; attrs = { class = "grid" }; children = map(subjects("isa", "PackNavigation"), "nav", { tag = "a"; attrs = { href = one($nav, "route"); class = "card" }; children = list({ tag = "h2"; attrs = {}; children = list(one($nav, "label")) }) }) }), $blocks)
  call shell.document

process shell.validateOutputs:
  let outputs = map(subjects("isa", "PackOutput"), "output", { path = one($output, "path"); owner = one($output, "owner") })
  let outputs = append($outputs, map(subjects("isa", "PackAsset"), "asset", { path = one($asset, "path"); owner = one($asset, "owner") }))
  let outputs = append($outputs, if(includes(subjects("isa", "PackNavigation"), "pack.reader"), map(subjects("isa", "Place"), "place", { path = concat("places/", $place, ".html"); owner = "reader" }), list()))
  let outputs = append($outputs, if(includes(subjects("isa", "PackNavigation"), "pack.microsites"), map(subjects("isa", "Microsite"), "site", { path = one($site, "route"); owner = "microsites" }), list()))
  let outputs = append($outputs, if(includes(subjects("isa", "PackNavigation"), "pack.microsites"), map(filter(subjects("isa", "Microsite"), "site", optional($site, "stylesheet")), "site", { path = one($site, "stylesheetRoute"); owner = "microsites" }), list()))
  let outputs = append($outputs, if(includes(subjects("isa", "PackNavigation"), "pack.sources"), map(subjects("isa", "SourceFile"), "file", { path = one($file, "path"); owner = "sources" }), list()))
  fold $outputs as output; owners starts {}:
    assert not(at($owners, $output.path))
      otherwise "WORLD-OUTPUT-COLLISION: Current source outputs must have one owner; choose a different route or stylesheet path."
    port record.put { record = $owners; key = $output.path; value = $output.owner } → next
    yield $next → outputOwners

# Typed configuration values use explicit record entries and ordered sequences.
process configuration.read:
  fold list(one($configurationOwner, "configuration")) as document; decoded starts null:
    assert eq(one($document, "kind"), "StaticValue")
      otherwise "CONFIGURATION: Expected a typed REL document."
    let node = one($document, "root")
    let depth = 0
    call configuration.value
    yield $result → configuration
  let result = $configuration

process configuration.value:
  assert includes(range(128), add($depth, 1))
    otherwise "CONFIGURATION: Typed REL value exceeds its depth bound."
  let kind = one($node, "type")
  assert includes(list("Record", "Sequence", "String", "Number", "Boolean", "Null"), $kind)
    otherwise "CONFIGURATION: Unknown typed REL value."
  let result = null
  when eq($kind, "String"):
    let result = one($node, "scalar")
  when eq($kind, "Number"):
    let scalar = one($node, "scalar")
    port text.matches { value = $scalar; pattern = "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$" } → numeric
    assert $numeric
      otherwise "CONFIGURATION: Invalid numeric scalar."
    let result = add(0, $scalar)
    port value.describe { value = $result } → number
    assert $number.finite
      otherwise "CONFIGURATION: Non-finite numeric scalar."
  when eq($kind, "Boolean"):
    let scalar = one($node, "scalar")
    assert includes(list("true", "false"), $scalar)
      otherwise "CONFIGURATION: Invalid Boolean scalar."
    let result = eq($scalar, "true")
  when eq($kind, "Sequence"):
    fold objects($node, "item") as child; values starts list():
      let node = $child
      let depth = add($depth, 1)
      call configuration.value
      yield append($values, list($result)) → result
  when eq($kind, "Record"):
    let entries = objects($node, "entry")
    let keys = map($entries, "item", one($item, "key"))
    assert eq(count(distinct($keys)), count($keys))
      otherwise "CONFIGURATION: Duplicate typed REL field."
    fold $entries as item; pairs starts list():
      assert eq(one($item, "type"), "Entry")
        otherwise "CONFIGURATION: Expected a typed REL entry."
      let key = one($item, "key")
      assert not(includes(list("__proto__", "constructor", "prototype"), $key))
        otherwise "CONFIGURATION: Forbidden typed REL field."
      fold list(one($item, "value")) as child; decoded starts null:
        let node = $child
        let depth = add($depth, 1)
        call configuration.value
        yield $result → value
      yield append($pairs, list(list($key, $value))) → pairs
    port record.fromEntries { entries = $pairs } → result
