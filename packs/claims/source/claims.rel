("claims","configuration","{\"claim\":\"Does a rising tide improve visibility at the inlet?\",\"scope\":\"Fictional observations for testing review methods. No scientific conclusion is implied.\",\"evidence\":[{\"id\":\"sighting-a\",\"name\":\"Marker photograph at dawn\",\"direction\":\"Supports\",\"sourceActor\":\"camera-east\",\"sourceIndependent\":\"true\",\"quality\":\"direct\",\"retracted\":\"false\"},{\"id\":\"sighting-b\",\"name\":\"Second observer reports glare\",\"direction\":\"Challenges\",\"sourceActor\":\"observer-west\",\"sourceIndependent\":\"true\",\"quality\":\"direct\",\"retracted\":\"false\"},{\"id\":\"sighting-c\",\"name\":\"Retold dockside report\",\"direction\":\"Supports\",\"sourceActor\":\"camera-east\",\"sourceIndependent\":\"false\",\"quality\":\"retold\",\"retracted\":\"false\"}],\"methods\":[{\"id\":\"direct\",\"name\":\"Direct observations\",\"minimumSources\":2,\"supportThreshold\":1,\"challengeThreshold\":1,\"rules\":[{\"id\":\"direct\",\"conditions\":[{\"field\":\"quality\",\"expected\":\"direct\"},{\"field\":\"retracted\",\"expected\":\"false\"}],\"weight\":1,\"units\":1,\"reason\":\"Direct and unretracted\"}],\"minimum\":2,\"thresholdUnits\":1},{\"id\":\"inclusive\",\"name\":\"Inclusive observations\",\"minimumSources\":1,\"supportThreshold\":2,\"challengeThreshold\":2,\"rules\":[{\"id\":\"unretracted\",\"conditions\":[{\"field\":\"retracted\",\"expected\":\"false\"}],\"weight\":1,\"units\":1,\"reason\":\"Unretracted observation\"}],\"minimum\":1,\"thresholdUnits\":2}]}")
