process-module "temple/surface-process-module/1"

process composition.definition:
  let result = {
    protocol = "worldwright/pack/1";
    id = "claims";
    title = "Evidence review";
    requires = list("core");
    conflicts = list();
    modules = list(
      {
        source = "algebra/claim-review.encounter";
        target = "algebra/claim-review.process.json"
      },
      {
        source = "algebra/claims.encounter";
        target = "algebra/claims.process.json"
      }
    );
    sources = list(
      {
        source = "source/claims.encounter";
        target = "source/claims.rel"
      }
    );
    assets = list();
    build = "claims.build";
    navigation = {
      label = "Evidence review";
      route = "claims.html"
    };
    grants = {
      build = list("json.parse", "file.write", "runtime.bundle");
      browser = list(
        "browser.content",
        "browser.on",
        "browser.property",
        "browser.write",
        "dom.exists",
        "json.parse",
        "json.stringify",
        "kernel.invoke",
        "number.calculate",
        "record.entries",
        "record.fromEntries",
        "record.put",
        "state.get",
        "state.set",
        "text.join",
        "text.matches",
        "text.replaceAll",
        "text.split",
        "text.trim",
        "value.describe",
        "value.freeze",
        "value.string",
        "value.type"
      )
    };
    runtime = {
      entry = "claims.boot";
      queries = list("claims.boot");
      profile = "claimsBrowser";
      allPages = true
    };
    outputs = list("claims.html", "claims-runtime.js");
    render = "claims.view";
    sharedModules = list(
      "algebra/language.process.json",
      "algebra/fact-index.process.json",
      "algebra/lowering.process.json",
      "algebra/admission.process.json"
    );
    files = list(
      {
        source = "README.md";
        target = "docs/packs/claims.md"
      }
    )
  }
