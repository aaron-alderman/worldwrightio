process-module "temple/surface-process-module/1"

process claim.review.item:
  let e = $eventInput.evidence
  let m = $eventInput.method
  let selected = includes($eventInput.selected, $e.id)
  fold $m.rules as rule; trials starts list():
    fold $rule.conditions as condition; checks starts list():
      yield append($checks, list({ field = $condition.field; expected = $condition.expected; actual = at($e, $condition.field); passed = eq(at($e, $condition.field), $condition.expected) })) → checks
    fold $checks as check; passed starts true:
      yield and($passed, $check.passed) → passed
    yield append($trials, list({ id = $rule.id; weight = $rule.weight; units = $rule.units; reason = $rule.reason; matched = $passed; checks = $checks })) → trials
  fold $trials as trial; chosen starts null:
    yield if(and(not($chosen), $trial.matched), $trial, $chosen) → chosen
  let admitted = and($selected, not(eq($chosen, null)))
  let result = { id = $e.id; name = $e.name; direction = $e.direction; source = $e.sourceActor; independent = eq($e.sourceIndependent, "true"); selected = $selected; admitted = $admitted; weight = if($admitted, at($chosen, "weight"), 0); units = if($admitted, at($chosen, "units"), 0); reason = if(not($selected), "Removed from this sandbox snapshot.", if($chosen, at($chosen, "reason"), "No rule matched. This method does not count this item.")); trials = $trials }

process claim.review.method:
  let m = $eventInput.method
  fold $eventInput.evidence as e; total starts { support = 0; challenge = 0; sources = list(); rows = list() }:
    port kernel.invoke { query = "claim.review.item"; input = { evidence = $e; method = $m; selected = $eventInput.selected } } → row
    port number.calculate { operation = "add"; values = list($total.support, if(and($row.admitted, eq($row.direction, "Supports")), $row.units, 0)) } → support
    port number.calculate { operation = "add"; values = list($total.challenge, if(and($row.admitted, eq($row.direction, "Challenges")), $row.units, 0)) } → challenge
    let sources = if(and($row.admitted, $row.independent, not(includes($total.sources, $row.source))), append($total.sources, list($row.source)), $total.sources)
    yield { support = $support; challenge = $challenge; sources = $sources; rows = append($total.rows, list($row)) } → total
  let sourceCount = count($total.sources)
  port number.calculate { operation = "greaterEqual"; values = list($sourceCount, $m.minimum) } → enough
  port number.calculate { operation = "greaterEqual"; values = list($total.support, $m.thresholdUnits) } → supportCrossed
  port number.calculate { operation = "greaterEqual"; values = list($total.challenge, $m.thresholdUnits) } → challengeCrossed
  let verdict = if(not($enough), "Undecided", if(and($supportCrossed, $challengeCrossed), "Conflicted", if($supportCrossed, "Accepted", if($challengeCrossed, "Rejected", "Undecided"))))
  let reason = if(not($enough), "Too few independent sources were admitted.", if(eq($verdict, "Conflicted"), "Both the support and challenge thresholds were reached.", if(eq($verdict, "Accepted"), "Support reached the threshold; challenge did not.", if(eq($verdict, "Rejected"), "Challenge reached the threshold; support did not.", "Neither side reached the threshold."))))
  let result = { method = $m.id; result = $verdict; reason = $reason; support = $total.support; challenge = $total.challenge; independentSources = $sourceCount; rows = $total.rows }

process claim.review.compare:
  fold $eventInput.configuration.methods as method; results starts list():
    port kernel.invoke { query = "claim.review.method"; input = { method = $method; evidence = $eventInput.configuration.evidence; selected = $eventInput.selected } } → review
    yield append($results, list($review)) → result
