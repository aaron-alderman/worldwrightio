{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "claim.review.item": [
      {
        "let": "e",
        "value": "$eventInput.evidence"
      },
      {
        "let": "m",
        "value": "$eventInput.method"
      },
      {
        "let": "selected",
        "value": [
          "includes",
          "$eventInput.selected",
          "$e.id"
        ]
      },
      {
        "fold": "$m.rules",
        "as": "rule",
        "accumulator": "trials",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "fold": "$rule.conditions",
            "as": "condition",
            "accumulator": "checks",
            "initial": [
              "list"
            ],
            "steps": [],
            "yield": [
              "append",
              "$checks",
              [
                "list",
                {
                  "field": "$condition.field",
                  "expected": "$condition.expected",
                  "actual": [
                    "at",
                    "$e",
                    "$condition.field"
                  ],
                  "passed": [
                    "eq",
                    [
                      "at",
                      "$e",
                      "$condition.field"
                    ],
                    "$condition.expected"
                  ]
                }
              ]
            ],
            "into": "checks"
          },
          {
            "fold": "$checks",
            "as": "check",
            "accumulator": "passed",
            "initial": true,
            "steps": [],
            "yield": [
              "and",
              "$passed",
              "$check.passed"
            ],
            "into": "passed"
          }
        ],
        "yield": [
          "append",
          "$trials",
          [
            "list",
            {
              "id": "$rule.id",
              "weight": "$rule.weight",
              "units": "$rule.units",
              "reason": "$rule.reason",
              "matched": "$passed",
              "checks": "$checks"
            }
          ]
        ],
        "into": "trials"
      },
      {
        "fold": "$trials",
        "as": "trial",
        "accumulator": "chosen",
        "initial": null,
        "steps": [],
        "yield": [
          "if",
          [
            "and",
            [
              "not",
              "$chosen"
            ],
            "$trial.matched"
          ],
          "$trial",
          "$chosen"
        ],
        "into": "chosen"
      },
      {
        "let": "admitted",
        "value": [
          "and",
          "$selected",
          [
            "not",
            [
              "eq",
              "$chosen",
              null
            ]
          ]
        ]
      },
      {
        "let": "result",
        "value": {
          "id": "$e.id",
          "name": "$e.name",
          "direction": "$e.direction",
          "source": "$e.sourceActor",
          "independent": [
            "eq",
            "$e.sourceIndependent",
            "true"
          ],
          "selected": "$selected",
          "admitted": "$admitted",
          "weight": [
            "if",
            "$admitted",
            [
              "at",
              "$chosen",
              "weight"
            ],
            0
          ],
          "units": [
            "if",
            "$admitted",
            [
              "at",
              "$chosen",
              "units"
            ],
            0
          ],
          "reason": [
            "if",
            [
              "not",
              "$selected"
            ],
            "Removed from this sandbox snapshot.",
            [
              "if",
              "$chosen",
              [
                "at",
                "$chosen",
                "reason"
              ],
              "No rule matched. This method does not count this item."
            ]
          ],
          "trials": "$trials"
        }
      }
    ],
    "claim.review.method": [
      {
        "let": "m",
        "value": "$eventInput.method"
      },
      {
        "fold": "$eventInput.evidence",
        "as": "e",
        "accumulator": "total",
        "initial": {
          "support": 0,
          "challenge": 0,
          "sources": [
            "list"
          ],
          "rows": [
            "list"
          ]
        },
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "claim.review.item",
              "input": {
                "evidence": "$e",
                "method": "$m",
                "selected": "$eventInput.selected"
              }
            },
            "into": "row"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$total.support",
                [
                  "if",
                  [
                    "and",
                    "$row.admitted",
                    [
                      "eq",
                      "$row.direction",
                      "Supports"
                    ]
                  ],
                  "$row.units",
                  0
                ]
              ]
            },
            "into": "support"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$total.challenge",
                [
                  "if",
                  [
                    "and",
                    "$row.admitted",
                    [
                      "eq",
                      "$row.direction",
                      "Challenges"
                    ]
                  ],
                  "$row.units",
                  0
                ]
              ]
            },
            "into": "challenge"
          },
          {
            "let": "sources",
            "value": [
              "if",
              [
                "and",
                "$row.admitted",
                "$row.independent",
                [
                  "not",
                  [
                    "includes",
                    "$total.sources",
                    "$row.source"
                  ]
                ]
              ],
              [
                "append",
                "$total.sources",
                [
                  "list",
                  "$row.source"
                ]
              ],
              "$total.sources"
            ]
          }
        ],
        "yield": {
          "support": "$support",
          "challenge": "$challenge",
          "sources": "$sources",
          "rows": [
            "append",
            "$total.rows",
            [
              "list",
              "$row"
            ]
          ]
        },
        "into": "total"
      },
      {
        "let": "sourceCount",
        "value": [
          "count",
          "$total.sources"
        ]
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$sourceCount",
            "$m.minimum"
          ]
        },
        "into": "enough"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$total.support",
            "$m.thresholdUnits"
          ]
        },
        "into": "supportCrossed"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$total.challenge",
            "$m.thresholdUnits"
          ]
        },
        "into": "challengeCrossed"
      },
      {
        "let": "verdict",
        "value": [
          "if",
          [
            "not",
            "$enough"
          ],
          "Undecided",
          [
            "if",
            [
              "and",
              "$supportCrossed",
              "$challengeCrossed"
            ],
            "Conflicted",
            [
              "if",
              "$supportCrossed",
              "Accepted",
              [
                "if",
                "$challengeCrossed",
                "Rejected",
                "Undecided"
              ]
            ]
          ]
        ]
      },
      {
        "let": "reason",
        "value": [
          "if",
          [
            "not",
            "$enough"
          ],
          "Too few independent sources were admitted.",
          [
            "if",
            [
              "eq",
              "$verdict",
              "Conflicted"
            ],
            "Both the support and challenge thresholds were reached.",
            [
              "if",
              [
                "eq",
                "$verdict",
                "Accepted"
              ],
              "Support reached the threshold; challenge did not.",
              [
                "if",
                [
                  "eq",
                  "$verdict",
                  "Rejected"
                ],
                "Challenge reached the threshold; support did not.",
                "Neither side reached the threshold."
              ]
            ]
          ]
        ]
      },
      {
        "let": "result",
        "value": {
          "method": "$m.id",
          "result": "$verdict",
          "reason": "$reason",
          "support": "$total.support",
          "challenge": "$total.challenge",
          "independentSources": "$sourceCount",
          "rows": "$total.rows"
        }
      }
    ],
    "claim.review.compare": [
      {
        "fold": "$eventInput.configuration.methods",
        "as": "method",
        "accumulator": "results",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "claim.review.method",
              "input": {
                "method": "$method",
                "evidence": "$eventInput.configuration.evidence",
                "selected": "$eventInput.selected"
              }
            },
            "into": "review"
          }
        ],
        "yield": [
          "append",
          "$results",
          [
            "list",
            "$review"
          ]
        ],
        "into": "result"
      }
    ]
  }
}
