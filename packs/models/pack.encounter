process-module "temple/surface-process-module/1"

process composition.definition:
  let result = {
    protocol = "worldwright/pack/1";
    id = "models";
    title = "Coastal model bench";
    requires = list("core");
    conflicts = list();
    modules = list(
      {
        source = "algebra/reader-models.encounter";
        target = "algebra/reader-models.process.json"
      },
      {
        source = "algebra/models.encounter";
        target = "algebra/models.process.json"
      }
    );
    sources = list(
      {
        source = "source/models.encounter";
        target = "source/models.rel"
      }
    );
    assets = list();
    build = "models.build";
    navigation = {
      label = "Coastal model bench";
      route = "models.html"
    };
    grants = {
      build = list("json.parse", "file.write", "runtime.bundle");
      browser = list(
        "browser.on",
        "browser.property",
        "browser.write",
        "dom.exists",
        "json.parse",
        "json.stringify",
        "kernel.invoke",
        "number.calculate",
        "number.format",
        "number.parse",
        "record.entries",
        "record.fromEntries",
        "record.put",
        "text.join",
        "text.matches",
        "text.replaceAll",
        "text.split",
        "text.trim",
        "value.describe",
        "value.freeze",
        "value.string",
        "value.type"
      )
    };
    runtime = {
      entry = "models.boot";
      queries = list("models.boot");
      profile = "modelsBrowser";
      allPages = true
    };
    outputs = list("models.html", "models-runtime.js");
    render = "models.view";
    sharedModules = list(
      "algebra/language.process.json",
      "algebra/fact-index.process.json",
      "algebra/lowering.process.json",
      "algebra/admission.process.json"
    );
    files = list(
      {
        source = "README.md";
        target = "docs/packs/models.md"
      }
    )
  }
