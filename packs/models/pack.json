{
  "protocol": "worldwright/pack/1",
  "id": "models",
  "title": "Coastal model bench",
  "requires": [
    "core"
  ],
  "conflicts": [],
  "modules": [
    "algebra/reader-models.process.json",
    "algebra/models.process.json"
  ],
  "sources": [
    "source/models.rel"
  ],
  "assets": [],
  "build": "models.build",
  "navigation": {
    "label": "Coastal model bench",
    "route": "models.html"
  },
  "grants": {
    "build": [
      "json.parse",
      "file.write",
      "runtime.bundle"
    ],
    "browser": [
      "browser.on",
      "browser.property",
      "browser.write",
      "dom.exists",
      "json.parse",
      "json.stringify",
      "kernel.invoke",
      "number.calculate",
      "number.format",
      "number.parse",
      "record.entries",
      "record.fromEntries",
      "record.put",
      "text.join",
      "text.matches",
      "text.replaceAll",
      "text.split",
      "text.trim",
      "value.describe",
      "value.freeze",
      "value.string",
      "value.type"
    ]
  },
  "runtime": {
    "entry": "models.boot",
    "queries": [
      "models.boot"
    ],
    "profile": "modelsBrowser",
    "allPages": true
  },
  "outputs": [
    "models.html",
    "models-runtime.js"
  ],
  "render": "models.view",
  "sharedModules": [
    "algebra/language.process.json",
    "algebra/fact-index.process.json",
    "algebra/lowering.process.json",
    "algebra/admission.process.json"
  ],
  "files": [
    {
      "source": "README.md",
      "target": "docs/packs/models.md"
    }
  ]
}
