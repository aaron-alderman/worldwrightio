process-module "temple/surface-process-module/1"

process curvature.check:
  assert not(eq(count($data.dimensions), 0))
    otherwise "CURVATURE-DIMENSIONS: Select at least one dimension."
  each list("image", "mood", "action", "motion") as kind:
    assert includes(list(0, 1), count(filter($data.dimensions, "dimension", eq($dimension.kind, $kind))))
      otherwise "CURVATURE-KIND: Include at most one dimension for each specialised mechanism."
  each $data.dimensions as dimension:
    port text.matches { value = $dimension.id; pattern = "^[a-z][a-z0-9-]*$" } → safe
    assert $safe
      otherwise "CURVATURE-ID: Use safe dimension identifiers."
    assert eq(count(filter($data.dimensions, "other", eq($other.id, $dimension.id))), 1)
      otherwise "CURVATURE-DUPLICATE: Dimension identifiers must be unique."
    assert includes(list("tokens", "image", "mood", "action", "motion"), $dimension.kind)
      otherwise "CURVATURE-KIND: Unknown dimension mechanism."
    assert not(eq(count($dimension.options), 0))
      otherwise "CURVATURE-OPTIONS: Each selected dimension needs an option."
    each $dimension.options as option:
      port text.matches { value = $option.id; pattern = "^[a-z][a-z0-9-]*$" } → safe
      assert $safe
        otherwise "CURVATURE-ID: Use safe option identifiers."
      assert eq(count(filter($dimension.options, "other", eq($other.id, $option.id))), 1)
        otherwise "CURVATURE-DUPLICATE: Options must be unique within their dimension."
      each $option.tokens as token:
        port text.matches { value = $token.name; pattern = "^--ww-[a-z][a-z0-9-]*$" } → safe
        assert $safe
          otherwise "CURVATURE-TOKEN: Presentation tokens must be namespaced."
        assert eq(count(filter($option.tokens, "other", eq($other.name, $token.name))), 1)
          otherwise "CURVATURE-TOKEN: An option cannot write a token twice."
        each filter($data.dimensions, "other", not(eq($other.id, $dimension.id))) as other:
          each $other.options as otherOption:
            assert eq(count(filter($otherOption.tokens, "foreignToken", eq($foreignToken.name, $token.name))), 0)
              otherwise "CURVATURE-OWNERSHIP: Dimensions cannot overwrite one another’s tokens."
        each $dimension.options as sibling:
          assert eq(count(filter($sibling.tokens, "siblingToken", eq($siblingToken.name, $token.name))), 1)
            otherwise "CURVATURE-TOKEN: Every option in a dimension must declare the same token names."
      when eq($dimension.kind, "image"):
        when not(eq($option.src, "")):
          port text.matches { value = $option.src; pattern = "^assets/[a-zA-Z0-9_/-]+\\.(png|jpg|jpeg|webp|svg)$" } → safe
          assert $safe
            otherwise "CURVATURE-IMAGE: Use a declared local asset."
          assert not(eq($option.alt, ""))
            otherwise "CURVATURE-IMAGE: Describe illustrative imagery."
      when eq($dimension.kind, "action"):
        port text.matches { value = $option.href; pattern = "^(#[a-zA-Z0-9_-]+|[a-zA-Z0-9_/-]+\\.html(#[a-zA-Z0-9_-]+)?)$" } → safe
        assert $safe
          otherwise "CURVATURE-ACTION: Use a local declared reading destination."
      when eq($dimension.kind, "motion"):
        assert includes(list(true, false), $option.moving)
          otherwise "CURVATURE-MOTION: Declare whether this option moves."
  each $data.presets as preset:
    assert eq(count(filter($data.presets, "other", eq($other.id, $preset.id))), 1)
      otherwise "CURVATURE-PRESET: Preset identifiers must be unique."
    let selections = $preset.selections
    call curvature.resolve
  assert eq(count(filter($data.presets, "other", eq($other.id, $data.defaultPreset))), 1)
    otherwise "CURVATURE-PRESET: Declare exactly one default preset."
  let result = true

process curvature.resolve:
  assert eq(count($selections), count($data.dimensions))
    otherwise "CURVATURE-SELECTION: Choose exactly one option per selected dimension."
  each $data.dimensions as dimension:
    let choices = filter($selections, "choice", eq($choice.dimension, $dimension.id))
    assert eq(count($choices), 1)
      otherwise "CURVATURE-SELECTION: Missing or duplicated dimension."
    let choice = at($choices, 0)
    assert eq(count(filter($dimension.options, "other", eq($other.id, $choice.option))), 1)
      otherwise "CURVATURE-OPTION: The requested option is not declared."
  let result = $selections

process curvature.defaults:
  let preset = at(filter($data.presets, "preset", eq($preset.id, $data.defaultPreset)), 0)
  let result = $preset.selections

process curvature.boot:
  call curvature.check
  call curvature.defaults
  let selections = $result
  port storage.read { key = $data.storageKey } → stored
  when $stored.ok:
    when $stored.value:
      try:
        port json.parse { text = $stored.value } → saved
        let selections = $saved
        call curvature.resolve
      catch restoreError:
        call curvature.defaults
        let selections = $result
  call curvature.commit
  port dom.exists { selector = "#curvature-mount" } → mounted
  when $mounted:
    port browser.on { ref = "#curvature-mount"; event = "change"; delegate = "select[data-dimension]"; query = "curvature.change"; input = {} } → _
    port browser.on { ref = "#curvature-preset"; event = "change"; query = "curvature.preset"; input = {} } → _
    port browser.on { ref = "#curvature-reset"; event = "click"; query = "curvature.reset"; input = {} } → _
    port browser.on { ref = "#curvature-motion-toggle"; event = "click"; query = "curvature.pause"; input = {} } → _
  port browser.on { ref = "document"; event = "visibilitychange"; query = "curvature.environment"; input = {} } → _
  port browser.on { ref = { media = "(prefers-reduced-motion: reduce)" }; event = "change"; query = "curvature.environment"; input = {} } → _
  port browser.on { ref = "window"; event = "pageshow"; query = "curvature.environment"; input = {} } → _

process curvature.change:
  port state.get { key = "curvature.selections" } → current
  let dimensionId = $eventInput.matched.attributes.data-dimension
  let optionId = $eventInput.matched.value
  assert eq(count(filter($data.dimensions, "other", eq($other.id, $dimensionId))), 1)
    otherwise "CURVATURE-SELECTION: Unknown dimension."
  let selections = map($current, "choice", if(eq($choice.dimension, $dimensionId), { dimension = $dimensionId; option = $optionId }, $choice))
  call curvature.commit
  port browser.write { ref = "#curvature-preset"; name = "value"; value = "custom" } → _

process curvature.preset:
  let presetId = $eventInput.event.target.value
  assert eq(count(filter($data.presets, "other", eq($other.id, $presetId))), 1)
    otherwise "CURVATURE-PRESET: Unknown preset."
  let preset = at(filter($data.presets, "preset", eq($preset.id, $presetId)), 0)
  let selections = $preset.selections
  call curvature.commit
  port dom.exists { selector = "#curvature-status" } → mounted
  when $mounted:
    port browser.write { ref = "#curvature-status"; name = "textContent"; value = $preset.description } → _

process curvature.reset:
  call curvature.defaults
  let selections = $result
  call curvature.commit
  port browser.write { ref = "#curvature-preset"; name = "value"; value = $data.defaultPreset } → _

process curvature.commit:
  call curvature.resolve
  port dom.exists { selector = "#curvature-mount" } → mounted
  port state.set { key = "curvature.selections"; value = $selections } → _
  port browser.attribute { ref = "body"; name = "data-ww-curvature"; value = "true" } → _
  each $data.dimensions as dimension:
    let choice = at(filter($selections, "choice", eq($choice.dimension, $dimension.id)), 0)
    let option = at(filter($dimension.options, "option", eq($option.id, $choice.option)), 0)
    port browser.attribute { ref = "body"; name = concat("data-ww-", $dimension.id); value = $option.id } → _
    each $option.tokens as token:
      port browser.style { ref = "body"; name = $token.name; value = $token.value } → _
    when $mounted:
      port browser.write { ref = concat("#curvature-", $dimension.id); name = "value"; value = $option.id } → _
      when eq($dimension.kind, "image"):
        port browser.attribute { ref = "#curvature-image"; name = "src"; value = if(eq($option.src, ""), null, $option.src) } → _
        port browser.attribute { ref = "#curvature-image"; name = "alt"; value = $option.alt } → _
        port browser.write { ref = "#curvature-image"; name = "hidden"; value = eq($option.src, "") } → _
        port browser.write { ref = "#curvature-caption"; name = "textContent"; value = $option.caption } → _
      when eq($dimension.kind, "mood"):
        port browser.write { ref = "#curvature-heading"; name = "textContent"; value = $option.heading } → _
        port browser.write { ref = "#curvature-description"; name = "textContent"; value = $option.description } → _
      when eq($dimension.kind, "action"):
        port browser.attribute { ref = "#curvature-action"; name = "href"; value = $option.href } → _
        port browser.write { ref = "#curvature-action"; name = "textContent"; value = $option.label } → _
        port browser.write { ref = "#curvature-action-description"; name = "textContent"; value = $option.description } → _
  let matchedPresets = filter($data.presets, "preset", eq(count(filter($preset.selections, "expected", eq(count(filter($selections, "actual", and(eq($actual.dimension, $expected.dimension), eq($actual.option, $expected.option)))), 1))), count($selections)))
  when $mounted:
    port browser.write { ref = "#curvature-preset"; name = "value"; value = if(eq(count($matchedPresets), 1), at(at($matchedPresets, 0), "id"), "custom") } → _
  port json.stringify { value = $selections } → serialized
  port storage.write { key = $data.storageKey; value = $serialized } → saved
  when $mounted:
    port browser.write { ref = "#curvature-status"; name = "textContent"; value = if($saved.ok, "Your choices are saved in this browser. Reset restores the authored composition.", "Your choices apply for this page; browser storage is unavailable.") } → _
  call curvature.environment

process curvature.environment:
  port browser.environment {} → environment
  port state.get { key = "curvature.paused" } → paused
  port state.get { key = "curvature.selections" } → selections
  let motions = filter($data.dimensions, "dimension", eq($dimension.kind, "motion"))
  let moving = if(eq(count($motions), 0), false, at(at(filter(at(at($motions, 0), "options"), "option", eq($option.id, at(at(filter($selections, "choice", eq($choice.dimension, at(at($motions, 0), "id"))), 0), "option"))), 0), "moving"))
  let still = or($environment.reduced, $paused, not($moving))
  port browser.attribute { ref = "body"; name = "data-ww-reduced"; value = if($still, "true", "false") } → _
  port browser.attribute { ref = "body"; name = "data-ww-hidden"; value = if($environment.hidden, "true", "false") } → _
  port dom.exists { selector = "#curvature-motion-toggle" } → mounted
  when $mounted:
    port browser.write { ref = "#curvature-motion-toggle"; name = "disabled"; value = or($environment.reduced, not($moving)) } → _
    port browser.attribute { ref = "#curvature-motion-toggle"; name = "aria-pressed"; value = if($still, "true", "false") } → _
    port browser.write { ref = "#curvature-motion-toggle"; name = "textContent"; value = if($environment.reduced, "Motion follows reduced-motion preference", if(not($moving), "Still composition", if($paused, "Resume scene motion", "Pause scene motion"))) } → _

process curvature.pause:
  port state.get { key = "curvature.paused" } → paused
  port state.set { key = "curvature.paused"; value = not($paused) } → _
  call curvature.environment

process curvature.view:
  let configurationOwner = "curvature"
  call configuration.read
  let data = $configuration
  call curvature.check
  call curvature.defaults
  let selections = $result
  let moods = filter($data.dimensions, "dimension", eq($dimension.kind, "mood"))
  let images = filter($data.dimensions, "dimension", eq($dimension.kind, "image"))
  let actions = filter($data.dimensions, "dimension", eq($dimension.kind, "action"))
  let mood = if(not(eq(count($moods), 0)), at(filter(at(at($moods, 0), "options"), "option", eq($option.id, at(at(filter($selections, "choice", eq($choice.dimension, at(at($moods, 0), "id"))), 0), "option"))), 0), null)
  let image = if(not(eq(count($images), 0)), at(filter(at(at($images, 0), "options"), "option", eq($option.id, at(at(filter($selections, "choice", eq($choice.dimension, at(at($images, 0), "id"))), 0), "option"))), 0), null)
  let action = if(not(eq(count($actions), 0)), at(filter(at(at($actions, 0), "options"), "option", eq($option.id, at(at(filter($selections, "choice", eq($choice.dimension, at(at($actions, 0), "id"))), 0), "option"))), 0), null)
  let result = { tag = "section"; attrs = { id = "curvature-mount"; class = "curvature"; "aria-label" = $data.title }; children = list({ tag = "div"; attrs = { class = "curvature-scene" }; children = list({ tag = "img"; attrs = { id = "curvature-image"; alt = if($image, $image.alt, ""); hidden = if($image, eq($image.src, ""), true); width = "1672"; height = "941"; fetchpriority = "high"; loading = "eager" }; children = list() }, { tag = "div"; attrs = { class = "curvature-horizon"; "aria-hidden" = "true" }; children = list({ tag = "span"; attrs = {}; children = list() }, { tag = "span"; attrs = {}; children = list() }, { tag = "span"; attrs = {}; children = list() }) }, { tag = "div"; attrs = { class = "curvature-story" }; children = list({ tag = "p"; attrs = { class = "eyebrow" }; children = list($data.kicker) }, { tag = "h2"; attrs = { id = "curvature-heading" }; children = list(if($mood, $mood.heading, $data.title)) }, { tag = "p"; attrs = { id = "curvature-description" }; children = list(if($mood, $mood.description, $data.intro)) }, { tag = "a"; attrs = { id = "curvature-action"; class = "button primary"; href = if($action, $action.href, "#curvature-detail") }; children = list(if($action, $action.label, "Explore the layers ↓")) }, { tag = "p"; attrs = { id = "curvature-action-description"; class = "curvature-small" }; children = list(if($action, $action.description, "Choose the layers that suit this world.")) }) }, { tag = "noscript"; attrs = {}; children = list({ tag = "img"; attrs = { src = if($image, if(eq($image.src, ""), null, $image.src), null); alt = if($image, $image.alt, ""); hidden = if($image, eq($image.src, ""), true); width = "1672"; height = "941"; fetchpriority = "high"; class = "curvature-fallback-image" }; children = list() }) }) }, { tag = "p"; attrs = { id = "curvature-caption"; class = "curvature-caption" }; children = list(if($image, $image.caption, "No illustrative image selected.")) }, { tag = "div"; attrs = { class = "curvature-composer" }; children = list({ tag = "label"; attrs = { for = "curvature-preset" }; children = list("A different light") }, { tag = "select"; attrs = { id = "curvature-preset" }; children = append(list({ tag = "option"; attrs = { value = "custom"; disabled = true }; children = list("Your composition") }), map($data.presets, "preset", { tag = "option"; attrs = { value = $preset.id; selected = eq($preset.id, $data.defaultPreset) }; children = list($preset.label) })) }, { tag = "button"; attrs = { id = "curvature-motion-toggle"; type = "button"; "aria-pressed" = "false"; hidden = eq(count(filter($data.dimensions, "dimension", eq($dimension.kind, "motion"))), 0) }; children = list("Pause scene motion") }, { tag = "button"; attrs = { id = "curvature-reset"; type = "button" }; children = list("Reset composition") }) }, { tag = "details"; attrs = { id = "curvature-detail" }; children = list({ tag = "summary"; attrs = {}; children = list("Compose the individual layers") }, { tag = "div"; attrs = { class = "curvature-dimensions" }; children = map($data.dimensions, "dimension", { tag = "label"; attrs = {}; children = list($dimension.label, { tag = "select"; attrs = { id = concat("curvature-", $dimension.id); "data-dimension" = $dimension.id }; children = map($dimension.options, "option", { tag = "option"; attrs = { value = $option.id; selected = eq($option.id, at(at(filter($selections, "choice", eq($choice.dimension, $dimension.id)), 0), "option")) }; children = list($option.label) }) }) }) }, { tag = "p"; attrs = { class = "curvature-small" }; children = list($data.intro) }) }, { tag = "p"; attrs = { id = "curvature-status"; role = "status"; "aria-live" = "polite" }; children = list("These layers belong to this world. Content and source attribution stay attached.") }) }

process curvature.build:
  let configurationOwner = "curvature"
  call configuration.read
  let data = $configuration
  call curvature.check
  each $data.dimensions as dimension:
    when eq($dimension.kind, "action"):
      each $dimension.options as option:
        port text.split { value = $option.href; pattern = "#" } → parts
        let destination = at($parts, 0)
        assert or(eq($option.href, "#curvature-detail"), eq($destination, "index.html"), includes(map(subjects("isa", "PackNavigation"), "nav", one($nav, "route")), $destination), and(includes(subjects("isa", "PackNavigation"), "pack.reader"), includes(map(subjects("isa", "Place"), "place", concat("places/", $place, ".html")), $destination)))
          otherwise "CURVATURE-ACTION: Destination is not supplied by the selected world."
  each $data.dimensions as dimension:
    when eq($dimension.kind, "image"):
      each $dimension.options as option:
        when not(eq($option.src, "")):
          assert includes(map(subjects("isa", "PackAsset"), "asset", one($asset, "path")), $option.src)
            otherwise "CURVATURE-IMAGE: Image is not owned by this composition."
  let pageTitle = $data.title
  let route = "curvature.html"
  call curvature.view
  let body = $result
  call shell.document
  port runtime.bundle { entry = "curvature.boot"; mode = "browser"; grantProfile = "curvatureBrowser"; queries = list("curvature.check", "curvature.resolve", "curvature.defaults", "curvature.boot", "curvature.change", "curvature.preset", "curvature.reset", "curvature.commit", "curvature.environment", "curvature.pause"); factSubjects = list("curvature"); data = $data; budget = 20000000 } → runtime
  port file.write { path = "curvature-runtime.js"; text = $runtime } → _
