process-module "temple/surface-process-module/1"

process source.document:
  port value.describe { value = $input } → shape
  let result = $input
  when eq($shape.type, "string"):
    when optional($input, "configuration"):
      let configurationOwner = $input
      call configuration.read
    when not(optional($input, "configuration")):
      port json.parse { text = one($input, "description") } → result

process source.markup:
  call source.document
  let markupNode = $result
  let markupKind = at($markupNode, "kind")
  let result = ""
  when eq($markupKind, "text"):
    let input = at($markupNode, "text")
    call html.escape
  when eq($markupKind, "comment"):
    let result = concat("<!--", at($markupNode, "text"), "-->")
  when eq($markupKind, "doctype"):
    let result = "<!doctype html>"
  when or(eq($markupKind, "element"), eq($markupKind, "document")):
    fold or(at($markupNode, "children"), list()) as markupChild; markupHTML starts "":
      let input = $markupChild
      call source.markup
      yield concat($markupHTML, $result) → markupChildren
    let result = $markupChildren
    when eq($markupKind, "element"):
      let markupTag = at($markupNode, "tag")
      fold or(at($markupNode, "attributes"), list()) as markupAttribute; markupAttrs starts {}:
        port record.put { record = $markupAttrs; key = at($markupAttribute, "title"); value = at($markupAttribute, "value") } → markupAttrs
        yield $markupAttrs → markupAttributes
      when eq($markupTag, "head"):
        when optional($msDocument, "runtime"):
          let input = { tag = "script"; attrs = { type = "module"; src = one($msDocument, "runtime") }; children = list() }
          call html.serialize
          let markupChildren = concat($markupChildren, $result)
        when optional($msDocument, "canonical"):
          call source.metadata
          let markupChildren = concat($markupChildren, $result)
      let input = { tag = $markupTag; attrs = $markupAttributes; children = list() }
      call html.serialize
      port text.replaceAll { value = $result; search = concat("</", $markupTag, ">"); replacement = concat($markupChildren, "</", $markupTag, ">") } → result
  when eq($markupKind, "world-context-name"):
    let input = one("world", "title")
    call html.escape

process source.css:
  call source.document
  let cssNode = $result
  let cssKind = at($cssNode, "kind")
  fold or(at($cssNode, "children"), list()) as cssChild; cssAccumulatedChildren starts "":
    let input = $cssChild
    call source.css
    yield concat($cssAccumulatedChildren, $result) → cssChildren
  let cssBody = ""
  when eq($cssKind, "root"):
    let cssBody = concat($cssChildren, or(at(at($cssNode, "syntax"), "after"), ""))
  when eq($cssKind, "comment"):
    let cssBody = concat("/*", or(at(at($cssNode, "syntax"), "left"), ""), at($cssNode, "text"), or(at(at($cssNode, "syntax"), "right"), ""), "*/")
  when eq($cssKind, "decl"):
    let cssBody = concat(at($cssNode, "prop"), at(at($cssNode, "syntax"), "between"), at(at($cssNode, "syntax"), "value"), or(at(at($cssNode, "syntax"), "important"), ""), if(eq(or(at(at($cssNode, "syntax"), "semicolon"), ""), "true"), ";", ""))
  when eq($cssKind, "rule"):
    let cssBody = concat(at(at($cssNode, "syntax"), "selector"), or(at(at($cssNode, "syntax"), "between"), ""), "{", $cssChildren, or(at(at($cssNode, "syntax"), "after"), ""), "}", or(at(at($cssNode, "syntax"), "ownSemicolon"), ""))
  when eq($cssKind, "atrule"):
    let cssBody = concat("@", at($cssNode, "title"), or(at(at($cssNode, "syntax"), "afterName"), ""), at(at($cssNode, "syntax"), "params"), or(at(at($cssNode, "syntax"), "between"), ""), if(eq(or(at($cssNode, "hasChildren"), ""), "true"), concat("{", $cssChildren, or(at(at($cssNode, "syntax"), "after"), ""), "}"), if(eq(or(at(at($cssNode, "syntax"), "semicolon"), ""), "true"), ";", "")))
  let result = concat(or(at(at($cssNode, "syntax"), "before"), ""), $cssBody)

process source.metadata:
  let input = list({ tag = "link"; attrs = { rel = "canonical"; href = concat(one("world", "origin"), one($msDocument, "canonical")) }; children = list() }, { tag = "meta"; attrs = { property = "og:type"; content = one($msDocument, "og:type") }; children = list() }, { tag = "meta"; attrs = { property = "og:title"; content = if(optional($msDocument, "sharing"), one(one($msDocument, "sharing"), "title"), one($msDocument, "og:title")) }; children = list() }, { tag = "meta"; attrs = { property = "og:description"; content = if(optional($msDocument, "sharing"), one(one($msDocument, "sharing"), "description"), one($msDocument, "og:description")) }; children = list() }, { tag = "meta"; attrs = { property = "og:url"; content = concat(one("world", "origin"), one($msDocument, "og:url")) }; children = list() }, { tag = "meta"; attrs = { property = "og:image"; content = if(optional($msDocument, "sharing"), concat(one("world", "origin"), one(one($msDocument, "sharing"), "image")), concat(one("world", "origin"), one($msDocument, "og:image"))) }; children = list() }, { tag = "meta"; attrs = { property = "og:image:alt"; content = if(optional($msDocument, "sharing"), one(one($msDocument, "sharing"), "alt"), one($msDocument, "og:image:alt")) }; children = list() }, { tag = "meta"; attrs = { name = "twitter:card"; content = one($msDocument, "twitter:card") }; children = list() }, { tag = "meta"; attrs = { name = "twitter:title"; content = if(optional($msDocument, "sharing"), one(one($msDocument, "sharing"), "title"), one($msDocument, "twitter:title")) }; children = list() }, { tag = "meta"; attrs = { name = "twitter:description"; content = if(optional($msDocument, "sharing"), one(one($msDocument, "sharing"), "description"), one($msDocument, "twitter:description")) }; children = list() }, { tag = "meta"; attrs = { name = "twitter:image"; content = if(optional($msDocument, "sharing"), concat(one("world", "origin"), one(one($msDocument, "sharing"), "image")), concat(one("world", "origin"), one($msDocument, "twitter:image"))) }; children = list() }, if(optional($msDocument, "sharing"), { tag = "meta"; attrs = { property = "og:image:secure_url"; content = concat(one("world", "origin"), one(one($msDocument, "sharing"), "image")) }; children = list() }, null), if(optional($msDocument, "sharing"), { tag = "meta"; attrs = { property = "og:image:width"; content = one(one($msDocument, "sharing"), "width") }; children = list() }, null), if(optional($msDocument, "sharing"), { tag = "meta"; attrs = { property = "og:image:height"; content = one(one($msDocument, "sharing"), "height") }; children = list() }, null), if(optional($msDocument, "sharing"), { tag = "meta"; attrs = { property = "og:image:type"; content = one(one($msDocument, "sharing"), "type") }; children = list() }, null), if(optional($msDocument, "sharing"), { tag = "meta"; attrs = { name = "twitter:image:alt"; content = one(one($msDocument, "sharing"), "alt") }; children = list() }, null))
  call html.serialize
