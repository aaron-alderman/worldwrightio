{
  "protocol": "worldwright/project-context/3",
  "name": "Worldwright",
  "purpose": "Help people and their agents compose inspectable worlds from their own purpose, content and sources.",
  "repository": "https://github.com/aaron-alderman/worldwrightio",
  "site": "https://worldwright.io",
  "initialWorld": "https://aaronalderman.com",
  "readFirst": [
    "AGENTS.md",
    "docs/operating-model.md",
    "context/operating-model.json",
    "docs/composition.md",
    "docs/start.md",
    "docs/templates.md",
    "docs/architecture.md",
    "docs/lightning.md"
  ],
  "starter": "templates/composable",
  "featureContract": "templates/feature.json",
  "catalogue": "packs/*/pack.json",
  "create": "npm run new -- worlds/my-world --features reader,sources,atlas",
  "hubChecks": [
    "npm run build",
    "npm test"
  ],
  "worldChecks": [
    "npm run build",
    "npm test"
  ],
  "owners": {
    "meaning": "source/world.rel",
    "presentation": "source/presentation.rel",
    "configuration": "selected pack source/*.rel",
    "policy": "selected pack algebra/*.process.json",
    "manifest": "bootstrap/site.json",
    "selection": "composition-receipt.json"
  },
  "open": [
    "Independent human usability study",
    "Capabilities beyond the bounded initial feature set",
    "Complete humane authoring language",
    "Algebraic self-hosting of the documentation hub"
  ],
  "evidenceFamily": "worldwright-composition-2026-11-06",
  "fullStarter": "examples/tidepool/profile.json",
  "nodeCreate": "node tooling/compose-world.mjs worlds/my-world --features reader,sources,atlas",
  "featureRecipes": "templates/features",
  "extraction": "context/extraction.json",
  "trialProtocol": "context/agent-trial-protocol.json",
  "minimalStarter": "templates/composable",
  "minimalOwners": {
    "meaning": "source/world.rel",
    "presentation": "source/presentation.rel",
    "policy": "algebra/world.process.json"
  },
  "trialReport": "evidence/composition/consumers.json",
  "packRegistry": "packs",
  "compositionAlgebra": "packs/composition.process.json",
  "compositionGuide": "docs/composition.md",
  "compositionCoverage": "context/composition-coverage.json",
  "historicalTemplates": {
    "world": "Minimal reading world",
    "expedition": "Full feature composition with local source, assets, effects and checks"
  },
  "agentAuthoredWorld": "examples/seed-library/profile.json",
  "operatingModel": "context/operating-model.json",
  "operatingModelDocument": "docs/operating-model.md",
  "currentDirection": "Record the operating model in documentation and agent context; no new features at this stage"
}
