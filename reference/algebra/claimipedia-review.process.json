{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "claim.review.item": [
      {
        "let": "e",
        "value": "$eventInput.evidence"
      },
      {
        "let": "m",
        "value": "$eventInput.method"
      },
      {
        "let": "selected",
        "value": [
          "includes",
          "$eventInput.selected",
          "$e.id"
        ]
      },
      {
        "fold": "$m.rules",
        "as": "rule",
        "accumulator": "trials",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "fold": "$rule.conditions",
            "as": "condition",
            "accumulator": "checks",
            "initial": [
              "list"
            ],
            "steps": [],
            "yield": [
              "append",
              "$checks",
              [
                "list",
                {
                  "field": "$condition.field",
                  "expected": "$condition.expected",
                  "actual": [
                    "at",
                    "$e",
                    "$condition.field"
                  ],
                  "passed": [
                    "eq",
                    [
                      "at",
                      "$e",
                      "$condition.field"
                    ],
                    "$condition.expected"
                  ]
                }
              ]
            ],
            "into": "checks"
          },
          {
            "fold": "$checks",
            "as": "check",
            "accumulator": "passed",
            "initial": true,
            "steps": [],
            "yield": [
              "and",
              "$passed",
              "$check.passed"
            ],
            "into": "passed"
          }
        ],
        "yield": [
          "append",
          "$trials",
          [
            "list",
            {
              "id": "$rule.id",
              "weight": "$rule.weight",
              "units": "$rule.units",
              "reason": "$rule.reason",
              "matched": "$passed",
              "checks": "$checks"
            }
          ]
        ],
        "into": "trials"
      },
      {
        "fold": "$trials",
        "as": "trial",
        "accumulator": "chosen",
        "initial": null,
        "steps": [],
        "yield": [
          "if",
          [
            "and",
            [
              "not",
              "$chosen"
            ],
            "$trial.matched"
          ],
          "$trial",
          "$chosen"
        ],
        "into": "chosen"
      },
      {
        "let": "admitted",
        "value": [
          "and",
          "$selected",
          [
            "not",
            [
              "eq",
              "$chosen",
              null
            ]
          ]
        ]
      },
      {
        "let": "result",
        "value": {
          "id": "$e.id",
          "name": "$e.name",
          "direction": "$e.direction",
          "source": "$e.sourceActor",
          "independent": [
            "eq",
            "$e.sourceIndependent",
            "true"
          ],
          "selected": "$selected",
          "admitted": "$admitted",
          "weight": [
            "if",
            "$admitted",
            [
              "at",
              "$chosen",
              "weight"
            ],
            0
          ],
          "units": [
            "if",
            "$admitted",
            [
              "at",
              "$chosen",
              "units"
            ],
            0
          ],
          "reason": [
            "if",
            [
              "not",
              "$selected"
            ],
            "Removed from this sandbox snapshot.",
            [
              "if",
              "$chosen",
              [
                "at",
                "$chosen",
                "reason"
              ],
              "No rule matched. This method does not count this item."
            ]
          ],
          "trials": "$trials"
        }
      }
    ],
    "claim.review.method": [
      {
        "let": "m",
        "value": "$eventInput.method"
      },
      {
        "fold": "$eventInput.evidence",
        "as": "e",
        "accumulator": "total",
        "initial": {
          "support": 0,
          "challenge": 0,
          "sources": [
            "list"
          ],
          "rows": [
            "list"
          ]
        },
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "claim.review.item",
              "input": {
                "evidence": "$e",
                "method": "$m",
                "selected": "$eventInput.selected"
              }
            },
            "into": "row"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$total.support",
                [
                  "if",
                  [
                    "and",
                    "$row.admitted",
                    [
                      "eq",
                      "$row.direction",
                      "Supports"
                    ]
                  ],
                  "$row.units",
                  0
                ]
              ]
            },
            "into": "support"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "add",
              "values": [
                "list",
                "$total.challenge",
                [
                  "if",
                  [
                    "and",
                    "$row.admitted",
                    [
                      "eq",
                      "$row.direction",
                      "Challenges"
                    ]
                  ],
                  "$row.units",
                  0
                ]
              ]
            },
            "into": "challenge"
          },
          {
            "let": "sources",
            "value": [
              "if",
              [
                "and",
                "$row.admitted",
                "$row.independent",
                [
                  "not",
                  [
                    "includes",
                    "$total.sources",
                    "$row.source"
                  ]
                ]
              ],
              [
                "append",
                "$total.sources",
                [
                  "list",
                  "$row.source"
                ]
              ],
              "$total.sources"
            ]
          }
        ],
        "yield": {
          "support": "$support",
          "challenge": "$challenge",
          "sources": "$sources",
          "rows": [
            "append",
            "$total.rows",
            [
              "list",
              "$row"
            ]
          ]
        },
        "into": "total"
      },
      {
        "let": "sourceCount",
        "value": [
          "count",
          "$total.sources"
        ]
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$sourceCount",
            "$m.minimum"
          ]
        },
        "into": "enough"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$total.support",
            "$m.thresholdUnits"
          ]
        },
        "into": "supportCrossed"
      },
      {
        "port": "number.calculate",
        "args": {
          "operation": "greaterEqual",
          "values": [
            "list",
            "$total.challenge",
            "$m.thresholdUnits"
          ]
        },
        "into": "challengeCrossed"
      },
      {
        "let": "verdict",
        "value": [
          "if",
          [
            "not",
            "$enough"
          ],
          "Undecided",
          [
            "if",
            [
              "and",
              "$supportCrossed",
              "$challengeCrossed"
            ],
            "Conflicted",
            [
              "if",
              "$supportCrossed",
              "Accepted",
              [
                "if",
                "$challengeCrossed",
                "Rejected",
                "Undecided"
              ]
            ]
          ]
        ]
      },
      {
        "let": "reason",
        "value": [
          "if",
          [
            "not",
            "$enough"
          ],
          "Too few independent sources were admitted.",
          [
            "if",
            [
              "eq",
              "$verdict",
              "Conflicted"
            ],
            "Both the support and challenge thresholds were reached.",
            [
              "if",
              [
                "eq",
                "$verdict",
                "Accepted"
              ],
              "Support reached the threshold; challenge did not.",
              [
                "if",
                [
                  "eq",
                  "$verdict",
                  "Rejected"
                ],
                "Challenge reached the threshold; support did not.",
                "Neither side reached the threshold."
              ]
            ]
          ]
        ]
      },
      {
        "let": "result",
        "value": {
          "method": "$m.id",
          "result": "$verdict",
          "reason": "$reason",
          "support": "$total.support",
          "challenge": "$total.challenge",
          "independentSources": "$sourceCount",
          "rows": "$total.rows"
        }
      }
    ],
    "claim.review.compare": [
      {
        "fold": "$eventInput.configuration.methods",
        "as": "method",
        "accumulator": "results",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "claim.review.method",
              "input": {
                "method": "$method",
                "evidence": "$eventInput.configuration.evidence",
                "selected": "$eventInput.selected"
              }
            },
            "into": "review"
          }
        ],
        "yield": [
          "append",
          "$results",
          [
            "list",
            "$review"
          ]
        ],
        "into": "result"
      }
    ],
    "claim.review.html": [
      {
        "let": "input",
        "value": "$eventInput.node"
      },
      {
        "call": "html.serialize"
      }
    ],
    "claim.review.boot": [
      {
        "port": "state.set",
        "args": {
          "key": "selected",
          "value": [
            "map",
            "$data.configuration.evidence",
            "e",
            "$e.id"
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#review-evidence",
          "event": "change",
          "query": "claim.review.change",
          "input": {},
          "delegate": "input[data-evidence]"
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#review-reset",
          "event": "click",
          "query": "claim.review.reset",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "claim.review.render",
          "input": {}
        },
        "into": "result"
      }
    ],
    "claim.review.change": [
      {
        "port": "browser.select",
        "args": {
          "selector": "#review-evidence input:checked"
        },
        "into": "checked"
      },
      {
        "port": "state.set",
        "args": {
          "key": "selected",
          "value": [
            "map",
            "$checked",
            "field",
            [
              "at",
              "$field.attributes",
              "data-evidence"
            ]
          ]
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "claim.review.render",
          "input": {}
        },
        "into": "result"
      }
    ],
    "claim.review.reset": [
      {
        "port": "state.set",
        "args": {
          "key": "selected",
          "value": [
            "map",
            "$data.configuration.evidence",
            "e",
            "$e.id"
          ]
        },
        "into": "_"
      },
      {
        "each": "$data.configuration.evidence",
        "as": "e",
        "steps": [
          {
            "port": "browser.write",
            "args": {
              "ref": [
                "concat",
                "[data-evidence=\"",
                "$e.id",
                "\"]"
              ],
              "name": "checked",
              "value": true
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "claim.review.render",
          "input": {}
        },
        "into": "result"
      }
    ],
    "claim.review.render": [
      {
        "port": "state.get",
        "args": {
          "key": "selected"
        },
        "into": "selected"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "claim.review.compare",
          "input": {
            "configuration": "$data.configuration",
            "selected": "$selected"
          }
        },
        "into": "reviews"
      },
      {
        "fold": "$reviews",
        "as": "review",
        "accumulator": "cards",
        "initial": [
          "list"
        ],
        "steps": [
          {
            "let": "method",
            "value": [
              "at",
              [
                "filter",
                "$data.configuration.methods",
                "m",
                [
                  "eq",
                  "$m.id",
                  "$review.method"
                ]
              ],
              0
            ]
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "divide",
              "values": [
                "list",
                "$review.support",
                1000000
              ]
            },
            "into": "support"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "divide",
              "values": [
                "list",
                "$review.challenge",
                1000000
              ]
            },
            "into": "challenge"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "multiply",
              "values": [
                "list",
                "$support",
                50
              ]
            },
            "into": "supportWidth"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "multiply",
              "values": [
                "list",
                "$challenge",
                50
              ]
            },
            "into": "challengeWidth"
          },
          {
            "port": "number.calculate",
            "args": {
              "operation": "multiply",
              "values": [
                "list",
                "$method.threshold",
                50
              ]
            },
            "into": "thresholdWidth"
          },
          {
            "let": "card",
            "value": {
              "tag": "article",
              "attrs": {
                "class": "review-card",
                "data-verdict": "$review.result"
              },
              "children": [
                "list",
                {
                  "tag": "p",
                  "attrs": {
                    "class": "claim-eyebrow"
                  },
                  "children": [
                    "list",
                    "Method / 1.0.0"
                  ]
                },
                {
                  "tag": "h3",
                  "attrs": {},
                  "children": [
                    "list",
                    "$method.name"
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "review-method"
                  },
                  "children": [
                    "list",
                    "$method.summary"
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "review-verdict"
                  },
                  "children": [
                    "list",
                    "$review.result"
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "review-reason"
                  },
                  "children": [
                    "list",
                    "$review.reason"
                  ]
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "review-measures"
                  },
                  "children": [
                    "list",
                    {
                      "tag": "div",
                      "attrs": {
                        "class": "review-measure"
                      },
                      "children": [
                        "list",
                        {
                          "tag": "div",
                          "attrs": {
                            "class": "review-measure-label"
                          },
                          "children": [
                            "list",
                            {
                              "tag": "span",
                              "attrs": {},
                              "children": [
                                "list",
                                "Support"
                              ]
                            },
                            {
                              "tag": "b",
                              "attrs": {},
                              "children": [
                                "list",
                                [
                                  "concat",
                                  "$support",
                                  " points"
                                ]
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "div",
                          "attrs": {
                            "class": "review-track",
                            "aria-hidden": "true"
                          },
                          "children": [
                            "list",
                            {
                              "tag": "span",
                              "attrs": {
                                "class": "review-fill support",
                                "style": [
                                  "concat",
                                  "width:",
                                  "$supportWidth",
                                  "%"
                                ]
                              },
                              "children": [
                                "list"
                              ]
                            },
                            {
                              "tag": "i",
                              "attrs": {
                                "style": [
                                  "concat",
                                  "left:",
                                  "$thresholdWidth",
                                  "%"
                                ]
                              },
                              "children": [
                                "list"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tag": "div",
                      "attrs": {
                        "class": "review-measure"
                      },
                      "children": [
                        "list",
                        {
                          "tag": "div",
                          "attrs": {
                            "class": "review-measure-label"
                          },
                          "children": [
                            "list",
                            {
                              "tag": "span",
                              "attrs": {},
                              "children": [
                                "list",
                                "Challenge"
                              ]
                            },
                            {
                              "tag": "b",
                              "attrs": {},
                              "children": [
                                "list",
                                [
                                  "concat",
                                  "$challenge",
                                  " points"
                                ]
                              ]
                            }
                          ]
                        },
                        {
                          "tag": "div",
                          "attrs": {
                            "class": "review-track",
                            "aria-hidden": "true"
                          },
                          "children": [
                            "list",
                            {
                              "tag": "span",
                              "attrs": {
                                "class": "review-fill challenge",
                                "style": [
                                  "concat",
                                  "width:",
                                  "$challengeWidth",
                                  "%"
                                ]
                              },
                              "children": [
                                "list"
                              ]
                            },
                            {
                              "tag": "i",
                              "attrs": {
                                "style": [
                                  "concat",
                                  "left:",
                                  "$thresholdWidth",
                                  "%"
                                ]
                              },
                              "children": [
                                "list"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {
                    "class": "review-threshold"
                  },
                  "children": [
                    "list",
                    [
                      "concat",
                      "Threshold: ",
                      "$method.threshold",
                      " points on either side. Independent sources: ",
                      "$review.independentSources",
                      " / ",
                      "$method.minimum",
                      " required."
                    ]
                  ]
                },
                {
                  "tag": "details",
                  "attrs": {},
                  "children": [
                    "list",
                    {
                      "tag": "summary",
                      "attrs": {},
                      "children": [
                        "list",
                        "Read the reasoning"
                      ]
                    },
                    {
                      "tag": "div",
                      "attrs": {
                        "class": "review-trace"
                      },
                      "children": [
                        "list",
                        [
                          "map",
                          "$review.rows",
                          "row",
                          {
                            "tag": "section",
                            "attrs": {
                              "class": "review-trace-item"
                            },
                            "children": [
                              "list",
                              {
                                "tag": "h4",
                                "attrs": {},
                                "children": [
                                  "list",
                                  "$row.name"
                                ]
                              },
                              {
                                "tag": "p",
                                "attrs": {
                                  "class": "review-item-status"
                                },
                                "children": [
                                  "list",
                                  [
                                    "if",
                                    "$row.admitted",
                                    [
                                      "concat",
                                      "Included · ",
                                      "$row.weight",
                                      " points · ",
                                      [
                                        "if",
                                        [
                                          "eq",
                                          "$row.direction",
                                          "Supports"
                                        ],
                                        "supports",
                                        "challenges"
                                      ]
                                    ],
                                    [
                                      "if",
                                      "$row.selected",
                                      "Not counted",
                                      "Removed from snapshot"
                                    ]
                                  ]
                                ]
                              },
                              {
                                "tag": "p",
                                "attrs": {},
                                "children": [
                                  "list",
                                  "$row.reason"
                                ]
                              },
                              [
                                "if",
                                "$row.selected",
                                [
                                  "map",
                                  "$row.trials",
                                  "trial",
                                  {
                                    "tag": "div",
                                    "attrs": {
                                      "class": "review-rule"
                                    },
                                    "children": [
                                      "list",
                                      {
                                        "tag": "p",
                                        "attrs": {
                                          "class": "review-rule-id"
                                        },
                                        "children": [
                                          "list",
                                          "$trial.id"
                                        ]
                                      },
                                      [
                                        "if",
                                        [
                                          "eq",
                                          [
                                            "count",
                                            "$trial.checks"
                                          ],
                                          0
                                        ],
                                        {
                                          "tag": "p",
                                          "attrs": {},
                                          "children": [
                                            "list",
                                            "No conditions: this rule accepts every submitted item."
                                          ]
                                        },
                                        {
                                          "tag": "ul",
                                          "attrs": {},
                                          "children": [
                                            "list",
                                            [
                                              "map",
                                              "$trial.checks",
                                              "check",
                                              {
                                                "tag": "li",
                                                "attrs": {},
                                                "children": [
                                                  "list",
                                                  [
                                                    "concat",
                                                    [
                                                      "if",
                                                      "$check.passed",
                                                      "Pass: ",
                                                      "Fail: "
                                                    ],
                                                    [
                                                      "at",
                                                      {
                                                        "evidenceType": "Kind of evidence",
                                                        "sourceCredentialed": "Credentialed source",
                                                        "sourceIndependent": "Independent source",
                                                        "peerReviewed": "Peer reviewed",
                                                        "retracted": "Retracted"
                                                      },
                                                      "$check.field"
                                                    ],
                                                    ": ",
                                                    [
                                                      "if",
                                                      [
                                                        "eq",
                                                        "$check.actual",
                                                        "true"
                                                      ],
                                                      "yes",
                                                      [
                                                        "if",
                                                        [
                                                          "eq",
                                                          "$check.actual",
                                                          "false"
                                                        ],
                                                        "no",
                                                        "$check.actual"
                                                      ]
                                                    ],
                                                    "; needs ",
                                                    [
                                                      "if",
                                                      [
                                                        "eq",
                                                        "$check.expected",
                                                        "true"
                                                      ],
                                                      "yes",
                                                      [
                                                        "if",
                                                        [
                                                          "eq",
                                                          "$check.expected",
                                                          "false"
                                                        ],
                                                        "no",
                                                        "$check.expected"
                                                      ]
                                                    ]
                                                  ]
                                                ]
                                              }
                                            ]
                                          ]
                                        }
                                      ]
                                    ]
                                  }
                                ],
                                null
                              ]
                            ]
                          }
                        ]
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ],
        "yield": [
          "append",
          "$cards",
          [
            "list",
            "$card"
          ]
        ],
        "into": "cards"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "claim.review.html",
          "input": {
            "node": "$cards"
          }
        },
        "into": "markup"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#review-results",
          "html": "$markup"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#review-announcement",
          "name": "textContent",
          "value": [
            "concat",
            [
              "count",
              "$selected"
            ],
            " of 4 evidence items selected. ",
            [
              "at",
              [
                "at",
                "$reviews",
                0
              ],
              "result"
            ],
            ", ",
            [
              "at",
              [
                "at",
                "$reviews",
                1
              ],
              "result"
            ],
            ", ",
            [
              "at",
              [
                "at",
                "$reviews",
                2
              ],
              "result"
            ],
            ". Results updated."
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#review-loading",
          "name": "hidden",
          "value": true
        },
        "into": "_"
      }
    ]
  }
}
