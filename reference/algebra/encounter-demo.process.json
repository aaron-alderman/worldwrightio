{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "encounter.demo.boot": [
      {
        "let": "spPolicy",
        "value": "$data.presentation.spPolicy"
      },
      {
        "let": "spGrammar",
        "value": "$data.presentation.spGrammar"
      },
      {
        "call": "sp.style"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-source-style",
          "name": "textContent",
          "value": "$result"
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.prepare",
          "input": "$data.inputs"
        },
        "into": "candidate"
      },
      {
        "port": "state.set",
        "args": {
          "key": "candidate",
          "value": "$candidate"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "notice",
          "value": "The story and the row share a title. The web menu has its own wording."
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "selection",
          "value": "meaning"
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#encounter-apply",
          "event": "click",
          "query": "encounter.demo.apply",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#encounter-reset",
          "event": "click",
          "query": "encounter.demo.reset",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#inspect-meaning",
          "event": "click",
          "query": "encounter.demo.select",
          "input": {
            "selection": "meaning"
          }
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#inspect-facts",
          "event": "click",
          "query": "encounter.demo.select",
          "input": {
            "selection": "facts"
          }
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#inspect-contract",
          "event": "click",
          "query": "encounter.demo.select",
          "input": {
            "selection": "contract"
          }
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#inspect-process",
          "event": "click",
          "query": "encounter.demo.select",
          "input": {
            "selection": "process"
          }
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#inspect-inspector",
          "event": "click",
          "query": "encounter.demo.select",
          "input": {
            "selection": "inspector"
          }
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.render",
          "input": {}
        },
        "into": "result"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-loading",
          "name": "hidden",
          "value": true
        },
        "into": "_"
      }
    ],
    "encounter.demo.change": [
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.run",
          "input": {
            "candidate": "$eventInput.candidate"
          }
        },
        "into": "before"
      },
      {
        "let": "pages",
        "value": [
          "filter",
          "$before",
          "item",
          [
            "eq",
            "$item.output.type",
            "Page"
          ]
        ]
      },
      {
        "assert": [
          "eq",
          [
            "count",
            "$pages"
          ],
          1
        ],
        "message": "Encounter requires one current Page projection."
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.patch",
          "input": {
            "candidate": "$eventInput.candidate",
            "projection": [
              "at",
              "$pages",
              0
            ],
            "field": "P.title",
            "value": "$eventInput.value"
          }
        },
        "into": "result"
      }
    ],
    "encounter.demo.apply": [
      {
        "port": "state.get",
        "args": {
          "key": "candidate"
        },
        "into": "candidate"
      },
      {
        "port": "browser.property",
        "args": {
          "ref": "#encounter-title",
          "name": "value"
        },
        "into": "proposed"
      },
      {
        "try": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "encounter.demo.change",
              "input": {
                "candidate": "$candidate",
                "value": "$proposed"
              }
            },
            "into": "change"
          },
          {
            "port": "state.set",
            "args": {
              "key": "candidate",
              "value": "$change.candidate"
            },
            "into": "_"
          },
          {
            "port": "state.set",
            "args": {
              "key": "notice",
              "value": "Accepted for this session. The story and the row changed; the web menu kept its own label."
            },
            "into": "_"
          },
          {
            "port": "state.set",
            "args": {
              "key": "selection",
              "value": "facts"
            },
            "into": "_"
          }
        ],
        "error": "fault",
        "catch": [
          {
            "port": "state.set",
            "args": {
              "key": "notice",
              "value": [
                "concat",
                "Refused. ",
                [
                  "at",
                  "$fault",
                  "message"
                ]
              ]
            },
            "into": "_"
          }
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.render",
          "input": {}
        },
        "into": "result"
      }
    ],
    "encounter.demo.reset": [
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.prepare",
          "input": "$data.inputs"
        },
        "into": "candidate"
      },
      {
        "port": "state.set",
        "args": {
          "key": "candidate",
          "value": "$candidate"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "selection",
          "value": "meaning"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "notice",
          "value": "Restored the original example. Reloading also starts a fresh session."
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.render",
          "input": {}
        },
        "into": "result"
      }
    ],
    "encounter.demo.select": [
      {
        "port": "state.set",
        "args": {
          "key": "selection",
          "value": "$eventInput.selection"
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.inspect",
          "input": {}
        },
        "into": "result"
      }
    ],
    "encounter.demo.html": [
      {
        "let": "input",
        "value": "$eventInput.tree"
      },
      {
        "call": "html.serialize"
      }
    ],
    "encounter.demo.render": [
      {
        "port": "state.get",
        "args": {
          "key": "candidate"
        },
        "into": "candidate"
      },
      {
        "port": "state.get",
        "args": {
          "key": "notice"
        },
        "into": "notice"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "ec.run",
          "input": {
            "candidate": "$candidate"
          }
        },
        "into": "projections"
      },
      {
        "let": "page",
        "value": [
          "at",
          [
            "filter",
            "$projections",
            "item",
            [
              "eq",
              "$item.output.type",
              "Page"
            ]
          ],
          0
        ]
      },
      {
        "let": "web",
        "value": [
          "at",
          [
            "filter",
            "$projections",
            "item",
            [
              "eq",
              "$item.output.type",
              "WebLink"
            ]
          ],
          0
        ]
      },
      {
        "let": "row",
        "value": [
          "at",
          [
            "filter",
            "$projections",
            "item",
            [
              "eq",
              "$item.output.type",
              "MainframeRow"
            ]
          ],
          0
        ]
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.html",
          "input": {
            "tree": "$page.output.tree"
          }
        },
        "into": "pageHTML"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.html",
          "input": {
            "tree": "$web.output.tree"
          }
        },
        "into": "webHTML"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.html",
          "input": {
            "tree": "$row.output.tree"
          }
        },
        "into": "rowHTML"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#encounter-story",
          "html": "$pageHTML"
        },
        "into": "_"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#encounter-menu",
          "html": "$webHTML"
        },
        "into": "_"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#encounter-row",
          "html": "$rowHTML"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-title",
          "name": "value",
          "value": [
            "at",
            "$page.values",
            "P.title"
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-status",
          "name": "textContent",
          "value": "$notice"
        },
        "into": "_"
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": "#encounter-menu a",
          "name": "href",
          "value": null
        },
        "into": "_"
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": "#encounter-menu a",
          "name": "role",
          "value": "text"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-row button",
          "name": "disabled",
          "value": true
        },
        "into": "_"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.inspect",
          "input": {}
        },
        "into": "result"
      }
    ],
    "encounter.demo.source": [
      {
        "let": "spPolicy",
        "value": "$data.presentation.spPolicy"
      },
      {
        "let": "spGrammar",
        "value": "$data.presentation.spGrammar"
      },
      {
        "let": "selection",
        "value": "$eventInput.selection"
      },
      {
        "let": "candidate",
        "value": "$eventInput.candidate"
      },
      {
        "let": "text",
        "value": "$candidate.inputs.codeText"
      },
      {
        "let": "language",
        "value": "encounter"
      },
      {
        "let": "file",
        "value": "story.encounter"
      },
      {
        "let": "label",
        "value": "The meaning and its routes"
      },
      {
        "when": [
          "eq",
          "$selection",
          "facts"
        ],
        "then": [
          {
            "let": "text",
            "value": "$candidate.inputs.factText"
          },
          {
            "let": "language",
            "value": "rel"
          },
          {
            "let": "file",
            "value": "story.rel"
          },
          {
            "let": "label",
            "value": "The current session source"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$selection",
          "contract"
        ],
        "then": [
          {
            "let": "text",
            "value": "$candidate.inputs.contractText"
          },
          {
            "let": "language",
            "value": "rel"
          },
          {
            "let": "file",
            "value": "contracts.rel"
          },
          {
            "let": "label",
            "value": "The closed type contracts"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$selection",
          "process"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "sp.listing",
              "input": {
                "programme": [
                  "at",
                  "$data.processes",
                  "encounter.demo.change"
                ],
                "origin": {
                  "file": "algebra/encounter-demo.process.json",
                  "query": "encounter.demo.change"
                }
              }
            },
            "into": "listing"
          },
          {
            "let": "text",
            "value": [
              "concat",
              "process encounter.demo.change:\n",
              "$listing.text"
            ]
          },
          {
            "let": "language",
            "value": "process"
          },
          {
            "let": "file",
            "value": "encounter-demo.process"
          },
          {
            "let": "label",
            "value": "How this change is composed"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$selection",
          "inspector"
        ],
        "then": [
          {
            "port": "kernel.invoke",
            "args": {
              "query": "sp.listing",
              "input": {
                "programme": [
                  "at",
                  "$data.processes",
                  "encounter.demo.inspect"
                ],
                "origin": {
                  "file": "algebra/encounter-demo.process.json",
                  "query": "encounter.demo.inspect"
                }
              }
            },
            "into": "listing"
          },
          {
            "let": "text",
            "value": [
              "concat",
              "process encounter.demo.inspect:\n",
              "$listing.text"
            ]
          },
          {
            "let": "language",
            "value": "process"
          },
          {
            "let": "file",
            "value": "encounter-inspector.process"
          },
          {
            "let": "label",
            "value": "The inspector’s own definition"
          }
        ]
      },
      {
        "port": "digest.sha256",
        "args": {
          "text": "$text"
        },
        "into": "hash"
      },
      {
        "let": "result",
        "value": {
          "text": "$text",
          "language": "$language",
          "file": "$file",
          "label": "$label",
          "hash": "$hash"
        }
      }
    ],
    "encounter.demo.inspect": [
      {
        "port": "state.get",
        "args": {
          "key": "candidate"
        },
        "into": "candidate"
      },
      {
        "port": "state.get",
        "args": {
          "key": "selection"
        },
        "into": "selection"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.source",
          "input": {
            "candidate": "$candidate",
            "selection": "$selection"
          }
        },
        "into": "source"
      },
      {
        "let": "spPolicy",
        "value": "$data.presentation.spPolicy"
      },
      {
        "let": "spGrammar",
        "value": "$data.presentation.spGrammar"
      },
      {
        "let": "lexPolicy",
        "value": "$data.presentation.lexPolicy"
      },
      {
        "let": "lexGrammar",
        "value": "$data.presentation.lexGrammar"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "sp.present",
          "input": {
            "text": "$source.text",
            "file": "$source.file",
            "language": "$source.language",
            "theme": "dark",
            "expectedHash": "$source.hash",
            "lineNumbers": true,
            "selectedLine": null,
            "origin": {
              "file": "$source.file",
              "sha256": "$source.hash",
              "scope": "current-session-definition; not an execution trace"
            }
          }
        },
        "into": "presentation"
      },
      {
        "port": "kernel.invoke",
        "args": {
          "query": "encounter.demo.html",
          "input": {
            "tree": "$presentation.tree"
          }
        },
        "into": "markup"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#encounter-source",
          "html": "$markup"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-source-label",
          "name": "textContent",
          "value": "$source.label"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#encounter-hash",
          "name": "textContent",
          "value": [
            "concat",
            "$source.file",
            " · SHA-256 ",
            "$source.hash"
          ]
        },
        "into": "_"
      },
      {
        "each": [
          "list",
          "meaning",
          "facts",
          "contract",
          "process",
          "inspector"
        ],
        "as": "part",
        "steps": [
          {
            "port": "browser.attribute",
            "args": {
              "ref": [
                "concat",
                "#inspect-",
                "$part"
              ],
              "name": "aria-pressed",
              "value": [
                "concat",
                [
                  "eq",
                  "$part",
                  "$selection"
                ]
              ]
            },
            "into": "_"
          }
        ]
      }
    ]
  }
}
