{
  "protocol": "temple/surface-process-module/1",
  "queries": {
    "reader.boot": [
      {
        "let": "visited",
        "value": [
          "list"
        ]
      },
      {
        "port": "storage.read",
        "args": {
          "key": "worldwright-aaron-trail-v1"
        },
        "into": "saved"
      },
      {
        "try": [
          {
            "when": "$saved.value",
            "then": [
              {
                "port": "json.parse",
                "args": {
                  "text": "$saved.value"
                },
                "into": "parsed"
              },
              {
                "when": [
                  "isArray",
                  "$parsed"
                ],
                "then": [
                  {
                    "let": "visited",
                    "value": [
                      "distinct",
                      [
                        "filter",
                        "$parsed",
                        "id",
                        [
                          "includes",
                          "$data.ids",
                          "$id"
                        ]
                      ]
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "error": "error",
        "catch": []
      },
      {
        "port": "state.set",
        "args": {
          "key": "visited",
          "value": "$visited"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "current",
          "value": "home"
        },
        "into": "_"
      },
      {
        "port": "state.set",
        "args": {
          "key": "previous",
          "value": "home"
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "window",
          "event": "hashchange",
          "query": "reader.route",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "document",
          "event": "click",
          "query": "reader.click",
          "input": {},
          "delegate": "[data-reader-action]"
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": "#reader-search",
          "event": "input",
          "query": "reader.search",
          "input": {}
        },
        "into": "_"
      },
      {
        "port": "browser.on",
        "args": {
          "ref": {
            "media": "(prefers-reduced-motion: reduce)"
          },
          "event": "change",
          "query": "reader.motion.sync",
          "input": {}
        },
        "into": "_"
      },
      {
        "call": "reader.motion.sync"
      },
      {
        "call": "reader.route"
      }
    ],
    "reader.motion.sync": [
      {
        "port": "storage.read",
        "args": {
          "key": "worldwright-motion"
        },
        "into": "preference"
      },
      {
        "port": "browser.environment",
        "args": {},
        "into": "environment"
      },
      {
        "let": "motion",
        "value": [
          "and",
          [
            "not",
            "$environment.reduced"
          ],
          [
            "not",
            [
              "eq",
              "$preference.value",
              "paused"
            ]
          ]
        ]
      },
      {
        "port": "state.set",
        "args": {
          "key": "motion",
          "value": "$motion"
        },
        "into": "_"
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": "body",
          "name": "data-motion",
          "value": [
            "if",
            "$motion",
            "on",
            "paused"
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-motion",
          "name": "disabled",
          "value": "$environment.reduced"
        },
        "into": "_"
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": "#reader-motion",
          "name": "aria-pressed",
          "value": "$motion"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-motion",
          "name": "textContent",
          "value": [
            "if",
            "$environment.reduced",
            "Reduced motion",
            [
              "if",
              "$motion",
              "Motion on",
              "Motion paused"
            ]
          ]
        },
        "into": "_"
      }
    ],
    "reader.route": [
      {
        "port": "browser.location",
        "args": {},
        "into": "location"
      },
      {
        "port": "text.slice",
        "args": {
          "value": "$location.hash",
          "start": 1
        },
        "into": "requested"
      },
      {
        "let": "id",
        "value": [
          "if",
          [
            "includes",
            "$data.ids",
            "$requested"
          ],
          "$requested",
          "home"
        ]
      },
      {
        "port": "state.get",
        "args": {
          "key": "current"
        },
        "into": "current"
      },
      {
        "port": "state.get",
        "args": {
          "key": "previous"
        },
        "into": "previous"
      },
      {
        "port": "state.get",
        "args": {
          "key": "visited"
        },
        "into": "visited"
      },
      {
        "let": "returning",
        "value": [
          "includes",
          "$visited",
          "$id"
        ]
      },
      {
        "when": [
          "not",
          [
            "eq",
            "$id",
            "$current"
          ]
        ],
        "then": [
          {
            "port": "state.set",
            "args": {
              "key": "previous",
              "value": "$current"
            },
            "into": "_"
          },
          {
            "let": "previous",
            "value": "$current"
          }
        ]
      },
      {
        "port": "state.set",
        "args": {
          "key": "current",
          "value": "$id"
        },
        "into": "_"
      },
      {
        "let": "input",
        "value": [
          "list"
        ]
      },
      {
        "call": "html.serialize"
      },
      {
        "let": "markup",
        "value": "$result"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#reader-echo",
          "html": "$markup"
        },
        "into": "_"
      },
      {
        "port": "browser.dialog",
        "args": {
          "ref": "#reader-dialog",
          "open": false
        },
        "into": "_"
      },
      {
        "when": [
          "eq",
          "$id",
          "home"
        ],
        "then": [
          {
            "let": "input",
            "value": {
              "tag": "section",
              "attrs": {
                "class": "reader-home"
              },
              "children": [
                "list",
                {
                  "tag": "p",
                  "attrs": {
                    "class": "eyebrow"
                  },
                  "children": [
                    "list",
                    "Aaron Alderman / A personal expedition"
                  ]
                },
                {
                  "tag": "h1",
                  "attrs": {},
                  "children": [
                    "list",
                    "Follow a question."
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {},
                  "children": [
                    "list",
                    "Forty places. More than one way through. Every place keeps its sources within reach."
                  ]
                },
                {
                  "tag": "div",
                  "attrs": {
                    "class": "reader-places"
                  },
                  "children": [
                    "list",
                    [
                      "map",
                      "$data.ids",
                      "placeId",
                      {
                        "tag": "a",
                        "attrs": {
                          "href": [
                            "concat",
                            "#",
                            "$placeId"
                          ],
                          "class": "reader-place"
                        },
                        "children": [
                          "list",
                          {
                            "tag": "strong",
                            "attrs": {},
                            "children": [
                              "list",
                              [
                                "at",
                                [
                                  "at",
                                  "$data.places",
                                  "$placeId"
                                ],
                                "region"
                              ]
                            ]
                          },
                          {
                            "tag": "span",
                            "attrs": {},
                            "children": [
                              "list",
                              [
                                "at",
                                [
                                  "at",
                                  "$data.places",
                                  "$placeId"
                                ],
                                "title"
                              ]
                            ]
                          }
                        ]
                      }
                    ]
                  ]
                }
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "markup",
            "value": "$result"
          },
          {
            "port": "browser.content",
            "args": {
              "ref": "#reader-content",
              "html": "$markup"
            },
            "into": "_"
          },
          {
            "port": "browser.title",
            "args": {
              "value": "Aaron Alderman — Follow a question"
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "not",
          [
            "eq",
            "$id",
            "home"
          ]
        ],
        "then": [
          {
            "let": "place",
            "value": [
              "at",
              "$data.places",
              "$id"
            ]
          },
          {
            "port": "asset.text",
            "args": {
              "url": [
                "concat",
                "places/",
                "$id",
                ".html"
              ],
              "cache": "no-cache"
            },
            "into": "document"
          },
          {
            "port": "document.fragment",
            "args": {
              "html": "$document",
              "selector": "main",
              "base": [
                "concat",
                "$location.origin",
                "/places/",
                "$id",
                ".html"
              ]
            },
            "into": "fragment"
          },
          {
            "port": "browser.content",
            "args": {
              "ref": "#reader-content",
              "html": "$fragment"
            },
            "into": "_"
          },
          {
            "port": "browser.title",
            "args": {
              "value": [
                "concat",
                "$place.region",
                " — Aaron Alderman"
              ]
            },
            "into": "_"
          },
          {
            "port": "browser.attribute",
            "args": {
              "ref": "body",
              "name": "data-light",
              "value": "$place.light"
            },
            "into": "_"
          },
          {
            "port": "browser.select",
            "args": {
              "selector": "#reader-content a[href]"
            },
            "into": "links"
          },
          {
            "each": "$links",
            "as": "link",
            "steps": [
              {
                "let": "href",
                "value": [
                  "at",
                  "$link.attributes",
                  "href"
                ]
              },
              {
                "port": "text.match",
                "args": {
                  "value": "$href",
                  "pattern": "/places/([^/?#]+)\\.html(?:$|[?#])"
                },
                "into": "match"
              },
              {
                "when": "$match",
                "then": [
                  {
                    "port": "browser.attribute",
                    "args": {
                      "ref": "$link.ref",
                      "name": "href",
                      "value": [
                        "concat",
                        "#",
                        [
                          "at",
                          "$match.groups",
                          0
                        ]
                      ]
                    },
                    "into": "_"
                  }
                ]
              }
            ]
          },
          {
            "port": "record.get",
            "args": {
              "record": "$data.echoes",
              "key": "$id"
            },
            "into": "echo"
          },
          {
            "when": "$echo",
            "then": [
              {
                "when": [
                  "includes",
                  "$visited",
                  "$echo.after"
                ],
                "then": [
                  {
                    "let": "input",
                    "value": {
                      "tag": "aside",
                      "attrs": {
                        "class": "return-echo"
                      },
                      "children": [
                        "list",
                        {
                          "tag": "p",
                          "attrs": {
                            "class": "eyebrow"
                          },
                          "children": [
                            "list",
                            "Another light you have encountered"
                          ]
                        },
                        {
                          "tag": "h2",
                          "attrs": {},
                          "children": [
                            "list",
                            "$echo.heading"
                          ]
                        },
                        {
                          "tag": "p",
                          "attrs": {},
                          "children": [
                            "list",
                            "$echo.text"
                          ]
                        },
                        {
                          "tag": "a",
                          "attrs": {
                            "href": [
                              "concat",
                              "#",
                              "$echo.to"
                            ]
                          },
                          "children": [
                            "list",
                            "Visit that question again →"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "call": "html.serialize"
                  },
                  {
                    "let": "markup",
                    "value": "$result"
                  },
                  {
                    "port": "browser.content",
                    "args": {
                      "ref": "#reader-echo",
                      "html": "$markup"
                    },
                    "into": "_"
                  }
                ]
              }
            ]
          },
          {
            "when": [
              "not",
              "$returning"
            ],
            "then": [
              {
                "let": "visited",
                "value": [
                  "append",
                  "$visited",
                  [
                    "list",
                    "$id"
                  ]
                ]
              },
              {
                "port": "state.set",
                "args": {
                  "key": "visited",
                  "value": "$visited"
                },
                "into": "_"
              },
              {
                "port": "json.stringify",
                "args": {
                  "value": "$visited"
                },
                "into": "saved"
              },
              {
                "port": "storage.write",
                "args": {
                  "key": "worldwright-aaron-trail-v1",
                  "value": "$saved"
                },
                "into": "_"
              }
            ]
          }
        ]
      },
      {
        "port": "browser.attribute",
        "args": {
          "ref": "#reader-back",
          "name": "href",
          "value": [
            "concat",
            "#",
            [
              "if",
              [
                "eq",
                "$previous",
                "$id"
              ],
              "home",
              "$previous"
            ]
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-count",
          "name": "textContent",
          "value": [
            "concat",
            [
              "count",
              "$visited"
            ],
            " ",
            [
              "if",
              [
                "eq",
                [
                  "count",
                  "$visited"
                ],
                1
              ],
              "place",
              "places"
            ],
            " discovered"
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-announcement",
          "name": "textContent",
          "value": [
            "if",
            [
              "eq",
              "$id",
              "home"
            ],
            "The expedition entrance",
            [
              "at",
              [
                "at",
                "$data.places",
                "$id"
              ],
              "region"
            ]
          ]
        },
        "into": "_"
      },
      {
        "port": "browser.scroll",
        "args": {},
        "into": "_"
      },
      {
        "port": "browser.focus",
        "args": {
          "ref": "#reader-content",
          "preventScroll": true
        },
        "into": "_"
      }
    ],
    "reader.click": [
      {
        "let": "action",
        "value": [
          "at",
          "$eventInput.matched.attributes",
          "data-reader-action"
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "close"
        ],
        "then": [
          {
            "port": "browser.dialog",
            "args": {
              "ref": "#reader-dialog",
              "open": false
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "atlas"
        ],
        "then": [
          {
            "call": "reader.atlas"
          },
          {
            "port": "browser.dialog",
            "args": {
              "ref": "#reader-dialog",
              "open": true
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "notes"
        ],
        "then": [
          {
            "call": "reader.notes"
          },
          {
            "port": "browser.dialog",
            "args": {
              "ref": "#reader-dialog",
              "open": true
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "about"
        ],
        "then": [
          {
            "let": "input",
            "value": {
              "tag": "section",
              "attrs": {},
              "children": [
                "list",
                {
                  "tag": "h2",
                  "attrs": {},
                  "children": [
                    "list",
                    "A person behind the questions."
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {},
                  "children": [
                    "list",
                    "I’m Aaron Alderman. My work moves through experimental physics, software, faith, and questions about how people understand and act together."
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {},
                  "children": [
                    "list",
                    "Some trails lead to a calculation or an instrument. Some lead to a correction. Some remain personal and unfinished. The research results retain their stated scope."
                  ]
                },
                {
                  "tag": "p",
                  "attrs": {},
                  "children": [
                    "list",
                    "Your visited places stay in this browser. No analytics or account is used by this story."
                  ]
                }
              ]
            }
          },
          {
            "call": "html.serialize"
          },
          {
            "let": "markup",
            "value": "$result"
          },
          {
            "port": "browser.content",
            "args": {
              "ref": "#reader-dialog-content",
              "html": "$markup"
            },
            "into": "_"
          },
          {
            "port": "browser.write",
            "args": {
              "ref": "#reader-search",
              "name": "hidden",
              "value": true
            },
            "into": "_"
          },
          {
            "port": "browser.dialog",
            "args": {
              "ref": "#reader-dialog",
              "open": true
            },
            "into": "_"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "reset"
        ],
        "then": [
          {
            "port": "state.set",
            "args": {
              "key": "visited",
              "value": [
                "list"
              ]
            },
            "into": "_"
          },
          {
            "port": "storage.remove",
            "args": {
              "key": "worldwright-aaron-trail-v1"
            },
            "into": "_"
          },
          {
            "port": "browser.dialog",
            "args": {
              "ref": "#reader-dialog",
              "open": false
            },
            "into": "_"
          },
          {
            "port": "browser.navigate",
            "args": {
              "hash": "home"
            },
            "into": "_"
          },
          {
            "call": "reader.route"
          }
        ]
      },
      {
        "when": [
          "eq",
          "$action",
          "motion"
        ],
        "then": [
          {
            "port": "state.get",
            "args": {
              "key": "motion"
            },
            "into": "motion"
          },
          {
            "port": "storage.write",
            "args": {
              "key": "worldwright-motion",
              "value": [
                "if",
                "$motion",
                "paused",
                "on"
              ]
            },
            "into": "_"
          },
          {
            "call": "reader.motion.sync"
          }
        ]
      }
    ],
    "reader.atlas": [
      {
        "port": "state.get",
        "args": {
          "key": "visited"
        },
        "into": "visited"
      },
      {
        "port": "state.get",
        "args": {
          "key": "current"
        },
        "into": "current"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-search",
          "name": "hidden",
          "value": false
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-search",
          "name": "value",
          "value": ""
        },
        "into": "_"
      },
      {
        "let": "input",
        "value": {
          "tag": "section",
          "attrs": {},
          "children": [
            "list",
            {
              "tag": "h2",
              "attrs": {},
              "children": [
                "list",
                "A world with room to wander."
              ]
            },
            {
              "tag": "p",
              "attrs": {},
              "children": [
                "list",
                [
                  "concat",
                  [
                    "count",
                    "$visited"
                  ],
                  " of ",
                  [
                    "count",
                    "$data.ids"
                  ],
                  " places discovered. Visited places are not a test score."
                ]
              ]
            },
            {
              "tag": "div",
              "attrs": {
                "class": "reader-places"
              },
              "children": [
                "list",
                [
                  "map",
                  "$data.ids",
                  "id",
                  {
                    "tag": "a",
                    "attrs": {
                      "class": [
                        "concat",
                        "reader-place ",
                        [
                          "if",
                          [
                            "includes",
                            "$visited",
                            "$id"
                          ],
                          "visited",
                          ""
                        ]
                      ],
                      "href": [
                        "concat",
                        "#",
                        "$id"
                      ],
                      "data-reader-search": [
                        "concat",
                        [
                          "at",
                          [
                            "at",
                            "$data.places",
                            "$id"
                          ],
                          "region"
                        ],
                        " ",
                        [
                          "at",
                          [
                            "at",
                            "$data.places",
                            "$id"
                          ],
                          "title"
                        ],
                        " ",
                        [
                          "at",
                          [
                            "at",
                            "$data.places",
                            "$id"
                          ],
                          "lead"
                        ]
                      ],
                      "aria-current": [
                        "if",
                        [
                          "eq",
                          "$current",
                          "$id"
                        ],
                        "location",
                        null
                      ]
                    },
                    "children": [
                      "list",
                      {
                        "tag": "strong",
                        "attrs": {},
                        "children": [
                          "list",
                          [
                            "concat",
                            [
                              "if",
                              [
                                "includes",
                                "$visited",
                                "$id"
                              ],
                              "◆ ",
                              "◇ "
                            ],
                            [
                              "at",
                              [
                                "at",
                                "$data.places",
                                "$id"
                              ],
                              "region"
                            ]
                          ]
                        ]
                      },
                      {
                        "tag": "span",
                        "attrs": {},
                        "children": [
                          "list",
                          [
                            "at",
                            [
                              "at",
                              "$data.places",
                              "$id"
                            ],
                            "title"
                          ]
                        ]
                      }
                    ]
                  }
                ]
              ]
            },
            {
              "tag": "button",
              "attrs": {
                "data-reader-action": "reset"
              },
              "children": [
                "list",
                "Begin a fresh expedition"
              ]
            }
          ]
        }
      },
      {
        "call": "html.serialize"
      },
      {
        "let": "markup",
        "value": "$result"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#reader-dialog-content",
          "html": "$markup"
        },
        "into": "_"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-search-result",
          "name": "textContent",
          "value": ""
        },
        "into": "_"
      }
    ],
    "reader.search": [
      {
        "port": "text.trim",
        "args": {
          "value": "$eventInput.event.target.value"
        },
        "into": "term"
      },
      {
        "port": "text.lowerCase",
        "args": {
          "value": "$term"
        },
        "into": "term"
      },
      {
        "port": "browser.select",
        "args": {
          "selector": "[data-reader-search]"
        },
        "into": "places"
      },
      {
        "fold": "$places",
        "as": "place",
        "accumulator": "matches",
        "initial": 0,
        "steps": [
          {
            "port": "text.lowerCase",
            "args": {
              "value": [
                "at",
                "$place.attributes",
                "data-reader-search"
              ]
            },
            "into": "search"
          },
          {
            "let": "match",
            "value": [
              "or",
              [
                "eq",
                "$term",
                ""
              ],
              [
                "includes",
                "$search",
                "$term"
              ]
            ]
          },
          {
            "port": "browser.write",
            "args": {
              "ref": "$place.ref",
              "name": "hidden",
              "value": [
                "not",
                "$match"
              ]
            },
            "into": "_"
          }
        ],
        "yield": [
          "add",
          "$matches",
          [
            "if",
            "$match",
            1,
            0
          ]
        ],
        "into": "matches"
      },
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-search-result",
          "name": "textContent",
          "value": [
            "if",
            [
              "eq",
              "$term",
              ""
            ],
            "",
            [
              "concat",
              "$matches",
              " matching places."
            ]
          ]
        },
        "into": "_"
      }
    ],
    "reader.notes": [
      {
        "port": "browser.write",
        "args": {
          "ref": "#reader-search",
          "name": "hidden",
          "value": true
        },
        "into": "_"
      },
      {
        "let": "input",
        "value": {
          "tag": "section",
          "attrs": {},
          "children": [
            "list",
            {
              "tag": "h2",
              "attrs": {},
              "children": [
                "list",
                "Where the stories come from."
              ]
            },
            [
              "map",
              "$data.notes",
              "note",
              {
                "tag": "details",
                "attrs": {},
                "children": [
                  "list",
                  {
                    "tag": "summary",
                    "attrs": {},
                    "children": [
                      "list",
                      "$note.title"
                    ]
                  },
                  [
                    "map",
                    "$note.paragraphs",
                    "paragraph",
                    {
                      "tag": "p",
                      "attrs": {},
                      "children": [
                        "list",
                        "$paragraph"
                      ]
                    }
                  ],
                  {
                    "tag": "p",
                    "attrs": {},
                    "children": [
                      "list",
                      "$note.note"
                    ]
                  },
                  {
                    "tag": "p",
                    "attrs": {},
                    "children": [
                      "list",
                      "$note.kind"
                    ]
                  },
                  {
                    "tag": "a",
                    "attrs": {
                      "href": "$note.href",
                      "target": "_blank",
                      "rel": "noopener"
                    },
                    "children": [
                      "list",
                      "Read the original source ↗"
                    ]
                  }
                ]
              }
            ]
          ]
        }
      },
      {
        "call": "html.serialize"
      },
      {
        "let": "markup",
        "value": "$result"
      },
      {
        "port": "browser.content",
        "args": {
          "ref": "#reader-dialog-content",
          "html": "$markup"
        },
        "into": "_"
      }
    ]
  }
}
