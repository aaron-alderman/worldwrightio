      list("StyleRule", ".experience-link", list(
        list("Declaration", "display", "block"),
        list("Declaration", "border", "1px solid #a77d5b"),
        list("Declaration", "background", "linear-gradient(135deg,#b87e4c22,#aa7dae11)"),
        list("Declaration", "border-radius", "5px"),
        list("Declaration", "padding", "20px 23px"),
