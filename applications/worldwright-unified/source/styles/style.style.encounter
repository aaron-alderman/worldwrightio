        list("Declaration", "-webkit-font-smoothing", "antialiased")
      )),
      list("StyleRule", "button,a", list(
        list("Declaration", "-webkit-tap-highlight-color", "transparent")
      )),
      list("StyleRule", "button", list(
        list("Declaration", "font", "inherit"),
        list("Declaration", "color", "inherit"),
        list("Declaration", "cursor", "pointer")
      )),
      list("StyleRule", "a", list(
        list("Declaration", "color", "inherit"),
        list("Declaration", "text-decoration", "none")
      )),
      list("StyleRule", "button", list(
        list("Declaration", "background", "none"),
        list("Declaration", "border", "0")
      )),
      list("StyleRule", "button:disabled", list(
        list("Declaration", "opacity", ".4"),
        list("Declaration", "cursor", "default")
      )),
      list("StyleRule", ":focus-visible", list(
        list("Declaration", "outline", "2px solid var(--lime)"),
        list("Declaration", "outline-offset", "6px")
      )),
      list("StyleRule", "::selection", list(
        list("Declaration", "background", "#f48b5855")
      )),
