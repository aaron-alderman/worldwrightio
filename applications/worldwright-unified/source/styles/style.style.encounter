        list("StyleRule", "html", list(
          list("Declaration", "scroll-behavior", "auto")
        )),
        list("StyleRule", "*,*:before,*:after", list(
          list("Declaration", "animation", "none!important"),
          list("Declaration", "transition", "none!important")
        ))
