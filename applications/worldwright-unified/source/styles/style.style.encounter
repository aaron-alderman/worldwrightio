process-module "temple/surface-process-module/1"

process style.definition:
  let result = {
    protocol = "encounter/style-projection/1";
    identity = "style.css";
    reason = "Own selectors, contexts and individual declarations as editable values.";
    target = "style.css";
    goal = "Generate CSS from rules without a latent stylesheet.";
    sheet = list("StyleSheet", list(
      list("StyleRule", ":root", list(
        list("Declaration", "color-scheme", "dark"),
        list("Declaration", "--ink", "#100e16"),
        list("Declaration", "--paper", "#f1e9d9"),
        list("Declaration", "--muted", "#a8a1ad"),
        list("Declaration", "--orange", "#f48b58"),
        list("Declaration", "--lime", "#d1ef8d"),
        list("Declaration", "--line", "#ffffff1c"),
        list("Declaration", "--serif", "Georgia,'Times New Roman',serif"),
        list("Declaration", "--sans", "Arial,Helvetica,sans-serif"),
        list("Declaration", "--mono", "'Courier New',monospace")
      )),
      list("StyleRule", "*", list(
        list("Declaration", "box-sizing", "border-box")
      )),
      list("StyleRule", "html", list(
        list("Declaration", "scroll-behavior", "smooth")
      )),
      list("StyleRule", "body", list(
        list("Declaration", "margin", "0"),
        list("Declaration", "background", "var(--ink)"),
        list("Declaration", "color", "var(--paper)"),
        list("Declaration", "font-family", "var(--sans)"),
