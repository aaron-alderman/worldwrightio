process-module "temple/surface-process-module/1"

process style.definition:
  let result = {
    protocol = "encounter/style-projection/1";
    identity = "territories.css";
    reason = "Own selectors, contexts and individual declarations as editable values.";
    target = "territories.css";
    goal = "Generate CSS from rules without a latent stylesheet.";
    sheet = list("StyleSheet", list(
      list("StyleRule", ":root", list(
        list("Declaration", "--accent", "#e9b991"),
        list("Declaration", "--glow", "#9e5e49"),
        list("Declaration", "--sky", "#100e16"),
        list("Declaration", "--soft", "#d4c0d4"),
        list("Declaration", "--leaf", "#91ac8b")
      )),
      list("StyleRule", "body", list(
        list("Declaration", "--orange", "var(--accent)"),
        list("Declaration", "--lime", "var(--accent)"),
