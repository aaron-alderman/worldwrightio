("workshop","configuration","{\"inputs\":{\"codeText\":\"# Experimental syntax: facts and type contracts stay in REL.\\nmodule notebook\\n\\nview experiment.page.notebook of @ShoreNote isa Page:\\n  P.subject: source\\n  P.title: source.S.Title\\n  P.paragraphs: source.S.Content\\n  P.route: \\\"encounter-notebook.html\\\"\\n  edit P.title through source.S.Title\\n  show as NotebookPage\\n\\nview experiment.nav.notebook of @ShoreNote isa NavigationItem:\\n  N.label: source.S.Title\\n  N.target: source\\n  edit N.label through source.S.Title\\n\\n  in @experiment.FieldMenu:\\n    N.label: \\\"Open field note\\\"\\n    edit N.label here\\n    show as WebLink:\\n      page: @experiment.page.notebook\\n\\n  in @experiment.NotebookIndex:\\n    show as NotebookRow:\\n      option: \\\"01\\\"\\n      open: @experiment.openNotebook\\n\\nrepresentation WebLink:\\n  given navigation as NavigationItem\\n  given page as Page\\n  require page.P.subject equals navigation.N.target\\n  return WebLink:\\n    W.text: navigation.N.label\\n    W.href: page.P.route\\n  render:\\n    tag: \\\"a\\\"\\n    attrs:\\n      id: \\\"experiment-web-link\\\"\\n      href: result.W.href\\n    children:\\n      - result.W.text\\n  events:\\n    - selector: \\\"#experiment-web-link\\\"\\n      open: page\\n\\nrepresentation NotebookRow:\\n  given navigation as NavigationItem\\n  given option as text\\n  given open as NotebookPanelAction\\n  return NotebookRow:\\n    R.option: option\\n    R.label: navigation.N.label\\n    R.target: navigation.N.target\\n  render:\\n    tag: \\\"table\\\"\\n    attrs:\\n      class: \\\"experiment-row\\\"\\n    children:\\n      - tag: \\\"tbody\\\"\\n        children:\\n          - tag: \\\"tr\\\"\\n            children:\\n              - tag: \\\"td\\\"\\n                children:\\n                  - result.R.option\\n              - tag: \\\"td\\\"\\n                children:\\n                  - tag: \\\"button\\\"\\n                    attrs:\\n                      id: \\\"experiment-mainframe-row\\\"\\n                      type: \\\"button\\\"\\n                    children:\\n                      - result.R.label\\n  events:\\n    - selector: \\\"#experiment-mainframe-row\\\"\\n      run: open.A.process\\n      arguments:\\n        notebook: navigation.N.target\\n\\nrepresentation NotebookPage:\\n  given navigation as Page\\n  return Page:\\n    P.subject: navigation.P.subject\\n    P.title: navigation.P.title\\n    P.paragraphs: navigation.P.paragraphs\\n    P.route: navigation.P.route\\n  render:\\n    tag: \\\"article\\\"\\n    children:\\n      - tag: \\\"h2\\\"\\n        children:\\n          - result.P.title\\n      - each paragraph in result.P.paragraphs:\\n        tag: \\\"p\\\"\\n        children:\\n          - paragraph\\n\\nrepresentation OpenNotebook:\\n  given notebook as FieldNote\\n  return NotebookPanel:\\n    P.title: notebook.S.Title\\n    P.paragraphs: notebook.S.Content\\n  render:\\n    tag: \\\"article\\\"\\n    children:\\n      - tag: \\\"h2\\\"\\n        children:\\n          - result.P.title\\n      - each paragraph in result.P.paragraphs:\\n        tag: \\\"p\\\"\\n        children:\\n          - paragraph\\n\",\"factText\":\"// FieldNote data and explicitly addressed contexts. Facts remain REL.\\n(\\\"ShoreNote\\\", \\\"isa\\\", \\\"FieldNote\\\")\\n(\\\"ShoreNote\\\", \\\"S.Title\\\", \\\"At the inlet\\\")\\n(\\\"ShoreNote\\\", \\\"S.Content\\\", \\\"ShoreNote.first\\\")\\n(\\\"ShoreNote\\\", \\\"S.Content\\\", \\\"ShoreNote.second\\\")\\n(\\\"experiment.FieldMenu\\\", \\\"isa\\\", \\\"Context\\\")\\n(\\\"experiment.FieldMenu\\\", \\\"C.view\\\", \\\"experiment.nav.notebook\\\")\\n(\\\"experiment.NotebookIndex\\\", \\\"isa\\\", \\\"Context\\\")\\n(\\\"experiment.NotebookIndex\\\", \\\"C.view\\\", \\\"experiment.nav.notebook\\\")\\n(\\\"experiment.openNotebook\\\", \\\"isa\\\", \\\"NotebookPanelAction\\\")\\n(\\\"experiment.openNotebook\\\", \\\"A.process\\\", \\\"OpenNotebook\\\")\\n(\\\"experiment.openNotebook\\\", \\\"A.accepts\\\", \\\"FieldNote\\\")\\n(\\\"experiment.openNotebook\\\", \\\"A.effect\\\", \\\"local-navigation\\\")\\n\\n(\\\"ShoreNote.first\\\", \\\"isa\\\", \\\"TextEntry\\\")\\n(\\\"ShoreNote.first\\\", \\\"E.value\\\", \\\"The waterline crossed the lower marker at dawn.\\\")\\n(\\\"ShoreNote.second\\\", \\\"isa\\\", \\\"TextEntry\\\")\\n(\\\"ShoreNote.second\\\", \\\"E.value\\\", \\\"A second observer returned after the wind changed.\\\")\\n\",\"contractText\":\"// Experimental, closed contract profile. Vocabulary recovered from Sourcery; scope is this slice.\\n(\\\"iface.experiment.FieldNote\\\", \\\"isa\\\", \\\"Interface\\\")\\n(\\\"iface.experiment.FieldNote\\\", \\\"type\\\", \\\"FieldNote\\\")\\n(\\\"iface.experiment.FieldNote\\\", \\\"mode\\\", \\\"closed\\\")\\n(\\\"iface.experiment.FieldNote\\\", \\\"slot\\\", \\\"slot.experiment.FieldNote.S.Title\\\")\\n(\\\"slot.experiment.FieldNote.S.Title\\\", \\\"isa\\\", \\\"Slot\\\")\\n(\\\"slot.experiment.FieldNote.S.Title\\\", \\\"predicate\\\", \\\"S.Title\\\")\\n(\\\"slot.experiment.FieldNote.S.Title\\\", \\\"valueType\\\", \\\"string\\\")\\n(\\\"slot.experiment.FieldNote.S.Title\\\", \\\"cardinality\\\", \\\"one\\\")\\n(\\\"iface.experiment.FieldNote\\\", \\\"slot\\\", \\\"slot.experiment.FieldNote.S.Content\\\")\\n(\\\"slot.experiment.FieldNote.S.Content\\\", \\\"isa\\\", \\\"Slot\\\")\\n(\\\"slot.experiment.FieldNote.S.Content\\\", \\\"predicate\\\", \\\"S.Content\\\")\\n(\\\"slot.experiment.FieldNote.S.Content\\\", \\\"valueType\\\", \\\"string\\\")\\n(\\\"slot.experiment.FieldNote.S.Content\\\", \\\"cardinality\\\", \\\"many\\\")\\n(\\\"iface.experiment.NavigationItem\\\", \\\"isa\\\", \\\"Interface\\\")\\n(\\\"iface.experiment.NavigationItem\\\", \\\"type\\\", \\\"NavigationItem\\\")\\n(\\\"iface.experiment.NavigationItem\\\", \\\"mode\\\", \\\"closed\\\")\\n(\\\"iface.experiment.NavigationItem\\\", \\\"slot\\\", \\\"slot.experiment.NavigationItem.N.label\\\")\\n(\\\"s