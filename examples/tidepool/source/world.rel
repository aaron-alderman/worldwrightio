("quadrat", "y", "290")
("signals", "x", "370")
("signals", "y", "130")
("hypotheses", "x", "460")
("hypotheses", "y", "210")
("notebook", "x", "550")
("notebook", "y", "290")
("commons", "x", "640")
("commons", "y", "130")
("shoreline", "isa", "Microsite")
("shoreline", "title", "The shoreline desk")
("shoreline", "description", "A pocket field guide to noticing and comparing.")
("shoreline", "reading", "Begin with the waterline. Keep the frame and method stable, then record what would change your interpretation.")
("shoreline", "route", "shoreline.html")
("shoreline", "place", "transect")
("shoreline", "place", "quadrat")
