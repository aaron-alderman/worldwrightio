("world", "title", "Tidepool")
("world", "kicker", "THE COMMON FIELD STATION / NOTEBOOK Nº 01")
("world", "description", "Small observations. Shared questions. An inlet worth looking after.")
("world", "purpose", "A fictional coastal field station for learning how observations become careful, revisable decisions.")
("world", "entry", "arrival")
("world", "image", "assets/tidepool-chart.svg")
("world", "imageAlt", "An original chart of the fictional inlet: a coral transect line crosses turquoise shallows and hand-drawn contour rings.")
("arrival", "isa", "Place")
("arrival", "title", "Begin at the waterline")
("arrival", "question", "What can one small place teach us?")
("arrival", "reading", "Meet the inlet at low water. A line on the rock records where the sea reached yesterday. It is a clue, not a forecast. This fictional notebook invites you to notice, test and revise together.")
("arrival", "source", "station-notes")
("arrival", "choice", "arrival-next")
("arrival-next", "isa", "Choice")
("arrival-next", "label", "Next field note →")
("arrival-next", "target", "transect")
("transect", "isa", "Place")
("transect", "title", "Walk the same line twice")
("transect", "question", "What changed—and what only looks different?")
("transect", "reading", "A transect gives a walk a repeatable shape. Mark the start, record the time and keep the route stable. On the second visit, changes in light and water level may explain more than changes in the living community.")
("transect", "source", "station-notes")
("transect", "choice", "transect-next")
("transect-next", "isa", "Choice")
("transect-next", "label", "Next field note →")
("transect-next", "target", "quadrat")
("quadrat", "isa", "Place")
("quadrat", "title", "A frame for attention")
("quadrat", "question", "What falls outside the square?")
("quadrat", "reading", "Place an imaginary frame over a patch of shore. Count what you can name and mark what you cannot. A frame helps a comparison; it also leaves a great deal out. Keep the boundary visible in every interpretation.")
("quadrat", "source", "station-notes")
("quadrat", "choice", "quadrat-next")
("quadrat-next", "isa", "Choice")
("quadrat-next", "label", "Next field note →")
("quadrat-next", "target", "signals")
("signals", "isa", "Place")
("signals", "title", "Listen before explaining")
("signals", "question", "Is the rhythm in the shore or the instrument?")
("signals", "reading", "A periodic trace can look convincing. Here it is deliberately synthetic. Move through the clip and pause the live signal: the fixed baseline makes motion easier to compare. A beautiful signal is not evidence of its cause.")
("signals", "source", "station-notes")
("signals", "choice", "signals-next")
("signals-next", "isa", "Choice")
("signals-next", "label", "Next field note →")
("signals-next", "target", "hypotheses")
("hypotheses", "isa", "Place")
("hypotheses", "title", "Keep two explanations alive")
("hypotheses", "question", "What would make us change our minds?")
("hypotheses", "reading", "Suppose more small animals appear near the shaded edge. Perhaps shade matters. Perhaps the pools there are deeper. Record both explanations before choosing what to measure next. Agreement among copied reports is still one observation family.")
("hypotheses", "source", "station-notes")
("hypotheses", "choice", "hypotheses-next")
("hypotheses-next", "isa", "Choice")
("hypotheses-next", "label", "Next field note →")
("hypotheses-next", "target", "notebook")
("notebook", "isa", "Place")
("notebook", "title", "Leave a useful trail")
("notebook", "question", "Could another person repeat the work?")
("notebook", "reading", "A useful notebook records the question, method, boundary and change. Try the typed rule editor and inspect the exact source. A rejected edit is part of the record. Local previews do not silently publish changes to the shared station.")
("notebook", "source", "station-notes")
("notebook", "choice", "notebook-next")
("notebook-next", "isa", "Choice")
("notebook-next", "label", "Next field note →")
("notebook-next", "target", "commons")
("commons", "isa", "Place")
("commons", "title", "Borrow, return, account")
("commons", "question", "How do we share a small resource fairly?")
("commons", "reading", "Three survey kits belong to the fictional station. A request needs authority and a current revision. The receipt chain shows the decision and can be replayed. Changing a past receipt should fail verification, rather than rewrite the story.")
("commons", "source", "station-notes")
("commons", "choice", "commons-next")
("commons-next", "isa", "Choice")
("commons-next", "label", "Return to the waterline →")
("commons-next", "target", "arrival")
("station-notes", "isa", "Source")
("station-notes", "title", "The common field station: an imagined notebook")
("station-notes", "attribution", "Original Tidepool text and diagrams for Worldwright, CC0.")
("station-notes", "scope", "Fictional educational scenarios. No claims about a real coast, organisms, weather or safe field practice.")
